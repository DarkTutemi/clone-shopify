<script>
  function zvhcSwitchTab(tab) {
    const trackBtn = document.getElementById('zvhcTabTrackBtn');
    const orderBtn = document.getElementById('zvhcTabOrderBtn');
    const trackPanel = document.getElementById('zvhcTabTrackContent');
    const orderPanel = document.getElementById('zvhcTabOrderContent');
    const resultBox = document.getElementById('zvhcRealResult');
    if (resultBox) resultBox.style.display = 'none';

    if (tab === 'tracking') {
      trackBtn.classList.add('is-active');
      trackBtn.setAttribute('aria-selected', 'true');
      orderBtn.classList.remove('is-active');
      orderBtn.setAttribute('aria-selected', 'false');
      trackPanel.classList.add('is-active');
      orderPanel.classList.remove('is-active');
    } else {
      orderBtn.classList.add('is-active');
      orderBtn.setAttribute('aria-selected', 'true');
      trackBtn.classList.remove('is-active');
      trackBtn.setAttribute('aria-selected', 'false');
      orderPanel.classList.add('is-active');
      trackPanel.classList.remove('is-active');
    }
  }

  function zvhcDetectCarrier(code) {
    const clean = code.replace(/[\s-]/g, '').toUpperCase();
    if (/^(94|93|92|95|420|91)\d{18,22}$/.test(clean) || /^[A-Z]{2}\d{9}US$/.test(clean)) {
      return { name: 'USPS Ground Advantage / Priority', url: 'https://tools.usps.com/go/TrackConfirmAction?tLabels=' + encodeURIComponent(clean) };
    }
    if (/^1Z[A-Z0-9]{16}$/i.test(clean)) {
      return { name: 'UPS Track', url: 'https://www.ups.com/track?tracknum=' + encodeURIComponent(clean) };
    }
    if (/^\d{12}$/.test(clean) || /^\d{15}$/.test(clean)) {
      return { name: 'FedEx Express / Ground', url: 'https://www.fedex.com/fedextrack/?trknbr=' + encodeURIComponent(clean) };
    }
    if (/^\d{10}$/.test(clean)) {
      return { name: 'DHL Express', url: 'https://www.dhl.com/us-en/home/tracking/tracking-express.html?submit=1&tracking-id=' + encodeURIComponent(clean) };
    }
    return { name: 'Universal Carrier Network (17Track)', url: 'https://www.17track.net/en/track?nums=' + encodeURIComponent(clean) };
  }

  function zvhcHandleTrackSubmit(e) {
    e.preventDefault();
    const input = document.getElementById('zvhcTrackingInput');
    const carrierSelect = document.getElementById('zvhcCarrierSelect').value;
    const rawCode = input ? input.value.trim() : '';
    if (!rawCode) return;

    // Sanitize alphanumeric input safely
    const cleanCode = rawCode.replace(/[^a-zA-Z0-9-_]/g, '');
    let carrierInfo;

    if (carrierSelect === 'usps') {
      carrierInfo = { name: 'USPS (United States Postal Service)', url: 'https://tools.usps.com/go/TrackConfirmAction?tLabels=' + encodeURIComponent(cleanCode) };
    } else if (carrierSelect === 'fedex') {
      carrierInfo = { name: 'FedEx Express & Ground', url: 'https://www.fedex.com/fedextrack/?trknbr=' + encodeURIComponent(cleanCode) };
    } else if (carrierSelect === 'ups') {
      carrierInfo = { name: 'UPS (United Parcel Service)', url: 'https://www.ups.com/track?tracknum=' + encodeURIComponent(cleanCode) };
    } else if (carrierSelect === 'dhl') {
      carrierInfo = { name: 'DHL Express', url: 'https://www.dhl.com/us-en/home/tracking/tracking-express.html?submit=1&tracking-id=' + encodeURIComponent(cleanCode) };
    } else if (carrierSelect === '17track') {
      carrierInfo = { name: 'Universal Carrier Tracker (17Track)', url: 'https://www.17track.net/en/track?nums=' + encodeURIComponent(cleanCode) };
    } else {
      carrierInfo = zvhcDetectCarrier(cleanCode);
    }

    const resultBox = document.getElementById('zvhcRealResult');
    const badgeEl = document.getElementById('zvhcResultCarrierBadge');
    const codeEl = document.getElementById('zvhcResultCode');
    const outLink = document.getElementById('zvhcCarrierOutLink');

    // Safe DOM assignment with zero unsanitized innerHTML
    if (badgeEl) badgeEl.textContent = carrierInfo.name;
    if (codeEl) codeEl.textContent = cleanCode;
    if (outLink) {
      outLink.href = carrierInfo.url;
      outLink.setAttribute('aria-label', 'Open official live tracking for ' + cleanCode + ' on ' + carrierInfo.name);
    }

    if (resultBox) {
      resultBox.style.display = 'block';
      resultBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }
</script>

