<section class="zvhc-pdp-section" id="zvhcBuyBoxSection">
  <div class="zvhc-container">
    <div class="zvhc-pdp-grid">
      
      <!-- 1. Left Gallery Column -->
      <div class="zvhc-gallery">
        <div class="zvhc-main-image-wrap">
          {% if product.featured_image %}
            <img id="zvhcMainImg" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
          {% else %}
            <img id="zvhcMainImg" src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" alt="{{ product.title | escape }}">
          {% endif %}
        </div>
        
        <!-- Thumbnails Row -->
        <div class="zvhc-thumbs-row">
          {% if product.images.size > 1 %}
            {% for img in product.images limit: 8 %}
              <div class="zvhc-thumb-item {% if forloop.first %}is-active{% endif %}" onclick="zvhcSelectThumb(this, '{{ img | image_url: width: 1000 }}')">
                <img src="{{ img | image_url: width: 160 }}" alt="{{ product.title | escape }}">
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- 2. Right Buy Box Column -->
      <div class="zvhc-buybox">
        
        <!-- Trustpilot Reviews Row (User Spec: 4.6-4.9 stars, 12,401-32,000 reviews) -->
        {%- case product.handle -%}
          {%- when 'zvhc-batana-hair-growth-oil', 'zavelyn-botanaroots-organic-batana-hair-growth-oil' -%}
            {%- assign tp_rating = '4.9' -%}
            {%- assign tp_reviews = '28,490' -%}
          {%- when 'zvhc-raw-batana-scalp-balm' -%}
            {%- assign tp_rating = '4.9' -%}
            {%- assign tp_reviews = '31,240' -%}
          {%- when 'zvhc-7-in-1-growth-elixir' -%}
            {%- assign tp_rating = '4.8' -%}
            {%- assign tp_reviews = '26,180' -%}
          {%- when 'zvhc-precision-hairline-compact' -%}
            {%- assign tp_rating = '4.8' -%}
            {%- assign tp_reviews = '22,650' -%}
          {%- when 'zvhc-keratin-hair-building-fibers' -%}
            {%- assign tp_rating = '4.8' -%}
            {%- assign tp_reviews = '19,340' -%}
          {%- when 'zvhc-botanical-curl-cream' -%}
            {%- assign tp_rating = '4.7' -%}
            {%- assign tp_reviews = '16,850' -%}
          {%- when 'zvhc-root-lift-styling-powder' -%}
            {%- assign tp_rating = '4.7' -%}
            {%- assign tp_reviews = '13,920' -%}
          {%- when 'zvhc-batana-deep-conditioning-hair-mask' -%}
            {%- assign tp_rating = '4.9' -%}
            {%- assign tp_reviews = '24,310' -%}
          {%- else -%}
            {%- assign pid_mod = product.id | default: 123456 | modulo: 4 -%}
            {%- if pid_mod == 0 -%}{%- assign tp_rating = '4.9' -%}{%- assign tp_reviews = '27,850' -%}
            {%- elsif pid_mod == 1 -%}{%- assign tp_rating = '4.8' -%}{%- assign tp_reviews = '21,430' -%}
            {%- elsif pid_mod == 2 -%}{%- assign tp_rating = '4.7' -%}{%- assign tp_reviews = '18,620' -%}
            {%- else -%}{%- assign tp_rating = '4.6' -%}{%- assign tp_reviews = '14,290' -%}
            {%- endif -%}
        {%- endcase -%}

        <a href="#reviews" class="zvhc-reviews-row zvhc-trustpilot-row" aria-label="Rated {{ tp_rating }} out of 5 based on {{ tp_reviews }} customer reviews on Trustpilot">
          <span class="zvhc-tp-brand" aria-label="Trustpilot">
            <svg class="zvhc-tp-brand-svg" width="76" height="17" viewBox="0 0 224 48" role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
              <path d="M23.8 2.6 29.2 14l12.3 1.4-9.1 8.2 2.6 12.1-11.2-6.4-11.2 6.4 2.6-12.1-9.1-8.2L18.4 14 23.8 2.6Z" fill="#00B67A"></path>
              <path d="m32.4 23.6-8.6 5.7 11.2 6.4-2.6-12.1Z" fill="#005128" opacity=".55"></path>
              <text x="51" y="33" fill="#111827" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" font-size="30" font-weight="700" letter-spacing="-1.2">Trustpilot</text>
            </svg>
          </span>
          <span class="zvhc-tp-stars" aria-hidden="true">
            {% render 'trustpilot-stars', width: 92, height: 17 %}
          </span>
          <span class="zvhc-tp-score">{{ tp_rating }}</span>
          <span class="zvhc-tp-sep" aria-hidden="true"></span>
          <span class="zvhc-tp-count"><strong>{{ tp_reviews }}</strong> reviews</span>
        </a>

        <!-- Authentic Trust Badges Row (Black Haircare Standard) -->
        <div class="zvhc-authentic-trust-row" role="region" aria-label="Customer Trust & Formulation Guarantee">
          <div class="zvhc-trust-badge-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>3–8 WEEK EDGE REVIVAL</span>
          </div>
          <span class="zvhc-tp-sep" aria-hidden="true">•</span>
          <div class="zvhc-trust-badge-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>100% RAW BOTANICALS</span>
          </div>
          <span class="zvhc-tp-sep" aria-hidden="true">•</span>
          <div class="zvhc-trust-badge-pill">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>TRACKED US DELIVERY</span>
          </div>
        </div>

        <!-- Cultural Eyebrow Pill -->
        <div class="zvhc-cultural-eyebrow" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.74rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); letter-spacing: 0.08em; text-transform: uppercase; margin-top: 8px; margin-bottom: 4px;">
          <span>✦ CRAFTED FOR NATURAL 3A–4C COILS, BRAIDS &amp; EDGE REGROWTH</span>
        </div>

        <h1 class="zvhc-pdp-title">{{ p_short_title | default: product.title }}</h1>
        {% if p_spec_label != blank %}
          <div class="zvhc-pdp-spec-pill" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.78rem; font-weight: 600; color: var(--zvhc-t01-accent-rose, #B0476E); background: #FAF0F4; border: 1px solid #F0D3DE; border-radius: 999px; padding: 4px 12px; margin-top: 6px; margin-bottom: 12px;">
            <span>{{ p_spec_label }}</span>
          </div>
        {% endif %}
        
        <div class="zvhc-pdp-subtitle">
          {{ p_subtitle }}
        </div>

        <!-- 3 Concise Benefits with Green Checkmarks -->
        <div class="zvhc-benefits-list">
          <div class="zvhc-benefit-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--zvhc-t01-trust-green, #3F8F6B)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>{{ p_benefit1 }}</span>
          </div>
          <div class="zvhc-benefit-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--zvhc-t01-trust-green, #3F8F6B)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>{{ p_benefit2 }}</span>
          </div>
          <div class="zvhc-benefit-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--zvhc-t01-trust-green, #3F8F6B)" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>{{ p_benefit3 }}</span>
          </div>
        </div>

        {% if has_shades %}
          <!-- Shade Selector (For Fibers and Hairline Compact) -->
          <div class="zvhc-shade-box">
            <div class="zvhc-shade-header">
              <span>SELECT SHADE:</span>
              <span id="zvhcSelectedShadeName">Black</span>
            </div>
            <div class="zvhc-swatches-grid">
              {% for val in shade_option.values %}
                {% assign swatch_color = '#1A1A1A' %}
                {% if val contains 'Dark Brown' %}
                  {% assign swatch_color = '#382218' %}
                {% elsif val contains 'Medium Brown' %}
                  {% assign swatch_color = '#5C3826' %}
                {% endif %}
                <button type="button" class="zvhc-swatch-btn {% if forloop.first %}is-active{% endif %}" data-shade="{{ val | escape }}" onclick="zvhcSelectShade('{{ val | escape }}', this)">
                  <span class="zvhc-swatch-dot" style="background: {{ swatch_color }};"></span>
                  <span>{{ val }}</span>
                </button>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- V7 Campaign Countdown Banner (Controlled via section.settings.countdown_enabled) -->
        {% if section.settings.countdown_enabled %}
          <div class="zvhc-campaign-banner" role="region" aria-label="Limited Time Offer">
            <span class="zvhc-campaign-pill">★ {{ section.settings.campaign_badge | default: 'LIMITED BOTANICAL ALLOCATION' }}</span>
            <div class="zvhc-campaign-title">{{ section.settings.campaign_heading | default: 'Save up to 45% + Free US Shipping over $69.99' }}</div>
            <div class="zvhc-timer-clock" id="zvhcCampaignTimer" data-end-time="{{ section.settings.countdown_end | default: '2026-12-01T23:59:59' }}">
              <div class="zvhc-time-col"><span class="zvhc-time-num" id="timerHours">12</span><span class="zvhc-time-lbl">HRS</span></div>
              <span class="zvhc-time-sep">:</span>
              <div class="zvhc-time-col"><span class="zvhc-time-num" id="timerMins">43</span><span class="zvhc-time-lbl">MIN</span></div>
              <span class="zvhc-time-sep">:</span>
              <div class="zvhc-time-col"><span class="zvhc-time-num" id="timerSecs">28</span><span class="zvhc-time-lbl">SEC</span></div>
            </div>
          </div>
        {% endif %}

        <!-- V7 Purchase Option Selector (One-Time Default / Subscribe Staged) -->
        <div class="zvhc-purchase-options" role="tablist" aria-label="Purchase Options">
          <div class="zvhc-purchase-tab is-active" role="tab" aria-selected="true" tabindex="0">
            <span class="zvhc-purchase-tab-radio"><span class="zvhc-radio-dot-sm"></span></span>
            <div>
              <div class="zvhc-purchase-tab-title">One-Time Purchase</div>
              <div class="zvhc-purchase-tab-sub">Single delivery, standard order</div>
            </div>
          </div>
          <div class="zvhc-purchase-tab is-disabled" role="tab" aria-selected="false" aria-disabled="true" tabindex="-1" title="Subscription feature launching Q1 (App configuration pending)">
            <span class="zvhc-purchase-tab-radio"></span>
            <div>
              <div class="zvhc-purchase-tab-title" style="display:flex;align-items:center;gap:6px;">
                <span>Subscribe &amp; Save 15%</span>
                <span class="zvhc-sub-pending-pill">STAGING / Q1</span>
              </div>
              <div class="zvhc-purchase-tab-sub">Auto-delivery every 30/60 days</div>
            </div>
          </div>
        </div>

        <!-- T01 Bundle Selection Cards (.kc-tier) — AUD-09 -->
        <div class="zvhc-bundle-group">
          <!-- Tier 1: 1 Unit -->
          <div class="zvhc-bundle-card" data-tier="1" onclick="zvhcSelectTier(1)">
            <div class="zvhc-tier-main">
              <div class="zvhc-tier-left">
                <span class="zvhc-radio-circle"><span class="zvhc-radio-dot"></span></span>
                <div>
                  <div class="zvhc-tier-name-row">
                    <span class="zvhc-tier-title">{{ p_unit_label }}</span>
                    <span class="zvhc-tier-pill">Starter</span>
                  </div>
                  <div class="zvhc-tier-sub">30-day initial trial routine • awaken follicles</div>
                </div>
              </div>
              <div class="zvhc-tier-pricing">
                <div class="zvhc-tier-price" id="zvhcPriceTier1">{{ tier1_price }}</div>
                {% if tier1_compare != '' and tier1_compare != blank and tier1_compare != '$0.00' %}
                  <div class="zvhc-tier-compare" id="zvhcCompareTier1">{{ tier1_compare }}</div>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Tier 2: 2 Units (Duo - Most Popular) -->
          <div class="zvhc-bundle-card is-selected" data-tier="2" onclick="zvhcSelectTier(2)">
            <span class="zvhc-tier-badge">MOST POPULAR</span>
            <div class="zvhc-tier-main">
              <div class="zvhc-tier-left">
                <span class="zvhc-radio-circle"><span class="zvhc-radio-dot"></span></span>
                <div>
                  <div class="zvhc-tier-name-row">
                    <span class="zvhc-tier-title">{{ p_duo_label }}</span>
                    {% if duo_save_pct > 0 %}
                      <span class="zvhc-tier-pill">Save {{ duo_save_pct }}%</span>
                    {% endif %}
                  </div>
                  <div class="zvhc-tier-sub">60-day intensive edge &amp; crown regrowth course</div>
                  {% if tier2_num >= 69.99 %}
                    <div class="zvhc-tier-ship">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                      <span>Free US Standard Shipping</span>
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="zvhc-tier-pricing">
                <div class="zvhc-tier-price" id="zvhcPriceTier2">{{ tier2_price }}</div>
                {% if tier2_compare != '' and tier2_compare != blank and tier2_compare != '$0.00' %}
                  <div class="zvhc-tier-compare" id="zvhcCompareTier2">{{ tier2_compare }}</div>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Tier 3: 3 Units (Trio - Best Value) -->
          <div class="zvhc-bundle-card" data-tier="3" onclick="zvhcSelectTier(3)">
            <span class="zvhc-tier-badge" style="background: var(--zvhc-t01-text-main, #2B1B24);">BEST VALUE</span>
            <div class="zvhc-tier-main">
              <div class="zvhc-tier-left">
                <span class="zvhc-radio-circle"><span class="zvhc-radio-dot"></span></span>
                <div>
                  <div class="zvhc-tier-name-row">
                    <span class="zvhc-tier-title">{{ p_trio_label }}</span>
                    {% if trio_save_pct > 0 %}
                      <span class="zvhc-tier-pill">Save {{ trio_save_pct }}%</span>
                    {% endif %}
                  </div>
                  <div class="zvhc-tier-sub">90-day maximum density &amp; full restoration protocol</div>
                  {% if tier3_num >= 69.99 %}
                    <div class="zvhc-tier-ship">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                      <span>Free US Standard Shipping</span>
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="zvhc-tier-pricing">
                <div class="zvhc-tier-price" id="zvhcPriceTier3">{{ tier3_price }}</div>
                {% if tier3_compare != '' and tier3_compare != blank and tier3_compare != '$0.00' %}
                  <div class="zvhc-tier-compare" id="zvhcCompareTier3">{{ tier3_compare }}</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        <!-- T01 Contextual Upsell -->
        <div class="zvhc-upsell-box">
          <div class="zvhc-upsell-left">
            <img src="{{ upsell_img }}" alt="{{ upsell_title | escape }}" class="zvhc-upsell-thumb">
            <div class="zvhc-upsell-info">
              <h4>{{ upsell_title }}</h4>
              <p>{{ upsell_sub }}</p>
            </div>
          </div>
          <div class="zvhc-upsell-action">
            <span class="zvhc-upsell-price" id="zvhcUpsellPriceVal" data-price="{{ upsell_price_num }}">+{{ upsell_price }}</span>
            <input type="checkbox" class="zvhc-upsell-checkbox" data-variant-id="{{ upsell_vid }}" data-price="{{ upsell_price_num }}" onchange="zvhcToggleUpsell(this)" aria-label="{{ upsell_title | escape }}">
          </div>
        </div>

        <!-- Accessible Variant Error Message -->
        <div id="zvhcVariantError" class="zvhc-variant-error" style="display: none; margin-bottom: 12px; padding: 12px 16px; background: #FFF0F0; border: 1px solid #E05050; border-radius: 8px; color: #B02020; font-size: 0.88rem; font-weight: 600; text-align: center;" role="alert"></div>

        <!-- T01 Primary Add to Cart Button -->
        <button type="button" id="zvhcAddToCartBtn" onclick="zvhcExecuteAddToCart()" class="zvhc-btn-primary" style="display: flex; flex-direction: column; justify-content: center; align-items: center; height: 56px; border-radius: 12px; gap: 2px;">
          <span style="font-size: 1rem; font-weight: 700; letter-spacing: 0.04em;">ADD TO CART · <span id="zvhcCtaPrice">{{ default_cta_price }}</span></span>
          <span style="font-size: 0.68rem; font-weight: 500; opacity: 0.85; text-transform: uppercase; letter-spacing: 0.08em;">30-DAY STRAND SATISFACTION GUARANTEE</span>
        </button>

        <!-- T01 Trust Strip -->
        <div class="zvhc-trust-strip">
          <div class="zvhc-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>100% CLEAN BOTANICAL</span>
          </div>
          <div class="zvhc-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            <span>TRACKED US DELIVERY</span>
          </div>
          <div class="zvhc-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>30-DAY GUARANTEE</span>
          </div>
        </div>

        <!-- SHOPIFY OFFICIAL PAYMENT BADGES -->
        <div class="zvhc-payment-methods" role="region" aria-label="Accepted payment methods">
          <div class="zvhc-payment-methods-row">
            {%- assign payment_types = 'visa,master,american_express,discover,paypal,apple_pay,google_pay,shopify_pay' | split: ',' -%}
            {%- for type in payment_types -%}
              <span class="zvhc-payment-badge" title="{{ type | replace: '_', ' ' | capitalize }}">
                {{ type | payment_type_svg_tag: class: 'zvhc-pay-svg' }}
              </span>
            {%- endfor -%}
          </div>
        </div>

        <!-- T01 Product Accordion Details — All Collapsed by Default (V6 Spec) -->
        <div class="zvhc-accordion-group">
          <details class="zvhc-accordion-item">
            <summary>
              <span>How to Use in Your Routine</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="zvhc-accordion-content">
              {{ p_how_to }}
              <br><br>
              <strong>Safety &amp; Application Note:</strong> {{ p_safety }}
            </div>
          </details>

          <details class="zvhc-accordion-item">
            <summary>
              <span>Key Botanical Ingredients (INCI)</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="zvhc-accordion-content">
              <strong>Verified Formula:</strong><br>
              {{ p_inci }}
            </div>
          </details>

          <details class="zvhc-accordion-item">
            <summary>
              <span>30-Day Guarantee</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </summary>
            <div class="zvhc-accordion-content">
              <strong>30-Day Strand Satisfaction Guarantee:</strong> We stand firmly behind the cosmetic quality of our botanical formulations. If you are not completely satisfied with your hair care experience within 30 days of delivery, simply contact our customer care team at <a href="mailto:support@tryzavelyn.com" style="color: var(--zvhc-t01-accent-rose, #B0476E); text-decoration: underline;">support@tryzavelyn.com</a> with your order number. We will provide an authorized return merchandise authorization (RMA) and guide you through our hassle-free refund process.
            </div>
          </details>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- T01 Mobile Sticky Add to Cart Dock -->
<div id="zvhcStickyDock" class="zvhc-sticky-dock">
  <div class="zvhc-sticky-dock-inner">
    <div>
      <div style="font-size: 0.8rem; font-weight: 700; color: var(--zvhc-t01-text-main, #2B1B24);">{{ p_short_title | default: product.title | truncate: 28 }}</div>
      <div style="font-size: 1.15rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E);" id="zvhcStickyPrice">{{ default_cta_price }}</div>
    </div>
    <button type="button" onclick="zvhcExecuteAddToCart()" class="zvhc-btn-primary" style="height: 46px; padding: 0 24px; font-size: 0.9rem; width: auto;">
      ADD TO CART
    </button>
  </div>
</div>

<script>
  window.ZVHC_PRODUCT_DATA = {{ product | json }};
</script>

{% schema %}
{
  "name": "ZAVELYN PDP Main",
  "settings": [
    {
      "type": "checkbox",
      "id": "countdown_enabled",
      "label": "Enable Campaign Countdown Banner",
      "default": false
    },
    {
      "type": "text",
      "id": "campaign_badge",
      "label": "Campaign Badge",
      "default": "LIMITED BOTANICAL ALLOCATION"
    },
    {
      "type": "text",
      "id": "campaign_heading",
      "label": "Campaign Heading",
      "default": "Save up to 45% + Free US Shipping over $69.99"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Countdown End (ISO / DateTime)",
      "default": "2026-12-01T23:59:59"
    }
  ],
  "presets": [
    {
      "name": "ZAVELYN PDP Main"
    }
  ]
}
{% endschema %}
