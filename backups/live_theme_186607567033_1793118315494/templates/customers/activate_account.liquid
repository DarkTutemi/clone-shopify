<section class="section">
  <div class="page-width page-width--narrow">
    <h1>{{ 'customer.activate_account.title' | t }}</h1>
    <p class="section__subheader">{{ 'customer.activate_account.subtext' | t }}</p>

    {% form 'activate_customer_password', class: 'product__form' %}
      {%- if form.errors -%}
        <div class="field__error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="Password">{{ 'customer.activate_account.password' | t }}</label>
        <input class="field__input" type="password" name="customer[password]" id="Password" autocomplete="new-password">
      </div>
      <div class="field">
        <label class="field__label" for="PasswordConfirmation">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input class="field__input" type="password" name="customer[password_confirmation]" id="PasswordConfirmation" autocomplete="new-password">
      </div>
      <button type="submit" class="button button--primary button--full">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" name="decline" class="button button--text" style="margin-block-start: 1rem;">
        {{ 'customer.activate_account.cancel' | t }}
      </button>
    {% endform %}
  </div>
</section>
