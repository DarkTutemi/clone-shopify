{{ 'zhp-collection.css' | asset_url | stylesheet_tag }}
{{ 'zhp-collection.js' | asset_url | script_tag }}

<div class="zhp-wrapper">
  <section class="zhp-shop-section" id="shop-by-model">
    <div class="zhp-container">
      <div class="zhp-sec-header">
        <span class="zhp-sec-tag">HANDCRAFTED CATALOG</span>
        <h2 class="zhp-sec-title">Shop Zavelyn Handpans & Drums</h2>
        <p class="zhp-sec-subtitle">
          Save up to 50% today. Every instrument arrives as an all-inclusive complete kit—ready to play out of the box with zero previous musical training required.
        </p>
      </div>

      <div class="zhp-products-grid">
        <!-- 1. Zavelyn Handpan Master (22-Inch) -->
        <div class="zhp-card zhp-card-flagship">
          <span class="zhp-card-badge zhp-badge-flagship">CONCERT FLAGSHIP • SAVE 50%</span>
          <div class="zhp-card-media">
            <a href="/products/zavelyn-handpan-master" title="Zavelyn Handpan Master">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/img_1.jpg?v=1792907902" alt="Zavelyn Handpan Master 22-Inch Concert Instrument" loading="eager">
            </a>
          </div>
          <div class="zhp-card-body">
            <h3 class="zhp-card-title"><a href="/products/zavelyn-handpan-master">Zavelyn Handpan™ Master</a></h3>
            <div class="zhp-card-subtitle">Concert 22" (55 cm) • 12 Notes (D-Minor Kurd)</div>

            <ul class="zhp-card-specs-list">
              <li><span class="zhp-check">✓</span> Hand-hammered nitrided titanium steel acoustic chamber</li>
              <li><span class="zhp-check">✓</span> 12 harmonic tone fields (Ding + 11 Dimples) with warm cathedral sustain</li>
              <li><span class="zhp-check">✓</span> Includes foldable aluminum tripod stand & padded travel backpack</li>
            </ul>

            <!-- Audio Player -->
            <div class="zhp-audio-box" data-audio-src="https://cdn.shopify.com/s/files/1/0566/1209/4037/files/Pro_Sound_Bar_v2.mp3">
              <button type="button" class="zhp-audio-btn" aria-label="Listen to Master Handpan preview">
                <svg class="zhp-icon-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg class="zhp-icon-pause" viewBox="0 0 24 24" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <div class="zhp-audio-info">
                <span class="zhp-audio-label">Listen: <strong>Master 22" (12 Notes Kurd)</strong></span>
                <div class="zhp-audio-track"><div class="zhp-audio-progress"></div></div>
              </div>
            </div>

            <div class="zhp-included-pill-row">
              <span class="zhp-included-pill">22" Master Handpan</span>
              <span class="zhp-included-pill">Tripod Stand Included</span>
              <span class="zhp-included-pill">Padded Backpack</span>
              <span class="zhp-included-pill">Mallets & Edge Braid</span>
            </div>

            <div class="zhp-card-footer">
              <div class="zhp-price-row">
                <span class="zhp-price-now">$599.00</span>
                <span class="zhp-price-was">$1,199.00</span>
                <span class="zhp-price-save-badge">Save $600</span>
              </div>
              <a href="/products/zavelyn-handpan-master" class="zhp-card-cta">
                <span>View Instrument</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </a>
            </div>
          </div>
        </div>

