            <div class="zv-thumb-item" onclick="setVfitSlide('faceMask', 1); event.stopPropagation();"><img src="{{ facemask_img_2 }}" alt="Thumb 2"></div>
            <div class="zv-thumb-item" onclick="setVfitSlide('faceMask', 2); event.stopPropagation();"><img src="{{ facemask_img_3 }}" alt="Thumb 3"></div>
            <div class="zv-thumb-item" onclick="setVfitSlide('faceMask', 3); event.stopPropagation();"><img src="{{ facemask_img_4 }}" alt="Thumb 4"></div>
