{% comment %}
  Clone-navage/sections/navage-legal-footnotes.liquid
  1:1 Replica of bottom footnotes / medical survey citations on navage.com
{% endcomment %}

<section id="SectionId-{{ section.id }}" class="navage-legal-footnotes">
  <div class="navage-footnotes-container">
    <div class="navage-footnotes-content">
      <p>¹Among powered suction nasal irrigation devices. October 2024 Survey of US ENT Physicians.<br>
      ²Simulated Use Study.<br>
      ³Based on peer-reviewed clinical studies reviewed for quality and relevance to the Naväge<sup>®</sup> Nasal Cleaner and supported by established scientific and clinical evidence.<br>
      ⁴Source: Nielsen NIQ; Total Navage Brand, Electric Powered Nasal Suction.&nbsp;<br>
      *,⁵Proprietary Consumer Study April 2026</p>
    </div>
  </div>
</section>

<style>
  #SectionId-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    padding: 30px 20px 40px;
    box-sizing: border-box;
    font-family: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }

  #SectionId-{{ section.id }} .navage-footnotes-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  #SectionId-{{ section.id }} .navage-footnotes-content p {
    color: #7b7b7b;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.8;
    margin: 0;
    letter-spacing: 0.2px;
  }

  #SectionId-{{ section.id }} .navage-footnotes-content sup {
    font-size: 10px;
    line-height: 0;
  }

  @media screen and (max-width: 768px) {
    #SectionId-{{ section.id }} {
      padding: 24px 16px 30px;
    }
    #SectionId-{{ section.id }} .navage-footnotes-content p {
      font-size: 11px;
      line-height: 1.7;
    }
  }
</style>

{% schema %}
{
  "name": "Navage Legal Footnotes",
  "settings": [],
  "presets": [
    {
      "name": "Navage Legal Footnotes"
    }
  ]
}
{% endschema %}
