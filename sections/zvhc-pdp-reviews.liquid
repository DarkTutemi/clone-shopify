        </div>
      </div>

      <!-- Right: Formulation Integrity & Purity Standard -->
      <div class="zvhc-editorial-card" style="padding: 32px; background: #FFFFFF; border: 1px solid var(--zvhc-t01-border, #EAD7DD); border-radius: 16px;">
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 6px;">QUALITY COMMITMENT</div>
        <h3 class="zvhc-h3" style="font-size: 1.2rem; margin-bottom: 16px;">Our Clean Cosmetic Standard</h3>
        
        <div style="display: flex; flex-direction: column; gap: 16px;">
          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--zvhc-t01-pill-bg, #F8E4EB); color: var(--zvhc-t01-accent-rose, #B0476E); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;">✓</div>
            <div>
              <div style="font-weight: 700; font-size: 0.9rem; color: var(--zvhc-t01-text-main, #2B1B24);">100% Unrefined Plant Lipids</div>
              <div style="font-size: 0.82rem; color: var(--zvhc-t01-text-muted, #5A4651);">Cold-pressed oils extracted without harsh chemical solvents, coal tar, or mineral oil diluents.</div>
            </div>
          </div>

          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--zvhc-t01-pill-bg, #F8E4EB); color: var(--zvhc-t01-accent-rose, #B0476E); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;">✓</div>
            <div>
              <div style="font-weight: 700; font-size: 0.9rem; color: var(--zvhc-t01-text-main, #2B1B24);">Zero Heavy Mineral Oil or Silicones</div>
              <div style="font-size: 0.82rem; color: var(--zvhc-t01-text-muted, #5A4651);">Gentle botanical formulations that absorb completely, leaving no waxy grey residue on dark scalps.</div>
            </div>
          </div>

          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--zvhc-t01-pill-bg, #F8E4EB); color: var(--zvhc-t01-accent-rose, #B0476E); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;">✓</div>
            <div>
              <div style="font-weight: 700; font-size: 0.9rem; color: var(--zvhc-t01-text-main, #2B1B24);">60-Day Satisfaction Guarantee</div>
              <div style="font-size: 0.82rem; color: var(--zvhc-t01-text-muted, #5A4651);">If you are not completely satisfied with your strand results within 60 days, email support@tryzavelyn.com for a full refund.</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

