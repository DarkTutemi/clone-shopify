<script>
  let currentVariantId = '67916361629881';
  let currentUnitPrice = 169.99;
  let currentQty = 1;

  function switchSufImg(src) {
    document.getElementById('suf-main-img').src = src;
    document.querySelectorAll('.suf-thumb').forEach(t => {
      t.classList.toggle('active', t.src === src);
    });
  }

  function selectBundle(variantId, price, oldPrice, boxId, imgSrc) {
    currentVariantId = variantId;
    currentUnitPrice = parseFloat(price);

    document.querySelectorAll('.suf-bundle-box').forEach(b => b.classList.remove('active'));
    document.getElementById(boxId).classList.add('active');

    if (boxId === 'bundle-box-1') {
      document.getElementById('radio-bundle-1').checked = true;
    } else {
      document.getElementById('radio-bundle-2').checked = true;
    }

    if (imgSrc) switchSufImg(imgSrc);
    updateTotalDisplay();
  }

  function adjustQty(delta) {
    currentQty = Math.max(1, Math.min(10, currentQty + delta));
    document.getElementById('suf-qty').value = currentQty;
    updateTotalDisplay();
  }

  function updateTotalDisplay() {
    const total = (currentUnitPrice * currentQty).toFixed(2);
    document.getElementById('suf-total-display').innerText = '$' + total;
  }

  async function submitFunnelOrder() {
    const btn = document.getElementById('suf-checkout-btn');
    btn.disabled = true;
    btn.innerHTML = '<span>Processing...</span>';

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            id: currentVariantId,
            quantity: currentQty
          }]
        })
      });

      if (res.ok) {
        window.location.href = '/checkout';
      } else {
        window.location.href = `/cart/${currentVariantId}:${currentQty}`;
      }
    } catch (e) {
      window.location.href = `/cart/${currentVariantId}:${currentQty}`;
    }
  }
</script>

