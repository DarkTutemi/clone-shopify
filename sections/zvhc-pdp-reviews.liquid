{% comment %}
  ZAVELYN HAIR CARE — Verified Reviews & Formulation Transparency (v5.0)
  Compliant with FTC/Shopify guidelines: No fictional testimonials, honest empty-review state, formulation parity.
{% endcomment %}
<section class="zvhc-reviews-section" id="reviews" style="padding: 72px 0; background: var(--zvhc-t01-bg, #E9E4E6);">
  <div class="zvhc-container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 48px;">
      <div style="font-size: 0.78rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px;">VERIFIED TRANSPARENCY</div>
      <h2 class="zvhc-h2">Customer Reviews &amp; Formulation Integrity</h2>
      <p style="color: var(--zvhc-t01-text-muted, #5A4651); font-size: 0.95rem;">
        We collect authentic feedback exclusively from verified purchasers after their order delivery.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px; max-width: 1040px; margin: 0 auto;">
      
      <!-- Left: Honest Empty Review State -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 40px 28px; border: 1px dashed var(--zvhc-t01-border, #EAD7DD); background: #FFFFFF;">
        <div style="font-size: 2rem; margin-bottom: 12px;" aria-hidden="true">🌿</div>
        <h3 class="zvhc-h3" style="font-size: 1.25rem; margin-bottom: 8px;">Be the First to Share Your Experience</h3>
        <p style="font-size: 0.9rem; color: var(--zvhc-t01-text-muted, #5A4651); line-height: 1.55; margin-bottom: 24px; max-width: 380px;">
          Initial production orders are currently shipping. If you recently purchased this product, you will receive an automatic review link via email 14 days after delivery.
        </p>
        <a href="#zvhcBuyBoxSection" class="zvhc-btn-secondary" style="font-size: 0.85rem; padding: 10px 20px;">
          START YOUR STRAND RITUAL
        </a>
      </div>

      <!-- Right: Formulation Integrity & Purity Standard -->
      <div class="zvhc-editorial-card" style="padding: 32px; background: #FFFFFF; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 6px;">QUALITY COMMITMENT</div>
        <h3 class="zvhc-h3" style="font-size: 1.2rem; margin-bottom: 16px;">Our Clean Cosmetic Standard</h3>
        
        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--zvhc-t01-pill-bg, #F8E4EB); color: var(--zvhc-t01-accent-rose, #B0476E); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;">✓</div>
            <div>
              <div style="font-weight: 700; font-size: 0.9rem; color: var(--zvhc-t01-text-main, #2B1B24);">100% Unrefined Plant Lipids</div>
              <div style="font-size: 0.82rem; color: var(--zvhc-t01-text-muted, #5A4651);">Cold-pressed oils extracted without chemical solvents or petroleum diluents.</div>
            </div>
          </div>

          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--zvhc-t01-pill-bg, #F8E4EB); color: var(--zvhc-t01-accent-rose, #B0476E); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;">✓</div>
            <div>
              {% if product.handle == 'zvhc-batana-deep-conditioning-hair-mask' %}
                <div style="font-weight: 700; font-size: 0.9rem; color: var(--zvhc-t01-text-main, #2B1B24);">High-Slip Detangling Formulation</div>
                <div style="font-size: 0.82rem; color: var(--zvhc-t01-text-muted, #5A4651);">Enriched with cosmetic Dimethiconol &amp; Biotin to dramatically reduce wet comb breakage without parabens.</div>
              {% else %}
                <div style="font-weight: 700; font-size: 0.9rem; color: var(--zvhc-t01-text-main, #2B1B24);">Zero Harsh Sulfates or Parabens</div>
                <div style="font-size: 0.82rem; color: var(--zvhc-t01-text-muted, #5A4651);">Gentle botanical formulations that protect natural strand moisture and color integrity.</div>
              {% endif %}
            </div>
          </div>

          <div style="display: flex; gap: 12px; align-items: flex-start;">
            <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--zvhc-t01-pill-bg, #F8E4EB); color: var(--zvhc-t01-accent-rose, #B0476E); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 800; flex-shrink: 0;">✓</div>
            <div>
              <div style="font-weight: 700; font-size: 0.9rem; color: var(--zvhc-t01-text-main, #2B1B24);">30-Day Satisfaction Guarantee</div>
              <div style="font-size: 0.82rem; color: var(--zvhc-t01-text-muted, #5A4651);">If you're not satisfied with strand comfort within 30 days, email support@tryzavelyn.com for full assistance.</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "ZVHC Verified Reviews",
  "settings": []
}
{% endschema %}
