{% schema %}
{
  "name": "Earthly Guarantee",
  "settings": []
}
{% endschema %}

<div class="earthly-moneyback-wrapper">
  <div class="vs-section-has-top-divider vsmoneyback-section">
    <svg width="1440" height="111" viewBox="0 0 1440 111" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="width: 100%; height: auto;">
      <g clip-path="url(#clip0_mb)">
        <rect width="1440" height="110" transform="matrix(-1 0 0 1 1440 0.695801)" fill="white"/>
        <path d="M1718.4 50.1958L1607.47 43.3208C1496.54 36.4458 1274.67 22.6958 1052.8 34.1685C830.934 45.4692 609.066 82.4224 387.198 84.5708C165.331 86.7192 -56.5367 54.9224 -167.471 38.7231L-278.404 22.6958V132.696H-167.471C-56.5367 132.696 165.331 132.696 387.198 132.696C609.066 132.696 830.934 132.696 1052.8 132.696C1274.67 132.696 1496.54 132.696 1607.47 132.696H1718.4V50.1958Z" fill="#2C5801"/>
      </g>
      <defs>
        <clipPath id="clip0_mb">
          <rect width="1440" height="110" fill="white" transform="matrix(-1 0 0 1 1440 0.695801)"/>
        </clipPath>
      </defs>
    </svg>
  </div>

  <div class="vs-earthly-pdp-moneyback-section">
    <div class="vs-earthly-container">
      <div class="vs-earthly-pdp-moneyback-inner">
        <img class="vs-earthly-pdp-moneyback-badge" src="//earthlyderm.com/cdn/shop/files/moneyback-badge-banner_1024x1024.svg?v=1769471388" alt="100% Money Back Guarantee">
        <h2 class="vs-earthly-font45">Clearer, brighter skin or <br> <em>your money back</em></h2>
        {% if product.handle contains 'african' or product.handle contains 'black' %}
          <p class="vs-earthly-pdp-moneyback-subtitle">Enjoy 60 nights of clearer, calmer skin, with less than 0.3% of customers asking for their money back.</p>
        {% else %}
          <p class="vs-earthly-pdp-moneyback-subtitle">Enjoy 60 nights of Clearer, Brighter Skin, with less than 0.3% of customers asking for their money back.</p>
        {% endif %}
      </div>
      <div class="vs-earthly-pdp-moneyback-hero-image">
        <img class="vs-earthly-pdp-instagram-icon" src="//earthlyderm.com/cdn/shop/files/moneyback-hero-banner_1024x1024.png?v=1769471400" alt="Clear Skin Guarantee">
      </div>
    </div>
  </div>
</div>

<style>
.vs-earthly-pdp-moneyback-section {
  background-color: #2C5801;
  padding: 0 20px 0px 20px;
  text-align: center;
}
.vs-earthly-pdp-moneyback-inner {
  padding: 40px 0 20px 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.vs-earthly-pdp-moneyback-badge {
  width: 90px;
  height: 90px;
  margin-bottom: 20px;
}
.vs-earthly-pdp-moneyback-section .vs-earthly-font45 {
  color: #ffffff;
  font-family: 'Playfair Display', serif;
  font-size: 38px;
  line-height: 1.25;
  margin: 0 0 14px 0;
}
.vs-earthly-pdp-moneyback-section .vs-earthly-font45 em {
  font-style: italic;
  color: #F1B948;
}
.vs-earthly-pdp-moneyback-subtitle {
  color: rgba(255, 255, 255, 0.9);
  font-family: 'Poppins', sans-serif;
  font-size: 16px;
  max-width: 580px;
  margin: 0 auto;
}
.vs-earthly-pdp-moneyback-hero-image {
  margin-top: 30px;
  display: flex;
  justify-content: center;
}
.vs-earthly-pdp-moneyback-hero-image img {
  max-width: 840px;
  width: 100%;
  height: auto;
  display: block;
  margin: 0 auto;
}
</style>