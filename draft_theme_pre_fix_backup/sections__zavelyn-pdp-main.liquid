{% schema %}
{
  "name": "Zavelyn PDP Main V2",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Subtitle",
      "default": "ZAVELYN INNOVATIONS · INDUSTRIAL GRADE"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Alert Text",
      "default": "High US Demand · Limited Units Remaining at Clearance Pricing"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary CTA Button Text",
      "default": "CLAIM OFFER"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Enable Sticky Add to Cart Bar",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Zavelyn PDP Main V2"
    }
  ]
}
{% endschema %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign has_compare = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}
  {%- assign has_compare = true -%}
  {%- assign savings_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
{%- endif -%}

{%- comment -%} Detect Bundle Option Index (e.g. Option named 'Bundle', or containing 'Buy 1') {%- endcomment -%}
{%- assign bundle_opt_idx = -1 -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_name_down = opt.name | downcase -%}
  {%- if opt_name_down contains 'bundle' or opt_name_down contains 'package' or opt_name_down contains 'tier' or opt.values.first contains 'Buy 1' -%}
    {%- if bundle_opt_idx == -1 -%}
      {%- assign bundle_opt_idx = forloop.index0 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="zv-pdp-section-wrap" id="zvPdpSection">
  <div class="zv-pdp-container">
    <div class="zv-pdp-layout">

      <!-- LEFT COLUMN: PRODUCT GALLERY -->
      <div class="zv-pdp-gallery-col">
        <div class="zv-pdp-gallery-inner">
          <div class="zv-pdp-main-media" id="zvMainMediaWrap">
            {% if has_compare %}
              <div class="zv-media-badge" id="zvMediaBadge">SAVE {{ savings_percent }}%</div>
            {% endif %}
            
            {% assign featured_img = current_variant.featured_image | default: product.featured_image %}
            <img 
              id="zvMainImg" 
              src="{{ featured_img | image_url: width: 1200 }}" 
              alt="{{ featured_img.alt | default: product.title | escape }}"
              width="600"
              height="600"
              loading="eager"
            >
          </div>

          {% if product.images.size > 1 %}
            <div class="zv-pdp-thumbs-row" id="zvThumbnails">
              {% for image in product.images limit: 8 %}
                <button 
                  type="button" 
                  class="zv-thumb-btn {% if forloop.first %}active{% endif %}" 
                  data-img-src="{{ image | image_url: width: 1200 }}" 
                  data-thumb-index="{{ forloop.index0 }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" width="80" height="80" loading="lazy">
                </button>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      <!-- RIGHT COLUMN: BUY BOX (1:1 KITTY COLLECTIVE ANATOMY) -->
      <div class="zv-pdp-info-col">
        <div class="zv-pdp-buybox">
          
          <!-- Eyebrow Subtitle -->
          <div class="zv-pdp-eyebrow">
            {{ section.settings.eyebrow_text }}
          </div>

          <!-- Product Title -->
          <h1 class="zv-pdp-title">{{ product.title }}</h1>

          <!-- Price Row -->
          <div class="kc-base-price" id="zvBasePrice">
            <span class="kc-base-price__current" id="zvPriceCurrent">{{ current_variant.price | money }}</span>
            {% if has_compare %}
              <s id="zvPriceCompare">{{ current_variant.compare_at_price | money }}</s>
              <span class="kc-base-price__save" id="zvPriceSave">SAVE {{ savings_percent }}%</span>
            {% endif %}
          </div>

          <!-- Divider Line -->
          <div class="zv-divider-line"></div>

          <!-- Value Proposition & Benefits -->
          {%- include 'zavelyn-pdp-data' -%}
          <div class="zv-benefits-block">
            {% if zv_vp_b0 != blank %}
              <p class="zv-lead-prop">
                {{ zv_vp_sub }}
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">⚡</span><span><strong>{{ zv_vp_b0 }}</strong></span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛡️</span><span><strong>{{ zv_vp_b1 }}</strong></span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🔧</span><span><strong>{{ zv_vp_b2 }}</strong></span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🚚</span><span><strong>Dispatched within 24–48h</strong> from US fulfillment hubs</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">💚</span><span><strong>60-Day Money-Back Guarantee</strong> — 100% risk-free trial</span></div>
              </div>
            {% elsif product.handle contains 'diesel' or product.handle contains 'injector' %}
              <p class="zv-lead-prop">
                Stop fighting seized injectors for hours with slide hammers that damage cylinder heads. Power through rock-solid carbon in under 5 minutes.
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛠️</span><span><strong>High-frequency pneumatic vibration</strong> breaks carbon bonds effortlessly</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛡️</span><span><strong>Zero cylinder head damage</strong> — balanced vertical shock eliminates snapped threads</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🧰</span><span><strong>21-piece master adapter set</strong> fits Bosch, Delphi, Denso & Siemens injectors</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🚚</span><span><strong>Dispatched within 24–48h</strong> from US warehouses with insured tracking</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">💚</span><span><strong>60-Day Money-Back Guarantee</strong> — if she won't budge, get every cent back</span></div>
              </div>
            {% else %}
              <p class="zv-lead-prop">
                Engineered for maximum reliability and daily performance. Experience precision build quality backed by our ironclad satisfaction guarantee.
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">⚡</span><span><strong>Instant High Performance</strong> — tested and calibrated for immediate daily use</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛡️</span><span><strong>Heavy-Duty Premium Materials</strong> — built to outlast ordinary alternatives</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🚚</span><span><strong>Dispatched within 24–48h</strong> from US regional fulfillment centers</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">💚</span><span><strong>60-Day Money-Back Guarantee</strong> — zero risk to try in your home or shop</span></div>
              </div>
            {% endif %}
          </div>

          <!-- Color / Style Swatches (if multi-variant with attribute options) -->
          {% for option in product.options_with_values %}
            {% assign opt_idx = forloop.index0 %}
            {% if opt_idx != bundle_opt_idx %}
              <div class="zv-variant-swatches">
                <div class="zv-option-label">Select {{ option.name }}: <span class="zv-selected-val" data-opt-idx="{{ opt_idx }}">{{ option.selected_value }}</span></div>
                <div class="zv-option-pills">
                  {% for value in option.values %}
                    <button 
                      type="button" 
                      class="zv-option-pill {% if option.selected_value == value %}active{% endif %}"
                      data-option-index="{{ opt_idx }}"
                      data-option-value="{{ value | escape }}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endfor %}

          <!-- BUNDLE OFFERS (3 HORIZONTAL CARDS - KITTY COLLECTIVE STYLE) -->
          <fieldset class="kc-offers" id="zvBundleOffers">
            <legend class="visually-hidden">Choose your purchase offer</legend>

            {% if bundle_opt_idx > -1 %}
              <!-- DYNAMIC NATIVE BUNDLE VARIANTS (e.g. ThermoGlove) -->
              {% assign bundle_option = product.options_with_values[bundle_opt_idx] %}
              {% for val in bundle_option.values limit: 3 %}
                {% assign card_tier = forloop.index %}
                {% assign val_parts = val | split: ' (' %}
                {% assign clean_title = val_parts[0] %}
                {% assign clean_sub = val_parts[1] | remove: ')' | default: 'Complete Set' %}
                
                <label class="kc-offer" data-tier="{{ card_tier }}" data-bundle-val="{{ val | escape }}">
                  <input class="kc-offer__input" type="radio" name="zv_offer_tier" value="{{ card_tier }}" {% if card_tier == 2 %}checked{% endif %}>
                  <span class="kc-offer__card">
                    {% if card_tier == 2 %}<span class="kc-offer__badge">MOST POPULAR</span>{% endif %}
                    {% if card_tier == 3 %}<span class="kc-offer__badge">BEST VALUE</span>{% endif %}
                    <span class="kc-offer__body">
                      <span class="kc-offer__radio" aria-hidden="true"></span>
                      <span class="kc-offer__copy">
                        <strong>{{ clean_title }}</strong>
                        <small>{{ clean_sub }}</small>
                      </span>
                      <span class="kc-offer__prices">
                        <strong class="zv-tier-price" data-tier-idx="{{ card_tier }}">—</strong>
                        <s class="zv-tier-compare" data-tier-idx="{{ card_tier }}"></s>
                      </span>
                    </span>
                  </span>
                </label>
              {% endfor %}

            {% else %}
              <!-- SINGLE-VARIANT BUNDLE TIERS (e.g. Diesel Injector Kit) -->
              <!-- Card 1: 1 Set -->
              <label class="kc-offer" data-tier="1" data-qty="1">
                <input class="kc-offer__input" type="radio" name="zv_offer_tier" value="1">
                <span class="kc-offer__card">
                  <span class="kc-offer__body">
                    <span class="kc-offer__radio" aria-hidden="true"></span>
                    <span class="kc-offer__copy">
                      <strong>Buy 1 Kit</strong>
                      <small>Standard Master Set (21 Pcs)</small>
                    </span>
                    <span class="kc-offer__prices">
                      <strong id="zvOffer1Price">{{ current_variant.price | money }}</strong>
                      {% if has_compare %}<s id="zvOffer1Compare">{{ current_variant.compare_at_price | money }}</s>{% endif %}
                    </span>
                  </span>
                </span>
              </label>

              <!-- Card 2: 2 Sets (MOST POPULAR) -->
              <label class="kc-offer" data-tier="2" data-qty="2">
                <input class="kc-offer__input" type="radio" name="zv_offer_tier" value="2" checked>
                <span class="kc-offer__card">
                  <span class="kc-offer__badge">MOST POPULAR</span>
                  <span class="kc-offer__body">
                    <span class="kc-offer__radio" aria-hidden="true"></span>
                    <span class="kc-offer__copy">
                      <strong>Buy 2 Kits (Shop & Service Truck)</strong>
                      <small>Save Extra 10% · FREE Priority Shipping</small>
                    </span>
                    <span class="kc-offer__prices">
                      {% assign tier2_price = current_variant.price | times: 2 | times: 0.90 | round %}
                      {% assign tier2_compare = current_variant.compare_at_price | times: 2 %}
                      <strong id="zvOffer2Price">{{ tier2_price | money }}</strong>
                      {% if has_compare %}<s id="zvOffer2Compare">{{ tier2_compare | money }}</s>{% endif %}
                    </span>
                  </span>
                </span>
              </label>

              <!-- Card 3: 3 Sets (BEST VALUE) -->
              <label class="kc-offer" data-tier="3" data-qty="3">
                <input class="kc-offer__input" type="radio" name="zv_offer_tier" value="3">
                <span class="kc-offer__card">
                  <span class="kc-offer__badge">BEST VALUE</span>
                  <span class="kc-offer__body">
                    <span class="kc-offer__radio" aria-hidden="true"></span>
                    <span class="kc-offer__copy">
                      <strong>Buy 3 Kits (Fleet Master Pack)</strong>
                      <small>Save Extra 15% · FREE Express Shipping</small>
                    </span>
                    <span class="kc-offer__prices">
                      {% assign tier3_price = current_variant.price | times: 3 | times: 0.85 | round %}
                      {% assign tier3_compare = current_variant.compare_at_price | times: 3 %}
                      <strong id="zvOffer3Price">{{ tier3_price | money }}</strong>
                      {% if has_compare %}<s id="zvOffer3Compare">{{ tier3_compare | money }}</s>{% endif %}
                    </span>
                  </span>
                </span>
              </label>
            {% endif %}
          </fieldset>

          <!-- Urgency Bar -->
          <p class="kc-order-limit" id="zvUrgencyBar">
            <span aria-hidden="true">✦</span>
            <span>{{ section.settings.urgency_text }}</span>
          </p>

          <!-- CTA BUTTONS -->
          <div class="zv-cta-group">
            <button type="button" class="kc-claim-button" id="zvClaimOfferBtn">
              <span class="button-text">{{ section.settings.cta_text }} ➔</span>
              <div class="loading__spinner hidden" id="zvBtnSpinner">
                <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                  <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                </svg>
              </div>
            </button>

            <button type="button" class="zv-buy-now-btn" id="zvBuyNowBtn">
              ⚡ BUY NOW (1-CLICK CHECKOUT)
            </button>
          </div>

          <!-- Payment Icons -->
          <div class="zv-payment-icons-row" role="region" aria-label="Accepted payment methods">
            <!-- Visa -->
            <svg class="zv-pay-icon" viewBox="0 0 38 24" width="38" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" fill="#000"/>
              <path d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32" fill="#fff"/>
              <path d="M15.8 15.6l1.6-9.7h2.6l-1.6 9.7h-2.6zM27.6 6.1c-.5-.2-1.3-.4-2.3-.4-2.5 0-4.3 1.3-4.3 3.2 0 1.4 1.3 2.2 2.2 2.7.9.5 1.3.8 1.3 1.2 0 .6-.8.9-1.5.9-1 0-1.5-.1-2.3-.5l-.3-.2-.3 2c.6.3 1.7.5 2.8.5 2.7 0 4.4-1.3 4.4-3.3 0-1.1-.7-2-2.2-2.7-.9-.5-1.5-.8-1.5-1.3 0-.4.5-.9 1.5-.9.8 0 1.5.2 1.9.4l.2.1.4-2.1zM34.8 6.1h-2c-.6 0-1.1.2-1.3.8l-3.8 8.7h2.8l.6-1.5h3.4l.3 1.5h2.5l-2.5-9.5zm-3 6.1l1.4-3.8.8 3.8h-2.2zM12.4 6.1l-2.5 6.6-.3-1.4c-.5-1.7-2-3.5-3.7-4.4l2.4 8.9h2.8l4.2-9.7h-2.9z" fill="#1434CB"/>
            </svg>
            <!-- Mastercard -->
            <svg class="zv-pay-icon" viewBox="0 0 38 24" width="38" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path opacity=".07" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3z" fill="#000"/>
              <path fill="#fff" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32"/>
              <circle fill="#EB001B" cx="15" cy="12" r="7"/>
              <circle fill="#F79E1B" cx="23" cy="12" r="7"/>
              <path fill="#FF5F00" d="M22 12c0-2.4-1.2-4.5-3-5.7-1.8 1.2-3 3.3-3 5.7s1.2 4.5 3 5.7c1.8-1.2 3-3.3 3-5.7z"/>
            </svg>
            <!-- Amex -->
            <svg class="zv-pay-icon" viewBox="0 0 38 24" width="38" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill="#000" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z" opacity=".07"/>
              <path fill="#006FCF" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32Z"/>
              <path fill="#FFF" d="M22.012 19.936v-8.421L37 11.528v2.326l-1.732 1.852L37 17.573v2.375h-2.766l-1.47-1.622-1.46 1.628-9.292-.02Z"/>
              <path fill="#006FCF" d="M23.013 19.012v-6.57h5.572v1.513h-3.768v1.028h3.678v1.488h-3.678v1.01h3.768v1.531h-5.572Z"/>
            </svg>
            <!-- Apple Pay -->
            <svg class="zv-pay-icon" viewBox="0 0 38 24" width="38" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill="#000" d="M35 0H3C1.3 0 0 1.3 0 3v18c0 1.7 1.4 3 3 3h32c1.7 0 3-1.3 3-3V3c0-1.7-1.4-3-3-3Z" opacity=".07"/>
              <path fill="#FFF" d="M35 1c1.1 0 2 .9 2 2v18c0 1.1-.9 2-2 2H3c-1.1 0-2-.9-2-2V3c0-1.1.9-2 2-2h32Z"/>
              <path fill="#000" d="M12.9 8.2c.3-.4.5-.9.4-1.5-.5 0-1 .3-1.3.7-.3.3-.5.9-.4 1.4.6 0 1.1-.2 1.3-.6m.5.7c-.7 0-1.4.4-1.7.4-.4 0-1-.4-1.5-.4-.8 0-1.5.5-1.9 1.2-.8 1.4-.2 3.5.6 4.7.4.6.9 1.2 1.5 1.2.6 0 .8-.4 1.5-.4.7 0 .9.4 1.5.4.6 0 1-.6 1.4-1.2.5-.7.7-1.4.7-1.4-.1 0-1.3-.5-1.3-1.9 0-1.2 1-1.7 1-1.7-.6-.8-1.5-.9-1.8-.9m5.5-1.6h-2.1v9.2h1.3v-3.4h.8c1.7 0 2.8-1.2 2.8-2.9 0-1.8-1.1-2.9-2.8-2.9zm0 4.6h-.8V8.6h.8c1 0 1.6.7 1.6 1.7 0 1.1-.6 1.8-1.6 1.8m5.8 4.6v-1.1c-.4.8-1.2 1.2-2.1 1.2-1.3 0-2.2-.8-2.2-2 0-1.2 1-2 2.6-2.1l1.6-.1v-.5c0-.7-.5-1.1-1.4-1.1-.7 0-1.3.3-1.5.7l-1-.5c.4-.9 1.4-1.4 2.6-1.4 1.6 0 2.6.9 2.6 2.2v4.6h-1.2zm-.1-2.9l-1.3.1c-.8.1-1.3.4-1.3 1.1 0 .6.5 1 1.2 1 .9 0 1.4-.6 1.4-1.3v-.9m4.8 4.4l2.4-6.9h1.4l-3.2 8.5c-.5 1.4-1.2 1.9-2.4 1.9-.3 0-.6 0-.8-.1v-1.1c.2 0 .4.1.7.1.6 0 1-.3 1.2-.9l.2-.5-2.2-7h1.4l1.3 4.9z"/>
