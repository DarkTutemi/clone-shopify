{% comment %}
  Clone-navage/sections/navage-faq-accordion.liquid
  1:1 Frequently Asked Questions Accordion from navage.com
{% endcomment %}

<div id="SectionId-{{ section.id }}" class="navage-faq-section">
  <div class="navage-faq-container">
    <div class="navage-faq-header">
      <h2 class="navage-faq-title">FREQUENTLY ASKED QUESTIONS</h2>
      <p class="navage-faq-subtitle">Everything you need to know about Naväge and how it works.</p>
    </div>

    <div class="navage-faq-list">
      <div class="navage-faq-item active">
        <button type="button" class="navage-faq-question">
          <span>How is Naväge different from a neti pot?</span>
          <span class="navage-faq-toggle">−</span>
        </button>
        <div class="navage-faq-answer">
          <p>
            Naväge is the world's only nasal irrigator with gentle powered suction. Unlike neti pots and squeeze bottles that push fluids into your sinuses with gravity or pressure (often leading to ear pain or choking sensations), Naväge creates a comfortable closed loop: clean saline flows in through one nostril and gentle suction pulls it out through the other, completely flushing allergens, mucus, and irritants in 30 seconds without the mess.
          </p>
        </div>
      </div>

      <div class="navage-faq-item">
        <button type="button" class="navage-faq-question">
          <span>How does Naväge work?</span>
          <span class="navage-faq-toggle">+</span>
        </button>
        <div class="navage-faq-answer">
          <p>
            Naväge uses powered suction to pull saline from the upper tank, through your nasal cavity, and into the lower tank. You simply fill the upper tank with warm distilled water, insert a Naväge SaltPod capsule, place the nose pillows against your nostrils, and press the power button. In 30 seconds, your sinuses feel completely clear and refreshed.
          </p>
        </div>
      </div>

      <div class="navage-faq-item">
        <button type="button" class="navage-faq-question">
          <span>What are SaltPods?</span>
          <span class="navage-faq-toggle">+</span>
        </button>
        <div class="navage-faq-answer">
          <p>
            SaltPods are precisely pre-measured single-dose capsules containing pure pharmaceutical-grade sodium chloride and purified water concentrate. When mixed with water in the upper tank, it creates perfectly isotonic saline that matches your body's natural chemistry to prevent any burning or stinging.
          </p>
        </div>
      </div>

      <div class="navage-faq-item">
        <button type="button" class="navage-faq-question">
          <span>Is nasal irrigation safe to use every day?</span>
          <span class="navage-faq-toggle">+</span>
        </button>
        <div class="navage-faq-answer">
          <p>
            Yes! In fact, clinical research shows daily nasal irrigation is safe, natural, and highly effective for chronic allergies, sinusitis, cold and flu prevention, and improving breathing quality without drugs or side effects.
          </p>
        </div>
      </div>

      <div class="navage-faq-item">
        <button type="button" class="navage-faq-question">
          <span>Is Naväge good for allergies and sinus pressure?</span>
          <span class="navage-faq-toggle">+</span>
        </button>
        <div class="navage-faq-answer">
          <p>
            Absolutely. Naväge flushes away airborne pollen, dust, pet dander, viruses, and thick mucus trapped in nasal cilia, providing fast, natural relief from congestion and facial sinus pressure.
          </p>
        </div>
      </div>

      <div class="navage-faq-item">
        <button type="button" class="navage-faq-question">
          <span>Is Naväge covered by FSA or HSA?</span>
          <span class="navage-faq-toggle">+</span>
        </button>
        <div class="navage-faq-answer">
          <p>
            Yes, Naväge Nose Cleaners and SaltPod refills are eligible medical expenses under Flexible Spending Accounts (FSA) and Health Savings Accounts (HSA). You can use your FSA/HSA debit card directly at checkout.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #SectionId-{{ section.id }} {
    background-color: #ffffff;
    padding: 70px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  #SectionId-{{ section.id }} .navage-faq-container {
    max-width: 860px;
    margin: 0 auto;
  }
  #SectionId-{{ section.id }} .navage-faq-header {
    text-align: center;
    margin-bottom: 45px;
  }
  #SectionId-{{ section.id }} .navage-faq-title {
    font-size: 38px;
    font-weight: 800;
    color: #0b4a82;
    margin: 0 0 10px 0;
    letter-spacing: -0.5px;
  }
  #SectionId-{{ section.id }} .navage-faq-subtitle {
    font-size: 15px;
    color: #00A3E0;
    font-weight: 600;
    margin: 0;
  }
  #SectionId-{{ section.id }} .navage-faq-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  #SectionId-{{ section.id }} .navage-faq-item {
    border: 1px solid #dce8f3;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.25s ease;
  }
  #SectionId-{{ section.id }} .navage-faq-item.active {
    border-color: #00A3E0;
    box-shadow: 0 4px 18px rgba(0, 163, 224, 0.08);
  }
  #SectionId-{{ section.id }} .navage-faq-question {
    width: 100%;
    padding: 20px 24px;
    background: #ffffff;
    border: none;
    text-align: left;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 17px;
    font-weight: 700;
    color: #0b4a82;
    transition: color 0.2s ease;
  }
  #SectionId-{{ section.id }} .navage-faq-question:hover {
    color: #00A3E0;
  }
  #SectionId-{{ section.id }} .navage-faq-toggle {
    font-size: 22px;
    font-weight: 700;
    color: #00A3E0;
    margin-left: 16px;
    flex-shrink: 0;
    line-height: 1;
  }
  #SectionId-{{ section.id }} .navage-faq-answer {
    display: none;
    padding: 0 24px 22px;
    font-size: 15px;
    line-height: 1.6;
    color: #4a5d6e;
    border-top: 1px solid #f1f5f9;
  }
  #SectionId-{{ section.id }} .navage-faq-item.active .navage-faq-answer {
    display: block;
  }
  #SectionId-{{ section.id }} .navage-faq-answer p {
    margin: 16px 0 0 0;
  }
</style>

<script>
  (function() {
    const section = document.getElementById('SectionId-{{ section.id }}');
    if (!section) return;
    const items = section.querySelectorAll('.navage-faq-item');

    items.forEach(item => {
      const btn = item.querySelector('.navage-faq-question');
      const toggle = item.querySelector('.navage-faq-toggle');
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        items.forEach(i => {
          i.classList.remove('active');
          const t = i.querySelector('.navage-faq-toggle');
          if (t) t.textContent = '+';
        });
        if (!isActive) {
          item.classList.add('active');
          if (toggle) toggle.textContent = '−';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Navage FAQ Accordion",
  "settings": []
}
{% endschema %}
