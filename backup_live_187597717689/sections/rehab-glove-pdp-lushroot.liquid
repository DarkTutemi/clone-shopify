  <script>
    (function() {
      // 10 SHOPIFY VARIANTS FROM PRODUCT 15424286589113
      const VARIANTS = {
        'Right Hand-Small': 67683407298745,
        'Right Hand-Medium': 67683407331513,
        'Right Hand-Large': 67683407364281,
        'Right Hand-Extra Large': 67683407397049,
        'Right Hand-XXL': 67683407429817,
        'Left Hand-Small': 67683407462585,
        'Left Hand-Medium': 67683407495353,
        'Left Hand-Large': 67683407528121,
        'Left Hand-Extra Large': 67683407560889,
        'Left Hand-XXL': 67683407593657
      };

      const GALLERY_RIGHT = "https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-gallery-1.png?v=1791657297";
      const GALLERY_LEFT = "https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-gallery-2.png?v=1791657300";

      // DEFAULT TO TIER 2 (2 Gloves, $149.00)
      let activeTier = 2;
      let activeBasePrice = 149.00;
      let activeComparePrice = 360.00;
      let activeSaveAmt = 211.00;

      const mainImg = document.getElementById('lr-main-photo');
      const thumbBtns = document.querySelectorAll('#Section-{{ section.id }} .lr-thumb-btn');
      const bCards = document.querySelectorAll('#Section-{{ section.id }} .lr-bcard');
      const priceDisplay = document.getElementById('lr-price-val');
      const compareDisplay = document.getElementById('lr-compare-val');
      const saveBadge = document.getElementById('lr-save-pill');
      const savingsText = document.getElementById('lr-savings-str');
      const ctaMainText = document.getElementById('lr-cta-text');
      const ctaBtn = document.getElementById('lr-atc-main-btn');
      const mobileStickyBtn = document.getElementById('lr-dock-atc-btn');
      const mobileStickyPrice = document.getElementById('lr-dock-price-val');

      // Gallery Thumb Click
      thumbBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          thumbBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const src = btn.getAttribute('data-img-src');
          if (src && mainImg) mainImg.src = src;
        });
      });

      // Synchronize dropdown labels
      function bindSelectPill(selectId, labelId, onHandChange) {
        const sel = document.getElementById(selectId);
        const lbl = document.getElementById(labelId);
        if (sel && lbl) {
          sel.addEventListener('change', () => {
            lbl.innerText = sel.options[sel.selectedIndex].text;
            if (onHandChange) onHandChange(sel.value);
          });
        }
      }

      function updatePhotoForHand(handVal) {
        if (!mainImg) return;
        if (handVal === 'Left Hand') {
          mainImg.src = GALLERY_LEFT;
          thumbBtns.forEach(b => {
            if (b.getAttribute('data-img-src') === GALLERY_LEFT) {
              thumbBtns.forEach(t => t.classList.remove('active'));
              b.classList.add('active');
            }
          });
        } else {
          mainImg.src = GALLERY_RIGHT;
          thumbBtns.forEach(b => {
            if (b.getAttribute('data-img-src') === GALLERY_RIGHT) {
              thumbBtns.forEach(t => t.classList.remove('active'));
              b.classList.add('active');
            }
          });
        }
      }

      bindSelectPill('lr-card1-hand', 'lr-card1-hand-label', (h) => { if (activeTier === 1) updatePhotoForHand(h); });
      bindSelectPill('lr-card1-size', 'lr-card1-size-label');

      bindSelectPill('lr-card2-hand-1', 'lr-card2-hand-1-label', (h) => { if (activeTier === 2) updatePhotoForHand(h); });
      bindSelectPill('lr-card2-size-1', 'lr-card2-size-1-label');
      bindSelectPill('lr-card2-hand-2', 'lr-card2-hand-2-label');
      bindSelectPill('lr-card2-size-2', 'lr-card2-size-2-label');

      // Card Selection
      bCards.forEach(card => {
        card.addEventListener('click', (e) => {
          if (e.target.tagName && e.target.tagName.toLowerCase() === 'select') return;

          bCards.forEach(c => c.classList.remove('active'));
          card.classList.add('active');

          activeTier = parseInt(card.getAttribute('data-tier'), 10);
          activeBasePrice = parseFloat(card.getAttribute('data-price'));
          activeComparePrice = parseFloat(card.getAttribute('data-compare'));
          activeSaveAmt = parseFloat(card.getAttribute('data-save'));

          if (activeTier === 1) {
            const h = document.getElementById('lr-card1-hand')?.value;
            if (h) updatePhotoForHand(h);
          } else if (activeTier === 2) {
            const h = document.getElementById('lr-card2-hand-1')?.value;
            if (h) updatePhotoForHand(h);
          }

          updatePriceUI();
        });
      });

      function updatePriceUI() {
        const finalPrice = activeBasePrice;
        const finalCompare = activeComparePrice;
        const saveAmount = activeSaveAmt;

        const priceStr = '$' + finalPrice.toFixed(2);
        const compareStr = '$' + finalCompare.toFixed(2);

        if (priceDisplay) priceDisplay.innerText = priceStr;
        if (compareDisplay) compareDisplay.innerText = compareStr;
        if (mobileStickyPrice) mobileStickyPrice.innerText = priceStr;

        const pct = Math.round(((finalCompare - finalPrice) / finalCompare) * 100);
        if (saveBadge) saveBadge.innerText = 'SAVE ' + pct + '%';

        if (savingsText) {
          savingsText.innerText = 'You save $' + saveAmount.toFixed(2) + ' on this order';
        }

        if (ctaMainText) {
          ctaMainText.innerText = 'ADD TO CART — ' + priceStr;
        }
      }

      // Sizing Guide Modal
      const modal = document.getElementById('lr-size-modal');
      const openModalBtn = document.getElementById('lr-open-size-modal');
      const closeModalBtn = document.getElementById('lr-close-size-modal');

      if (openModalBtn && modal) {
        openModalBtn.addEventListener('click', () => modal.classList.add('active'));
      }
      if (closeModalBtn && modal) {
        closeModalBtn.addEventListener('click', () => modal.classList.remove('active'));
      }
      if (modal) {
        modal.addEventListener('click', (e) => {
          if (e.target === modal) modal.classList.remove('active');
        });
      }

      // Add to Cart
      async function handleAddToCart() {
        if (ctaBtn) {
          ctaBtn.disabled = true;
          ctaBtn.style.opacity = '0.7';
          ctaMainText.innerText = 'ADDING TO CART...';
        }
        if (mobileStickyBtn) {
          mobileStickyBtn.innerText = 'ADDING...';
        }

        let items = [];

        if (activeTier === 1) {
          const h = document.getElementById('lr-card1-hand')?.value || 'Right Hand';
          const s = document.getElementById('lr-card1-size')?.value || 'Medium';
          const vid = VARIANTS[`${h}-${s}`] || 67683407331513;
          items.push({
            id: vid,
            quantity: 1,
            properties: {
              'Tier': '1 Rehabilitation Glove',
              'Hand': h,
              'Size': s
            }
          });
        } else if (activeTier === 2) {
          const h1 = document.getElementById('lr-card2-hand-1')?.value || 'Right Hand';
          const s1 = document.getElementById('lr-card2-size-1')?.value || 'Medium';
          const h2 = document.getElementById('lr-card2-hand-2')?.value || 'Left Hand';
          const s2 = document.getElementById('lr-card2-size-2')?.value || 'Medium';

          const vid1 = VARIANTS[`${h1}-${s1}`] || 67683407331513;
          const vid2 = VARIANTS[`${h2}-${s2}`] || 67683407495353;

          if (vid1 === vid2) {
            items.push({
              id: vid1,
              quantity: 2,
              properties: {
                'Tier': '2 Rehabilitation Gloves (Save 58%)',
                'Configuration': `${h1} (${s1}) + ${h2} (${s2})`
              }
            });
          } else {
            items.push({
              id: vid1,
              quantity: 1,
              properties: {
                'Tier': '2 Rehabilitation Gloves (Save 58%) - Glove 1',
                'Hand': h1,
                'Size': s1
              }
            });
            items.push({
              id: vid2,
              quantity: 1,
              properties: {
                'Tier': '2 Rehabilitation Gloves (Save 58%) - Glove 2',
                'Hand': h2,
                'Size': s2
              }
            });
          }
        }

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (res.ok) {
            window.location.href = '/checkout';
          } else {
            window.location.href = '/cart';
          }
        } catch (err) {
          console.error(err);
          window.location.href = '/cart';
        }
      }

      if (ctaBtn) ctaBtn.addEventListener('click', handleAddToCart);
      if (mobileStickyBtn) mobileStickyBtn.addEventListener('click', handleAddToCart);
    })();
  </script>
</div>

