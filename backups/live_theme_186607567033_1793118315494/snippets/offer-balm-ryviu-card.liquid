<article class="mb-ry-card">
  {% if pair %}
    <div class="mb-ry-card__pair">
      <img src="{% if pair_1 != blank %}{{ pair_1 }}{% else %}{{ 'mb-ry-c1.jpg' | asset_url }}{% endif %}" alt="" width="300" height="400" loading="lazy">
      <img src="{% if pair_2 != blank %}{{ pair_2 }}{% else %}{{ 'mb-ry-c2.jpg' | asset_url }}{% endif %}" alt="" width="300" height="400" loading="lazy">
    </div>
  {% elsif photo %}
    <div class="mb-ry-card__photo">
      <img src="{% if photo_url != blank %}{{ photo_url }}{% else %}{{ photo | asset_url }}{% endif %}" alt="{{ title | escape }}" width="{{ photo_w }}" height="{{ photo_h }}" loading="lazy">
    </div>
  {% endif %}
  <div class="mb-ry-card__body">
    <div class="mb-ry-card__who">
      <div class="mb-ry-avatar" style="background: {{ color }}">{{ letter }}</div>
      <div>
        <div class="mb-ry-name">{{ name }}<i class="mb-ry-check" aria-label="Verified buyer"></i></div>
        <time class="mb-ry-date">{{ date }}</time>
      </div>
    </div>
    <div class="mb-ry-card__stars mb-ry-stars mb-ry-stars--card" aria-label="{{ stars }} out of 5 stars">
      {% for i in (1..5) %}
        <i class="mb-ry-star{% if i <= stars %} is-on{% endif %}"></i>
      {% endfor %}
    </div>
    <p class="mb-ry-title">{{ title }}</p>
    <p class="mb-ry-copy">
      {% if full != blank %}
        <span class="mb-ry-short">{{ short }}</span>
        <button type="button" class="mb-ry-more" data-mb-ry-more>[...]</button>
        <span class="mb-ry-full" hidden>{{ full }}</span>
      {% else %}
        {{ short }}
      {% endif %}
    </p>
    <div class="mb-ry-help">
      <span>Is this helpful?</span>
      <span class="mb-ry-vote">
        <svg aria-hidden="true" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.539 14.57a9.25 9.25 0 0 1-4.074-.838l-.307-.141a3.751 3.751 0 0 0-1.158-.32v-5.222a1.5 1.5 0 0 0 .15-.099 6.489 6.489 0 0 0 2.475-3.95 1.41 1.41 0 0 1 1.378 1.557l-.133 1.26a1.75 1.75 0 0 0 1.74 1.933h1.595c.758 0 1.342.67 1.239 1.42l-.338 2.449a2.25 2.25 0 0 1-2.176 1.942l-.391.01Zm-7.039-6.32h-1v5h1v-5Zm2.34 6.845a10.75 10.75 0 0 0 4.735.975l.391-.01a3.75 3.75 0 0 0 3.626-3.236l.337-2.448a2.75 2.75 0 0 0-2.724-3.126h-1.594a.25.25 0 0 1-.249-.276l.133-1.26a2.91 2.91 0 0 0-2.894-3.214h-.364c-.5 0-.928.357-1.017.849l-.055.303a4.989 4.989 0 0 1-1.915 3.098h-2c-.69 0-1.25.56-1.25 1.25v5.5c0 .69.56 1.25 1.25 1.25h2.345c.324 0 .644.07.938.205l.307.14Z"></path></svg>
        {{ up }}
      </span>
      <span class="mb-ry-vote">
        <svg aria-hidden="true" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M12.16 4.904a10.75 10.75 0 0 0-4.735-.974l-.391.01a3.75 3.75 0 0 0-3.626 3.236l-.337 2.448a2.75 2.75 0 0 0 2.724 3.126h1.594a.25.25 0 0 1 .249.276l-.133 1.26a2.91 2.91 0 0 0 2.894 3.214h.364c.5 0 .928-.358 1.017-.85l.055-.302a4.989 4.989 0 0 1 1.915-3.098h2c.69 0 1.25-.56 1.25-1.25v-5.5c0-.69-.56-1.25-1.25-1.25h-2.345a2.25 2.25 0 0 1-.938-.205l-.307-.14Zm-4.699.525a9.25 9.25 0 0 1 4.074.839l.307.14a3.75 3.75 0 0 0 1.158.32v5.223c-.052.03-.102.062-.15.098a6.49 6.49 0 0 0-2.475 3.95 1.41 1.41 0 0 1-1.378-1.557l.133-1.26a1.75 1.75 0 0 0-1.74-1.932h-1.595a1.25 1.25 0 0 1-1.238-1.421l.337-2.448a2.25 2.25 0 0 1 2.176-1.942l.391-.01Zm7.039 6.32h1v-5h-1v5Z"></path></svg>
        {{ down }}
      </span>
    </div>
  </div>
</article>
