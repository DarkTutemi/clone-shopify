        <span>{{ vs_eyebrow }}</span>
      </div>
      <h2 class="zvhc-h2" style="font-size: clamp(1.8rem, 3.2vw, 2.5rem); line-height: 1.2; margin-bottom: 16px; color: #2B1B24;">
        {{ vs_title }}
      </h2>
      <p style="color: #5A4651; font-size: 1.02rem; line-height: 1.6; max-width: 640px; margin: 0 auto;">
        {{ vs_subtitle }}
      </p>
    </div>

    <!-- Comparison Table Container -->
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 16px; border: 1px solid #EAD7DD; box-shadow: 0 6px 24px rgba(43,27,36,0.06); max-width: 960px; margin: 0 auto;">
      <table style="width: 100%; border-collapse: collapse; min-width: 640px; background: #FFFFFF; font-size: 0.95rem; text-align: left;">
