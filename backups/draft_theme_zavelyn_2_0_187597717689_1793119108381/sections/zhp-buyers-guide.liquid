{{ 'zhp-collection.css' | asset_url | stylesheet_tag }}

<div class="zhp-wrapper">
  <section class="zhp-story-section" id="storytelling">
    <div class="zhp-container">
      <div class="zhp-sec-header">
        <span class="zhp-sec-tag">SOUND & CRAFTSMANSHIP</span>
        <h2 class="zhp-sec-title">The Art of Mindful Resonance</h2>
        <p class="zhp-sec-subtitle">
          Discover how Zavelyn acoustic instruments bring tranquility, presence, and musical joy into homes worldwide.
        </p>
      </div>

      <!-- Story Block 1: Image Left / Text Right -->
      <div class="zhp-story-row">
        <div class="zhp-story-media">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/img_2.jpg?v=1792907902" alt="Zavelyn Handpan Tone Fields Craftsmanship" loading="lazy">
        </div>
        <div class="zhp-story-content">
          <span class="zhp-story-pill">INTUITIVE HARMONY</span>
          <h3 class="zhp-story-title">Music Without the Music Theory</h3>
          <p class="zhp-story-desc">
            Traditional instruments require months of frustrating finger drills and note-reading before making pleasant music. Zavelyn Handpans and Drums break through that barrier entirely.
          </p>
          <ul class="zhp-story-points">
            <li>
              <span class="zhp-pt-icon">✓</span>
              <span><strong>Pure Harmonic Tuning:</strong> Every note is mathematically tuned to belong in natural harmony—play in any order, and the resonance will always sound beautiful.</span>
            </li>
            <li>
              <span class="zhp-pt-icon">✓</span>
              <span><strong>Numbered Songbook Guidance:</strong> Follow along with simple laser-marked numbers to effortlessly play 20+ songs during your very first afternoon.</span>
            </li>
            <li>
              <span class="zhp-pt-icon">✓</span>
              <span><strong>Mindful Daily Escape:</strong> Tap into a flow state that quiets racing thoughts and restores calm focus within minutes.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Story Block 2: Text Left / Image Right -->
      <div class="zhp-story-row zhp-reverse">
        <div class="zhp-story-media">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/img_4.jpg?v=1792907902" alt="Hand-Hammered Nitrided Steel Construction" loading="lazy">
        </div>
        <div class="zhp-story-content">
          <span class="zhp-story-pill">METICULOUS METALLURGY</span>
          <h3 class="zhp-story-title">Artisanal Metallurgy Engineered to Last</h3>
          <p class="zhp-story-desc">
            Every Zavelyn instrument begins with aerospace-grade carbon and titanium steel alloys, carefully shaped and heat-treated to produce an expansive, warm acoustic chamber.
          </p>
          <ul class="zhp-story-points">
            <li>
              <span class="zhp-pt-icon">✓</span>
              <span><strong>High-Temperature Nitriding:</strong> Case-hardened surface treatments protect against humidity, rust, and surface scratches for decades of play.</span>
            </li>
            <li>
              <span class="zhp-pt-icon">✓</span>
              <span><strong>Cathedral Bloom & Sustain:</strong> Extended resonant decay allows each strike to bloom gently without harsh metallic overtones.</span>
            </li>
            <li>
              <span class="zhp-pt-icon">✓</span>
              <span><strong>Hand-Braided Protective Edging:</strong> Natural braided rope buffers the outer perimeter while serving as an artisanal decorative frame.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "ZHP Storytelling Blocks",
  "settings": []
}
{% endschema %}
