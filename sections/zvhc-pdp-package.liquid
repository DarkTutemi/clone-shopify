{% comment %}
  ZAVELYN HAIR CARE — Package & Ingredient Spotlight
{% endcomment %}
<section class="zvhc-package-section" id="ingredients">
  <div class="zvhc-container">
    <div class="zvhc-package-grid">
      <!-- Left Image Column -->
      <div class="zvhc-package-img-col">
        <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-3.png?v=1793191524" alt="Pure Batana Botanical Ingredients" loading="lazy">
      </div>

      <!-- Right Content Column -->
      <div class="zvhc-package-content">
        <div class="zvhc-eyebrow">CLEAN BOTANICAL CARE</div>
        <h2 class="zvhc-heading-md">What's Inside Your Pure Batana Elixir</h2>
        <p style="color: var(--zvhc-muted); margin-top: 10px; font-size: 0.95rem;">
          No artificial fillers, synthetic fragrances, silicones or watered-down carrier oils. Every drop delivers nutrient-rich plant lipids.
        </p>

        <div class="zvhc-package-list">
          <div class="zvhc-package-item">
            <div class="zvhc-package-icon">🌿</div>
            <div>
              <div class="zvhc-package-item-title">Pure Cold-Pressed Batana Oil (Elaeis Oleifera)</div>
              <div class="zvhc-package-item-desc">Rich in phytosterols and oleic fatty acids to nourish the scalp and condition hair strands.</div>
            </div>
          </div>

          <div class="zvhc-package-item">
            <div class="zvhc-package-icon">🌱</div>
            <div>
              <div class="zvhc-package-item-title">Rosemary Leaf Extract (Rosmarinus Officinalis)</div>
              <div class="zvhc-package-item-desc">A revitalizing botanical essence known to refresh the scalp and support healthy-looking hair.</div>
            </div>
          </div>

          <div class="zvhc-package-item">
            <div class="zvhc-package-icon">✨</div>
            <div>
              <div class="zvhc-package-item-title">Natural Vitamin E &amp; Essential Plant Lipids</div>
              <div class="zvhc-package-item-desc">Antioxidant-rich protection that shields dry hair against environmental stress and styling damage.</div>
            </div>
          </div>

          <div class="zvhc-package-item">
            <div class="zvhc-package-icon">🧪</div>
            <div>
              <div class="zvhc-package-item-title">Amber Glass Apothecary Dropper Bottle</div>
              <div class="zvhc-package-item-desc">Protective amber glass preserves active botanical properties against light degradation.</div>
            </div>
          </div>
        </div>

        <a href="#zvhcBuyBoxSection" class="zvhc-btn zvhc-btn-primary" style="margin-top: 16px;">
          CLAIM YOUR TREATMENT COURSE &rarr;
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ZVHC Package",
  "settings": []
}
{% endschema %}
