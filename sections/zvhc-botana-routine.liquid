{% comment %}
  ZAVELYN HAIR CARE — 4-Step Botanical Ritual (Section 6)
{% endcomment %}
<section class="zvhc-routine-section" id="routine" style="padding: 80px 0; background: var(--zvhc-green); color: var(--zvhc-ivory);">
  <div class="zvhc-container">
    <div class="zvhc-section-header" style="text-align: center; max-width: 680px; margin: 0 auto 56px;">
      <div class="zvhc-eyebrow" style="color: var(--zvhc-lime); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 8px;">THE BOTANICAL RITUAL</div>
      <h2 class="zvhc-heading-md" style="color: #FFFFFF; font-family: var(--zvhc-font-heading); font-size: clamp(2rem, 3.8vw, 2.8rem); font-weight: 900; letter-spacing: -0.02em; margin: 0 0 14px;">The 4-Step Healthy Strand Ritual</h2>
      <p style="color: var(--zvhc-ivory); font-size: 1.05rem; line-height: 1.5; opacity: 0.9;">Designed to harmoniously feed the scalp microbiome, strengthen hair follicles, define textures, and perfect everyday styling.</p>
    </div>

    <div class="zvhc-routine-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
      <!-- Step 1 -->
      <div class="zvhc-step-card" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 20px; padding: 28px; display: flex; flex-direction: column;">
        <div style="font-size: 2.2rem; font-family: var(--zvhc-font-heading); font-weight: 900; color: var(--zvhc-lime); margin-bottom: 12px;">01</div>
        <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-orange); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;">SCALP PREP &amp; MELT</div>
        <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 800; margin: 0 0 10px;">Raw Batana Balm</h3>
        <p style="font-size: 0.9rem; line-height: 1.5; opacity: 0.88; margin-bottom: 18px; flex-grow: 1;">Warm a pea-sized amount between fingertips to melt into nutrient-rich butter. Massage gently into scalp tension zones 20 mins prior to wash.</p>
        <div style="font-size: 0.82rem; font-weight: 700; color: var(--zvhc-lime);">Step Result: Soothed, nourished scalp barrier</div>
      </div>

      <!-- Step 2 -->
      <div class="zvhc-step-card" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 20px; padding: 28px; display: flex; flex-direction: column;">
        <div style="font-size: 2.2rem; font-family: var(--zvhc-font-heading); font-weight: 900; color: var(--zvhc-lime); margin-bottom: 12px;">02</div>
        <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-orange); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;">NOURISH &amp; SEAL</div>
        <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 800; margin: 0 0 10px;">Batana Scalp &amp; Hair Oil</h3>
        <p style="font-size: 0.9rem; line-height: 1.5; opacity: 0.88; margin-bottom: 18px; flex-grow: 1;">Apply 3-5 drops of pure Batana Oil or 7-in-1 Elixir onto damp roots and shaft. Comb gently through strands to seal moisture and lock the cuticle.</p>
        <div style="font-size: 0.82rem; font-weight: 700; color: var(--zvhc-lime);">Step Result: 85% reduced breakage &amp; split ends</div>
      </div>

      <!-- Step 3 -->
      <div class="zvhc-step-card" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 20px; padding: 28px; display: flex; flex-direction: column;">
        <div style="font-size: 2.2rem; font-family: var(--zvhc-font-heading); font-weight: 900; color: var(--zvhc-lime); margin-bottom: 12px;">03</div>
        <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-orange); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;">SHAPE &amp; DEFINE</div>
        <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 800; margin: 0 0 10px;">Curl Cream or Root Powder</h3>
        <p style="font-size: 0.9rem; line-height: 1.5; opacity: 0.88; margin-bottom: 18px; flex-grow: 1;">Work Botanical Curl Cream through damp curls for defined spirals, or tap Root-Lift Powder at dry roots for instant matte lift.</p>
        <div style="font-size: 0.82rem; font-weight: 700; color: var(--zvhc-lime);">Step Result: Touchable bounce, zero crunch</div>
      </div>

      <!-- Step 4 -->
      <div class="zvhc-step-card" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); border-radius: 20px; padding: 28px; display: flex; flex-direction: column;">
        <div style="font-size: 2.2rem; font-family: var(--zvhc-font-heading); font-weight: 900; color: var(--zvhc-lime); margin-bottom: 12px;">04</div>
        <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-orange); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px;">PERFECT &amp; COVER</div>
        <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 800; margin: 0 0 10px;">Fibers &amp; Hairline Compact</h3>
        <p style="font-size: 0.9rem; line-height: 1.5; opacity: 0.88; margin-bottom: 18px; flex-grow: 1;">Dab the Hairline Shadow Compact along temples or sprinkle Keratin Fibers over crown thinning for undetectable 24hr coverage.</p>
        <div style="font-size: 0.82rem; font-weight: 700; color: var(--zvhc-lime);">Step Result: Full, camera-ready hairline confidence</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ZVHC 4-Step Routine",
  "settings": []
}
{% endschema %}
