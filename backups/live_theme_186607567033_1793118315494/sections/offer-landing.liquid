                  <p>{{ block.settings.text }}</p>
                  <p class="offer-vreview__author">{{ block.settings.author }}</p>
                </div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
