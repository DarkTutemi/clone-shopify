{%- liquid
  if request.page_type == 'product' and product != blank
    assign offer_product = product
  elsif section.settings.product != blank
    assign offer_product = section.settings.product
  else
    assign offer_product = all_products['cdf']
  endif
  if offer_product == blank
    assign offer_product = collections.all.products.first
  endif
  assign product = offer_product
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
  assign brand = s.brand_name | default: 'Zavelyn'
  assign cta_label = s.cta_label | default: 'Add to cart'
  assign sec_gallery = section.blocks | where: 'type', 'sec_gallery' | first
  assign sec_hero = section.blocks | where: 'type', 'sec_hero' | first
  assign sec_intro = section.blocks | where: 'type', 'sec_intro' | first
  assign sec_results = section.blocks | where: 'type', 'sec_results' | first
  assign sec_lift = section.blocks | where: 'type', 'sec_lift' | first
  assign sec_strain = section.blocks | where: 'type', 'sec_strain' | first
  assign sec_trusted = section.blocks | where: 'type', 'sec_trusted' | first
  assign sec_falls = section.blocks | where: 'type', 'sec_falls' | first
  assign sec_easy = section.blocks | where: 'type', 'sec_easy' | first
  assign sec_doctors = section.blocks | where: 'type', 'sec_doctors' | first
  assign sec_guarantee = section.blocks | where: 'type', 'sec_guarantee' | first
  assign sec_faq = section.blocks | where: 'type', 'sec_faq' | first
  assign sec_reviews = section.blocks | where: 'type', 'sec_reviews' | first
  assign sec_trust = section.blocks | where: 'type', 'sec_trust' | first
  assign sec_footer = section.blocks | where: 'type', 'sec_footer' | first
-%}
{% render 'offer-seo', product: product, section: section %}
{{ 'zavelyn-cdf.css' | asset_url | stylesheet_tag }}

<div class="offer-page offer-page--cdf" id="OfferTop">
  <div class="offer-ticker">
    <p class="offer-ticker__line">🦶 {{ s.ticker_text | default: 'RECOVERY SALE STARTS NOW.' }} <span>{{ s.ticker_highlight | default: 'BUY 2 · EXTRA 10% OFF!' }}</span></p>
  </div>
  {% render 'offer-header', brand: brand, product: product %}

  {%- comment -%} ===== 1. HERO + BUY BOX ===== {%- endcomment -%}
  <section class="offer-hero">
    <div class="offer-hero__grid">
      <div class="offer-hero__left">
        <div class="offer-media" data-offer-gallery>
          <div class="offer-media__stage">
            {%- if sec_gallery and sec_gallery.settings.image_1 != blank -%}
              {%- assign main_src = sec_gallery.settings.image_1 | image_url: width: 1200 -%}
            {%- elsif sec_gallery and sec_gallery.settings.fallback_1 != blank -%}
              {%- assign main_src = sec_gallery.settings.fallback_1 | asset_url -%}
            {%- else -%}
              {%- assign main_src = 'cdf-gallery-1.jpg' | asset_url -%}
            {%- endif -%}
            <button type="button" class="offer-media__zoom" data-offer-zoom aria-label="Open gallery">
              <img data-offer-main src="{{ main_src }}" alt="{{ product.title | escape }}" width="1200" height="1200" fetchpriority="high">
            </button>
            <button type="button" class="offer-media__nav offer-media__nav--prev" data-offer-prev aria-label="Previous">❮</button>
            <button type="button" class="offer-media__nav offer-media__nav--next" data-offer-next aria-label="Next">❯</button>
          </div>
          <div class="offer-thumbs" role="list" {% if sec_gallery %}{{ sec_gallery.shopify_attributes }}{% endif %}>
            {%- if sec_gallery -%}
              {% render 'offer-group-slots', group: sec_gallery, mode: 'gallery', count: 10 %}
            {%- else -%}
              {%- assign galleries = 'cdf-gallery-1.jpg,cdf-gallery-2.jpg,cdf-gallery-3.jpg,cdf-gallery-4.jpg,cdf-gallery-5.jpg,cdf-gallery-6.jpg,cdf-gallery-7.jpg,cdf-gallery-8.jpg,cdf-gallery-9.jpg,cdf-gallery-10.jpg' | split: ',' -%}
              {%- for file in galleries -%}
                {%- assign thumb_file = file | replace: '.jpg', '-thumb.jpg' -%}
                <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-offer-thumb data-index="{{ forloop.index0 }}" data-src="{{ file | asset_url }}" aria-label="Image {{ forloop.index }}">
                  <img src="{{ thumb_file | asset_url }}" alt="" width="60" height="60" {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="offer-hero__right">
        <a class="cdf-review-row" href="#REVIEW">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span class="rating"><strong>4.9</strong></span>
          <span class="sep">|</span>
          <span>3,269 reviews</span>
        </a>
        <h1 class="offer-title">{{ product.title }}</h1>

        <div class="cdf-price-row">
          <span class="cdf-price" data-cdf-price>{{ current_variant.price | money }}</span>
          {% if current_variant.compare_at_price > current_variant.price %}
            <span class="cdf-compare" data-cdf-compare>{{ current_variant.compare_at_price | money }}</span>
            <span class="cdf-sale-badge">Sale</span>
          {% endif %}
        </div>

        <p class="cdf-lead">{% if sec_hero.settings.lead != blank %}{{ sec_hero.settings.lead }}{% else %}Naturally support your foot, reduce tripping risk, <strong>improve walking stability and regain confident movement</strong> without surgery or medications instantly.{% endif %}</p>

        <div class="pi-feats">
          <div class="pi-feat">
            <div class="pi-feat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg></div>
            <div class="pi-feat-text"><p class="pi-feat-title">Better Mobility</p><p class="pi-feat-sub">Reducing toe dragging &amp; stumbling</p></div>
          </div>
          <div class="pi-feat">
            <div class="pi-feat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg></div>
            <div class="pi-feat-text"><p class="pi-feat-title">Enhanced Balance</p><p class="pi-feat-sub">Improves walking stability &amp; balance</p></div>
          </div>
          <div class="pi-feat">
            <div class="pi-feat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg></div>
            <div class="pi-feat-text"><p class="pi-feat-title">Secure Fit</p><p class="pi-feat-sub">Keeps your foot lifted &amp; supported</p></div>
          </div>
          <div class="pi-feat">
            <div class="pi-feat-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path></svg></div>
            <div class="pi-feat-text"><p class="pi-feat-title">All-Day Wear</p><p class="pi-feat-sub">Lightweight &amp; comfortable</p></div>
          </div>
        </div>

        <div class="cdf-risk">
          <span aria-hidden="true">💡</span>
          <div><strong>Try it risk-free for 30 days</strong> If you don't notice less foot dragging, better stability or safer walking, we'll refund you in full.</div>
        </div>

        {%- assign pack1_price = current_variant.price -%}
        {%- assign pack2_qty = s.bundle_2_qty | default: 2 -%}
        {%- assign pack2_discount = s.bundle_2_discount | default: 10 -%}
        {%- assign pack2_full = current_variant.price | times: pack2_qty -%}
        {%- assign pack2_off = pack2_full | times: pack2_discount | divided_by: 100 -%}
        {%- assign pack2_price = pack2_full | minus: pack2_off -%}

        {%- comment -%} Single-brace options: Foot Side + Size (Black only) {%- endcomment -%}
        {%- capture cdf_item_opts_markup -%}
            <div class="cdf-bundle-opt" data-opt="Foot Side">
              <div class="offer-bundle__sizes-head">
                <div class="offer-bundle__sizes-rule"><span>Foot Side: <em data-cdf-side-label>Left</em></span></div>
              </div>
              <div class="offer-bundle__size-pills" role="radiogroup" aria-label="Foot Side">
                <button type="button" class="offer-size-pill is-active" data-cdf-side="Left">Left</button>
                <button type="button" class="offer-size-pill" data-cdf-side="Right">Right</button>
              </div>
            </div>
            <div class="cdf-bundle-opt" data-opt="Size">
              <div class="offer-bundle__sizes-head">
                <div class="offer-bundle__sizes-rule"><span>Size: <em data-cdf-size-label>S</em></span></div>
                <button type="button" class="offer-sizechart-link offer-sizechart-link--inline" data-cdf-sizechart-toggle>Size chart</button>
              </div>
              <div class="offer-bundle__size-pills" role="radiogroup" aria-label="Size">
                <button type="button" class="offer-size-pill is-active" data-cdf-size="S">S</button>
                <button type="button" class="offer-size-pill" data-cdf-size="M">M</button>
                <button type="button" class="offer-size-pill" data-cdf-size="L">L</button>
                <button type="button" class="offer-size-pill" data-cdf-size="XL">XL</button>
              </div>
            </div>
        {%- endcapture -%}

        <div
          class="offer-bundles"
          id="OfferPackages"
          data-offer-bundles
          data-unit-price="{{ current_variant.price }}"
          data-money-format="{{ shop.money_format | escape }}"
          data-discount-code="{{ s.bundle_2_discount_code | default: 'CDF10' | escape }}"
        >
          <div class="offer-bundles__head">
            <p class="offer-bundles__label">{{ s.bundles_label | default: 'Choose your package' }}</p>
          </div>
          <div class="offer-bundles__list{% if s.packages_reversed %} offer-bundles__list--rev{% endif %}" role="radiogroup" aria-label="Package">
            <div class="offer-bundle{% unless s.packages_reversed %} is-active{% endunless %}">
              <label class="offer-bundle__pick">
                <input
                  type="radio"
                  name="offer_bundle"
                  value="1"
                  data-qty="{{ s.bundle_1_qty | default: 1 }}"
                  data-discount="0"
                  {% unless s.packages_reversed %}checked{% endunless %}
                >
                <span class="offer-bundle__radio" aria-hidden="true"></span>
                <span class="offer-bundle__body">
                  <span class="offer-bundle__content">
                    <span class="offer-bundle__title">{{ s.bundle_1_title | default: 'Buy 1' }}</span>
                    <span class="offer-bundle__meta-row">
                      <span class="offer-bundle__meta">{{ s.bundle_1_meta | default: '1 brace' }}</span>
                      {%- if s.bundle_1_badge != blank -%}
                        <span class="offer-bundle__ship">{{ s.bundle_1_badge }}</span>
                      {%- else -%}
                        <span class="offer-bundle__ship">$4.95 ship</span>
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="offer-bundle__price" data-bundle-price>{{ pack1_price | money }}</span>
                </span>
              </label>
              <div class="offer-bundle__sizes cdf-bundle-opts" data-cdf-items="1">
                <div class="cdf-item-opts" data-cdf-item="0">
                  {{ cdf_item_opts_markup }}
                </div>
              </div>
            </div>
            <div class="offer-bundle offer-bundle--featured{% if s.packages_reversed %} is-active{% endif %}">
              <label class="offer-bundle__pick">
                <input
                  type="radio"
                  name="offer_bundle"
                  value="2"
                  data-qty="{{ pack2_qty }}"
                  data-discount="{{ pack2_discount }}"
                  {% if s.packages_reversed %}checked{% endif %}
                >
                <span class="offer-bundle__radio" aria-hidden="true"></span>
                <span class="offer-bundle__body">
                  <span class="offer-bundle__content">
                    <span class="offer-bundle__title">{{ s.bundle_2_title | default: 'Buy 2' }}</span>
                    <span class="offer-bundle__meta-row">
                      <span class="offer-bundle__meta">{{ s.bundle_2_meta | default: 'Extra 10% OFF' }}</span>
                      {%- if s.bundle_2_badge != blank -%}
                        <span class="offer-bundle__ship offer-bundle__ship--free">{{ s.bundle_2_badge }}</span>
                      {%- else -%}
                        <span class="offer-bundle__ship offer-bundle__ship--free">Free ship</span>
                      {%- endif -%}
                    </span>
                  </span>
                  <span class="offer-bundle__price" data-bundle-price>{{ pack2_price | money }}</span>
                </span>
              </label>
              <div class="offer-bundle__sizes cdf-bundle-opts" data-cdf-items="2">
                <div class="cdf-item-opts" data-cdf-item="0">
                  <p class="cdf-item-opts__title">Brace 1</p>
                  {{ cdf_item_opts_markup }}
                </div>
                <div class="cdf-item-opts" data-cdf-item="1">
                  <p class="cdf-item-opts__title">Brace 2</p>
                  <div class="cdf-bundle-opt" data-opt="Foot Side">
                    <div class="offer-bundle__sizes-head">
                      <div class="offer-bundle__sizes-rule"><span>Foot Side: <em data-cdf-side-label>Right</em></span></div>
                    </div>
                    <div class="offer-bundle__size-pills" role="radiogroup" aria-label="Foot Side">
                      <button type="button" class="offer-size-pill" data-cdf-side="Left">Left</button>
                      <button type="button" class="offer-size-pill is-active" data-cdf-side="Right">Right</button>
                    </div>
                  </div>
                  <div class="cdf-bundle-opt" data-opt="Size">
                    <div class="offer-bundle__sizes-head">
                      <div class="offer-bundle__sizes-rule"><span>Size: <em data-cdf-size-label>S</em></span></div>
                      <button type="button" class="offer-sizechart-link offer-sizechart-link--inline" data-cdf-sizechart-toggle>Size chart</button>
                    </div>
                    <div class="offer-bundle__size-pills" role="radiogroup" aria-label="Size">
                      <button type="button" class="offer-size-pill is-active" data-cdf-size="S">S</button>
                      <button type="button" class="offer-size-pill" data-cdf-size="M">M</button>
                      <button type="button" class="offer-size-pill" data-cdf-size="L">L</button>
                      <button type="button" class="offer-size-pill" data-cdf-size="XL">XL</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="offer-sizechart" data-cdf-sizechart hidden>
          <div class="offer-sizechart__backdrop" data-cdf-sizechart-close tabindex="-1"></div>
          <div class="offer-sizechart__dialog" role="dialog" aria-modal="true" aria-labelledby="CdfSizeChartTitle">
            <div class="offer-sizechart__head">
              <h2 id="CdfSizeChartTitle">Shoe Size Guide</h2>
              <button type="button" class="offer-sizechart__close" data-cdf-sizechart-close aria-label="Close">×</button>
            </div>
            <div class="offer-sizechart__body">
              <table class="cdf-sizechart-table">
                <thead>
                  <tr><th>SIZE</th><th>US (MEN)</th><th>US (WOMEN)</th></tr>
                </thead>
                <tbody>
                  <tr><td>S</td><td>3–5</td><td>4.5–6.5</td></tr>
                  <tr><td>M</td><td>5–8</td><td>6.5–9.5</td></tr>
                  <tr><td>L</td><td>8–11</td><td>9.5–12.5</td></tr>
                  <tr><td>XL</td><td>11–14</td><td>12.5–15.5</td></tr>
                </tbody>
              </table>
              <p class="offer-sizechart__note">If the size you order doesn't fit perfectly, don't worry! We offer a 30-day window for easy exchanges.</p>
            </div>
          </div>
        </div>

        {%- if s.packages_reversed -%}
          {%- assign cta_price_cents = pack2_price -%}
        {%- else -%}
          {%- assign cta_price_cents = pack1_price -%}
        {%- endif -%}
        {% form 'product', product, id: 'OfferAddForm', class: 'offer-buy-form' %}
          <input type="hidden" name="id" id="OfferVariantId" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="OfferQuantity" value="{% if s.packages_reversed %}{{ pack2_qty }}{% else %}1{% endif %}">
          <button class="offer-cta" type="submit" name="add" data-offer-checkout {% unless current_variant.available %}disabled{% endunless %}>
            <span class="offer-cta__label">{{ cta_label }}</span>
            <span class="offer-cta__sep" aria-hidden="true">—</span>
            <span class="offer-cta__price" data-offer-cta-price>{{ cta_price_cents | money_without_trailing_zeros }}</span>
          </button>
        {% endform %}

        <div class="cdf-trust">
          <span>Free shipping on Buy 2</span>
          <span>100% money-back</span>
        </div>

        <div class="single-review">
          <div class="single-review-top">
            <div class="single-review-top-left">
              <img class="single-reviewer-img" src="{{ 'cdf-reviewer.png' | asset_url }}" alt="Sarah Jenkins" width="40" height="40" loading="lazy">
              <p>Sarah Jenkins</p>
              <img src="{{ 'cdf-stars.svg' | asset_url }}" alt="" width="69" height="13" loading="lazy">
            </div>
          </div>
          <div class="single-review-bottom">
            <p>I was terrified of tripping and constantly looked at the ground. This brace fits perfectly inside my sneakers and gave me instant stability. I walked the whole park today without dragging my foot once. Finally feel confident again!</p>
            <div class="review-footer">
              <div class="verified-badge">
                <img src="{{ 'cdf-verified.svg' | asset_url }}" alt="" width="16" height="16" loading="lazy">
                <p>Verified customer</p>
              </div>
              <span class="review-date">12 Dec 2025</span>
            </div>
          </div>
        </div>

        <div class="cdf-sia" aria-label="See it in action">
          <div class="cdf-sia__grid">
            <div class="cdf-sia-card">
              <video playsinline muted loop preload="metadata" poster="{{ 'cdf-video-thumb-1.jpg' | asset_url }}">
                <source src="https://cedrow.com/cdn/shop/videos/c/vp/4091e65b3b3749f38c55f1ac039c732f/4091e65b3b3749f38c55f1ac039c732f.HD-1080p-2.5Mbps-90709356.mp4?v=0" type="video/mp4">
              </video>
              <span class="cdf-sia-card__badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5 14.6 4l3.5-.4.8 3.4 3 1.9-1.5 3.2 1.5 3.2-3 1.9-.8 3.4-3.5-.4L12 22.5 9.4 20l-3.5.4-.8-3.4-3-1.9L3.6 12 2.1 8.8l3-1.9.8-3.4L9.4 4 12 1.5zm-1.2 14.2 5.9-5.9-1.4-1.4-4.5 4.4-2-2-1.4 1.5 3.4 3.4z"></path></svg> Verified Buyer</span>
              <span class="cdf-sia-card__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.14v13.72L19 12 8 5.14z"></path></svg></span>
            </div>
            <div class="cdf-sia-card">
              <video playsinline muted loop preload="metadata" poster="{{ 'cdf-video-thumb-2.jpg' | asset_url }}">
                <source src="https://cedrow.com/cdn/shop/videos/c/vp/e9a004f477d047bfb714c282be2c46c4/e9a004f477d047bfb714c282be2c46c4.HD-1080p-2.5Mbps-90709355.mp4?v=0" type="video/mp4">
              </video>
              <span class="cdf-sia-card__badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5 14.6 4l3.5-.4.8 3.4 3 1.9-1.5 3.2 1.5 3.2-3 1.9-.8 3.4-3.5-.4L12 22.5 9.4 20l-3.5.4-.8-3.4-3-1.9L3.6 12 2.1 8.8l3-1.9.8-3.4L9.4 4 12 1.5zm-1.2 14.2 5.9-5.9-1.4-1.4-4.5 4.4-2-2-1.4 1.5 3.4 3.4z"></path></svg> Verified Buyer</span>
              <span class="cdf-sia-card__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.14v13.72L19 12 8 5.14z"></path></svg></span>
            </div>
            <div class="cdf-sia-card">
              <video playsinline muted loop preload="metadata" poster="{{ 'cdf-video-thumb-3.jpg' | asset_url }}">
                <source src="https://cedrow.com/cdn/shop/videos/c/vp/d61437b622f941bc8333df58caf19de4/d61437b622f941bc8333df58caf19de4.HD-1080p-4.8Mbps-90823000.mp4?v=0" type="video/mp4">
              </video>
              <span class="cdf-sia-card__badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1.5 14.6 4l3.5-.4.8 3.4 3 1.9-1.5 3.2 1.5 3.2-3 1.9-.8 3.4-3.5-.4L12 22.5 9.4 20l-3.5.4-.8-3.4-3-1.9L3.6 12 2.1 8.8l3-1.9.8-3.4L9.4 4 12 1.5zm-1.2 14.2 5.9-5.9-1.4-1.4-4.5 4.4-2-2-1.4 1.5 3.4 3.4z"></path></svg> Verified Buyer</span>
              <span class="cdf-sia-card__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.14v13.72L19 12 8 5.14z"></path></svg></span>
            </div>
          </div>
        </div>

        <div class="offer-faq device-accordion" data-offer-accordion>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">Benefits</button>
            <div class="offer-faq__panel"><div class="offer-faq__body">
              <div class="ced-benefits">
                <div class="ced-benefits__panel ced-benefits__panel--old">
                  <span class="ced-benefits__panel-title">The old way</span>
                  <ul class="ced-benefits__list">
                    <li><span class="ced-benefits__mark ced-benefits__mark--x">✕</span>Feel rigid, heavy, and restrictive</li>
                    <li><span class="ced-benefits__mark ced-benefits__mark--x">✕</span>Crowd your shoes</li>
                    <li><span class="ced-benefits__mark ced-benefits__mark--x">✕</span>Look medical and unnatural</li>
                    <li><span class="ced-benefits__mark ced-benefits__mark--x">✕</span>Make walking feel tiring</li>
                  </ul>
                </div>
                <div class="ced-benefits__panel ced-benefits__panel--new">
                  <span class="ced-benefits__panel-title">The {{ brand }} way</span>
                  <ul class="ced-benefits__list">
                    <li><span class="ced-benefits__mark ced-benefits__mark--check">✓</span>Lightweight and comfortable</li>
                    <li><span class="ced-benefits__mark ced-benefits__mark--check">✓</span>Fits inside all shoes</li>
                    <li><span class="ced-benefits__mark ced-benefits__mark--check">✓</span>Discreet, everyday design</li>
                    <li><span class="ced-benefits__mark ced-benefits__mark--check">✓</span>Walk naturally all day</li>
                  </ul>
                  <div class="ced-benefits__accent"><span class="ced-benefits__accent-icon">✦</span><span>No surgery. No medications. Just everyday support.</span></div>
                </div>
                <div class="ced-benefits__details">
                  <div class="ced-benefits__detail">
