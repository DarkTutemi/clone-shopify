{% comment %}
  Clone-navage/sections/navage-commitment.liquid
  1:1 Our Commitment Section with Original Media
{% endcomment %}

<div id="SectionId-{{ section.id }}" class="navage-commit-section">
  <div class="navage-commit-container">
    <div class="navage-commit-grid">
      <div class="navage-commit-media">
        <img
          src="https://navage.com/cdn/shop/files/Our_Commitment.png?v=1777057682&width=800"
          alt="Our Commitment - Naväge Handheld Device"
          loading="lazy"
          class="navage-commit-img"
        >
      </div>

      <div class="navage-commit-content">
        <h2 class="navage-commit-title">Our Commitment</h2>
        <p class="navage-commit-lead">
          At Naväge, we're committed to helping you breathe easier with reliable, clinically proven nasal irrigation. For more than 10 years, Naväge has been a trusted choice for consistent, effective nasal care.
        </p>

        <div class="navage-commit-list">
          <div class="navage-commit-item">
            <div class="navage-commit-icon">✓</div>
            <div class="navage-commit-item-text">
              <h4 class="navage-commit-item-title">Patient-Centered Design</h4>
              <p class="navage-commit-item-desc">Every feature designed with your comfort and results in mind.</p>
            </div>
          </div>

          <div class="navage-commit-item">
            <div class="navage-commit-icon">✓</div>
            <div class="navage-commit-item-text">
              <h4 class="navage-commit-item-title">Clinically Proven Results</h4>
              <p class="navage-commit-item-desc">Backed by research and trusted by healthcare professionals.</p>
            </div>
          </div>

          <div class="navage-commit-item">
            <div class="navage-commit-icon">✓</div>
            <div class="navage-commit-item-text">
              <h4 class="navage-commit-item-title">Quality You Can Trust</h4>
              <p class="navage-commit-item-desc">Over a decade of innovation in nasal health and wellness.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #SectionId-{{ section.id }} {
    background-color: #0b4a82;
    padding: 70px 24px;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  #SectionId-{{ section.id }} .navage-commit-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  #SectionId-{{ section.id }} .navage-commit-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 50px;
    align-items: center;
  }
  #SectionId-{{ section.id }} .navage-commit-media {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
  }
  #SectionId-{{ section.id }} .navage-commit-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    object-fit: cover;
  }
  #SectionId-{{ section.id }} .navage-commit-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #SectionId-{{ section.id }} .navage-commit-title {
    font-size: 40px;
    font-weight: 800;
    line-height: 1.15;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.5px;
  }
  #SectionId-{{ section.id }} .navage-commit-lead {
    font-size: 16px;
    line-height: 1.6;
    color: #e0ecf8;
    margin: 0 0 10px 0;
  }
  #SectionId-{{ section.id }} .navage-commit-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  #SectionId-{{ section.id }} .navage-commit-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  #SectionId-{{ section.id }} .navage-commit-icon {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #58c5f5;
    color: #002244;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 16px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  #SectionId-{{ section.id }} .navage-commit-item-title {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 4px 0;
  }
  #SectionId-{{ section.id }} .navage-commit-item-desc {
    font-size: 14px;
    color: #cfe2f7;
    margin: 0;
    line-height: 1.4;
  }
  @media (max-width: 900px) {
    #SectionId-{{ section.id }} .navage-commit-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    #SectionId-{{ section.id }} .navage-commit-title {
      font-size: 30px;
    }
  }
</style>

{% schema %}
{
  "name": "Navage Our Commitment",
  "settings": []
}
{% endschema %}
