{{ 'zhp-collection.css' | asset_url | stylesheet_tag }}

<div class="zhp-wrapper">
  <section class="zhp-hero-section">
    <div class="zhp-container">
      <div class="zhp-hero-grid">
        <div class="zhp-hero-content">
          <span class="zhp-tag-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            Handcrafted Acoustic Resonance
          </span>
          <h1 class="zhp-hero-title">Escape to Calmness with Zavelyn Handpans</h1>
          <p class="zhp-hero-subtitle">
            Feel stress melt away with every resonant note. Handcrafted steel alloy instruments tuned with laser precision to rich acoustic harmonics—bringing tranquility, mindfulness, and effortless musical joy into your everyday life.
          </p>

          <div class="zhp-hero-badges-row">
            <div class="zhp-hero-badge-item">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Handcrafted Alloy Steel</span>
            </div>
            <div class="zhp-hero-badge-item">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Free US Shipping Over $49</span>
            </div>
            <div class="zhp-hero-badge-item">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>60-Day Money-Back Guarantee</span>
            </div>
            <div class="zhp-hero-badge-item">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
              <span>Zero Musical Experience Needed</span>
            </div>
          </div>

          <div class="zhp-hero-actions">
            <a href="#shop-by-model" class="zhp-btn-elixir">
              <span>Explore Handpans</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
            <a href="#compare-models" class="zhp-btn-ghost">
              <span>Compare All 5 Models</span>
            </a>
          </div>
        </div>

        <div class="zhp-hero-media">
          <div class="zhp-hero-img-wrap">
            <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/img_1.jpg?v=1792907902" alt="Zavelyn Handpan Master Flagship 22-Inch Concert Instrument" width="600" height="600" loading="eager" fetchpriority="high">
            <div class="zhp-hero-corner-badge">
              <span>★</span> Concert Flagship • Hand-Hammered Nitrided Steel
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "ZHP Collection Hero",
  "settings": []
}
{% endschema %}
