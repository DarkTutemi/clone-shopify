                  assign vf = grp_vreviews.settings.item_4_fallback
                  assign vv = grp_vreviews.settings.item_4_video
                  assign vt = grp_vreviews.settings.item_4_title
                  assign vtx = grp_vreviews.settings.item_4_text
                  assign va = grp_vreviews.settings.item_4_author
              endcase
            -%}
            {%- if vt != blank or vf != blank or vp != blank -%}
              {%- if vp != blank -%}
                {%- assign poster_src = vp | image_url: width: 720 -%}
              {%- elsif vf != blank -%}
                {%- assign poster_src = vf | asset_url -%}
              {%- else -%}
                {%- assign poster_src = '' -%}
              {%- endif -%}
              <article class="offer-vreview">
                <button type="button" class="offer-vreview__media" data-offer-video aria-label="Play {{ va | escape }} video">
                  {%- if poster_src != blank -%}<img src="{{ poster_src }}" alt="" width="720" height="900" loading="lazy">{%- endif -%}
                  {%- if vv != blank -%}
                    <video preload="metadata" playsinline loop src="{{ vv }}" {% if poster_src != blank %}poster="{{ poster_src }}"{% endif %}></video>
                  {%- endif -%}
                  <span class="offer-vreview__play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="32" height="32"><path d="M8 5v14l11-7z" fill="#111"></path></svg>
                  </span>
                </button>
                <div class="offer-vreview__body">
