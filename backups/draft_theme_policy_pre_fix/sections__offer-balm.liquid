{%- liquid
  if request.page_type == 'product' and product != blank
    assign offer_product = product
  elsif section.settings.product != blank
    assign offer_product = section.settings.product
  else
    assign offer_product = all_products['miracle-balm']
  endif
  if offer_product == blank
    assign offer_product = collections.all.products.first
  endif
  assign product = offer_product
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
  assign brand = s.brand_name | default: 'Zavelyn'
  assign cta_label = s.cta_label | default: 'Add to cart'
  assign unit = current_variant.price
  assign compare_unit = current_variant.compare_at_price | default: 0
  if compare_unit <= unit
    assign compare_unit = unit | times: 2
  endif
  assign qty_1 = s.bundle_1_qty | default: 1
  assign qty_2 = s.bundle_2_qty | default: 2
  assign qty_3 = s.bundle_3_qty | default: 3
  assign default_qty = s.default_qty | default: 2
  assign p2 = unit | times: qty_2
  assign c2 = compare_unit | times: qty_2
  assign p3_list = unit | times: qty_3
  assign pack_off = s.bundle_3_discount | default: 10
  assign pack_keep = 100 | minus: pack_off
  assign p3 = p3_list | times: pack_keep | divided_by: 100
  assign sec_gallery = section.blocks | where: 'type', 'sec_gallery' | first
  assign sec_buybox = section.blocks | where: 'type', 'sec_buybox' | first
  assign sec_people = section.blocks | where: 'type', 'sec_people' | first
  assign sec_purity = section.blocks | where: 'type', 'sec_purity' | first
  assign sec_explorer = section.blocks | where: 'type', 'sec_explorer' | first
  assign sec_herbs = section.blocks | where: 'type', 'sec_herbs' | first
  assign sec_compare = section.blocks | where: 'type', 'sec_compare' | first
  assign sec_science = section.blocks | where: 'type', 'sec_science' | first
  assign sec_reviews = section.blocks | where: 'type', 'sec_reviews' | first
  assign sec_howto = section.blocks | where: 'type', 'sec_howto' | first
  assign sec_timeline = section.blocks | where: 'type', 'sec_timeline' | first
  assign sec_faq = section.blocks | where: 'type', 'sec_faq' | first
  assign sec_ryviu = section.blocks | where: 'type', 'sec_ryviu' | first
  if sec_buybox != blank
    assign bb = sec_buybox.settings
  endif
  if sec_herbs != blank
    assign herbs = sec_herbs.settings
  endif
  if sec_howto != blank
    assign howto = sec_howto.settings
  endif
-%}
{% render 'offer-seo', product: product, section: section %}
{{ 'zavelyn-balm.css' | asset_url | stylesheet_tag }}

<div class="offer-page offer-page--balm" id="OfferTop">
  <div class="offer-ticker">
    <p class="offer-ticker__line">{{ s.ticker_text | default: 'SUMMER SALE : 50% Off! —' }} <span>{{ s.ticker_highlight | default: 'Free Shipping $50+' }}</span></p>
  </div>
  {% render 'offer-header', brand: brand, product: product %}

  <section class="offer-hero">
    <div class="offer-hero__grid">
      <div class="offer-hero__left">
        <div class="offer-media" data-offer-gallery>
          <div class="offer-media__stage" {% if sec_gallery %}{{ sec_gallery.shopify_attributes }}{% endif %}>
            {%- liquid
              assign g_file = 'mb-g1.png'
              assign g_picked = nil
              if sec_gallery != blank
                if sec_gallery.settings.fallback_1 != blank
                  assign g_file = sec_gallery.settings.fallback_1
                endif
                assign g_picked = sec_gallery.settings.image_1
              endif
              if g_picked != blank
                assign g_src = g_picked | image_url: width: 1200
              else
                assign g_src = g_file | asset_url
              endif
            -%}
            <button type="button" class="offer-media__zoom" data-offer-zoom aria-label="Product image">
              <img data-offer-main src="{{ g_src }}" alt="{{ brand }} Miracle Balm" width="1200" height="1200" fetchpriority="high">
            </button>
            <button type="button" class="offer-media__nav offer-media__nav--prev" data-offer-prev aria-label="Previous">❮</button>
            <button type="button" class="offer-media__nav offer-media__nav--next" data-offer-next aria-label="Next">❯</button>
          </div>
          <div class="offer-thumbs" role="list">
            {%- for i in (1..6) -%}
              {%- liquid
                assign fk = 'fallback_' | append: i
                assign ik = 'image_' | append: i
                assign file = 'mb-g' | append: i | append: '.png'
                assign picked = nil
                if sec_gallery != blank
                  if sec_gallery.settings[fk] != blank
                    assign file = sec_gallery.settings[fk]
                  endif
                  assign picked = sec_gallery.settings[ik]
                endif
                if picked != blank
                  assign src = picked | image_url: width: 1200
                else
                  assign src = file | asset_url
                endif
              -%}
              <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-offer-thumb data-index="{{ forloop.index0 }}" data-src="{{ src }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ src }}" alt="" width="72" height="72" {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
              </button>
            {%- endfor -%}
          </div>
        </div>

        <div class="senzio-benefit-icons" data-senzio-benefit-icons aria-label="Product benefits">
          <div class="senzio-benefit-grid">
            <article class="senzio-benefit-item">
              <div class="senzio-benefit-icon senzio-leaf-icon" aria-hidden="true">
                <span class="senzio-icon-halo"></span>
                <svg class="senzio-svg" viewBox="0 0 64 64" role="presentation">
                  <path class="senzio-svg-path senzio-leaf-outline" d="M18 42C19 26 29 17 47 15C47 33 38 44 22 46"></path>
                  <path class="senzio-svg-path senzio-leaf-stem" d="M20 45C27 36 35 29 45 20"></path>
                  <path class="senzio-svg-path senzio-leaf-veins" d="M28 36L27 27M35 30L36 22"></path>
                  <circle class="senzio-svg-spark senzio-svg-spark--one" cx="47" cy="15" r="2"></circle>
                </svg>
              </div>
              <h3><span>{{ bb.benefit_1a | default: 'Natural' }}</span><span>{{ bb.benefit_1b | default: 'Ingredients' }}</span></h3>
            </article>
            <article class="senzio-benefit-item">
              <div class="senzio-benefit-icon senzio-shield-icon" aria-hidden="true">
                <span class="senzio-icon-halo"></span>
                <svg class="senzio-svg" viewBox="0 0 64 64" role="presentation">
                  <path class="senzio-svg-path senzio-shield-outline" d="M32 10L49 17V30C49 42 42 50 32 55C22 50 15 42 15 30V17L32 10Z"></path>
                  <path class="senzio-svg-path senzio-shield-inner" d="M32 16L43 21V30C43 38 39 44 32 48C25 44 21 38 21 30V21L32 16Z"></path>
                  <path class="senzio-svg-path senzio-check" d="M24 31L30 37L41 24"></path>
                </svg>
              </div>
              <h3><span>{{ bb.benefit_2a | default: 'Daily' }}</span><span>{{ bb.benefit_2b | default: 'Wellness' }}</span></h3>
            </article>
            <article class="senzio-benefit-item">
              <div class="senzio-benefit-icon senzio-users-icon" aria-hidden="true">
                <span class="senzio-icon-halo"></span>
                <svg class="senzio-svg senzio-users-svg" viewBox="0 0 64 64" role="presentation">
                  <g class="senzio-person senzio-person--primary">
                    <circle class="senzio-svg-path senzio-human-head senzio-human-head--primary" cx="23" cy="21" r="7"></circle>
                    <path class="senzio-svg-path senzio-human-body senzio-human-body--primary" d="M10 49C11.5 39.5 16.5 34 23 34C29.5 34 34.5 39.5 36 49"></path>
                    <path class="senzio-svg-path senzio-human-shoulder senzio-human-shoulder--primary" d="M16 37C18 40 20 42 23 42C26 42 29 40 31 37"></path>
                  </g>
                  <g class="senzio-person senzio-person--secondary">
                    <circle class="senzio-svg-path senzio-human-head senzio-human-head--secondary" cx="44" cy="24" r="5.5"></circle>
                    <path class="senzio-svg-path senzio-human-body senzio-human-body--secondary" d="M36 47C37.5 39.5 40.5 35.5 44.5 35.5C50.5 35.5 54 40 55 47"></path>
                    <path class="senzio-svg-path senzio-human-shoulder senzio-human-shoulder--secondary" d="M40 38C41 40 42.5 41 44.5 41C47 41 49 39.5 50 38"></path>
                  </g>
                  <path class="senzio-svg-path senzio-human-connection" d="M31 26C34 23 37 22 39 23"></path>
                  <circle class="senzio-human-heart" cx="34" cy="31" r="2.2"></circle>
                </svg>
              </div>
              <h3><span>{{ bb.benefit_3a | default: 'Made for' }}</span><span>{{ bb.benefit_3b | default: 'Everyone' }}</span></h3>
            </article>
            <article class="senzio-benefit-item">
              <div class="senzio-benefit-icon senzio-target-icon" aria-hidden="true">
                <span class="senzio-icon-halo"></span>
                <svg class="senzio-svg" viewBox="0 0 64 64" role="presentation">
                  <circle class="senzio-svg-path senzio-target-ring senzio-ring-one" cx="31" cy="33" r="20"></circle>
                  <circle class="senzio-svg-path senzio-target-ring senzio-ring-two" cx="31" cy="33" r="12"></circle>
                  <circle class="senzio-target-dot" cx="31" cy="33" r="4"></circle>
                  <path class="senzio-svg-path senzio-target-lines" d="M31 8V16M31 50V58M6 33H14M48 33H56"></path>
                  <path class="senzio-svg-path senzio-arrow" d="M43 21L54 10M47 10H54V17"></path>
                </svg>
              </div>
              <h3><span>{{ bb.benefit_4a | default: 'Targeted' }}</span><span>{{ bb.benefit_4b | default: 'Relief' }}</span></h3>
            </article>
          </div>
        </div>

        <section class="gp-senzio-compact-proof" aria-label="14 day relief">
          <div class="gp-senzio-compact-proof__inner">
            <div class="gp-senzio-compact-proof__headline">
              <span class="gp-senzio-compact-proof__text">{{ bb.proof_before | default: '7 years of Heel Pain' }}</span>
              <span class="gp-senzio-compact-proof__animated" aria-hidden="true">
                <span class="gp-senzio-compact-proof__animated-track">
                  <span class="gp-senzio-compact-proof__animated-item">{{ bb.proof_word_1 | default: 'improved' }}</span>
                  <span class="gp-senzio-compact-proof__animated-item">{{ bb.proof_word_2 | default: 'started easing' }}</span>
                  <span class="gp-senzio-compact-proof__animated-item">{{ bb.proof_word_3 | default: 'felt lighter' }}</span>
                </span>
              </span>
              <span class="gp-senzio-compact-proof__text">{{ bb.proof_after | default: 'in just' }} <strong>{{ bb.proof_strong | default: '14 DAYS' }}</strong></span>
            </div>
          </div>
        </section>
      </div>

      <div class="offer-hero__right">
        <div class="gp-trustpilot-inline" role="group" aria-label="Rated 4.8 out of 5 based on 16,032 verified reviews">
          <span class="gp-trustpilot-inline__brand" aria-label="Trustpilot">
            <svg class="gp-trustpilot-inline__brand-svg" viewBox="0 0 224 48" role="img" aria-label="Trustpilot" xmlns="http://www.w3.org/2000/svg">
              <path d="M23.8 2.6 29.2 14l12.3 1.4-9.1 8.2 2.6 12.1-11.2-6.4-11.2 6.4 2.6-12.1-9.1-8.2L18.4 14 23.8 2.6Z" fill="#00B67A"></path>
              <path d="m32.4 23.6-8.6 5.7 11.2 6.4-2.6-12.1Z" fill="#005128" opacity=".55"></path>
              <text x="51" y="33" fill="#191919" font-family="Arial, Helvetica, sans-serif" font-size="30" font-weight="700" letter-spacing="-1.2">Trustpilot</text>
            </svg>
          </span>
          <span class="gp-trustpilot-inline__stars" aria-label="Five green Trustpilot stars">
            {%- for i in (1..5) -%}
              <span class="gp-trustpilot-star">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="1" fill="#00B67A"></rect><path d="m12 4 2.25 4.56 5.03.73-3.64 3.55.86 5.01L12 15.49l-4.5 2.36.86-5.01-3.64-3.55 5.03-.73L12 4Z" fill="#fff"></path></svg>
              </span>
            {%- endfor -%}
          </span>
          <strong class="gp-trustpilot-inline__score">{{ bb.score | default: '4.8' }}</strong>
          <span class="gp-trustpilot-inline__excellent">{{ bb.score_label | default: 'Excellent' }}</span>
          <span class="gp-trustpilot-inline__separator" aria-hidden="true"></span>
          <span class="gp-trustpilot-inline__reviews">
            <svg class="gp-trustpilot-inline__verified" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m7.5 12.1 2.8 2.8 6.2-6.3"></path></svg>
            <span><strong>{{ bb.review_count | default: '16,032' }}</strong> verified reviews</span>
          </span>
        </div>

        <h1 class="offer-title">{{ brand }} {{ bb.product_title | default: 'Miracle Balm™' }}</h1>
        <p class="mb-price">{{ unit | money_without_trailing_zeros }}</p>

        <div class="senzio-proof-list" role="list">
          <div class="senzio-proof-item" role="listitem">
            <span class="senzio-check-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle class="senzio-check-circle" cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2"></circle><path class="senzio-check-mark" d="M14.5 24.5L21 31L34 17.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <div class="senzio-proof-text"><strong>{{ bb.bullet_1 | default: 'Stop Plantar Fasciitis Pain in 60 Days — Or You Don’t Pay' }}</strong></div>
          </div>
          <div class="senzio-proof-item" role="listitem">
            <span class="senzio-check-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle class="senzio-check-circle" cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2"></circle><path class="senzio-check-mark" d="M14.5 24.5L21 31L34 17.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <div class="senzio-proof-text"><strong>{{ bb.bullet_2 | default: '91% of Customers Reported Less Heel Pain, Less Burning, and Lighter-Feeling Feet' }}</strong></div>
          </div>
          <div class="senzio-proof-item" role="listitem">
            <span class="senzio-check-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle class="senzio-check-circle" cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2"></circle><path class="senzio-check-mark" d="M14.5 24.5L21 31L34 17.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <div class="senzio-proof-text"><strong>{{ bb.bullet_3 | default: 'Herbal Powerhouse: Made with Potent Asian Medicinal Herbs' }}</strong></div>
          </div>
          <div class="senzio-proof-item" role="listitem">
            <span class="senzio-check-icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle class="senzio-check-circle" cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2"></circle><path class="senzio-check-mark" d="M14.5 24.5L21 31L34 17.5" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></span>
            <div class="senzio-proof-text"><strong>{{ bb.bullet_4 | default: 'For Heel Pain / Plantar Fascia Strain / Arch Pain / Burning Soles / Achilles Tightness' }}</strong></div>
          </div>
        </div>

        {% form 'product', product, id: 'OfferAddForm', class: 'offer-buy-form' %}
          <input type="hidden" name="id" id="OfferVariantId" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="OfferQuantity" value="{{ default_qty }}">

          <p class="mb-deals-label">{{ s.deals_label | default: 'EXCLUSIVE DEALS' }}</p>
          <div class="mb-packs" data-mb-packs id="MbDeals" {% if sec_buybox %}{{ sec_buybox.shopify_attributes }}{% endif %}>
            <button type="button" class="mb-pack{% if default_qty == qty_1 %} is-active{% endif %}" data-qty="{{ qty_1 }}" aria-pressed="{% if default_qty == qty_1 %}true{% else %}false{% endif %}">
              <span class="mb-pack__radio" aria-hidden="true"></span>
              <span><span class="mb-pack__name">{{ s.bundle_1_title | default: 'Buy 1' }}</span></span>
              <span class="mb-pack__prices">
                <span class="mb-pack__now">{{ unit | money_without_trailing_zeros }}</span>
                <span class="mb-pack__was">{{ compare_unit | money_without_trailing_zeros }}</span>
              </span>
            </button>
            <button type="button" class="mb-pack{% if default_qty == qty_2 %} is-active{% endif %}" data-qty="{{ qty_2 }}" aria-pressed="{% if default_qty == qty_2 %}true{% else %}false{% endif %}">
              <span class="mb-pack__radio" aria-hidden="true"></span>
              <span><span class="mb-pack__name">{{ s.bundle_2_title | default: 'Buy 2' }}</span></span>
              <span class="mb-pack__prices">
                <span class="mb-pack__now">{{ p2 | money_without_trailing_zeros }}</span>
                <span class="mb-pack__was">{{ c2 | money_without_trailing_zeros }}</span>
              </span>
            </button>
            <button type="button" class="mb-pack{% if default_qty == qty_3 %} is-active{% endif %}" data-qty="{{ qty_3 }}" data-discount="{{ s.bundle_3_code | default: 'BALM3EXTRA10' }}" aria-pressed="{% if default_qty == qty_3 %}true{% else %}false{% endif %}">
              <span class="mb-pack__radio" aria-hidden="true"></span>
              <span>
                <span class="mb-pack__name">{{ s.bundle_3_title | default: 'Buy 3' }}</span>
                <span class="mb-pack__save">{{ s.bundle_3_badge | default: 'Extra 10%' }}</span>
                <span class="mb-pack__sub">{{ s.bundle_3_sub | default: 'Free Shipping' }}</span>
              </span>
              <span class="mb-pack__prices">
                <span class="mb-pack__now">{{ p3 | money_without_trailing_zeros }}</span>
                <span class="mb-pack__was">{{ p3_list | money_without_trailing_zeros }}</span>
              </span>
            </button>
          </div>

          <button type="submit" class="offer-cta" data-mb-atc>
            <svg height="20" width="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true"><path fill="currentColor" d="M233.21,56.31A12,12,0,0,0,224,52H66L60.53,21.85A12,12,0,0,0,48.73,12H24a12,12,0,0,0,0,24H38.71L63.62,173a28,28,0,0,0,4.07,10.21A32,32,0,1,0,123,196h34a32,32,0,1,0,31-24H91.17a4,4,0,0,1-3.93-3.28L84.92,156H196.1a28,28,0,0,0,27.55-23l12.16-66.86A12,12,0,0,0,233.21,56.31ZM100,204a8,8,0,1,1-8-8A8,8,0,0,1,100,204Zm88,8a8,8,0,1,1,8-8A8,8,0,0,1,188,212Zm12-83.28A4,4,0,0,1,196.1,132H80.56L70.38,76H209.62Z"></path></svg>
            {{ cta_label }}
          </button>
        {% endform %}

        <div class="gp-subscription-trust">
          <div class="gp-subscription-grid">
            <div class="gp-subscription-item">
              <div class="gp-subscription-icon-wrap" aria-hidden="true">
                <svg class="gp-subscription-svg gp-refill-svg" viewBox="0 0 24 24">
                  <polyline class="gp-icon-draw" points="23 4 23 10 17 10"></polyline>
                  <polyline class="gp-icon-draw" points="1 20 1 14 7 14"></polyline>
                  <path class="gp-icon-draw" d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
                </svg>
              </div>
              <p class="gp-subscription-title">{{ bb.trust_1_title | default: 'Auto-Refill' }}</p>
              <p class="gp-subscription-subtitle">{{ bb.trust_1_sub | default: 'Ships every month' }}</p>
            </div>
            <div class="gp-subscription-item">
              <div class="gp-subscription-icon-wrap" aria-hidden="true">
                <svg class="gp-subscription-svg" viewBox="0 0 24 24">
                  <rect class="gp-icon-draw" x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line class="gp-icon-draw" x1="16" y1="2" x2="16" y2="6"></line>
                  <line class="gp-icon-draw" x1="8" y1="2" x2="8" y2="6"></line>
                  <line class="gp-icon-draw" x1="3" y1="10" x2="21" y2="10"></line>
                  <path class="gp-calendar-check" d="M9 16l2 2 4-4"></path>
                </svg>
              </div>
              <p class="gp-subscription-title">{{ bb.trust_2_title | default: 'Skip or Cancel' }}</p>
              <p class="gp-subscription-subtitle">{{ bb.trust_2_sub | default: 'Anytime, no fees' }}</p>
            </div>
            <div class="gp-subscription-item">
              <div class="gp-subscription-icon-wrap" aria-hidden="true">
                <svg class="gp-subscription-svg gp-shield-svg" viewBox="0 0 24 24">
                  <path class="gp-icon-draw" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <polyline class="gp-shield-check" points="9 12 11 14 15 10"></polyline>
                </svg>
              </div>
              <p class="gp-subscription-title">{{ bb.trust_3_title | default: '60-Day Guarantee' }}</p>
              <p class="gp-subscription-subtitle">{{ bb.trust_3_sub | default: 'Money-back promise' }}</p>
            </div>
          </div>
        </div>

        <div class="senzio-official-store-alert" role="alert">
          <div class="senzio-official-store-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" role="presentation">
              <path class="senzio-alert-triangle" d="M24 5L44 40H4L24 5Z"></path>
              <path class="senzio-alert-line" d="M24 17V28"></path>
              <circle class="senzio-alert-dot" cx="24" cy="34" r="2"></circle>
            </svg>
          </div>
          <div class="senzio-official-store-content">
            <strong>{{ bb.alert_title | default: 'Beware of Counterfeit Products' }}</strong>
            <span>{{ bb.alert_text | default: 'The only official store is' }} <a href="{{ shop.url }}">{{ shop.domain }}</a></span>
          </div>
        </div>

        <div class="mb-faq" data-mb-acc>
          <div class="mb-faq__item">
            <button type="button" class="mb-faq__trigger" aria-expanded="false">{{ bb.faq_1_q | default: 'How To Use For Maximum Relief' }}</button>
            <div class="mb-faq__panel" hidden>
              {%- if bb.faq_1_a != blank -%}{{ bb.faq_1_a }}{%- else -%}
              <ul>
                <li>Apply to the <strong>heel and arch of the foot</strong> and massage thoroughly until fully absorbed.</li>
                <li>Use <strong>2–3 times daily</strong> — especially <strong>morning and evening</strong>.</li>
                <li>Many customers feel <strong>reduced tension shortly after applying</strong>.</li>
                <li>This balm helps calm <strong>inflammation in the plantar fascia</strong>.</li>
                <li>Each application builds on the last — helping the <strong>tissue recover over time</strong>.</li>
                <li>For best results, use consistently for at least <strong>60–90 days</strong>.</li>
              </ul>
              {%- endif -%}
            </div>
          </div>
          <div class="mb-faq__item">
            <button type="button" class="mb-faq__trigger" aria-expanded="false">{{ bb.faq_2_q | default: 'Why Consistent Use Works Better' }}</button>
            <div class="mb-faq__panel" hidden>
              {%- if bb.faq_2_a != blank -%}{{ bb.faq_2_a }}{%- else -%}
              <ul>
                <li>Plantar fasciitis worsens with <strong>repeated strain</strong>.</li>
                <li>You may feel early relief, but full recovery requires <strong>consistent use</strong>.</li>
                <li><strong>One application won’t repair ongoing irritation.</strong></li>
                <li>Daily use helps prevent <strong>re-aggravation</strong> and supports <strong>healing</strong>.</li>
                <li>Most customers notice improvement within weeks, with stronger results after <strong>4–8 weeks</strong>, continuing through <strong>60–90 days</strong>.</li>
              </ul>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mb-people">
    {% render 'offer-balm-people', brand: brand, group: sec_people %}
  </div>

  <section class="mb-sec" id="ingredients">
    {% render 'offer-balm-purity', group: sec_purity %}
  </section>
  {% render 'offer-balm-explorer', group: sec_explorer %}

  {%- unless sec_herbs and sec_herbs.settings.show == false -%}
  <section class="mb-sec senzio-herbs" style="padding-top:0">
    <div class="senzio-asian-herbs-title" {% if sec_herbs %}{{ sec_herbs.shopify_attributes }}{% endif %}>
      <span class="senzio-asian-herbs-eyebrow">{{ herbs.eyebrow | default: 'Traditional Botanical Wisdom' }}</span>
      <h2>{{ herbs.title | default: 'Why Asian Herbs Are So Powerful' }}</h2>
      <span class="senzio-asian-herbs-line" aria-hidden="true"></span>
    </div>
    {%- liquid
      if herbs.image != blank
        assign herbs_src = herbs.image | image_url: width: 1672
      else
        assign herbs_src = 'mb-herbs.png' | asset_url
      endif
    -%}
    <img class="senzio-asian-herbs-photo" src="{{ herbs_src }}" alt="{{ herbs.alt | default: 'Resilient, potent, and time-tested Asian herbs' }}" width="1672" height="941" loading="lazy">
  </section>
  {%- endunless -%}

  <section class="mb-sec senzio-results">
    {% render 'offer-balm-compare', brand: brand, group: sec_compare %}
  </section>

  {% render 'offer-balm-proof', group: sec_science %}

  {% render 'offer-balm-reviews-carousel', group: sec_reviews %}

  {%- unless sec_howto and sec_howto.settings.show == false -%}
  <section class="mb-howto" aria-label="How to use for plantar and heel pain" {% if sec_howto %}{{ sec_howto.shopify_attributes }}{% endif %}>
    {%- liquid
      if howto.image != blank
        assign howto_src = howto.image | image_url: width: 1672
      else
        assign howto_src = 'mb-rev-mark.png' | asset_url
      endif
    -%}
    <img src="{{ howto_src }}" alt="{{ howto.alt | default: 'How to use for plantar and heel pain: scoop a small amount, apply to the heel and arch, massage gently, and use daily' }}" width="1672" height="941" loading="lazy">
  </section>
  {%- endunless -%}

  {% render 'offer-balm-timeline', group: sec_timeline %}

  {% render 'offer-balm-faq', group: sec_faq %}

  {% render 'offer-balm-ryviu', group: sec_ryviu %}

  <footer class="offer-foot">
    <div class="offer-foot__inner">
      <div class="offer-foot__logo">{{ brand }}</div>
      <p class="offer-foot__line">© {{ 'now' | date: '%Y' }} {{ brand }}®. All Rights Reserved.</p>
      <p class="offer-foot__line"><a href="/pages/privacy-policy">Privacy Policy</a> - <a href="/pages/terms-of-service">Terms of Service</a></p>
      <p class="offer-foot__line">{{ s.email | default: 'support@zavelyn.com' }}</p>
    </div>
  </footer>

  <div class="offer-sticky" data-offer-sticky aria-hidden="true" inert>
    <div class="offer-sticky__inner">
      <div class="offer-sticky__copy">{{ s.sticky_copy | default: 'Miracle Balm' }}</div>
      <button type="button" class="offer-sticky__cta" data-mb-atc>{{ cta_label }}</button>
