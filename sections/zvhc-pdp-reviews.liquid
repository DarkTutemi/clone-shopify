                  <span style="font-size: 0.75rem; color: var(--zvhc-t01-accent-rose, #B0476E); font-weight: 700;">{{ rev_r3_badge }}</span>
                </div>
                <p style="font-size: 0.88rem; color: var(--zvhc-t01-text-muted, #5A4651); line-height: 1.55; margin: 0;">
                  "{{ rev_r3_text }}"
                </p>
              </div>
            </div>
          </div>
        </div>

        <div style="margin-top: 24px;">
