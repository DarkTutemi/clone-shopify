{{ 'zhp-collection.css' | asset_url | stylesheet_tag }}

<div class="zhp-wrapper">
  <section class="zhp-included-section" id="whats-included">
    <div class="zhp-container">
      <div class="zhp-sec-header">
        <span class="zhp-sec-tag">ALL-IN-ONE STARTER KITS</span>
        <h2 class="zhp-sec-title">What's Included in Your Package</h2>
        <p class="zhp-sec-subtitle">
          Every Zavelyn order ships as a self-contained, ready-to-play set. Verified accessories tailored to each model with zero surprise add-ons required.
        </p>
      </div>

      <div class="zhp-acc-grid">
        <!-- Accessory 1: Travel Bag / Backpack -->
        <div class="zhp-acc-card">
          <div class="zhp-acc-img-wrap">
            <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/img_3.png?v=1792907902" alt="Padded Protective Travel Backpack and Bags" loading="lazy">
          </div>
          <span class="zhp-acc-badge">INCLUDED</span>
          <h3 class="zhp-acc-title">Padded Travel Bag</h3>
          <p class="zhp-acc-desc">
            Thick foam shock absorption with reinforced shoulder straps and zip compartments for safe transport and dust-free home storage.
          </p>
          <span class="zhp-acc-compat">All Models (Backpack / Pouch)</span>
        </div>

        <!-- Accessory 2: Balanced Bamboo Mallets -->
        <div class="zhp-acc-card">
          <div class="zhp-acc-img-wrap">
            <img src="https://cdn.shopify.com/s/files/1/0566/1209/4037/files/accessory_mallets.webp?v=1691487451" alt="Balanced Bamboo Mallets with Soft Rubber Tips" loading="lazy">
          </div>
          <span class="zhp-acc-badge">INCLUDED</span>
          <h3 class="zhp-acc-title">Pair of Acoustic Mallets</h3>
          <p class="zhp-acc-desc">
            Custom-weighted natural bamboo mallets with soft rubber tips engineered to produce crystal-clear resonance without harsh percussive clack.
          </p>
          <span class="zhp-acc-compat">Included with All Models</span>
        </div>

        <!-- Accessory 3: Foldable Tripod Stand -->
        <div class="zhp-acc-card">
          <div class="zhp-acc-img-wrap">
            <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/img_6.jpg?v=1792907902" alt="Foldable Aluminum Tripod Stand" loading="lazy">
          </div>
          <span class="zhp-acc-badge" style="background:#E0F2FE; color:#0369A1;">MASTER EXCLUSIVE</span>
          <h3 class="zhp-acc-title">Aluminum Tripod Stand</h3>
          <p class="zhp-acc-desc">
            Heavy-duty, quick-folding aluminum tripod stand with rubberized contact pads. Position your 22" Handpan at ideal ergonomic playing height.
          </p>
          <span class="zhp-acc-compat">Handpan Master 22" Exclusive</span>
        </div>

        <!-- Accessory 4: Tutorial Songbook & Number Guide -->
        <div class="zhp-acc-card">
          <div class="zhp-acc-img-wrap">
            <img src="https://cdn.shopify.com/s/files/1/0566/1209/4037/files/accessory_songbook.webp?v=1691487451" alt="Zavelyn Illustrated Tutorial Songbook" loading="lazy">
          </div>
          <span class="zhp-acc-badge">INCLUDED</span>
          <h3 class="zhp-acc-title">Illustrated Songbook</h3>
          <p class="zhp-acc-desc">
            Beginner-friendly visual guide featuring 20+ timeless songs, scale maps, and playing techniques mapped to numbered tone tongues.
          </p>
          <span class="zhp-acc-compat">Master, Pro, Plus & Mini</span>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "ZHP What Is Included",
  "settings": []
}
{% endschema %}
