<div class="zv-bins-body-wrapper" id="storage-bins-details">
  <style>
    .zv-bins-body-wrapper {
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
      font-family: inherit;
      color: #17433C;
      line-height: 1.65;
    }
    .zv-bins-section {
      background: #FFFFFF;
      border: 1px solid rgba(23, 67, 60, 0.12);
      border-radius: 16px;
      padding: 32px 28px;
      margin-bottom: 24px;
      box-shadow: 0 4px 16px rgba(23, 67, 60, 0.04);
    }
    .zv-bins-section h2 {
      font-size: 22px;
      font-weight: 800;
      color: #17433C;
      margin-top: 0;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .zv-bins-section p {
      font-size: 15.5px;
      color: #334e48;
      margin-bottom: 14px;
    }
    .zv-bins-section p:last-child {
      margin-bottom: 0;
    }
    .zv-bins-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-top: 20px;
    }
    @media (max-width: 768px) {
      .zv-bins-grid {
        grid-template-columns: 1fr;
      }
      .zv-bins-section {
        padding: 24px 18px;
      }
    }
    .zv-bins-card {
      background: #F7F9F8;
      border: 1px solid rgba(23, 67, 60, 0.08);
      border-radius: 12px;
      padding: 20px;
    }
    .zv-bins-card h3 {
      font-size: 17px;
      font-weight: 750;
      color: #17433C;
      margin-top: 0;
      margin-bottom: 10px;
    }
    .zv-bins-card p {
      font-size: 14.5px;
      color: #49635d;
      margin: 0;
    }
    /* Responsive Body Images */
    .zv-bins-body-img-wrap {
      margin-top: 24px;
      text-align: center;
    }
    .zv-bins-body-img {
      width: 100%;
      max-width: 720px;
      height: auto;
      display: block;
      margin: 0 auto;
      border-radius: 14px;
      border: 1px solid rgba(23, 67, 60, 0.12);
      box-shadow: 0 4px 20px rgba(23, 67, 60, 0.06);
    }
    @media (max-width: 768px) {
      .zv-bins-body-img-wrap {
        margin-top: 18px;
      }
      .zv-bins-body-img {
        border-radius: 10px;
      }
    }
    /* Steps Layout */
    .zv-bin-step-item {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      padding: 16px;
      background: #F7F9F8;
      border-radius: 12px;
      margin-bottom: 12px;
    }
    .zv-bin-step-num {
      width: 36px;
      height: 36px;
      background: #17433C;
      color: #C6FA54;
      font-size: 16px;
      font-weight: 800;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .zv-bin-step-content strong {
      display: block;
      font-size: 15.5px;
      color: #17433C;
      margin-bottom: 4px;
    }
    .zv-bin-step-content span {
      font-size: 14px;
      color: #49635d;
      line-height: 1.5;
    }
    /* Specs Table */
    .zv-bins-specs-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
      font-size: 14.5px;
    }
    .zv-bins-specs-table th,
    .zv-bins-specs-table td {
      padding: 12px 14px;
      border-bottom: 1px solid rgba(23, 67, 60, 0.08);
      text-align: left;
    }
    .zv-bins-specs-table th {
      color: #17433C;
      font-weight: 700;
      width: 35%;
      background: #F7F9F8;
    }
    .zv-bins-specs-table td {
      color: #334e48;
    }
    /* FAQ Accordion */
    .zv-bins-faq-item {
      background: #F7F9F8;
      border: 1px solid rgba(23, 67, 60, 0.08);
      border-radius: 12px;
      margin-bottom: 10px;
      overflow: hidden;
      transition: all 0.2s ease;
    }
    .zv-bins-faq-item[open] {
      background: #FFFFFF;
      border-color: rgba(23, 67, 60, 0.25);
      box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .zv-bins-faq-summary {
      padding: 16px 20px;
      cursor: pointer;
      font-weight: 750;
      font-size: 15px;
      color: #17433C;
      display: flex;
      align-items: center;
      justify-content: space-between;
      list-style: none;
      user-select: none;
    }
    .zv-bins-faq-summary::-webkit-details-marker {
      display: none;
    }
    .zv-bins-faq-summary::after {
      content: '+';
      font-size: 20px;
      font-weight: 400;
      color: #17433C;
      transition: transform 0.2s ease;
    }
    .zv-bins-faq-item[open] .zv-bins-faq-summary::after {
      content: '−';
    }
    .zv-bins-faq-answer {
      padding: 0 20px 18px;
      font-size: 14px;
      color: #49635d;
      line-height: 1.6;
      border-top: 1px solid rgba(23, 67, 60, 0.06);
      padding-top: 12px;
    }
  </style>

