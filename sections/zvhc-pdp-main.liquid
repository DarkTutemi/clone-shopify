{% comment %}
  ZAVELYN HAIR CARE — Main Product Section & Buy Box (Ported & Scoped from TRYMALORA)
  Features 1/2/3 Bundle Cards, Honest Savings Math, and Safe Variant Mapping
{% endcomment %}

<section class="zvhc-pdp-main" id="zvhcBuyBoxSection">
  <div class="zvhc-container">
    <div class="zvhc-pdp-grid">
      <!-- 1. Left Gallery Column -->
      <div class="zvhc-gallery">
        <div class="zvhc-main-image-wrap">
          {% if product.featured_image %}
            <img id="zvhcMainImg" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
          {% else %}
            <img id="zvhcMainImg" src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-1.jpg?v=1793191361" alt="{{ product.title | escape }}">
          {% endif %}
        </div>
        <div class="zvhc-thumbs-row">
          {% if product.images.size > 1 %}
            {% for img in product.images limit: 5 %}
              <div class="zvhc-thumb-item {% if forloop.first %}is-active{% endif %}" onclick="zvhcSelectThumb(this, '{{ img | image_url: width: 1000 }}')">
                <img src="{{ img | image_url: width: 160 }}" alt="{{ product.title | escape }}">
              </div>
            {% endfor %}
          {% else %}
            <div class="zvhc-thumb-item is-active" onclick="zvhcSelectThumb(this, 'https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-1.jpg?v=1793191361')">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-1.jpg?v=1793191361" alt="Bottle">
            </div>
            <div class="zvhc-thumb-item" onclick="zvhcSelectThumb(this, 'https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-2.jpg?v=1792936448')">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-2.jpg?v=1792936448" alt="Model">
            </div>
            <div class="zvhc-thumb-item" onclick="zvhcSelectThumb(this, 'https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-3.png?v=1793191524')">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-3.png?v=1793191524" alt="Ingredients">
            </div>
          {% endif %}
        </div>
      </div>

      <!-- 2. Right Buy Box Column -->
      <div class="zvhc-buybox">
        <!-- Review Stars -->
        <div class="zvhc-reviews-row">
          <div class="zvhc-stars">★★★★★</div>
          <span>Customer Verified Experiences · Pure Botanical Formula</span>
        </div>

        <h1 class="zvhc-pdp-title">{{ product.title | default: "Zavelyn BotanaRoots Batana Hair Oil" }}</h1>
        <div class="zvhc-pdp-subtitle">
          Pure Cold-Pressed Batana Botanical Oil. Deeply nourishes the scalp, replenishes dry hair cuticles, and restores lustrous natural hair resilience.
        </div>

        <!-- Formula Selector -->
        <div class="zvhc-formula-section">
          <div class="zvhc-formula-label">SELECT BOTANICAL FORMULA:</div>
          <div class="zvhc-formula-options">
            <button type="button" class="zvhc-formula-btn is-active" data-formula="100% Pure Raw Honduran Batana (60ml)">
              <div class="zvhc-formula-name">Pure Raw Batana</div>
              <div class="zvhc-formula-desc">100% unrefined cold-pressed oil</div>
            </button>
            <button type="button" class="zvhc-formula-btn" data-formula="Batana + Rosemary Scalp Infusion (60ml)">
              <div class="zvhc-formula-name">Batana + Rosemary</div>
              <div class="zvhc-formula-desc">Infused with rosemary scalp activator</div>
            </button>
          </div>
        </div>

        <!-- Kaching-Style Bundle Cards -->
        <div class="zvhc-bundle-label">
          <span>CHOOSE YOUR TREATMENT COURSE:</span>
          <span style="color: var(--zvhc-copper); font-size: 0.76rem;">30-DAY SATISFACTION GUARANTEE</span>
        </div>

        <div class="zvhc-bundle-cards-group">
          <!-- Tier 1: 1 Bottle (Starter Supply) -->
          <div class="zvhc-bundle-card" data-tier="1">
            <div class="zvhc-bundle-card-top">
              <div class="zvhc-bundle-radio-wrap">
                <div class="zvhc-radio-circle"><div class="zvhc-radio-dot"></div></div>
                <div class="zvhc-bundle-info-title">
                  <span>1 Bottle</span>
                  <span class="zvhc-save-pill">Starter</span>
                </div>
              </div>
              <div class="zvhc-bundle-pricing">
                <div class="zvhc-bundle-price">$39.99</div>
                <div class="zvhc-bundle-compare">$49.99</div>
                <div class="zvhc-bundle-each">$39.99 / bottle</div>
              </div>
            </div>
            <div class="zvhc-bundle-subtext">30-day targeted supply for scalp &amp; hairline care</div>
          </div>

          <!-- Tier 2: 2 Bottles (Duo Care - Most Popular) -->
          <div class="zvhc-bundle-card is-selected" data-tier="2">
            <div class="zvhc-card-badge">★ MOST POPULAR</div>
            <div class="zvhc-bundle-card-top">
              <div class="zvhc-bundle-radio-wrap">
                <div class="zvhc-radio-circle"><div class="zvhc-radio-dot"></div></div>
                <div class="zvhc-bundle-info-title">
                  <span>2 Bottles Duo</span>
                  <span class="zvhc-save-pill">Save 30%</span>
                </div>
              </div>
              <div class="zvhc-bundle-pricing">
                <div class="zvhc-bundle-price">$69.99</div>
                <div class="zvhc-bundle-compare">$99.98</div>
                <div class="zvhc-bundle-each">$35.00 / bottle</div>
              </div>
            </div>
            <div class="zvhc-bundle-subtext">Recommended 60-day intensive scalp hydration &amp; hair strength routine</div>
            <div class="zvhc-bundle-perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>FREE US Tracked Shipping included</span>
            </div>
            <div class="zvhc-gift-unlock">
              🎁 <span><strong>Free Gift Unlocked:</strong> Soft Silicone Scalp Massaging Comb ($14.99 Value)</span>
            </div>
          </div>

          <!-- Tier 3: 3 Bottles (Full Restoration - Best Value) -->
          <div class="zvhc-bundle-card" data-tier="3">
            <div class="zvhc-card-badge">💎 BEST VALUE</div>
            <div class="zvhc-bundle-card-top">
              <div class="zvhc-bundle-radio-wrap">
                <div class="zvhc-radio-circle"><div class="zvhc-radio-dot"></div></div>
                <div class="zvhc-bundle-info-title">
                  <span>3 Bottles Course</span>
                  <span class="zvhc-save-pill">Save 40%</span>
                </div>
              </div>
              <div class="zvhc-bundle-pricing">
                <div class="zvhc-bundle-price">$89.99</div>
                <div class="zvhc-bundle-compare">$149.97</div>
                <div class="zvhc-bundle-each">$30.00 / bottle</div>
              </div>
            </div>
            <div class="zvhc-bundle-subtext">Complete 90-day comprehensive botanical restoration routine</div>
            <div class="zvhc-bundle-perk">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>FREE US Tracked Shipping included</span>
            </div>
            <div class="zvhc-gift-unlock">
              🎁 <span><strong>2 Free Gifts Unlocked:</strong> Scalp Massager + Pure Silk Sleep Bonnet ($29.98 Value)</span>
            </div>
          </div>
        </div>

        <!-- Savings Callout -->
        <div class="zvhc-savings-callout" id="zvhcSavingsCallout">
          ✨ <strong>Save $30 vs Reg. + FREE US Tracked Shipping</strong> included on this order
        </div>

        <!-- Two-Line CTA Button -->
        <button type="button" class="zvhc-cta-btn" id="zvhcMainCta">
          <div class="zvhc-cta-line-1">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
            <span>ADD TO CART — <span id="zvhcCtaPrice">$69.99</span></span>
          </div>
          <div class="zvhc-cta-line-2">
            🔒 30-DAY SATISFACTION GUARANTEE
          </div>
        </button>

        <!-- Security & Delivery Notes -->
        <div class="zvhc-guarantee-note">
          <span>🔒 256-Bit SSL Encrypted Checkout</span>
          <span>•</span>
          <span>📦 Tracked US Shipping</span>
        </div>

        <!-- 3-Step Delivery Stepper -->
        <div class="zvhc-stepper">
          <div class="zvhc-step-item">
            <div class="zvhc-step-dot"></div>
            <div class="zvhc-step-lbl">ORDER CONFIRMED</div>
            <div class="zvhc-step-val">Instant</div>
          </div>
          <div class="zvhc-step-item">
            <div class="zvhc-step-dot"></div>
            <div class="zvhc-step-lbl">FULFILLMENT</div>
            <div class="zvhc-step-val">US Tracked</div>
          </div>
          <div class="zvhc-step-item">
            <div class="zvhc-step-dot"></div>
            <div class="zvhc-step-lbl">DELIVERY</div>
            <div class="zvhc-step-val">Tracked Shipping</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile Sticky Dock -->
<div class="zvhc-mobile-dock" id="zvhcMobileDock">
  <div class="zvhc-dock-info">
    <div class="zvhc-dock-info-title">{{ product.title | default: "Batana Hair Care" | truncate: 26 }}</div>
    <div class="zvhc-dock-info-price" id="zvhcDockPrice">$69.99</div>
  </div>
  <button type="button" class="zvhc-dock-btn" id="zvhcDockCta">
    ADD TO CART
  </button>
</div>

<script src="{{ 'zvhc-pdp.js' | asset_url }}" defer></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.ZvhcPdp) {
      window.ZvhcPdp.init({{ product.variants | json }});
    }
  });
</script>

{% schema %}
{
  "name": "ZVHC PDP Main BuyBox",
  "settings": []
}
{% endschema %}
