{%- liquid
  if request.page_type == 'product' and product != blank
    assign offer_product = product
  elsif section.settings.product != blank
    assign offer_product = section.settings.product
  else
    assign offer_product = all_products['zavelyn-foot-sleeves']
  endif
  if offer_product == blank
    assign offer_product = collections.all.products.first
  endif
  assign product = offer_product
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
  assign brand = s.brand_name | default: 'Zavelyn'
  assign cta_label = s.cta_label | default: 'Add to cart'
  comment
    Paid qty only (UI price). Physical totals: buy1=1, buy2get1=3, buy3get3=6
  endcomment
  assign cta_paid_qty = 1
  assign cta_total_qty = 1
  if s.packages_reversed
    assign cta_paid_qty = 3
    assign cta_total_qty = 6
  endif
  assign cta_price_cents = current_variant.price | times: cta_paid_qty
  assign privacy_url = s.privacy_link | default: '/pages/privacy-policy'
  assign terms_url = s.terms_link | default: '/pages/terms-of-service'
  assign size_option = blank
  for option in product.options_with_values
    assign option_key = option.name | downcase
    if option_key == 'size'
      assign size_option = option
      break
    endif
  endfor
  assign grp_gallery = section.blocks | where: 'type', 'grp_gallery' | first
  assign grp_perks = section.blocks | where: 'type', 'grp_perks' | first
  assign grp_checks = section.blocks | where: 'type', 'grp_checks' | first
  assign grp_press = section.blocks | where: 'type', 'grp_press' | first
  assign grp_features = section.blocks | where: 'type', 'grp_features' | first
  assign grp_timeline = section.blocks | where: 'type', 'grp_timeline' | first
  assign grp_tech = section.blocks | where: 'type', 'grp_tech' | first
  assign grp_compare = section.blocks | where: 'type', 'grp_compare' | first
  assign grp_vreviews = section.blocks | where: 'type', 'grp_vreviews' | first
  assign grp_clinicians = section.blocks | where: 'type', 'grp_clinicians' | first
  assign grp_specialist = section.blocks | where: 'type', 'grp_specialist' | first
  assign grp_reviews = section.blocks | where: 'type', 'grp_reviews' | first
  assign grp_final = section.blocks | where: 'type', 'grp_final' | first
  assign bogo_free_product = all_products['zavelyn-foot-sleeves-bogo-free']
-%}
{% render 'offer-seo', product: product, section: section %}

<div class="offer-page" id="OfferTop">

  <div class="offer-ticker">
    <p class="offer-ticker__line">🦶 {{ s.ticker_text | default: 'RECOVERY SALE STARTS NOW.' }} <span>{{ s.ticker_highlight | default: 'BUY ONE GET ONE FREE!' }}</span></p>
  </div>

  {% render 'offer-header', brand: brand, product: product %}

  <section class="offer-hero">
    <div class="offer-hero__grid">
      <div class="offer-hero__left">
        <div class="offer-media" data-offer-gallery>
          <div class="offer-media__stage">
            {%- if grp_gallery and grp_gallery.settings.image_1 != blank -%}
              {%- assign main_src = grp_gallery.settings.image_1 | image_url: width: 1200 -%}
            {%- elsif grp_gallery and grp_gallery.settings.fallback_1 != blank -%}
              {%- assign main_src = grp_gallery.settings.fallback_1 | asset_url -%}
            {%- else -%}
              {%- assign first_gallery = section.blocks | where: 'type', 'gallery_image' | first -%}
              {%- if first_gallery and first_gallery.settings.image != blank -%}
                {%- assign main_src = first_gallery.settings.image | image_url: width: 1200 -%}
              {%- elsif first_gallery and first_gallery.settings.fallback_asset != blank -%}
                {%- assign main_src = first_gallery.settings.fallback_asset | asset_url -%}
              {%- else -%}
                {%- assign main_src = 'offer-gallery-1.jpg' | asset_url -%}
              {%- endif -%}
            {%- endif -%}
            <button type="button" class="offer-media__zoom" data-offer-zoom aria-label="Open gallery">
              <img
                data-offer-main
                src="{{ main_src }}"
                alt="{{ product.title | escape }}"
                width="1200"
                height="1200"
                fetchpriority="high"
              >
            </button>
            <button type="button" class="offer-media__nav offer-media__nav--prev" data-offer-prev aria-label="Previous image">❮</button>
            <button type="button" class="offer-media__nav offer-media__nav--next" data-offer-next aria-label="Next image">❯</button>
            {%- if s.show_frontrow != false -%}
              <div class="offer-frontrow" data-frontrow>
                <button type="button" class="offer-frontrow__x" data-frontrow-close aria-label="Close">×</button>
                <div class="offer-frontrow__row">
                  <div class="offer-frontrow__badge" aria-hidden="true">{{ s.frontrow_badge | default: "CLINICIANS'<br>CHOICE" }}</div>
                  <div class="offer-frontrow__copy">
                    <div>{{ s.frontrow_text | default: "832 clinicians share this on FrontrowMD without compensation." }}</div>
                    <a href="#clinicians">{{ s.frontrow_link_label | default: 'View clinicians & learn more' }}</a>
                  </div>
                  <div class="offer-frontrow__faces" aria-hidden="true">
                    {% render 'offer-img', image: s.frontrow_face_1, fallback: 'offer-frontrow-face-1.png', width: 44, height: 44, loading: 'lazy', alt: '' %}
                    {% render 'offer-img', image: s.frontrow_face_2, fallback: 'offer-frontrow-face-2.png', width: 44, height: 44, loading: 'lazy', alt: '' %}
                    {% render 'offer-img', image: s.frontrow_face_3, fallback: 'offer-frontrow-face-3.png', width: 44, height: 44, loading: 'lazy', alt: '' %}
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>

          <div class="offer-thumbs" role="list" {% if grp_gallery %}{{ grp_gallery.shopify_attributes }}{% endif %}>
            {%- if grp_gallery -%}
              {% render 'offer-group-slots', group: grp_gallery, mode: 'gallery' %}
            {%- else -%}
              {%- assign gallery_blocks = section.blocks | where: 'type', 'gallery_image' -%}
              {%- if gallery_blocks.size > 0 -%}
                {%- for block in gallery_blocks -%}
                  {%- if block.settings.image != blank -%}
                    {%- assign thumb_src = block.settings.image | image_url: width: 240 -%}
                  {%- elsif block.settings.fallback_asset != blank -%}
                    {%- assign thumb_src = block.settings.fallback_asset | asset_url -%}
                  {%- else -%}
                    {%- continue -%}
                  {%- endif -%}
                  <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-offer-thumb data-index="{{ forloop.index0 }}" data-src="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ thumb_src }}{% endif %}" aria-label="Image {{ forloop.index }}" {{ block.shopify_attributes }}>
                    <img src="{{ thumb_src }}" alt="" width="60" height="60" loading="lazy">
                  </button>
                {%- endfor -%}
              {%- else -%}
                {%- assign galleries = 'offer-gallery-1.jpg,offer-gallery-2.jpg,offer-gallery-3.jpg,offer-gallery-4.jpg,offer-gallery-5.webp,offer-gallery-6.jpg,offer-gallery-7.jpg' | split: ',' -%}
                {%- for file in galleries -%}
                  <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-offer-thumb data-index="{{ forloop.index0 }}" data-src="{{ file | asset_url }}" aria-label="Image {{ forloop.index }}">
                    <img src="{{ file | asset_url }}" alt="" width="60" height="60" loading="lazy">
                  </button>
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="offer-hero__right">
        <a class="offer-stars" href="#REVIEW">
          {% render 'offer-img', image: s.stars_image, fallback: 'offer-stars-47.png', alt: '4.7 out of 5 stars', width: 141, height: 26, loading: 'eager' %}
          <span>{{ s.reviews_count_label | default: '(10,242 Reviews)' }}</span>
        </a>

        <h1 class="offer-title">{{ product.title }}</h1>

        <div class="offer-price-block" data-offer-price-block>
          <div class="offer-price-row">
            <span class="offer-price" data-offer-price>{{ current_variant.price | money }}</span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="offer-price-dash" data-offer-price-dash aria-hidden="true">–</span>
              <span class="offer-value" data-offer-value>{{ current_variant.compare_at_price | money }}</span>
            {%- else -%}
              <span class="offer-price-dash" data-offer-price-dash aria-hidden="true" hidden>–</span>
              <span class="offer-value" data-offer-value hidden></span>
            {%- endif -%}
          </div>
          <ul class="offer-sellpoints">
            <li>{{ s.selling_point_1 | default: 'Instant heel & arch support from first wear' }}</li>
            <li>{{ s.selling_point_2 | default: 'Boosts blood flow to help tissue recover' }}</li>
            <li>{{ s.selling_point_3 | default: 'Thin enough for any shoe, all day' }}</li>
          </ul>
          <p class="offer-regular">{{ s.regular_price_prefix | default: 'Regular price' }} {{ current_variant.compare_at_price | default: current_variant.price | money }} {{ s.regular_price_suffix | default: 'per pair' }}</p>
        </div>

        <div class="offer-perks" {% if grp_perks %}{{ grp_perks.shopify_attributes }}{% endif %}>
          {%- if grp_perks -%}
            {%- if grp_perks.settings.label_1 != blank or grp_perks.settings.fallback_1 != blank -%}
              <div class="offer-perk">{% render 'offer-img', image: grp_perks.settings.icon_1, fallback: grp_perks.settings.fallback_1, width: 30, height: 30, loading: 'lazy', alt: '' %} {{ grp_perks.settings.label_1 }}</div>
            {%- endif -%}
            {%- if grp_perks.settings.label_2 != blank or grp_perks.settings.fallback_2 != blank -%}
              <div class="offer-perk">{% render 'offer-img', image: grp_perks.settings.icon_2, fallback: grp_perks.settings.fallback_2, width: 30, height: 30, loading: 'lazy', alt: '' %} {{ grp_perks.settings.label_2 }}</div>
            {%- endif -%}
            {%- if grp_perks.settings.label_3 != blank or grp_perks.settings.fallback_3 != blank -%}
              <div class="offer-perk">{% render 'offer-img', image: grp_perks.settings.icon_3, fallback: grp_perks.settings.fallback_3, width: 30, height: 30, loading: 'lazy', alt: '' %} {{ grp_perks.settings.label_3 }}</div>
            {%- endif -%}
          {%- else -%}
            {%- assign perk_blocks = section.blocks | where: 'type', 'perk' -%}
            {%- if perk_blocks.size > 0 -%}
              {%- for block in perk_blocks -%}
                <div class="offer-perk" {{ block.shopify_attributes }}>
                  {% render 'offer-img', image: block.settings.icon, fallback: block.settings.fallback_asset, width: 30, height: 30, loading: 'lazy', alt: '' %}
                  {{ block.settings.label }}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="offer-perk">{% render 'offer-img', fallback: 'offer-icon-truck.png', width: 30, height: 30, alt: '' %} Free Shipping</div>
              <div class="offer-perk">{% render 'offer-img', fallback: 'offer-icon-shield.png', width: 30, height: 30, alt: '' %} 30-Days Guarantee</div>
              <div class="offer-perk">{% render 'offer-img', fallback: 'offer-icon-people.png', width: 30, height: 30, alt: '' %} 500k+ Customers</div>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div
          class="offer-bundles"
          id="OfferPackages"
          data-offer-bundles
          data-unit-price="{{ current_variant.price }}"
          data-compare-price="{{ current_variant.compare_at_price | default: current_variant.price }}"
          data-money-format="{{ shop.money_format | escape }}"
          data-value-suffix="{{ s.value_suffix | default: 'value' | escape }}"
          {% if size_option != blank %}data-has-sizes="true"{% endif %}
        >
          <div class="offer-bundles__head">
            <p class="offer-bundles__label">{{ s.bundles_label | default: 'Choose your package' }}</p>
            {%- if size_option != blank -%}
              <button type="button" class="offer-sizechart-link" data-offer-sizechart-open>{{ s.size_chart_link | default: 'Size chart' }}</button>
            {%- endif -%}
          </div>
          <div class="offer-bundles__list{% if s.packages_reversed %} offer-bundles__list--rev{% endif %}" role="radiogroup" aria-label="Package">
            <div class="offer-bundle{% unless s.packages_reversed %} is-active{% endunless %}">
              <label class="offer-bundle__pick">
                <input
                  type="radio"
                  name="offer_bundle"
                  value="buy1"
                  data-package="buy1"
                  data-paid="1"
                  data-free="0"
                  data-total="1"
                  data-qty="1"
                  data-sleeves="1"
                  data-discount-code=""
                  {% unless s.packages_reversed %}checked{% endunless %}
                >
                <span class="offer-bundle__radio" aria-hidden="true"></span>
                <span class="offer-bundle__body">
                  <span class="offer-bundle__content">
                    <span class="offer-bundle__title">{{ s.bundle_1_title | default: 'Buy 1' }}</span>
                    <span class="offer-bundle__meta-row">
                      <span class="offer-bundle__meta">{{ s.bundle_1_meta | default: '1 sleeve' }}</span>
                      {%- if s.bundle_1_badge != blank -%}<span class="offer-bundle__ship">{{ s.bundle_1_badge }}</span>{%- endif -%}
                    </span>
                  </span>
                  <span class="offer-bundle__price" data-bundle-price>{{ current_variant.price | money }}</span>
                </span>
              </label>
              {%- if size_option != blank -%}
                <div class="offer-bundle__sizes">
                  <div class="offer-bundle__sizes-head">
                    <div class="offer-bundle__sizes-rule"><span>{{ s.size_label | default: 'Size' }}</span></div>
                    <button type="button" class="offer-sizechart-link offer-sizechart-link--inline" data-offer-sizechart-open>{{ s.size_chart_link | default: 'Size chart' }}</button>
                  </div>
                  <div class="offer-bundle__size-pills" role="radiogroup" aria-label="Size">
                    {%- for value in size_option.values -%}
                      {%- assign size_variant = blank -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.option1 == value -%}
                          {%- assign size_variant = variant -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <button
                        type="button"
                        class="offer-size-pill{% if current_variant.option1 == value %} is-active{% endif %}"
                        data-offer-size="{{ value | escape }}"
                        data-variant-id="{{ size_variant.id }}"
                        {% if size_variant == blank or size_variant.available == false %}disabled{% endif %}
                      >{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
            <div class="offer-bundle offer-bundle--featured">
              <label class="offer-bundle__pick">
                <input
                  type="radio"
                  name="offer_bundle"
                  value="buy2get1"
                  data-package="buy2get1"
                  data-paid="2"
                  data-free="1"
                  data-total="3"
                  data-qty="2"
                  data-sleeves="3"
                  data-discount-code="{{ s.bundle_2_discount_code | default: 'FS21' | escape }}"
                >
                <span class="offer-bundle__radio" aria-hidden="true"></span>
                <span class="offer-bundle__body">
                  <span class="offer-bundle__content">
                    <span class="offer-bundle__title">{{ s.bundle_2_title | default: 'Buy 2 Get 1 FREE' }}</span>
                    <span class="offer-bundle__meta-row">
                      <span class="offer-bundle__meta">{{ s.bundle_2_meta | default: '3 sleeves' }}</span>
                      {%- if s.bundle_2_badge != blank -%}<span class="offer-bundle__ship">{{ s.bundle_2_badge }}</span>{%- endif -%}
                    </span>
                  </span>
                  <span class="offer-bundle__price" data-bundle-price>{{ current_variant.price | times: 2 | money }}</span>
                </span>
              </label>
              {%- if size_option != blank -%}
                <div class="offer-bundle__sizes">
                  <div class="offer-bundle__sizes-head">
                    <div class="offer-bundle__sizes-rule"><span>{{ s.size_label | default: 'Size' }}</span></div>
                    <button type="button" class="offer-sizechart-link offer-sizechart-link--inline" data-offer-sizechart-open>{{ s.size_chart_link | default: 'Size chart' }}</button>
                  </div>
                  <div class="offer-bundle__size-pills" role="radiogroup" aria-label="Size">
                    {%- for value in size_option.values -%}
                      {%- assign size_variant = blank -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.option1 == value -%}
                          {%- assign size_variant = variant -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <button
                        type="button"
                        class="offer-size-pill{% if current_variant.option1 == value %} is-active{% endif %}"
                        data-offer-size="{{ value | escape }}"
                        data-variant-id="{{ size_variant.id }}"
                        {% if size_variant == blank or size_variant.available == false %}disabled{% endif %}
                      >{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
            <div class="offer-bundle offer-bundle--value{% if s.packages_reversed %} is-active{% endif %}">
              <label class="offer-bundle__pick">
                <input
                  type="radio"
                  name="offer_bundle"
                  value="buy3get3"
                  data-package="buy3get3"
                  data-paid="3"
                  data-free="3"
                  data-total="6"
                  data-qty="3"
                  data-sleeves="6"
                  data-discount-code="{{ s.bundle_3_discount_code | default: 'FS33' | escape }}"
                  {% if s.packages_reversed %}checked{% endif %}
                >
                <span class="offer-bundle__radio" aria-hidden="true"></span>
                <span class="offer-bundle__body">
                  <span class="offer-bundle__content">
                    <span class="offer-bundle__title">{{ s.bundle_3_title | default: 'Buy 3 Get 3 FREE' }}</span>
                    <span class="offer-bundle__meta-row">
                      <span class="offer-bundle__meta">{{ s.bundle_3_meta | default: '6 sleeves' }}</span>
                      {%- if s.bundle_3_badge != blank -%}<span class="offer-bundle__ship offer-bundle__ship--free">{{ s.bundle_3_badge }}</span>{%- endif -%}
                    </span>
                  </span>
                  <span class="offer-bundle__price" data-bundle-price>{{ current_variant.price | times: 3 | money }}</span>
                </span>
              </label>
              {%- if size_option != blank -%}
                <div class="offer-bundle__sizes">
                  <div class="offer-bundle__sizes-head">
                    <div class="offer-bundle__sizes-rule"><span>{{ s.size_label | default: 'Size' }}</span></div>
                    <button type="button" class="offer-sizechart-link offer-sizechart-link--inline" data-offer-sizechart-open>{{ s.size_chart_link | default: 'Size chart' }}</button>
                  </div>
                  <div class="offer-bundle__size-pills" role="radiogroup" aria-label="Size">
                    {%- for value in size_option.values -%}
                      {%- assign size_variant = blank -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.option1 == value -%}
                          {%- assign size_variant = variant -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      <button
                        type="button"
                        class="offer-size-pill{% if current_variant.option1 == value %} is-active{% endif %}"
                        data-offer-size="{{ value | escape }}"
                        data-variant-id="{{ size_variant.id }}"
                        {% if size_variant == blank or size_variant.available == false %}disabled{% endif %}
                      >{{ value }}</button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- if size_option != blank -%}
          <div class="offer-sizechart" data-offer-sizechart hidden>
            <div class="offer-sizechart__backdrop" data-offer-sizechart-close tabindex="-1"></div>
            <div class="offer-sizechart__dialog" role="dialog" aria-modal="true" aria-labelledby="OfferSizeChartTitle">
              <div class="offer-sizechart__head">
                <h2 id="OfferSizeChartTitle">{{ s.size_chart_title | default: 'Shoe Size Guide' }}</h2>
                <button type="button" class="offer-sizechart__close" data-offer-sizechart-close aria-label="Close">×</button>
              </div>
              <div class="offer-sizechart__body">
                {% render 'offer-img', image: s.size_guide_image, fallback: 'offer-size-guide.jpg', class: 'offer-sizechart__img', alt: 'Zavelyn Foot Sleeve size guide', width: 1260, height: 948, loading: 'lazy' %}
                <p class="offer-sizechart__note">{{ s.size_chart_note | default: "If the size you order doesn't fit perfectly, we offer easy exchanges within 30 days." }}</p>
              </div>
            </div>
          </div>
        {%- endif -%}

        {% form 'product', product, id: 'OfferAddForm', class: 'offer-buy-form' %}
          <input type="hidden" name="id" id="OfferVariantId" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" id="OfferQuantity" value="{{ cta_total_qty }}">
          <button class="offer-cta" type="submit" name="add" data-offer-checkout {% unless current_variant.available %}disabled{% endunless %}>
            <span class="offer-cta__label">{{ cta_label }}</span>
            <span class="offer-cta__sep" aria-hidden="true">—</span>
            <span class="offer-cta__price" data-offer-cta-price>{{ cta_price_cents | money_without_trailing_zeros }}</span>
          </button>
        {% endform %}

        <div class="offer-reserve" data-offer-reserve>
          <span class="offer-reserve__pulse" aria-hidden="true"></span>
          <p>
            {{ s.reserve_prefix | default: 'High demand — package reserved for' }}
            <strong data-offer-timer>10:00</strong>
            {% if current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 20 %}
              · {{ s.reserve_left_prefix | default: 'Only' }} <strong>{{ current_variant.inventory_quantity }}</strong> left
            {% else %}
              · {{ s.reserve_left_prefix | default: 'Only' }} <strong>{{ s.reserve_stock_fallback | default: '14' }}</strong> {{ s.reserve_left_suffix | default: 'left in stock' }}
            {% endif %}
          </p>
        </div>

        <div class="offer-ship" data-offer-ship>
          {% render 'offer-img', image: s.ship_icon, fallback: 'offer-icon-truck.png', width: 28, height: 28, alt: '' %}
          <div>
            <div><strong>{{ s.shipping_to_label | default: 'Shipping to' }}</strong> <span data-offer-ship-country>{{ localization.country.name | default: 'your country' }}</span></div>
            <div>{{ s.shipping_arrive | default: 'Your order will arrive in' }} <strong>{{ s.shipping_days | default: '7–15 Business Days' }}</strong></div>
          </div>
        </div>

        <div class="offer-sale">
          <span class="offer-sale__tag">{{ s.sale_tag | default: 'Recovery Sale' }}</span>
          <p class="offer-sale__title">{{ s.sale_title | default: 'BUY ONE GET ONE FREE' }}</p>
        </div>

        <div class="offer-faq" data-offer-accordion>
          {%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}
          {%- if faq_blocks.size > 0 -%}
            {%- for block in faq_blocks -%}
              <div class="offer-faq__item" {{ block.shopify_attributes }}>
                <button type="button" class="offer-faq__trigger" aria-expanded="false">{{ block.settings.title }}</button>
                <div class="offer-faq__panel">
                  {%- if block.settings.style == 'description' -%}
                    <div class="offer-faq__body">
                      <p>{{ s.description_intro }}</p>
                      <ul class="offer-faq__checks" {% if grp_checks %}{{ grp_checks.shopify_attributes }}{% endif %}>
                        {%- if grp_checks -%}
                          {%- if grp_checks.settings.check_1 != blank -%}<li>{% render 'offer-img', image: s.check_blue_icon, fallback: 'offer-check-blue.png', width: 22, height: 25, loading: 'lazy', alt: '' %}<span>{{ grp_checks.settings.check_1 }}</span></li>{%- endif -%}
