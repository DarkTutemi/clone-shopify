{% comment %}
  ZAVELYN IMMERSIVE COMMERCE THEME V4.0
  SECTION B: ENTER OUR STORES (REAL-WORLD RETAIL SHOWROOM ENTRANCES)
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}

<section class="zv-section-pad" id="zvStores" style="background: var(--zv-bg);">
  <div class="zv-container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 52px;">
      <span class="zv-badge zv-badge-forest" style="margin-bottom: 12px;">SHOP BY REAL-WORLD STORES</span>
      <h2 style="font-family: var(--zv-font-heading); font-size: 34px; font-weight: 800; color: var(--zv-heading); line-height: 1.2; margin: 0 0 14px;">
        Curated Retail Environments
      </h2>
      <p style="font-size: 16px; color: var(--zv-body); line-height: 1.6; margin: 0;">
        Explore our specialized product showrooms. Each department features realistic physical shelving, tailored environmental lighting, and instant product inspection.
      </p>
    </div>

    <!-- Store Entrances Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px;">

      <!-- STORE 1: HOME & LIVING -->
      <div class="zv-store-card" style="background: #FFFFFF; border: 1.5px solid var(--zv-border); border-radius: var(--zv-radius-xl); overflow: hidden; box-shadow: var(--zv-shadow-md); display: flex; flex-direction: column; transition: transform var(--zv-transition-base), box-shadow var(--zv-transition-base);">
        <div style="background: linear-gradient(135deg, #2D4A3E 0%, #17352B 100%); color: #FFFFFF; padding: 28px; position: relative;">
          <span class="zv-badge zv-badge-lime" style="margin-bottom: 12px;">DEPARTMENT 01</span>
          <h3 style="font-family: var(--zv-font-heading); font-size: 24px; font-weight: 800; color: #FFFFFF; margin: 0 0 8px;">Home &amp; Organization</h3>
          <p style="font-size: 14px; color: #D1DDD6; line-height: 1.5; margin: 0;">Foldable storage solutions, airtight food prep, and smart space-saving home organizers.</p>
        </div>
        <div style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
          <div style="font-size: 12px; font-weight: 800; letter-spacing: 0.8px; color: var(--zv-muted); text-transform: uppercase; margin-bottom: 12px;">Featured on the shelves:</div>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 24px;">
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-foldable-storage-bins-hero.jpg?v=1793290094" alt="Storage Bins" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/sakerplus_7a036ff3-6ab7-44b3-92ef-2c510ee821e7.png?v=1792790958" alt="Shelf Liner" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_e6a42e80-7283-4a2a-bfa3-f8e0a4f1ed17.jpg?v=1792791236" alt="Desk Organizer" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
          </div>
          <a href="/collections/home-improvement?view=showroom" class="zv-btn zv-btn-primary zv-btn-block" style="margin-top: auto;">
            <span>ENTER HOME SHOWROOM ➔</span>
          </a>
        </div>
      </div>

      <!-- STORE 2: POWER & TOOLS WORKSHOP -->
      <div class="zv-store-card" style="background: #FFFFFF; border: 1.5px solid var(--zv-border); border-radius: var(--zv-radius-xl); overflow: hidden; box-shadow: var(--zv-shadow-md); display: flex; flex-direction: column; transition: transform var(--zv-transition-base), box-shadow var(--zv-transition-base);">
        <div style="background: linear-gradient(135deg, #37474F 0%, #212121 100%); color: #FFFFFF; padding: 28px; position: relative;">
          <span class="zv-badge zv-badge-lime" style="margin-bottom: 12px;">DEPARTMENT 02</span>
          <h3 style="font-family: var(--zv-font-heading); font-size: 24px; font-weight: 800; color: #FFFFFF; margin: 0 0 8px;">Power &amp; Tools Workshop</h3>
          <p style="font-size: 14px; color: #CFD8DC; line-height: 1.5; margin: 0;">Rugged multi-tools, magnetic jobsite lighting, cordless tillers, and industrial gear.</p>
        </div>
        <div style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
          <div style="font-size: 12px; font-weight: 800; letter-spacing: 0.8px; color: var(--zv-muted); text-transform: uppercase; margin-bottom: 12px;">Featured on the shelves:</div>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 24px;">
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_ff6ff9ab-a7a7-444c-a984-6562dec0c726.png?v=1792791362" alt="Drywall Tool" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_4fa87677-3733-422d-87ba-0324c1ce93ec.png?v=1792791459" alt="Magnetic Light" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_41aa2303-ed98-45f3-90bb-0390ffb5fe8e.jpg?v=1792791252" alt="Thermal Camera" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
          </div>
          <a href="/collections/power-tools?view=showroom" class="zv-btn zv-btn-primary zv-btn-block" style="margin-top: auto;">
            <span>ENTER TOOLS WORKSHOP ➔</span>
          </a>
        </div>
      </div>

      <!-- STORE 3: WELLNESS & BOTANICALS -->
      <div class="zv-store-card" style="background: #FFFFFF; border: 1.5px solid var(--zv-border); border-radius: var(--zv-radius-xl); overflow: hidden; box-shadow: var(--zv-shadow-md); display: flex; flex-direction: column; transition: transform var(--zv-transition-base), box-shadow var(--zv-transition-base);">
        <div style="background: linear-gradient(135deg, #4A2E35 0%, #2A171D 100%); color: #FFFFFF; padding: 28px; position: relative;">
          <span class="zv-badge zv-badge-lime" style="margin-bottom: 12px;">DEPARTMENT 03</span>
          <h3 style="font-family: var(--zv-font-heading); font-size: 24px; font-weight: 800; color: #FFFFFF; margin: 0 0 8px;">Wellness &amp; Botanicals</h3>
          <p style="font-size: 14px; color: #E8D4DA; line-height: 1.5; margin: 0;">Organic wild-harvested Batana hair restoration, at-home dental care, and therapeutic wellness.</p>
        </div>
        <div style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
          <div style="font-size: 12px; font-weight: 800; letter-spacing: 0.8px; color: var(--zv-muted); text-transform: uppercase; margin-bottom: 12px;">Featured on the shelves:</div>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 24px;">
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-1.jpg?v=1793191361" alt="Batana Oil" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/sakerplus_30a2782e-1b0d-44a9-9b9b-9a4d87a72b65.jpg?v=1792791437" alt="Sauna Blanket" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/Sp_cb49fbea-fa77-4264-9834-d125cb176515.png?v=1792790912" alt="Sensory Mats" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
          </div>
          <a href="/collections/all-products?view=showroom" class="zv-btn zv-btn-primary zv-btn-block" style="margin-top: auto;">
            <span>ENTER WELLNESS BOUTIQUE ➔</span>
          </a>
        </div>
      </div>

      <!-- STORE 4: SOUND & MEDITATION -->
      <div class="zv-store-card" style="background: #FFFFFF; border: 1.5px solid var(--zv-border); border-radius: var(--zv-radius-xl); overflow: hidden; box-shadow: var(--zv-shadow-md); display: flex; flex-direction: column; transition: transform var(--zv-transition-base), box-shadow var(--zv-transition-base);">
        <div style="background: linear-gradient(135deg, #1A365D 0%, #0F172A 100%); color: #FFFFFF; padding: 28px; position: relative;">
          <span class="zv-badge zv-badge-lime" style="margin-bottom: 12px;">DEPARTMENT 04</span>
          <h3 style="font-family: var(--zv-font-heading); font-size: 24px; font-weight: 800; color: #FFFFFF; margin: 0 0 8px;">Acoustic &amp; Meditation</h3>
          <p style="font-size: 14px; color: #CBD5E1; line-height: 1.5; margin: 0;">Handcrafted steel tongue rain drums, galaxy ambient lighting, and serene sensory soundscapes.</p>
        </div>
        <div style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
          <div style="font-size: 12px; font-weight: 800; letter-spacing: 0.8px; color: var(--zv-muted); text-transform: uppercase; margin-bottom: 12px;">Featured on the shelves:</div>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 24px;">
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_719c1653-2f69-4a7b-bcb3-c45248ee7ef6.jpg?v=1792791376" alt="Star Projector" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_f3b09dc7-0aba-43f2-8b05-10072673a7a1.png?v=1792791328" alt="Smart Clock" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
            <div style="background: var(--zv-surface-muted); border-radius: var(--zv-radius-md); padding: 8px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
              <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/fmsakerplus.jpg?v=1792791077" alt="Squishy Light" style="max-height: 100%; max-width: 100%; object-fit: cover; border-radius: 6px;">
            </div>
          </div>
          <a href="/collections/all-products?view=showroom" class="zv-btn zv-btn-primary zv-btn-block" style="margin-top: auto;">
            <span>ENTER SOUND STUDIO ➔</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

