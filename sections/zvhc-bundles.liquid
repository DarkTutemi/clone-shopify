{% comment %}
  ZAVELYN HAIR CARE — T01 Curated Routine Bundles
{% endcomment %}
<section class="zvhc-editorial-section alt-bg" id="bundles">
  <div class="zvhc-container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 52px;">
      <div style="font-size: 0.78rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px;">CURATED ROUTINES</div>
      <h2 class="zvhc-h2">Complete Multi-Product Sets</h2>
      <p>Save up to 40% when pairing our targeted scalp therapies with styling essentials. Complete routines designed to work better together.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px;">
      <!-- Bundle 1 -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column; position: relative;">
        <span class="zvhc-tier-badge" style="top: -11px; right: 20px;">Save 33%</span>
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 4px;">Daily Edge Recovery</div>
        <h3 class="zvhc-h3" style="margin-bottom: 10px;">Scalp &amp; Edge Care Duo</h3>
        <p style="font-size: 0.9rem; margin-bottom: 18px;">Combines Pure Batana Scalp Oil (60ml) and Precision Hairline Shadow Compact (4g) for daily nourishment plus instant temple perfecting.</p>
        
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" alt="Batana Oil" style="width: 68px; height: 68px; object-fit: cover; border-radius: 10px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256808781854155-hero.jpg?v=1795264431" alt="Hairline Compact" style="width: 68px; height: 68px; object-fit: cover; border-radius: 10px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
        </div>

        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: auto; margin-bottom: 18px;">
          <span style="font-size: 1.5rem; font-weight: 800; color: var(--zvhc-t01-text-main, #2B1B24);">$49.99</span>
          <span style="font-size: 0.95rem; text-decoration: line-through; color: var(--zvhc-t01-text-subtle, #7A6670);">$74.98</span>
          <span class="zvhc-tier-pill">You Save $24.99</span>
        </div>
        <a href="/products/zvhc-batana-hair-growth-oil" class="zvhc-btn-primary">
          BUILD THIS DUO →
        </a>
      </div>

      <!-- Bundle 2 -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column; position: relative; border-color: var(--zvhc-t01-accent-rose, #B0476E); background: var(--zvhc-t01-card-sel-bg, #FDF2F6);">
        <span class="zvhc-tier-badge" style="top: -11px; right: 20px;">★ MOST POPULAR KIT</span>
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 4px;">Instant Fullness</div>
        <h3 class="zvhc-h3" style="margin-bottom: 10px;">Instant Density 3-Piece Kit</h3>
        <p style="font-size: 0.9rem; margin-bottom: 18px;">The ultimate cosmetic fullness kit: Keratin Building Fibers (100g) + Root-Lift Powder (10g) + Precision Hairline Shadow Compact (4g).</p>
        
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811885406846-hero.jpg?v=1795264423" alt="Keratin Fibers" style="width: 68px; height: 68px; object-fit: cover; border-radius: 10px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256810605010511-hero.jpg?v=1795264427" alt="Root Powder" style="width: 68px; height: 68px; object-fit: cover; border-radius: 10px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256808781854155-hero.jpg?v=1795264431" alt="Hairline Compact" style="width: 68px; height: 68px; object-fit: cover; border-radius: 10px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
        </div>

        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: auto; margin-bottom: 18px;">
          <span style="font-size: 1.5rem; font-weight: 800; color: var(--zvhc-t01-text-main, #2B1B24);">$69.99</span>
          <span style="font-size: 0.95rem; text-decoration: line-through; color: var(--zvhc-t01-text-subtle, #7A6670);">$94.97</span>
          <span class="zvhc-tier-pill">You Save $24.98</span>
        </div>
        <a href="/products/zvhc-keratin-hair-building-fibers" class="zvhc-btn-primary">
          GET THE DENSITY KIT →
        </a>
      </div>

      <!-- Bundle 3 -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column; position: relative;">
        <span class="zvhc-tier-badge" style="top: -11px; right: 20px;">Save 35%</span>
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 4px;">Total Hair Regimen</div>
        <h3 class="zvhc-h3" style="margin-bottom: 10px;">Wash-to-Style 4-Piece Routine</h3>
        <p style="font-size: 0.9rem; margin-bottom: 18px;">Complete botanical regimen: Scalp Balm (20g) + Batana Oil (60ml) + Curl Cream (100ml) + 7-in-1 Elixir (60ml).</p>
        
        <div style="display: flex; gap: 8px; margin-bottom: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807671072569-hero.jpg?v=1795264435" alt="Scalp Balm" style="width: 54px; height: 54px; object-fit: cover; border-radius: 8px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" alt="Batana Oil" style="width: 54px; height: 54px; object-fit: cover; border-radius: 8px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811372233630-hero.jpg?v=1795264440" alt="Curl Cream" style="width: 54px; height: 54px; object-fit: cover; border-radius: 8px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811903160451-hero.jpg?v=1795264444" alt="7-in-1 Elixir" style="width: 54px; height: 54px; object-fit: cover; border-radius: 8px; border: 1px solid var(--zvhc-t01-border, #EAD7DD);">
        </div>

        <div style="display: flex; align-items: baseline; gap: 8px; margin-top: auto; margin-bottom: 18px;">
          <span style="font-size: 1.5rem; font-weight: 800; color: var(--zvhc-t01-text-main, #2B1B24);">$89.99</span>
          <span style="font-size: 0.95rem; text-decoration: line-through; color: var(--zvhc-t01-text-subtle, #7A6670);">$134.96</span>
          <span class="zvhc-tier-pill">You Save $44.97</span>
        </div>
        <a href="/products/zvhc-botanical-curl-cream" class="zvhc-btn-primary">
          BUILD WASH ROUTINE →
        </a>
      </div>
    </div>
  </div>
</section>

