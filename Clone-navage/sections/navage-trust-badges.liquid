{% comment %}
  Clone-navage/sections/navage-trust-badges.liquid
  1:1 Full-Fidelity 5 Circular Trust Badges from navage.com
{% endcomment %}

<div id="SectionId-{{ section.id }}" class="navage-trust-bar">
  <div class="navage-trust-container">
    <div class="navage-trust-grid">
      <div class="navage-trust-item">
        <div class="navage-trust-icon-wrap">
          <img
            src="https://navage.com/cdn/shop/files/Badge-12.png?v=1776613787&width=200"
            alt="#1 Doctor Recommended"
            loading="lazy"
            class="navage-trust-icon-img"
          >
        </div>
        <div class="navage-trust-text">
          <h4 class="navage-trust-title">#1 Doctor Recommended¹</h4>
          <p class="navage-trust-desc">Trusted by healthcare professionals</p>
        </div>
      </div>

      <div class="navage-trust-item">
        <div class="navage-trust-icon-wrap">
          <img
            src="https://navage.com/cdn/shop/files/virus.png?v=1777045434&width=200"
            alt="99% Virus Removal"
            loading="lazy"
            class="navage-trust-icon-img"
          >
        </div>
        <div class="navage-trust-text">
          <h4 class="navage-trust-title">99% Virus Removal²</h4>
          <p class="navage-trust-desc">Flushes out allergens &amp; irritants</p>
        </div>
      </div>

      <div class="navage-trust-item">
        <div class="navage-trust-icon-wrap">
          <img
            src="https://navage.com/cdn/shop/files/9_out_of_10_d5aa18b3-0f6a-4e2b-8c97-ddaea92db78c.png?v=1785351912&width=200"
            alt="Naväge Outperforms Alternatives"
            loading="lazy"
            class="navage-trust-icon-img"
          >
        </div>
        <div class="navage-trust-text">
          <h4 class="navage-trust-title">Naväge Outperforms Alternatives.⁵</h4>
          <p class="navage-trust-desc">9 out of 10 users say</p>
        </div>
      </div>

      <div class="navage-trust-item">
        <div class="navage-trust-icon-wrap">
          <img
            src="https://navage.com/cdn/shop/files/Badge-11.png?v=1777318284&width=200"
            alt="100k+ 5-Star Reviews"
            loading="lazy"
            class="navage-trust-icon-img"
          >
        </div>
        <div class="navage-trust-text">
          <h4 class="navage-trust-title">100k+ 5-Star Reviews</h4>
          <p class="navage-trust-desc">Highly rated irrigation device</p>
        </div>
      </div>

      <div class="navage-trust-item">
        <div class="navage-trust-icon-wrap">
          <img
            src="https://navage.com/cdn/shop/files/HSA.png?v=1777044949&width=200"
            alt="HSA/FSA Approved"
            loading="lazy"
            class="navage-trust-icon-img"
          >
        </div>
        <div class="navage-trust-text">
          <h4 class="navage-trust-title">HSA/FSA Approved</h4>
          <p class="navage-trust-desc">Eligible for reimbursement</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #SectionId-{{ section.id }} {
    background-color: #0b4a82;
    padding: 22px 16px;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  #SectionId-{{ section.id }} .navage-trust-container {
    max-width: 1360px;
    margin: 0 auto;
  }

  #SectionId-{{ section.id }} .navage-trust-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    align-items: center;
  }

  #SectionId-{{ section.id }} .navage-trust-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #SectionId-{{ section.id }} .navage-trust-icon-wrap {
    flex-shrink: 0;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #SectionId-{{ section.id }} .navage-trust-icon-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #SectionId-{{ section.id }} .navage-trust-text {
    display: flex;
    flex-direction: column;
  }

  #SectionId-{{ section.id }} .navage-trust-title {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 2px 0;
    line-height: 1.25;
  }

  #SectionId-{{ section.id }} .navage-trust-desc {
    font-size: 12px;
    color: #cfe2f7;
    margin: 0;
    line-height: 1.2;
  }

  @media (max-width: 1100px) {
    #SectionId-{{ section.id }} .navage-trust-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
  }

  @media (max-width: 768px) {
    #SectionId-{{ section.id }} .navage-trust-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    #SectionId-{{ section.id }} .navage-trust-item {
      justify-content: flex-start;
    }
  }
</style>

{% schema %}
{
  "name": "Navage Trust Badges",
  "settings": []
}
{% endschema %}
