            "name_2": "Leo E.",
            "text_2": "There was a point where I stopped using my hand as much because it felt too difficult. This helped me get back into daily movement. It gave me a bit of confidence again.",
            "stars_2": 5,
            "verified_2": false,
            "image_url_2": "https:\/\/images.loox.io\/uploads\/2026\/3\/24\/l3byDeeWE.jpg"
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "name": "Julia T.",
            "text": "Good for keeping the hand active without overthinking it.",
            "stars": 4,
