{{ 'zhp-collection.css' | asset_url | stylesheet_tag }}

<div class="zhp-wrapper">
  <section class="zhp-benefits-section" id="why-zavelyn">
    <div class="zhp-container">
      <div class="zhp-sec-header">
        <span class="zhp-sec-tag">BUILT FOR LIFELONG HARMONY</span>
        <h2 class="zhp-sec-title">Why Choose Zavelyn Handpans?</h2>
        <p class="zhp-sec-subtitle">
          Designed for pure acoustic enjoyment, intuitive music-making, and lasting peace of mind.
        </p>
      </div>

      <div class="zhp-benefits-grid">
        <!-- Benefit 1: Instrument Quality -->
        <div class="zhp-benefit-card">
          <div class="zhp-benefit-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <h3 class="zhp-benefit-title">Artisanal Instrument Quality</h3>
          <p class="zhp-benefit-desc">
            Hand-hammered from certified nitrided steel and tempered titanium alloys. Laser-tuned acoustic tongues produce pure, bell-like sustain with stable pitch retention.
          </p>
        </div>

        <!-- Benefit 2: Ease of Playing -->
        <div class="zhp-benefit-card">
          <div class="zhp-benefit-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M10 15l5-3-5-3v6z"/></svg>
          </div>
          <h3 class="zhp-benefit-title">Zero Learning Curve</h3>
          <p class="zhp-benefit-desc">
            Permanent laser-numbered note markers pair directly with our illustrated songbook. Complete beginners can play harmonious, meditative melodies within 5 minutes.
          </p>
        </div>

        <!-- Benefit 3: Musical Expression -->
        <div class="zhp-benefit-card">
          <div class="zhp-benefit-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          </div>
          <h3 class="zhp-benefit-title">Rich Harmonic Expression</h3>
          <p class="zhp-benefit-desc">
            Mathematically tuned musical scales ensure every struck note blends in natural concord. Impossible to play a wrong or dissonant note, allowing effortless creative flow.
          </p>
        </div>

        <!-- Benefit 4: Included Accessories -->
        <div class="zhp-benefit-card">
          <div class="zhp-benefit-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <h3 class="zhp-benefit-title">All-Inclusive Starter Sets</h3>
          <p class="zhp-benefit-desc">
            No unexpected add-ons or hidden accessories to buy. Every drum arrives with custom protective bags, balanced bamboo mallets, tutorial guidebooks, and edge protection.
          </p>
        </div>
      </div>
    </div>
  </section>
</div>

