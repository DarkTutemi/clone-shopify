{% comment %}
  ZAVELYN HAIR CARE — Shop By Concern (Section 4)
{% endcomment %}
<section class="zvhc-concern-section" id="concerns" style="padding: 72px 0; background: var(--zvhc-ivory);">
  <div class="zvhc-container">
    <div class="zvhc-section-header" style="text-align: center; max-width: 640px; margin: 0 auto 48px;">
      <div class="zvhc-eyebrow" style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 8px;">TARGETED BOTANICAL SOLUTIONS</div>
      <h2 class="zvhc-heading-md" style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: clamp(2rem, 3.8vw, 2.8rem); font-weight: 900; letter-spacing: -0.02em; margin: 0 0 14px;">Shop by Hair Concern</h2>
      <p style="color: var(--zvhc-forest); font-size: 1.05rem; line-height: 1.5; opacity: 0.85;">Whether your goal is deep scalp therapy, moisture retention, or instant cosmetic fullness, our botanical rituals have you covered.</p>
    </div>

    <div class="zvhc-concern-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;">
      <!-- Concern 1: Dry Hair & Conditioning -->
      <a href="/collections/zvhc-batana" class="zvhc-concern-card" style="display: flex; flex-direction: column; background: #FFFFFF; border-radius: 20px; padding: 24px; text-decoration: none; border: 2px solid rgba(1,93,71,0.08); transition: transform 0.2s ease, box-shadow 0.2s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.04);">
        <div class="zvhc-concern-img" style="border-radius: 14px; overflow: hidden; margin-bottom: 18px; aspect-ratio: 1/1; background: #FAF7F2;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" alt="Dry Hair & Conditioning" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
        <div class="zvhc-concern-tag" style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px;">Concern 01</div>
        <div class="zvhc-concern-title" style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: 1.25rem; font-weight: 800; margin-bottom: 8px;">Dry Hair & Conditioning</div>
        <div class="zvhc-concern-desc" style="color: #555; font-size: 0.9rem; line-height: 1.45; margin-bottom: 16px; flex-grow: 1;">Restore dry, brittle strands with pure unrefined Batana oil that locks in deep cellular moisture.</div>
        <div class="zvhc-concern-link" style="color: var(--zvhc-green); font-weight: 800; font-size: 0.9rem; display: flex; align-items: center; gap: 6px;">Explore Collection &rarr;</div>
      </a>

      <!-- Concern 2: Curl Definition -->
      <a href="/collections/zvhc-curl" class="zvhc-concern-card" style="display: flex; flex-direction: column; background: #FFFFFF; border-radius: 20px; padding: 24px; text-decoration: none; border: 2px solid rgba(1,93,71,0.08); transition: transform 0.2s ease, box-shadow 0.2s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.04);">
        <div class="zvhc-concern-img" style="border-radius: 14px; overflow: hidden; margin-bottom: 18px; aspect-ratio: 1/1; background: #FAF7F2;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811372233630-hero.jpg?v=1795264440" alt="Curl Definition & Frizz Shield" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
        <div class="zvhc-concern-tag" style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px;">Concern 02</div>
        <div class="zvhc-concern-title" style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: 1.25rem; font-weight: 800; margin-bottom: 8px;">Curl Definition & Anti-Frizz</div>
        <div class="zvhc-concern-desc" style="color: #555; font-size: 0.9rem; line-height: 1.45; margin-bottom: 16px; flex-grow: 1;">Enhance natural curl patterns, eliminate frizz, and provide flexible touchable hold with plant-based styling polymers.</div>
        <div class="zvhc-concern-link" style="color: var(--zvhc-green); font-weight: 800; font-size: 0.9rem; display: flex; align-items: center; gap: 6px;">Explore Collection &rarr;</div>
      </a>

      <!-- Concern 3: Scalp & Edge Care -->
      <a href="/collections/zvhc-scalp" class="zvhc-concern-card" style="display: flex; flex-direction: column; background: #FFFFFF; border-radius: 20px; padding: 24px; text-decoration: none; border: 2px solid rgba(1,93,71,0.08); transition: transform 0.2s ease, box-shadow 0.2s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.04);">
        <div class="zvhc-concern-img" style="border-radius: 14px; overflow: hidden; margin-bottom: 18px; aspect-ratio: 1/1; background: #FAF7F2;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807671072569-hero.jpg?v=1795264435" alt="Scalp & Edge Care" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
        <div class="zvhc-concern-tag" style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px;">Concern 03</div>
        <div class="zvhc-concern-title" style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: 1.25rem; font-weight: 800; margin-bottom: 8px;">Scalp & Edge Therapy</div>
        <div class="zvhc-concern-desc" style="color: #555; font-size: 0.9rem; line-height: 1.45; margin-bottom: 16px; flex-grow: 1;">Target sensitive scalps, strengthen fragile edges, and calm tension with solid Batana balm & 7-in-1 multi-oil elixir.</div>
        <div class="zvhc-concern-link" style="color: var(--zvhc-green); font-weight: 800; font-size: 0.9rem; display: flex; align-items: center; gap: 6px;">Explore Collection &rarr;</div>
      </a>

      <!-- Concern 4: Instant Hair Coverage -->
      <a href="/collections/zvhc-coverage" class="zvhc-concern-card" style="display: flex; flex-direction: column; background: #FFFFFF; border-radius: 20px; padding: 24px; text-decoration: none; border: 2px solid rgba(1,93,71,0.08); transition: transform 0.2s ease, box-shadow 0.2s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.04);">
        <div class="zvhc-concern-img" style="border-radius: 14px; overflow: hidden; margin-bottom: 18px; aspect-ratio: 1/1; background: #FAF7F2;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811885406846-hero.jpg?v=1795264423" alt="Instant Hair Coverage" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
        <div class="zvhc-concern-tag" style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 6px;">Concern 04</div>
        <div class="zvhc-concern-title" style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: 1.25rem; font-weight: 800; margin-bottom: 8px;">Instant Hair Coverage</div>
        <div class="zvhc-concern-desc" style="color: #555; font-size: 0.9rem; line-height: 1.45; margin-bottom: 16px; flex-grow: 1;">Instantly conceal visible scalp, widen part lines, and thinning temples with natural electrostatic keratin fibers & shadow compact.</div>
        <div class="zvhc-concern-link" style="color: var(--zvhc-green); font-weight: 800; font-size: 0.9rem; display: flex; align-items: center; gap: 6px;">Explore Collection &rarr;</div>
      </a>
    </div>
  </div>
</section>

