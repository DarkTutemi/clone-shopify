{% render 'breadcrumbs' %}

<section class="section" id="ProductSection-{{ section.id }}">
  <div class="page-width">
    <div class="product">
      <div class="product__media">
        {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
        <div class="product__media-main" data-product-media-main>
          {%- if featured_media -%}
            {{
              featured_media
              | image_url: width: 1600
              | image_tag:
                widths: '550, 750, 1100, 1400, 1600',
                sizes: '(min-width: 900px) 50vw, 100vw',
                loading: 'eager',
                fetchpriority: 'high',
                alt: featured_media.alt | default: product.title | escape
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__thumbs" role="list" aria-label="{{ 'products.product.media.gallery' | t }}">
            {%- for media in product.media -%}
              <button
                type="button"
                class="product__thumb{% if media.id == featured_media.id %} is-active{% endif %}"
                data-product-thumb
                data-media-id="{{ media.id }}"
                data-media-src="{{ media | image_url: width: 1600 }}"
                data-media-srcset="{{ media | image_url: width: 550 }} 550w, {{ media | image_url: width: 750 }} 750w, {{ media | image_url: width: 1100 }} 1100w, {{ media | image_url: width: 1600 }} 1600w"
                data-media-alt="{{ media.alt | default: product.title | escape }}"
                aria-pressed="{% if media.id == featured_media.id %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.media.load_image' | t: index: forloop.index, total: product.media.size }}"
              >
                {{
                  media
                  | image_url: width: 200
                  | image_tag:
                    widths: '100, 150, 200',
                    sizes: '72px',
                    loading: 'lazy',
                    alt: media.alt | default: product.title | escape
                }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <p class="product-card__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product__title">{{ product.title }}</h1>

        <div class="product__price" data-product-price-wrapper>
          {% render 'price', product: product, use_variant: true, data_price: true %}
        </div>

        {%- if section.settings.show_tax_note -%}
          {%- if cart.taxes_included -%}
            <p class="cart-drawer__note">{{ 'products.product.include_taxes' | t }}</p>
          {%- endif -%}
        {%- endif -%}

        {% render 'product-form', product: product, section: section %}

        {%- if product.description != blank -%}
          <div class="product__description rte">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.show_sku -%}
          <p data-product-sku class="cart-drawer__note" {% if product.selected_or_first_available_variant.sku == blank %}hidden{% endif %}>
            SKU: {{ product.selected_or_first_available_variant.sku }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKU",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_tax_note",
      "label": "Show tax note",
      "default": true
    }
  ]
}
{% endschema %}
