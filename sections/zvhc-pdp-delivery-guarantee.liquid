{% comment %}
  ZAVELYN HAIR CARE — Doorstep Delivery Guarantee & Real-Time Tracking
  Shown at the bottom of the BotanaRoots PDP before footer.
  Decoupled per-SKU — only renders for zavelyn-botanaroots-organic-batana-hair-growth-oil.
{% endcomment %}

{% if product.handle == 'zavelyn-botanaroots-organic-batana-hair-growth-oil' or product.handle contains 'zvhc-' %}

<section id="delivery-guarantee" style="padding: 72px 0; background: #FAF7F2; border-top: 1px solid #EAD7DD;">
  <div class="zvhc-container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; max-width: 1120px; margin: 0 auto;">

      <!-- Left: Stacked image duo -->
      <div style="display: grid; grid-template-rows: 1fr 1fr; gap: 16px; height: 480px;">
        <!-- FedEx / carrier delivery photo -->
        <div style="border-radius: 16px; overflow: hidden; background: #E8E4E0; position: relative;">
          <img
            src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/5555.webp?v=1792856415"
            alt="Fast FedEx tracked delivery for Zavelyn orders"
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
            loading="lazy"
            onerror="this.parentElement.style.background='linear-gradient(135deg,#2B1B24 0%,#5A3A48 100%)'; this.style.display='none'; this.parentElement.innerHTML += '<div style=\'display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#fff;padding:24px;text-align:center;\'><div style=\'font-size:3rem;margin-bottom:12px;\'>🚚</div><div style=\'font-size:1rem;font-weight:700;\'>#1 BATANA OIL IN U.S.A.</div><div style=\'font-size:0.82rem;margin-top:8px;opacity:0.8;\'>Ships via FedEx · USPS · DHL Express</div></div>\';"
          >
        </div>
        <!-- Globe / worldwide express delivery illustration -->
        <div style="border-radius: 16px; overflow: hidden; background: #E8E4E0; position: relative;">
          <img
            src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/44444.webp?v=1792856415"
            alt="Express global delivery network"
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
            loading="lazy"
            onerror="this.parentElement.style.background='linear-gradient(135deg,#1B3A5C 0%,#2E6DA4 100%)'; this.style.display='none'; this.parentElement.innerHTML += '<div style=\'display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;color:#fff;padding:24px;text-align:center;\'><div style=\'font-size:3rem;margin-bottom:12px;\'>🌍</div><div style=\'font-size:1rem;font-weight:700;\'>EXPRESS DELIVERY</div><div style=\'font-size:0.82rem;margin-top:8px;opacity:0.8;\'>Dispatched from US regional warehouses within 24–48h</div></div>\' + \'\';"
          >
        </div>
      </div>

      <!-- Right: Content -->
      <div style="display: flex; flex-direction: column; gap: 24px;">

        <!-- Eyebrow pill -->
        <div style="display: inline-flex; align-items: center; gap: 8px; background: #E6F4EA; color: #2E7D32; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; padding: 6px 16px; border-radius: 9999px; text-transform: uppercase; width: fit-content;">
          🚚 FAST &amp; INSURED TRACKED US DELIVERY
        </div>

        <!-- Heading -->
        <h2 class="zvhc-h2" style="font-size: clamp(1.6rem, 2.8vw, 2.2rem); line-height: 1.2; color: #2B1B24; margin: 0;">
          Doorstep Delivery Guarantee<br>&amp; Real-Time Tracking
        </h2>

        <!-- Description -->
        <p style="font-size: 0.95rem; color: #5A4651; line-height: 1.65; margin: 0; max-width: 480px;">
          Every Zavelyn order is cushioned in heavy-duty protective packaging, inspected for quality, and dispatched from regional US warehouses within 24–48 business hours. We partner directly with USPS, FedEx, and DHL Express to guarantee rapid, dependable doorstep transit.
        </p>

        <!-- 2×2 Feature cards -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">

          <!-- Card 1: 24–48h Dispatch -->
          <div style="background: #FFFFFF; border: 1px solid #EAD7DD; border-radius: 12px; padding: 20px 18px; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 2px 10px rgba(43,27,36,0.04);">
            <div style="font-size: 1.4rem;">⏱</div>
            <div style="font-weight: 700; font-size: 0.92rem; color: #2B1B24;">24–48h Dispatch</div>
            <div style="font-size: 0.82rem; color: #5A4651; line-height: 1.5;">Rapid order processing from regional US fulfillment hubs.</div>
          </div>

          <!-- Card 2: Insured Transit -->
          <div style="background: #FFFFFF; border: 1px solid #EAD7DD; border-radius: 12px; padding: 20px 18px; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 2px 10px rgba(43,27,36,0.04);">
            <div style="font-size: 1.4rem;">📦</div>
            <div style="font-weight: 700; font-size: 0.92rem; color: #2B1B24;">Insured Transit</div>
            <div style="font-size: 0.82rem; color: #5A4651; line-height: 1.5;">Full protection against lost, stolen, or damaged parcels.</div>
          </div>

          <!-- Card 3: Tracking Updates -->
          <div style="background: #FFFFFF; border: 1px solid #EAD7DD; border-radius: 12px; padding: 20px 18px; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 2px 10px rgba(43,27,36,0.04);">
            <div style="font-size: 1.4rem;">🔍</div>
            <div style="font-weight: 700; font-size: 0.92rem; color: #2B1B24;">Tracking Updates</div>
            <div style="font-size: 0.82rem; color: #5A4651; line-height: 1.5;">Instant carrier tracking notifications via SMS and email.</div>
          </div>

          <!-- Card 4: Money-Back Guarantee -->
          <div style="background: #FFFFFF; border: 1px solid #EAD7DD; border-radius: 12px; padding: 20px 18px; display: flex; flex-direction: column; gap: 8px; box-shadow: 0 2px 10px rgba(43,27,36,0.04);">
            <div style="font-size: 1.4rem;">💰</div>
            <div style="font-weight: 700; font-size: 0.92rem; color: #2B1B24;">Money-Back Guarantee</div>
            <div style="font-size: 0.82rem; color: #5A4651; line-height: 1.5;">Standard 30-day return policy for peace of mind.</div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Mobile responsive styles -->
  <style>
    @media (max-width: 767px) {
      #delivery-guarantee .zvhc-container > div {
        grid-template-columns: 1fr !important;
      }
      #delivery-guarantee .zvhc-container > div > div:first-child {
        height: 320px !important;
      }
    }
    @media (max-width: 480px) {
      #delivery-guarantee .zvhc-container > div > div:last-child > div:last-child {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
</section>

{% endif %}

{% schema %}
{
  "name": "ZVHC Delivery Guarantee",
  "settings": []
}
{% endschema %}
