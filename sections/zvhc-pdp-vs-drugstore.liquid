              <span style="color: #F3C4D3;">✦ {{ vs_brand_title }}</span>
              <div style="font-size: 0.72rem; font-weight: 600; color: #D5C2C9; text-transform: none; margin-top: 4px;">{{ vs_brand_sub }}</div>
            </th>
            <th style="padding: 20px 24px; background: #FAF7F2; color: #7A6871; font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; width: 36%; border-bottom: 2px solid #EAD7DD; text-align: center;">
