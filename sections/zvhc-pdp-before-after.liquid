<section class="zvhc-editorial-section zvhc-before-after-section" id="results-timeline" style="padding: 72px 0; background: #FAF7F2; border-top: 1px solid var(--zvhc-t01-border, #EAD7DD); border-bottom: 1px solid var(--zvhc-t01-border, #EAD7DD);">
  <div class="zvhc-container">
    
    <!-- Section Header -->
    <div style="text-align: center; max-width: 760px; margin: 0 auto 52px;">
      <div style="display: inline-flex; align-items: center; gap: 8px; background: #F8E4EB; color: #B0476E; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.1em; padding: 6px 16px; border-radius: 9999px; text-transform: uppercase; margin-bottom: 16px;">
        <span>{{ ba_eyebrow }}</span>
      </div>
      <h2 class="zvhc-h2" style="font-size: clamp(1.8rem, 3.2vw, 2.5rem); line-height: 1.2; margin-bottom: 16px; color: #2B1B24;">
        {{ ba_title }}
      </h2>
      <p style="color: #5A4651; font-size: 1.02rem; line-height: 1.6; max-width: 640px; margin: 0 auto;">
        {{ ba_subtitle }}
      </p>
    </div>

    <!-- 3-Phase Progression Timeline Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; margin-bottom: 48px;">
      
      <!-- Phase 1 -->
      <div style="background: #FFFFFF; border: 1px solid #EAD7DD; border-radius: 16px; padding: 32px 24px; display: flex; flex-direction: column; position: relative; box-shadow: 0 4px 20px rgba(43, 27, 36, 0.04);">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
          <span style="font-size: 0.75rem; font-weight: 800; color: #B0476E; letter-spacing: 0.08em; text-transform: uppercase; background: #FDF2F6; padding: 4px 12px; border-radius: 6px;">{{ ba_p1_badge }}</span>
          <span style="font-size: 0.85rem; font-weight: 800; color: #2B1B24;">{{ ba_p1_time }}</span>
        </div>
        <div style="font-size: 1.25rem; font-weight: 800; color: #2B1B24; margin-bottom: 12px;">
          {{ ba_p1_title }}
        </div>
        <p style="font-size: 0.92rem; color: #5A4651; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
          {{ ba_p1_desc }}
        </p>
        <div style="background: #FAF7F2; border-radius: 10px; padding: 14px 16px; border-left: 3px solid #B0476E;">
          <div style="font-size: 0.8rem; font-weight: 700; color: #2B1B24; margin-bottom: 2px;">Key Milestone:</div>
          <div style="font-size: 0.85rem; color: #5A4651;">{{ ba_p1_milestone }}</div>
        </div>
      </div>

