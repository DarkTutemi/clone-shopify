        <div class="zv-card-body">
          <h3 class="zv-card-title">Zavelyn LED Red Light Face Mask</h3>
          <p class="zv-card-desc">Full-face photon therapy delivering 630nm red wavelengths for radiant skin texture, clarity, and daily facial rejuvenation.</p>

          <div class="zv-stock-status-pill">In Stock • Ships in Same Discreet Package</div>

          <div class="zv-card-price-row">
            <span class="zv-card-price-current">$129.99</span>
            <s class="zv-card-price-compare">$199.99</s>
            <span class="zv-card-save-pill">SAVE $70.00 (35% OFF)</span>
          </div>

          <div class="zv-card-action-row">
            <div class="zv-card-action-left">
              <label class="zv-card-checkbox-label">
                <span class="zv-custom-check" id="checkFace">✓</span>
                <span id="labelAddFace">Add to My Order</span>
              </label>

              <!-- In-Card Quantity Stepper -->
              <div class="zv-card-qty-stepper" id="cardQtyFace" onclick="event.stopPropagation();">
                <button type="button" class="zv-card-qty-btn" onclick="changeAddonQty('faceMask', -1); event.stopPropagation();" aria-label="Decrease quantity">−</button>
                <span class="zv-card-qty-num" id="displayCardQtyFace">1</span>
                <button type="button" class="zv-card-qty-btn" onclick="changeAddonQty('faceMask', 1); event.stopPropagation();" aria-label="Increase quantity">+</button>
              </div>
            </div>

            <button type="button" class="zv-link-details" onclick="openVfitModal('faceMask'); event.stopPropagation();">View Details</button>
          </div>
        </div>
      </article>

    </div>

    <!-- Dynamic Order Summary Card -->
    <div class="zv-package-summary-card" id="zvOrderSummaryCard">
      <div class="zv-summary-header">
        <h3 class="zv-summary-title">YOUR SELF-CARE PACKAGE</h3>
        <span class="zv-summary-badge-tier" id="zvSummaryTierBadge">CORE INTIMATE WELLNESS</span>
      </div>

      <div class="zv-summary-list">
        <!-- Item 1: vFit Base Device (with Quantity Stepper) -->
        <div class="zv-summary-item base">
          <div class="zv-summary-item-left">
            <span class="zv-item-dot"></span>
            <span class="zv-item-name" id="zvSummaryVfitName">Zavelyn vFit™ Red Light Device</span>
            <span class="zv-item-tag">MAIN DEVICE</span>
          </div>
          <div class="zv-summary-item-right">
            <div class="zv-mini-qty-stepper">
              <button type="button" class="zv-mini-qty-btn" onclick="changeVfitQty(-1);" aria-label="Decrease vFit quantity">−</button>
              <span class="zv-mini-qty-num" id="zvSummaryVfitQty">1</span>
              <button type="button" class="zv-mini-qty-btn" onclick="changeVfitQty(1);" aria-label="Increase vFit quantity">+</button>
            </div>
            <span class="zv-item-price" id="zvSummaryVfitPrice">$149.99</span>
          </div>
