    btn.addEventListener('click', function () {
      if (mainImg) mainImg.src = btn.getAttribute('data-full');
      root.querySelectorAll('[data-gal-thumb]').forEach(function (b) {
        b.setAttribute('aria-current', b === btn ? 'true' : 'false');
      });
    });
  });

  /* ── accordions ── */
  root.querySelectorAll('.sup-acc-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var item = btn.closest('.sup-acc-item');
      var panel = item.querySelector('.sup-acc-panel');
      var open = item.getAttribute('data-open') === 'true';
      item.setAttribute('data-open', open ? 'false' : 'true');
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      panel.style.maxHeight = open ? '0px' : panel.scrollHeight + 'px';
    });
  });

  /* ── hero price ── */
  function paintPrice(variant) {
    var price = document.getElementById('sup-price');
    var was = document.getElementById('sup-was');
    var save = document.getElementById('sup-save');
    var sticky = document.getElementById('sup-sticky-price');
    if (price) price.textContent = variant.priceStr;
    if (sticky) sticky.textContent = variant.priceStr;
    var hasCompare = variant.compare > variant.price;
    if (was) { was.textContent = variant.compareStr; was.hidden = !hasCompare; }
    if (save) {
      save.hidden = !hasCompare;
      if (hasCompare) {
        save.textContent = 'Save ' + Math.round((variant.compare - variant.price) / variant.compare * 100) + '%';
      }
    }
  }

  /* ── VIDEO CAROUSEL (infinite scroll) ── */
  var videoTrack = document.getElementById('yh-vids-track');
  if (videoTrack) {
    var originalSlides = Array.prototype.slice.call(videoTrack.children);
    var N = originalSlides.length;

    if (N > 0) {
      /* Clone the set once before and once after so user can scroll either direction without hitting an end */
      var cloneBefore = originalSlides.map(function(s) {
        var c = s.cloneNode(true);
        c.setAttribute('data-cloned', 'before');
        return c;
      });
      var cloneAfter = originalSlides.map(function(s) {
        var c = s.cloneNode(true);
        c.setAttribute('data-cloned', 'after');
        return c;
      });
      /* Prepend "before" clones in their original order so visual order is preserved */
      for (var i = cloneBefore.length - 1; i >= 0; i--) {
        videoTrack.insertBefore(cloneBefore[i], videoTrack.firstChild);
      }
      cloneAfter.forEach(function(c) { videoTrack.appendChild(c); });

      function getSetWidth() {
        var slide = videoTrack.firstElementChild;
        if (!slide) return 0;
        var styles = window.getComputedStyle(videoTrack);
        var gap = parseFloat(styles.columnGap || styles.gap) || 0;
        return (slide.offsetWidth + gap) * N;
      }

      function centerScroll() {
        videoTrack.style.scrollBehavior = 'auto';
        videoTrack.scrollLeft = getSetWidth();
        /* force reflow then restore */
        void videoTrack.offsetWidth;
        videoTrack.style.scrollBehavior = '';
      }

      requestAnimationFrame(centerScroll);
      window.addEventListener('load', centerScroll);

      var warping = false;
      videoTrack.addEventListener('scroll', function() {
        if (warping) return;
        var setW = getSetWidth();
        if (setW <= 0) return;
        var pos = videoTrack.scrollLeft;
        if (pos >= setW * 2) {
          warping = true;
          videoTrack.style.scrollBehavior = 'auto';
          videoTrack.scrollLeft = pos - setW;
          requestAnimationFrame(function() {
            videoTrack.style.scrollBehavior = '';
            warping = false;
          });
        } else if (pos <= 0) {
          warping = true;
          videoTrack.style.scrollBehavior = 'auto';
          videoTrack.scrollLeft = pos + setW;
          requestAnimationFrame(function() {
            videoTrack.style.scrollBehavior = '';
            warping = false;
          });
        }
      });
    }

    /* Event delegation — works on originals AND clones */
    videoTrack.addEventListener('click', function(e) {
      var slide = e.target.closest('.yh-vid-slide');
      if (!slide) return;
      var video = slide.querySelector('video');
      if (!video) return;

      if (e.target.closest('.yh-vid-sound')) {
        e.stopPropagation();
        video.muted = !video.muted;
        var btn = slide.querySelector('.yh-vid-sound');
        btn.setAttribute('data-muted', video.muted ? 'true' : 'false');
        var mi = slide.querySelector('.yh-vid-sound-muted');
        var oi = slide.querySelector('.yh-vid-sound-on');
        if (mi) mi.style.display = video.muted ? '' : 'none';
        if (oi) oi.style.display = video.muted ? 'none' : '';
        return;
      }

      if (video.paused) {
        videoTrack.querySelectorAll('video').forEach(function(v) {
          if (v !== video && !v.paused) v.pause();
        });
        var p = video.play();
        if (p && typeof p.then === 'function') p.catch(function() {});
      } else {
        video.pause();
      }
    });

    /* Attach state listeners (play/pause class) to every video, including clones */
    videoTrack.querySelectorAll('.yh-vid-slide video').forEach(function(video) {
      var slide = video.closest('.yh-vid-slide');
      video.addEventListener('play', function() { slide.classList.add('playing'); });
      video.addEventListener('pause', function() { slide.classList.remove('playing'); });
    });
  }


  /* ── FREE GIFTS ──
     Driven by the selected tier's data-unlocks flag, NOT by the variant title.
     The live section parses the title and broke once when "2 Handles" was
     renamed "Buy 2 Get 1 Free". Keep it on the flag. */
  var giftsBox = document.getElementById('yh-gifts');
  var giftsFoot = document.getElementById('yh-gifts-foot');
  var footLocked = "";
  var footUnlocked = "";

  function paintGifts(unlocked) {
    if (!giftsBox) return;
    giftsBox.classList.toggle('is-unlocked', unlocked);
    giftsBox.querySelectorAll('[data-gift-lock]').forEach(function (el) {
      el.style.display = unlocked ? 'none' : '';
    });
    giftsBox.querySelectorAll('[data-gift-name] [data-gift-flag]').forEach(function (el) {
      el.textContent = unlocked ? 'Free' : 'Locked';
      el.classList.toggle('is-locked', !unlocked);
    });
    if (giftsFoot) {
      var ft = unlocked ? footUnlocked : footLocked;
      giftsFoot.textContent = ft;
      giftsFoot.style.display = ft ? '' : 'none';
    }
  }

  /* ── tier ladder ── */
  function paintTiers() {
    root.querySelectorAll('[data-tier]').forEach(function (btn) {
      var pack = btn.getAttribute('data-pack');
      var units = parseInt(btn.getAttribute('data-units'), 10) || 1;
      var variant = findVariant(pack, state.color);
      var now = btn.querySelector('[data-tier-now]');
      var wasEl = btn.querySelector('[data-tier-was]');
      var perEl = btn.querySelector('[data-tier-per]');
      if (now) now.textContent = variant.priceStr;
      if (wasEl) {
        var hasCompare = variant.compare > variant.price;
        wasEl.textContent = variant.compareStr;
        wasEl.style.display = hasCompare ? '' : 'none';
      }
      if (perEl && units > 1) perEl.textContent = money(Math.round(variant.price / units)) + ' each';

      var on = pack === state.pack;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      if (on) paintGifts(btn.getAttribute('data-unlocks') === 'true');
    });
  }

  /* A ?variant= link to a sold-out size would otherwise load with it selected. */
  (function () {
    var cur = findVariant(state.pack, state.color);
    if (cur && cur.available) return;
    for (var i = 0; i < variants.length; i++) {
      if (variants[i].available) { state.pack = variants[i].pack; state.color = variants[i].color; return; }
    }
  })();

  var userPicked = false;   /* stays false through the initial commit() on load */
  function commit() {
    var variant = findVariant(state.pack, state.color);
    document.getElementById('sup-variant-id').value = variant.id;
    paintPrice(variant);
    paintTiers();
    if (userPicked && variant.image && mainImg && mainImg.src !== variant.image) {
      mainImg.src = variant.image;
    }
  }

  root.querySelectorAll('[data-tier]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (btn.hasAttribute('data-soldout')) return;
      state.pack = btn.getAttribute('data-pack');
      userPicked = true;
      commit();
    });
  });

  var colorCurrent = document.getElementById('yh-color-current');
  root.querySelectorAll('[data-color]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      state.color = btn.getAttribute('data-color');
      userPicked = true;
      root.querySelectorAll('[data-color]').forEach(function (b) {
        var on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-checked', on ? 'true' : 'false');
      });
      if (colorCurrent) colorCurrent.textContent = state.color;
      commit();
    });
  });

  /* ── cart drawer ──
     This store's cart is UPCART, not the Horizon native drawer. Horizon's
     drawer element does not exist on the page, so every selector below misses
     and the buyer would get no confirmation at all. UpCart exposes a global
     API, so call that first. Verified live: window.upcartOpenCart exists. */
  function openCart() {
    if (typeof window.upcartRefreshCart === 'function') {
      try { window.upcartRefreshCart(); } catch (e) {}
    }
    if (typeof window.upcartOpenCart === 'function') {
      try { window.upcartOpenCart(); return true; } catch (e) {}
    }
    document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
    document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true }));
    var drawer = document.querySelector(
      'cart-drawer-component, cart-drawer, #cart-drawer, [id^="CartDrawer"], .cart-drawer'
    );
    if (drawer) {
      if (typeof drawer.open === 'function') { drawer.open(); return true; }
      if (typeof drawer.showDialog === 'function') { drawer.showDialog(); return true; }
      var dlg = drawer.tagName === 'DIALOG' ? drawer : drawer.querySelector('dialog');
      if (dlg && typeof dlg.showModal === 'function') { dlg.showModal(); return true; }
      drawer.setAttribute('open', '');
      return true;
    }
    var toggle = document.querySelector('[data-cart-drawer-toggle], .header__icon--cart, a[href$="/cart"]');
    if (toggle && toggle.tagName !== 'A') { toggle.click(); return true; }
    return false;
  }

  /* ── GIFT LINE ITEMS ───────────────────────────────────────────────────
     The gifts are real products so the cart can show what they are worth.
     Two automatic Shopify BxGy discounts take them to zero. The line items
     are added here, NEVER priced at 0, so the buyer sees $105 of value being
     given rather than two mystery free rows.

     The locked gift follows the PAGE, not the variant title: it reads the
     same `is-unlocked` class paintGifts() sets, so the cart can never show a
     gift the page says is locked. Selecting 21 in after 26 in removes it.

     Quantities are FORCED with /cart/update.js rather than left to
     /cart/add.js, which increments. Two clicks of Add to cart would otherwise
     put 2 gifts against a discount that covers 1 and the buyer would be
     charged for a "free" gift. update.js sets an absolute quantity, and 0
     removes the line entirely. */
  var GIFT_ALWAYS = 0;
  var GIFT_LOCKED = 0;

  /* The spare brushes are cut to the deck, so the locked gift follows the
     SELECTED SIZE. Each tier carries its own variant id; a tier with none
     falls back to the section-level one, which is how this behaved before
     the brushes were split into 26 in and 30 in. */
  function tierGift(btn) {
    var id = btn && parseInt(btn.getAttribute('data-gift-variant'), 10);
    return id || GIFT_LOCKED;
  }

  function lockedGift() {
    return tierGift(root.querySelector('[data-tier].is-active'));
  }

  /* Every gift id the page can add, so switching size REMOVES the other
     size's brushes instead of leaving both in the cart. */
  var ALL_LOCKED = (function () {
    var seen = {}, out = [];
    if (GIFT_LOCKED) { seen[GIFT_LOCKED] = 1; out.push(GIFT_LOCKED); }
    root.querySelectorAll('[data-tier]').forEach(function (b) {
      var id = parseInt(b.getAttribute('data-gift-variant'), 10);
      if (id && !seen[id]) { seen[id] = 1; out.push(id); }
    });
    return out;
  })();

  function giftsUnlocked() {
    var box = document.getElementById('yh-gifts');
    return !!(box && box.classList.contains('is-unlocked'));
  }

  function syncGifts() {
    var updates = {};
    var want = giftsUnlocked() ? lockedGift() : 0;
    if (GIFT_ALWAYS) updates[GIFT_ALWAYS] = 1;
    ALL_LOCKED.forEach(function (id) { updates[id] = (id === want) ? 1 : 0; });
    if (!Object.keys(updates).length) return Promise.resolve();
    return fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ updates: updates })
    }).catch(function () {});
  }

  function addToCart(btn) {
    var id = parseInt(document.getElementById('sup-variant-id').value, 10);
    if (btn) btn.setAttribute('disabled', 'disabled');
    /* /cart/add.js REVERSES this array in the resulting cart (verified in
       browser, with and without the update call), so the Sweep is pushed LAST
       to come out FIRST. Gifts must never sit above the paid product. */
    var items = [];
    var lockedId = lockedGift();
    if (lockedId && giftsUnlocked()) items.push({ id: lockedId, quantity: 1 });
    if (GIFT_ALWAYS) items.push({ id: GIFT_ALWAYS, quantity: 1 });
    items.push({ id: id, quantity: 1 });
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    })
      .then(function (r) { return r.json(); })
      .then(function () { return syncGifts(); })
      .then(function () { if (!openCart()) window.location.href = '/cart'; })
      .catch(function () { window.location.href = '/cart'; })
      .then(function () { if (btn) btn.removeAttribute('disabled'); });
  }

  /* The main ATC is bound on CLICK, not on the form's submit, because UpCart
     intercepts submit on any form posting to /cart/add and performs its own
     single-item add. The form is kept for its fields and for the Enter key. */
  var atcBtn = document.getElementById('sup-atc');
  if (atcBtn) atcBtn.addEventListener('click', function (e) { e.preventDefault(); addToCart(atcBtn); });
  var form = document.getElementById('sup-form');
  if (form) form.addEventListener('submit', function (e) { e.preventDefault(); addToCart(document.getElementById('sup-atc')); });
  var stickyAtc = document.getElementById('sup-sticky-atc');
  if (stickyAtc) stickyAtc.addEventListener('click', function () { addToCart(stickyAtc); });

  /* ── sticky bar: earned, not shown on load ── */
  var sticky = document.getElementById('sup-sticky');
  var atc = document.getElementById('sup-atc');
  if (sticky && atc && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        sticky.classList.toggle('is-on', !entry.isIntersecting && entry.boundingClientRect.top < 0);
      });
    }, { threshold: 0 }).observe(atc);
  }

  commit();
})();
</script>



</div>
