<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_accent }}">

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" href="{{ 'favicon-z.svg' | asset_url }}" type="image/svg+xml">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-z-32.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon-z.png' | asset_url }}">
    {%- endif -%}

    {%- liquid
      assign brand_name = 'Zavelyn®'
      assign meta_title = page_title
      if request.page_type == 'index' or meta_title == blank or meta_title == shop.name or meta_title == 'My Store' or meta_title contains 'Sakerplus'
        assign meta_title = 'Zavelyn® Official Store — Heavy Duty Tools & Homestead Essentials'
      endif
    -%}
    <title>
      {{ meta_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless meta_title contains brand_name or meta_title contains shop.name or request.page_type == 'index' %} &ndash; {{ brand_name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign body_font = settings.font_body
      assign heading_font = settings.font_heading
    -%}

    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}
      {{ body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
      {{ heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

      :root {
        --color-background: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-text-muted: {{ settings.color_text_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-contrast: {{ settings.color_accent_contrast }};
        --color-border: {{ settings.color_border }};
        --color-sale: {{ settings.color_sale }};
        --color-success: {{ settings.color_success }};
        --color-error: {{ settings.color_error }};

        --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-body-style: {{ body_font.style }};
        --font-body-weight: {{ body_font.weight }};
        --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --font-heading-style: {{ heading_font.style }};
        --font-heading-weight: {{ heading_font.weight }};

        --font-size-base: {{ settings.font_size_base }}px;
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --page-width: {{ settings.page_width }}px;
        --section-spacing: {{ settings.section_spacing }}px;
        --product-card-ratio: {{ settings.product_card_image_ratio }};

        --space-3xs: 0.25rem;
        --space-2xs: 0.5rem;
        --space-xs: 0.75rem;
        --space-sm: 1rem;
        --space-md: 1.5rem;
        --space-lg: 2rem;
        --space-xl: 3rem;
        --space-2xl: 4.5rem;
        --space-3xl: 6rem;

        --radius-sm: 0.25rem;
        --radius-md: 0.5rem;
        --radius-lg: 0.75rem;

        --shadow-sm: 0 1px 2px rgb(0 0 0 / 0.06);
        --shadow-md: 0 8px 24px rgb(0 0 0 / 0.08);
        --shadow-lg: 0 16px 48px rgb(0 0 0 / 0.12);

        --header-height: 4.5rem;
        --transition-fast: 150ms ease;
        --transition-base: 250ms ease;
        --focus-ring: 0 0 0 2px var(--color-background), 0 0 0 4px var(--color-accent);

        --font-size-sm: clamp(0.8125rem, 0.78rem + 0.15vw, 0.875rem);
        --font-size-md: clamp(1rem, 0.96rem + 0.2vw, 1.0625rem);
        --font-size-lg: clamp(1.125rem, 1.05rem + 0.35vw, 1.25rem);
        --font-size-xl: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
        --font-size-2xl: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
        --font-size-3xl: clamp(2.25rem, 1.6rem + 2.8vw, 3.75rem);
      }
    {% endstyle %}

    {{ 'zavelyn-base.css' | asset_url | stylesheet_tag }}
    {{ 'zavelyn-layout.css' | asset_url | stylesheet_tag }}
    {{ 'zavelyn-components.css' | asset_url | stylesheet_tag }}
    {{ 'zavelyn.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.Sakerplus = window.Sakerplus || {};
      window.Sakerplus.routes = {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
        search_url: '{{ routes.search_url }}',
        root_url: '{{ routes.root_url }}'
      };
      window.Sakerplus.strings = {
        cartError: {{ 'cart.general.error' | t | json }},
        cartItemAdded: {{ 'cart.general.item_added' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        loading: {{ 'general.accessibility.loading' | t | json }}
      };
      window.Sakerplus.settings = {
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }},
        moneyWithCurrencyFormat: {{ shop.money_with_currency_format | json }},
        predictiveSearchEnabled: {{ settings.predictive_search_enabled | json }},
        predictiveSearchLimit: {{ settings.predictive_search_limit | json }},
        freeShippingThreshold: {{ settings.cart_free_shipping_threshold | json }},
        showFreeShipping: {{ settings.cart_show_free_shipping | json }}
      };
    </script>

    <script type="importmap">
      {
        "imports": {
          "zavelyn-utils": "{{ 'zavelyn-utils.js' | asset_url }}",
          "zavelyn-cart": "{{ 'zavelyn-cart.js' | asset_url }}",
          "zavelyn-product": "{{ 'zavelyn-product.js' | asset_url }}",
          "zavelyn-search": "{{ 'zavelyn-search.js' | asset_url }}",
          "zavelyn-navigation": "{{ 'zavelyn-navigation.js' | asset_url }}"
        }
      }
    </script>
    <script src="{{ 'zavelyn.js' | asset_url }}" type="module"></script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div id="zavelyn-live-region" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
