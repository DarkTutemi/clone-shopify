<script>
(function () {
  var main = document.querySelector('[data-offer-main]');
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-offer-thumb]'));
  var sources = thumbs.map(function (t) { return t.dataset.src; });
  var index = 0;
  function setSlide(i) {
    if (!main || !sources.length) return;
    index = (i + sources.length) % sources.length;
    main.src = sources[index];
    thumbs.forEach(function (t, n) { t.classList.toggle('is-active', n === index); });
  }
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () { setSlide(Number(thumb.dataset.index)); });
  });
  var prev = document.querySelector('[data-offer-prev]');
  var next = document.querySelector('[data-offer-next]');
  if (prev) prev.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index - 1); });
  if (next) next.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index + 1); });

  var fancyboxLoading = null;
  function loadFancybox(cb) {
    if (window.Fancybox) { cb(); return; }
    if (fancyboxLoading) { fancyboxLoading.then(cb); return; }
    fancyboxLoading = new Promise(function (resolve) {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css';
      document.head.appendChild(css);
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js';
      s.onload = function () { resolve(); };
      s.onerror = function () { resolve(); };
      document.body.appendChild(s);
    });
    fancyboxLoading.then(cb);
  }
  var zoom = document.querySelector('[data-offer-zoom]');
  if (zoom) {
    zoom.addEventListener('click', function () {
      if (!sources.length) return;
      loadFancybox(function () {
        if (!window.Fancybox) return;
        window.Fancybox.show(
          sources.map(function (src) { return { src: src, type: 'image' }; }),
          { startIndex: index }
        );
      });
    });
  }

  /* Ship note — destination + ETA from visitor IP (Shopify geo) */
  (function syncDeviceShipFromIp() {
    var root = document.querySelector('[data-device-shipnote]');
    if (!root) return;
    var flagEl = root.querySelector('[data-device-flag]');
    var labelEl = root.querySelector('[data-device-ship-label]');
    var placeEl = root.querySelector('[data-device-ship-place]');
    var arriveEl = root.querySelector('[data-device-arrive-by]');

    function flagEmoji(code) {
      if (!code || code.length !== 2) return '';
      var cc = code.toUpperCase();
      return String.fromCodePoint(127397 + cc.charCodeAt(0), 127397 + cc.charCodeAt(1));
    }

    function formatArriveBy(businessDays) {
      var d = new Date();
      var left = Math.max(1, businessDays || 7);
      while (left > 0) {
        d.setDate(d.getDate() + 1);
        var day = d.getDay();
        if (day !== 0 && day !== 6) left--;
      }
      var weekdays = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
      var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
      var n = d.getDate();
      var suf = (n % 10 === 1 && n !== 11) ? 'st' : (n % 10 === 2 && n !== 12) ? 'nd' : (n % 10 === 3 && n !== 13) ? 'rd' : 'th';
      return weekdays[d.getDay()] + ', ' + months[d.getMonth()] + ' ' + n + suf;
    }

    function applyShip(code, name) {
      var iso = (code || '').toUpperCase();
      var country = name || 'your country';
      var isUs = iso === 'US' || iso === 'USA' || /united states/i.test(country);
      if (labelEl) labelEl.textContent = isUs ? 'Ships From' : 'Shipping to';
      if (placeEl) placeEl.textContent = isUs ? 'Texas' : country;
      if (flagEl) {
        if (isUs) {
          flagEl.textContent = '';
          flagEl.classList.add('device-flag--us');
          flagEl.classList.remove('device-flag--emoji');
        } else {
          flagEl.textContent = flagEmoji(iso) || '🌍';
          flagEl.classList.add('device-flag--emoji');
          flagEl.classList.remove('device-flag--us');
        }
      }
      if (arriveEl) arriveEl.textContent = formatArriveBy(isUs ? 7 : 12);
    }

    /* Fallback from Shopify localization until geo resolves */
    applyShip(
      {{ localization.country.iso_code | default: '' | json }},
      {{ localization.country.name | default: 'your country' | json }}
    );

    fetch('/browsing_context_suggestions.json', {
      credentials: 'same-origin',
      headers: { Accept: 'application/json' }
    })
      .then(function (res) { return res.ok ? res.json() : null; })
      .then(function (data) {
        var detected = data && data.detected_values && data.detected_values.country;
        if (!detected) return;
        applyShip(detected.handle || detected.code || '', detected.name || detected.handle || '');
      })
      .catch(function () {});
  })();

  document.querySelectorAll('[data-offer-accordion]').forEach(function (accordion, aIdx) {
    var items = Array.prototype.slice.call(accordion.querySelectorAll('.offer-faq__item'));
    items.forEach(function (item, i) {
      var trigger = item.querySelector('.offer-faq__trigger');
      var panel = item.querySelector('.offer-faq__panel');
      if (!trigger || !panel) return;
      var panelId = 'device-faq-' + aIdx + '-' + i;
      panel.id = panelId;
      trigger.setAttribute('aria-controls', panelId);
      panel.setAttribute('role', 'region');
      var startOpen = item.classList.contains('is-open');
      trigger.setAttribute('aria-expanded', startOpen ? 'true' : 'false');
      if (startOpen) panel.removeAttribute('hidden');
      else panel.setAttribute('hidden', '');
      trigger.addEventListener('click', function () {
        var willOpen = !item.classList.contains('is-open');
        items.forEach(function (other) {
          var open = other === item && willOpen;
          other.classList.toggle('is-open', open);
          var btn = other.querySelector('.offer-faq__trigger');
          var p = other.querySelector('.offer-faq__panel');
          if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (p) { if (open) p.removeAttribute('hidden'); else p.setAttribute('hidden', ''); }
        });
      });
    });
  });

  var variantInput = document.getElementById('OfferVariantId');
  var buyForm = document.getElementById('OfferAddForm');
  var packsRoot = document.querySelector('[data-device-packs]');
  var ctaPriceEls = Array.prototype.slice.call(document.querySelectorAll('[data-device-cta-price]'));

  function syncCtaPrice(input) {
    if (!input) input = packsRoot && packsRoot.querySelector('input[name="device_pack"]:checked');
    var price = input ? (input.getAttribute('data-cta-price') || '') : '';
    ctaPriceEls.forEach(function (el) { el.textContent = price; });
  }

  if (packsRoot) {
    packsRoot.addEventListener('change', function (e) {
      var input = e.target;
      if (!input || input.name !== 'device_pack') return;
      if (variantInput) variantInput.value = input.value;
      packsRoot.querySelectorAll('.offer-bundle').forEach(function (pack) {
        pack.classList.toggle('is-active', pack.contains(input) && input.checked);
      });
      syncCtaPrice(input);
    });
    var initialPack = packsRoot.querySelector('input[name="device_pack"]:checked');
    if (initialPack) syncCtaPrice(initialPack);
  }
  syncCtaPrice();
  function selectedVariantId() {
    if (packsRoot) {
      var checked = packsRoot.querySelector('input[name="device_pack"]:checked');
      if (checked) return Number(checked.value);
    }
    return variantInput ? Number(variantInput.value) : 0;
  }
  var checkoutBtns = Array.prototype.slice.call(document.querySelectorAll('[data-offer-checkout]'));
  var checkoutBusy = false;
  function goToCheckout(trigger) {
    var vid = selectedVariantId();
    if (checkoutBusy || !vid) return;
    var checked = packsRoot ? packsRoot.querySelector('input[name="device_pack"]:checked') : null;
    var packNum = checked ? (checked.getAttribute('data-pack') || '1') : '1';
    var packLabel = 'Buy ' + packNum;
    var packCard = checked && checked.closest('.offer-bundle');
    var nameEl = packCard && packCard.querySelector('.offer-bundle__title');
    var metaEl = packCard && packCard.querySelector('.offer-bundle__meta');
    var shipEl = packCard && packCard.querySelector('.offer-bundle__ship');
    if (nameEl) packLabel = nameEl.textContent.trim();
    var units = Math.max(1, Number(packNum) || 1);
    var contentsLabel = units === 1 ? '1 × V1 Device + 3 bonuses' : (units + ' × V1 Device + bonuses');
    var metaLabel = metaEl ? metaEl.textContent.trim() : '';
    var shipLabel = shipEl ? shipEl.textContent.trim() : '';
    var lineProperties = {
      _bundle: 'device-pack',
      _bundle_id: 'dev_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8),
      _pack: String(packNum),
      _cart_qty: '1',
      Offer: packLabel,
      'You get': contentsLabel
    };
    if (metaLabel) lineProperties.Deal = metaLabel;
    if (shipLabel) lineProperties.Shipping = shipLabel;
    var packageNote = [packLabel, contentsLabel, metaLabel, shipLabel].filter(Boolean).join(' · ');
    checkoutBusy = true;
    checkoutBtns.forEach(function (btn) { btn.classList.add('is-loading'); });
    if (trigger && trigger.classList) trigger.classList.add('is-loading');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        items: [{
          id: vid,
          quantity: 1,
          properties: lineProperties
        }]
      })
    })
      .then(function (res) { if (!res.ok) throw new Error('add_failed'); return res.json(); })
      .then(function () {
        return fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) {
          return r.ok ? r.json() : null;
        });
      })
      .then(function (cart) {
        checkoutBusy = false;
        checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
        if (trigger && trigger.classList) trigger.classList.remove('is-loading');
        if (cart) {
          document.dispatchEvent(new CustomEvent('zavelyn:offer-cart:open', { detail: { cart: cart } }));
          return;
        }
        window.location.href = '/checkout';
      })
      .catch(function () {
        checkoutBusy = false;
        checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
        if (trigger && trigger.classList) trigger.classList.remove('is-loading');
        if (buyForm) buyForm.submit();
      });
  }
  if (buyForm) buyForm.addEventListener('submit', function (e) { e.preventDefault(); goToCheckout(e.submitter); });
  checkoutBtns.forEach(function (btn) {
    if (btn.closest('#OfferAddForm')) return;
    btn.addEventListener('click', function (e) { e.preventDefault(); goToCheckout(btn); });
  });

  /* Stats: show final values (no scroll count-up) */
  (function () {
    var root = document.querySelector('[data-device-stats]');
    if (!root) return;
    Array.prototype.slice.call(root.querySelectorAll('[data-count-to]')).forEach(function (el) {
      var to = Number(el.getAttribute('data-count-to') || 0);
      var suffix = el.getAttribute('data-suffix') || '';
      el.textContent = to + suffix;
    });
  })();

  var sticky = document.querySelector('[data-offer-sticky]');
  var stickyCta = sticky ? sticky.querySelector('[data-offer-checkout]') : null;
  var hero = document.querySelector('.offer-hero');
  if (sticky && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      var on = !entries[0].isIntersecting;
      sticky.classList.toggle('is-on', on);
      sticky.setAttribute('aria-hidden', on ? 'false' : 'true');
      if (on) sticky.removeAttribute('inert');
      else sticky.setAttribute('inert', '');
      if (stickyCta) stickyCta.tabIndex = on ? 0 : -1;
      document.documentElement.classList.toggle('offer-sticky-on', on);
    }, { threshold: 0.05 }).observe(hero);
  }

  var topBtn = document.querySelector('[data-offer-top]');
  if (topBtn) {
    function syncTopBtn() {
      var show = window.scrollY > 480;
      topBtn.hidden = !show;
      topBtn.classList.toggle('is-on', show);
    }
    window.addEventListener('scroll', syncTopBtn, { passive: true });
    syncTopBtn();
    topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  }
})();
</script>

