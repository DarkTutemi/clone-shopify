    "option3": {{ v.option3 | json }},
    "title": {{ v.title | json }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
</script>
<script>
(function () {
  var main = document.querySelector('[data-offer-main]');
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-offer-thumb]'));
  var sources = thumbs.map(function (t) { return t.dataset.src; });
  var index = 0;
  function setSlide(i) {
    if (!main || !sources.length) return;
    index = (i + sources.length) % sources.length;
    main.src = sources[index];
    thumbs.forEach(function (t, n) { t.classList.toggle('is-active', n === index); });
  }
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () { setSlide(Number(thumb.dataset.index)); });
  });
  var prev = document.querySelector('[data-offer-prev]');
  var next = document.querySelector('[data-offer-next]');
  if (prev) prev.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index - 1); });
  if (next) next.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index + 1); });

  var fancyboxLoading = null;
  function loadFancybox(cb) {
    if (window.Fancybox) { cb(); return; }
    if (fancyboxLoading) { fancyboxLoading.then(cb); return; }
    fancyboxLoading = new Promise(function (resolve) {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css';
      document.head.appendChild(css);
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js';
      s.onload = function () { resolve(); };
      s.onerror = function () { resolve(); };
      document.body.appendChild(s);
    });
    fancyboxLoading.then(cb);
  }
  var zoom = document.querySelector('[data-offer-zoom]');
  if (zoom) {
    zoom.addEventListener('click', function () {
      if (!sources.length) return;
      loadFancybox(function () {
        if (!window.Fancybox) return;
        window.Fancybox.show(
          sources.map(function (src) { return { src: src, type: 'image' }; }),
          { startIndex: index }
        );
      });
    });
  }

  document.querySelectorAll('[data-offer-accordion]').forEach(function (accordion, aIdx) {
    var items = Array.prototype.slice.call(accordion.querySelectorAll('.offer-faq__item'));
    function setOpen(target, open) {
      target.classList.toggle('is-open', open);
      var btn = target.querySelector('.offer-faq__trigger');
      var p = target.querySelector('.offer-faq__panel');
      if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (p) {
        p.removeAttribute('hidden');
        if (open) p.removeAttribute('aria-hidden');
        else p.setAttribute('aria-hidden', 'true');
      }
    }
    items.forEach(function (item, i) {
      var trigger = item.querySelector('.offer-faq__trigger');
      var panel = item.querySelector('.offer-faq__panel');
      if (!trigger || !panel) return;
      var panelId = 'cdf-faq-' + aIdx + '-' + i;
      panel.id = panelId;
      trigger.setAttribute('aria-controls', panelId);
      panel.setAttribute('role', 'region');
      panel.removeAttribute('hidden');
      trigger.addEventListener('click', function () {
        var willOpen = !item.classList.contains('is-open');
        items.forEach(function (other) { setOpen(other, other === item && willOpen); });
      });
    });
    /* Default: all closed unless an item already has .is-open */
    var preset = accordion.querySelector('.offer-faq__item.is-open');
    items.forEach(function (other) { setOpen(other, preset ? other === preset : false); });
  });

  /* Size chart modal */
  var sizeChart = document.querySelector('[data-cdf-sizechart]');
  var sizeChartLastFocus = null;
  function openSizeChart() {
    if (!sizeChart) return;
    sizeChartLastFocus = document.activeElement;
    sizeChart.hidden = false;
    document.documentElement.classList.add('offer-sizechart-open');
    var closeBtn = sizeChart.querySelector('[data-cdf-sizechart-close].offer-sizechart__close');
    if (closeBtn) closeBtn.focus();
  }
  function closeSizeChart() {
    if (!sizeChart || sizeChart.hidden) return;
    sizeChart.hidden = true;
    document.documentElement.classList.remove('offer-sizechart-open');
    if (sizeChartLastFocus && sizeChartLastFocus.focus) sizeChartLastFocus.focus();
  }
  document.querySelectorAll('[data-cdf-sizechart-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      var card = btn.closest('.offer-bundle');
      var radio = card && card.querySelector('input[name="offer_bundle"]');
      if (radio && !radio.checked) {
        radio.checked = true;
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }
      openSizeChart();
    });
  });
  document.querySelectorAll('[data-cdf-sizechart-close]').forEach(function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      closeSizeChart();
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeSizeChart();
  });

  /* Trusted split: keep muted autoplay loop when visible */
  document.querySelectorAll('.cdf-trusted__video').forEach(function (vid) {
    vid.muted = true;
    function tryPlay() { vid.play().catch(function () {}); }
    tryPlay();
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) tryPlay();
          else vid.pause();
        });
      }, { threshold: 0.25 });
      io.observe(vid);
    }
  });

  /* See-it-in-action: play muted loop on hover/click; hide play btn while playing */
  document.querySelectorAll('.cdf-sia-card video').forEach(function (vid) {
    var card = vid.closest('.cdf-sia-card');
    if (!card) return;

    function syncPlayUi() {
      card.classList.toggle('is-playing', !vid.paused && !vid.ended);
    }

    vid.addEventListener('play', syncPlayUi);
    vid.addEventListener('playing', syncPlayUi);
    vid.addEventListener('pause', syncPlayUi);
    vid.addEventListener('ended', syncPlayUi);
    syncPlayUi();

    card.addEventListener('mouseenter', function () {
      vid.muted = true;
      vid.play().catch(function () {});
    });
    card.addEventListener('mouseleave', function () {
      vid.pause();
      try { vid.currentTime = 0; } catch (e) {}
      syncPlayUi();
    });
    card.addEventListener('click', function () {
      if (vid.paused) {
        vid.muted = true;
        vid.play().catch(function () {});
      } else {
        vid.pause();
      }
    });
  });

  /* RSS results charts (Cedrow clone) */
  (function () {
    var CHARTS = {
      stiffness: { points: [100, 60, 32, 15] },
      position: { points: [100, 55, 26, 12] },
      mobility: { points: [100, 68, 38, 20] }
    };
    var animating = {};
    var INK = '#1857b2';

    function drawChart(id) {
      var canvas = document.getElementById('rss-chart-' + id);
      if (!canvas) return;
      var wrap = canvas.parentElement;
      var isMobile = window.innerWidth <= 860;
      var padLeft = isMobile ? 38 : 52;
      var padBottom = isMobile ? 38 : 44;
      var W = (wrap.clientWidth - padLeft) || 400;
      var H = (wrap.clientHeight - padBottom) || 256;
      var dpr = window.devicePixelRatio || 1;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      var ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);
      var pts = CHARTS[id].points;
      var cols = pts.length;
      var xStep = W / (cols - 1);
      function vy(v) { return H - (v / 100) * H; }
      function vx(i) { return i * xStep; }
      var lineWidth = isMobile ? 3.5 : 3;
      var dotRadius = isMobile ? 6.5 : 6;
      var duration = 1100;
      var start = null;
      animating[id] = true;

      function buildPath(toFrac) {
        var p = new Path2D();
        p.moveTo(vx(0), vy(pts[0]));
        var totalSegs = cols - 1;
        var drawnSegs = toFrac * totalSegs;
        for (var s = 0; s < totalSegs; s++) {
          if (drawnSegs <= s) break;
          var frac = Math.min(drawnSegs - s, 1);
          var x0 = vx(s), y0 = vy(pts[s]);
          var x1 = vx(s + 1), y1 = vy(pts[s + 1]);
          var ex = x0 + (x1 - x0) * frac;
          var ey = y0 + (y1 - y0) * frac;
          var cpx = (x0 + x1) / 2;
          p.bezierCurveTo(cpx, y0, cpx, ey, ex, ey);
        }
        return p;
      }

      function frame(ts) {
        if (!animating[id]) return;
        if (!start) start = ts;
        var t = Math.min((ts - start) / duration, 1);
        var ease = 1 - Math.pow(1 - t, 3);
        ctx.clearRect(0, 0, W, H);
        var totalSegs = cols - 1;
        var drawn = ease * totalSegs;
        var path = buildPath(ease);
        var endX = (function () {
          var ts2 = Math.min(drawn, totalSegs);
          var s = Math.floor(ts2);
          if (s >= totalSegs) return vx(totalSegs);
          var frac = ts2 - s;
          return vx(s) + (vx(s + 1) - vx(s)) * frac;
        })();
        var area = new Path2D(path);
        area.lineTo(endX, H);
        area.lineTo(vx(0), H);
        area.closePath();
        var grad = ctx.createLinearGradient(0, 0, 0, H);
        grad.addColorStop(0, 'rgba(24, 87, 178, 0.16)');
        grad.addColorStop(1, 'rgba(24, 87, 178, 0)');
        ctx.fillStyle = grad;
        ctx.fill(area);
        ctx.save();
        ctx.shadowColor = 'rgba(24, 87, 178, 0.18)';
        ctx.shadowBlur = 8;
        ctx.shadowOffsetY = 4;
        ctx.strokeStyle = INK;
        ctx.lineWidth = lineWidth;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        ctx.stroke(path);
        ctx.restore();
        for (var d = 0; d < cols; d++) {
          var alpha = d < Math.floor(drawn) ? 1 : d === Math.floor(drawn) ? (drawn % 1) : 0;
          if (alpha <= 0) continue;
          ctx.beginPath();
          ctx.arc(vx(d), vy(pts[d]), dotRadius + 4, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(24,87,178,' + (0.10 * alpha) + ')';
          ctx.fill();
          ctx.beginPath();
          ctx.arc(vx(d), vy(pts[d]), dotRadius, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(24,87,178,' + alpha + ')';
          ctx.fill();
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 2.5;
          ctx.stroke();
        }
        if (t < 1) requestAnimationFrame(frame);
      }
      requestAnimationFrame(frame);
    }

    function movePill(btn) {
      var pill = document.getElementById('rss-pill');
      if (!pill || !btn) return;
      pill.style.left = btn.offsetLeft + 'px';
      pill.style.width = btn.offsetWidth + 'px';
    }

    var buttons = document.querySelectorAll('.rss-tab-btn');
    var panels = document.querySelectorAll('.rss-panel');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var tab = btn.getAttribute('data-tab');
        buttons.forEach(function (b) { b.classList.remove('active'); });
        panels.forEach(function (p) { p.classList.remove('active'); });
        btn.classList.add('active');
        movePill(btn);
        var panel = document.getElementById('rss-panel-' + tab);
        if (panel) {
          panel.classList.add('active');
          animating[tab] = false;
          setTimeout(function () { drawChart(tab); }, 16);
        }
      });
    });

    function initRss() {
      var active = document.querySelector('.rss-tab-btn.active');
      movePill(active);
      drawChart('stiffness');
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initRss);
    else initRss();

    var rt;
    window.addEventListener('resize', function () {
      clearTimeout(rt);
      rt = setTimeout(function () {
        var active = document.querySelector('.rss-tab-btn.active');
        if (active) {
          movePill(active);
          var tab = active.getAttribute('data-tab');
          animating[tab] = false;
          drawChart(tab);
        }
      }, 150);
    });
  })();

  /* Variant matching — Black only; Buy 2 = two independent side/size picks */
  var variants = [];
  try {
    var raw = document.getElementById('CdfVariantsJson');
    variants = raw ? JSON.parse(raw.textContent) : [];
  } catch (e) { variants = []; }
  variants = variants.filter(function (v) { return v.option1 === 'Black'; });

  /* Brace 1 defaults Left; Brace 2 defaults Right (pair) */
  var items = [
    { side: 'Left', size: 'S' },
    { side: 'Right', size: 'S' }
  ];
  var COLOR = 'Black';
  var variantInput = document.getElementById('OfferVariantId');
  var priceEl = document.querySelector('[data-cdf-price]');
  var compareEl = document.querySelector('[data-cdf-compare]');
  var buyForm = document.getElementById('OfferAddForm');
  var qtyInput = document.getElementById('OfferQuantity');
  var bundlesRoot = document.querySelector('[data-offer-bundles]');
  var checkoutBtns = Array.prototype.slice.call(document.querySelectorAll('[data-offer-checkout]'));
  var checkoutBusy = false;

  function formatMoney(cents) {
    if (typeof cents !== 'number') return '';
    return '$' + (cents / 100).toFixed(2);
  }

  function formatCtaMoney(cents) {
    var n = Number(cents) / 100;
    if (!isFinite(n)) return '';
    if (Math.abs(n - Math.round(n)) < 0.001) return '$' + Math.round(n);
    return '$' + n.toFixed(2);
  }

  var ctaPriceEls = Array.prototype.slice.call(document.querySelectorAll('[data-offer-cta-price]'));

  function findVariantFor(side, size) {
    return variants.find(function (v) {
      return v.option1 === COLOR && v.option2 === side && v.option3 === size;
    }) || null;
  }

  function selectedBundle() {
    if (!bundlesRoot) return { qty: 1, discount: 0, label: 'Buy 1' };
    var checked = bundlesRoot.querySelector('input[name="offer_bundle"]:checked');
    if (!checked) return { qty: 1, discount: 0, label: 'Buy 1' };
    var qty = Math.max(1, Number(checked.getAttribute('data-qty') || 1));
    var discount = Math.max(0, Number(checked.getAttribute('data-discount') || 0));
    var card = checked.closest('.offer-bundle');
    var titleEl = card && card.querySelector('.offer-bundle__title');
    return {
      qty: qty,
      discount: discount,
      label: titleEl ? titleEl.textContent.trim() : ('Buy ' + qty)
    };
  }

  function activateBundleFrom(el) {
    var card = el && el.closest('.offer-bundle');
    var radio = card && card.querySelector('input[name="offer_bundle"]');
    if (radio && !radio.checked) {
      radio.checked = true;
      syncBundleUI();
    }
  }

  function itemIndexFrom(el) {
    var wrap = el && el.closest('[data-cdf-item]');
    if (!wrap) return 0;
    var n = Number(wrap.getAttribute('data-cdf-item') || 0);
    return isNaN(n) ? 0 : n;
  }

  function syncItemUI() {
    document.querySelectorAll('.cdf-item-opts[data-cdf-item]').forEach(function (wrap) {
      var idx = Number(wrap.getAttribute('data-cdf-item') || 0);
      var item = items[idx] || items[0];
      var sideLabel = wrap.querySelector('[data-cdf-side-label]');
      var sizeLabel = wrap.querySelector('[data-cdf-size-label]');
      if (sideLabel) sideLabel.textContent = item.side;
      if (sizeLabel) sizeLabel.textContent = item.size;
      wrap.querySelectorAll('[data-cdf-side]').forEach(function (b) {
        b.classList.toggle('is-active', b.getAttribute('data-cdf-side') === item.side);
      });
      wrap.querySelectorAll('[data-cdf-size]').forEach(function (b) {
        b.classList.toggle('is-active', b.getAttribute('data-cdf-size') === item.size);
      });
    });
  }

  function syncVariant() {
    var primary = findVariantFor(items[0].side, items[0].size);
    if (primary && variantInput) variantInput.value = primary.id;
    if (compareEl && primary) {
      if (primary.compare > primary.price) {
        compareEl.textContent = primary.compare_money || formatMoney(primary.compare);
        compareEl.style.display = '';
      } else {
        compareEl.style.display = 'none';
      }
    }
    var bundle = selectedBundle();
    var allOk = true;
    for (var i = 0; i < bundle.qty; i++) {
      var v = findVariantFor(items[i].side, items[i].size);
      if (!v || !v.available) allOk = false;
    }
    var cta = document.querySelector('#OfferAddForm [data-offer-checkout]');
    if (cta) cta.disabled = !allOk;
    syncItemUI();
    syncBundleUI();
  }

  document.querySelectorAll('[data-cdf-side]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      activateBundleFrom(btn);
      var idx = itemIndexFrom(btn);
      items[idx] = items[idx] || { side: 'Left', size: 'S' };
      items[idx].side = btn.getAttribute('data-cdf-side');
      syncVariant();
    });
  });
  document.querySelectorAll('[data-cdf-size]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (btn.disabled) return;
      activateBundleFrom(btn);
      var idx = itemIndexFrom(btn);
      items[idx] = items[idx] || { side: 'Left', size: 'S' };
      items[idx].size = btn.getAttribute('data-cdf-size');
      syncVariant();
    });
  });

  function unitCents() {
    var v = findVariantFor(items[0].side, items[0].size);
    if (v && typeof v.price === 'number') return v.price;
    if (bundlesRoot) return Number(bundlesRoot.getAttribute('data-unit-price') || 0);
    return 0;
  }

  function syncBundleUI() {
    var unit = unitCents();
    var bundle = selectedBundle();
    var total = Math.round(unit * bundle.qty * (100 - bundle.discount) / 100);
    if (qtyInput) qtyInput.value = String(bundle.qty);
    if (priceEl) priceEl.textContent = formatMoney(total);
    if (bundlesRoot) {
      bundlesRoot.querySelectorAll('.offer-bundle').forEach(function (card) {
        var input = card.querySelector('input[name="offer_bundle"]');
        card.classList.toggle('is-active', !!(input && input.checked));
        var priceNode = card.querySelector('[data-bundle-price]');
        if (priceNode && input) {
          var q = Math.max(1, Number(input.getAttribute('data-qty') || 1));
          var d = Math.max(0, Number(input.getAttribute('data-discount') || 0));
          priceNode.textContent = formatMoney(Math.round(unit * q * (100 - d) / 100));
        }
      });
    }
    var ctaMoney = formatCtaMoney(total);
    ctaPriceEls.forEach(function (el) { el.textContent = ctaMoney; });
  }

  if (bundlesRoot) {
    bundlesRoot.querySelectorAll('input[name="offer_bundle"]').forEach(function (input) {
      input.addEventListener('change', syncVariant);
    });
  }
  syncVariant();

  function buildCartItems(bundle) {
    var packageLabel = bundle.label || ('Buy ' + bundle.qty);
    if (bundle.discount > 0 && packageLabel.indexOf('%') === -1) {
      packageLabel += ' · Extra ' + bundle.discount + '% OFF';
    }
    var contentsLabel = bundle.qty === 1 ? '1 brace' : (bundle.qty + ' braces');
    var discountCode = bundlesRoot ? (bundlesRoot.getAttribute('data-discount-code') || '') : '';
    var bundleId = 'cdf_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);
    var merged = {};
    var braceNotes = [];
    for (var i = 0; i < bundle.qty; i++) {
      var pick = items[i] || items[0];
      var v = findVariantFor(pick.side, pick.size);
      if (!v) continue;
      var key = String(v.id);
      if (!merged[key]) {
        merged[key] = {
          id: v.id,
          quantity: 0,
          properties: {
            _bundle: 'cdf-pack',
            _bundle_id: bundleId,
            _paid: String(bundle.qty),
            _discount: String(bundle.discount),
            _cart_qty: String(bundle.qty),
            _discount_code: bundle.discount > 0 ? discountCode : '',
            Offer: packageLabel,
            'You get': contentsLabel
          }
        };
      }
      merged[key].quantity += 1;
      var note = pick.side + ' / ' + pick.size;
      braceNotes.push('Brace ' + (i + 1) + ': ' + note);
      merged[key].properties['Brace ' + (i + 1)] = note;
    }
    return {
      items: Object.keys(merged).map(function (k) { return merged[k]; }),
      note: [packageLabel, contentsLabel].concat(braceNotes).join(' · ')
    };
  }

  function goToCheckout(trigger) {
    var bundle = selectedBundle();
    var built = buildCartItems(bundle);
    var cartItems = built.items;
    if (checkoutBusy || !cartItems.length) return;
    checkoutBusy = true;
    checkoutBtns.forEach(function (btn) { btn.classList.add('is-loading'); });
    if (trigger && trigger.classList) trigger.classList.add('is-loading');
    var discountCode = bundlesRoot ? (bundlesRoot.getAttribute('data-discount-code') || '') : '';
    if (variantInput && cartItems[0]) variantInput.value = cartItems[0].id;
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ items: cartItems })
    })
      .then(function (res) { if (!res.ok) throw new Error('add_failed'); return res.json(); })
      .then(function () {
        return fetch('/cart/update.js', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ note: built.note })
        }).catch(function () {});
      })
      .then(function () {
        if (bundle.discount > 0 && discountCode) {
          return fetch('/discount/' + encodeURIComponent(discountCode), {
            credentials: 'same-origin',
            redirect: 'follow'
          }).catch(function () {});
        }
      })
      .then(function () {
        return fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) {
          return r.ok ? r.json() : null;
        });
      })
      .then(function (cart) {
        checkoutBusy = false;
        checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
        if (trigger && trigger.classList) trigger.classList.remove('is-loading');
        if (cart) {
          document.dispatchEvent(new CustomEvent('zavelyn:offer-cart:open', { detail: { cart: cart } }));
          return;
        }
        var url = '/checkout';
        if (bundle.discount > 0 && discountCode) url += '?discount=' + encodeURIComponent(discountCode);
        window.location.href = url;
      })
      .catch(function () {
        checkoutBusy = false;
        checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
        if (trigger && trigger.classList) trigger.classList.remove('is-loading');
        if (buyForm) buyForm.submit();
      });
  }
  if (buyForm) buyForm.addEventListener('submit', function (e) { e.preventDefault(); goToCheckout(e.submitter); });
  checkoutBtns.forEach(function (btn) {
    if (btn.closest('#OfferAddForm')) return;
    btn.addEventListener('click', function (e) { e.preventDefault(); goToCheckout(btn); });
  });

  var sticky = document.querySelector('[data-offer-sticky]');
  var stickyCta = sticky ? sticky.querySelector('[data-offer-checkout]') : null;
  var hero = document.querySelector('.offer-hero');
  if (sticky && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      var on = !entries[0].isIntersecting;
      sticky.classList.toggle('is-on', on);
      sticky.setAttribute('aria-hidden', on ? 'false' : 'true');
      if (on) sticky.removeAttribute('inert');
      else sticky.setAttribute('inert', '');
      if (stickyCta) stickyCta.tabIndex = on ? 0 : -1;
      document.documentElement.classList.toggle('offer-sticky-on', on);
    }, { threshold: 0.05 }).observe(hero);
  }

  var topBtn = document.querySelector('[data-offer-top]');
  if (topBtn) {
    function syncTopBtn() {
      var show = window.scrollY > 480;
      topBtn.hidden = !show;
      topBtn.classList.toggle('is-on', show);
    }
    window.addEventListener('scroll', syncTopBtn, { passive: true });
    syncTopBtn();
    topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  }
})();
</script>

