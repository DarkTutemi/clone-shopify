<div class="zv-track-page">
  <!-- Hero Section -->
  <div class="zv-track-hero">
    <div class="zv-container">
      <div class="zv-track-pill">
        <span class="zv-status-dot"></span>
        <span>Real-Time Carrier Tracking Active</span>
      </div>
      <h1 class="zv-track-title">Track Your Order</h1>
      <p class="zv-track-subtitle">
        Enter your tracking number or order details below to monitor your shipment from our fulfillment center directly to your doorstep.
      </p>

      <!-- Trust highlights -->
      <div class="zv-hero-trust">
        <div class="zv-htrust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>Insured Transit</span>
        </div>
        <div class="zv-htrust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span>24-48h Fast Dispatch</span>
        </div>
        <div class="zv-htrust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <span>Doorstep Delivery Guarantee</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Tracking Form Box -->
  <div class="zv-container zv-form-container">
    <div class="zv-track-card">
      <!-- Tabs Switcher -->
      <div class="zv-track-tabs">
        <button type="button" class="zv-tab-btn active" id="tabTrackingBtn" onclick="switchTrackTab('tracking')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          <span>Tracking Number</span>
        </button>
        <button type="button" class="zv-tab-btn" id="tabOrderBtn" onclick="switchTrackTab('order')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <span>Order Number &amp; Email</span>
        </button>
      </div>

      <!-- Tab Content 1: Tracking Number -->
      <div class="zv-tab-content active" id="tabTrackingContent">
        <form class="zv-track-form" onsubmit="handleTrackNumberSubmit(event)">
          <div class="zv-input-group">
            <label for="trackingNumberInput" class="zv-input-label">Tracking Number</label>
            <div class="zv-input-wrapper">
              <svg class="zv-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input type="text" id="trackingNumberInput" class="zv-input" placeholder="e.g. 9400111899562847192031 or DHL/FedEx code" required>
            </div>
            <span class="zv-input-hint">Found in your shipping confirmation email or SMS.</span>
          </div>

          <button type="submit" class="zv-track-submit-btn" id="submitTrackBtn">
            <span>Track Package</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </form>
      </div>

      <!-- Tab Content 2: Order Number & Email -->
      <div class="zv-tab-content" id="tabOrderContent">
        <form class="zv-track-form" onsubmit="handleOrderEmailSubmit(event)">
          <div class="zv-input-grid">
            <div class="zv-input-group">
              <label for="orderNumberInput" class="zv-input-label">Order Number</label>
              <div class="zv-input-wrapper">
                <svg class="zv-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="20" y2="15"></line><line x1="10" y1="3" x2="8" y2="21"></line><line x1="16" y1="3" x2="14" y2="21"></line></svg>
                <input type="text" id="orderNumberInput" class="zv-input" placeholder="e.g. #ZAV-1048 or 1048" required>
              </div>
            </div>

            <div class="zv-input-group">
              <label for="orderEmailInput" class="zv-input-label">Email or Phone</label>
              <div class="zv-input-wrapper">
                <svg class="zv-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                <input type="email" id="orderEmailInput" class="zv-input" placeholder="Used during checkout" required>
              </div>
            </div>
          </div>

          <button type="submit" class="zv-track-submit-btn" id="submitOrderBtn">
            <span>Lookup Order</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </form>
      </div>

      <!-- Live Tracking Result Container (Embedded frame / result card) -->
      <div id="zvTrackingResult" class="zv-tracking-result" style="display: none;"></div>

      <!-- Supported Carriers Line -->
      <div class="zv-carriers-footer">
        <span class="zv-carriers-label">Seamless Integration with Major Worldwide Carriers:</span>
        <div class="zv-carriers-list">
          <span class="zv-carrier-tag">USPS</span>
          <span class="zv-carrier-tag">FedEx</span>
          <span class="zv-carrier-tag">UPS</span>
          <span class="zv-carrier-tag">DHL Express</span>
          <span class="zv-carrier-tag">Royal Mail</span>
          <span class="zv-carrier-tag">Canada Post</span>
          <span class="zv-carrier-tag">Australia Post</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Delivery Process Milestones -->
  <div class="zv-container zv-milestones-container">
    <h2 class="zv-section-title">How Your Zavelyn Order Travels</h2>
    <div class="zv-milestones-grid">
      <div class="zv-milestone-card">
        <div class="zv-milestone-icon">✓</div>
        <div class="zv-milestone-step">STEP 01</div>
        <h3 class="zv-milestone-title">Order Verified</h3>
        <p class="zv-milestone-desc">Your order is logged and payment securely cleared by our automated system.</p>
      </div>
      <div class="zv-milestone-card">
        <div class="zv-milestone-icon">📦</div>
        <div class="zv-milestone-step">STEP 02</div>
        <h3 class="zv-milestone-title">Customs &amp; Quality Check</h3>
        <p class="zv-milestone-desc">Each item undergoes quality inspection, is safely padded, and barcoded.</p>
      </div>
      <div class="zv-milestone-card">
        <div class="zv-milestone-icon">🚚</div>
        <div class="zv-milestone-step">STEP 03</div>
        <h3 class="zv-milestone-title">Dispatched with Carrier</h3>
        <p class="zv-milestone-desc">Handed off to express courier. Real-time GPS tracking becomes active.</p>
      </div>
      <div class="zv-milestone-card">
        <div class="zv-milestone-icon">🏡</div>
        <div class="zv-milestone-step">STEP 04</div>
        <h3 class="zv-milestone-title">Delivered to Doorstep</h3>
        <p class="zv-milestone-desc">Arrives securely at your door backed by our 30-Day Money-Back Guarantee.</p>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div class="zv-container zv-faq-container">
    <h2 class="zv-section-title">Frequently Asked Questions</h2>
    <div class="zv-faq-list">
      <div class="zv-faq-item">
        <button type="button" class="zv-faq-q" onclick="toggleFaq(this)">
          <span>Where can I find my tracking number?</span>
          <span class="zv-faq-arrow">+</span>
        </button>
        <div class="zv-faq-a">
          <p>Your tracking number is automatically generated and sent to the email address or phone number you entered during checkout as soon as your parcel ships (typically within 24–48 hours). Please check your Inbox and Spam/Junk folder for an email from <strong>Zavelyn Support</strong>.</p>
        </div>
      </div>

      <div class="zv-faq-item">
        <button type="button" class="zv-faq-q" onclick="toggleFaq(this)">
          <span>How long does delivery take?</span>
          <span class="zv-faq-arrow">+</span>
        </button>
        <div class="zv-faq-a">
          <p>Standard delivery across the United States typically takes <strong>3–7 business days</strong>. Express courier shipments arrive within <strong>2–4 business days</strong>. International orders take 7–12 business days depending on customs clearance.</p>
        </div>
      </div>

      <div class="zv-faq-item">
        <button type="button" class="zv-faq-q" onclick="toggleFaq(this)">
          <span>My tracking status says "Pending" or hasn't updated. What should I do?</span>
          <span class="zv-faq-arrow">+</span>
        </button>
        <div class="zv-faq-a">
          <p>When tracking numbers are newly generated, couriers like USPS or FedEx may take 24–48 hours to scan the barcode at the regional distribution facility. Your package is already moving! If no update appears after 3 business days, reach out to our team immediately.</p>
        </div>
      </div>

      <div class="zv-faq-item">
        <button type="button" class="zv-faq-q" onclick="toggleFaq(this)">
          <span>Can I change or update my delivery address?</span>
          <span class="zv-faq-arrow">+</span>
        </button>
        <div class="zv-faq-a">
          <p>Because we process orders rapidly, address modifications must be requested within <strong>2 hours</strong> of placing your order. Email <strong>support@tryzavelyn.com</strong> with your order number and updated address immediately.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Dedicated Support Box -->
  <div class="zv-container zv-support-container">
    <div class="zv-support-card">
      <div class="zv-support-icon">💬</div>
      <div class="zv-support-content">
        <h3 class="zv-support-title">Need Extra Assistance with Your Shipment?</h3>
        <p class="zv-support-desc">Our dedicated concierge care team is available 24/7 to locate packages, coordinate with couriers, or initiate replacements.</p>
        <div class="zv-support-action">
          <a href="mailto:support@tryzavelyn.com" class="zv-support-btn">Contact Concierge Support</a>
          <span class="zv-support-reply">Average response time: &lt; 2 hours</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     ZAVELYN MODERN ORDER TRACKING PAGE STYLES
     ========================================================================== */
  .zv-track-page {
    background-color: #f8fafc;
    min-height: 80vh;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: #0f172a;
    padding-bottom: 80px;
  }

  .zv-container {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* Hero */
