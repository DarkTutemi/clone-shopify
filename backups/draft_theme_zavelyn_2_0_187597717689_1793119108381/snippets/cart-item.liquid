{%- comment -%}
  {% render 'cart-item', item: item, index: forloop.index %}
{%- endcomment -%}
<div class="cart-item" data-cart-item="{{ item.key }}">
  <a class="cart-item__image" href="{{ item.url }}">
    {%- if item.image -%}
      {{
        item.image
        | image_url: width: 200
        | image_tag:
          widths: '100, 150, 200',
          sizes: '80px',
          loading: 'lazy',
          alt: item.image.alt | default: item.product.title | escape
      }}
    {%- endif -%}
  </a>

  <div class="cart-item__details">
    <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>

    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__variant">{{ item.variant.title }}</p>
    {%- endunless -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    <div class="cart-item__actions">
      <zavelyn-quantity-selector class="quantity-selector">
        <button
          type="button"
          class="quantity-selector__button"
          data-cart-qty="{{ item.quantity | minus: 1 }}"
          data-line="{{ index }}"
          aria-label="{{ 'products.product.quantity_decrease' | t }}"
        >
          {% render 'icon', icon: 'minus', size: 'sm' %}
        </button>
        <input
          class="quantity-selector__input"
          type="number"
          name="updates[]"
          id="CartQty-{{ item.key }}"
          value="{{ item.quantity }}"
          min="0"
          data-cart-qty-input
          data-line="{{ index }}"
          aria-label="{{ 'cart.general.quantity' | t: title: item.product.title }}"
        >
        <button
          type="button"
          class="quantity-selector__button"
          data-cart-qty="{{ item.quantity | plus: 1 }}"
          data-line="{{ index }}"
          aria-label="{{ 'products.product.quantity_increase' | t }}"
        >
          {% render 'icon', icon: 'plus', size: 'sm' %}
        </button>
      </zavelyn-quantity-selector>

      <button
        type="button"
        class="cart-item__remove"
        data-cart-remove="{{ index }}"
        aria-label="{{ 'cart.general.remove' | t: title: item.product.title }}"
      >
        {{ 'sections.cart.remove' | t }}
      </button>

      <span class="cart-item__price">{{ item.final_line_price | money }}</span>
    </div>
  </div>
</div>
