{% comment %}
  Clone-navage/sections/navage-how-it-works.liquid
  1:1 Naväge 3-Step "From Congested to Clear" Section
{% endcomment %}

<div id="SectionId-{{ section.id }}" class="navage-how-it-works">
  <div class="navage-section-container">
    <div class="navage-section-header">
      <span class="navage-section-tag">EFFORTLESS OPERATION</span>
      <h2 class="navage-section-heading">From Congested to Clear in 3 Simple Steps</h2>
      <p class="navage-section-subheading">
        Unlike Neti pots that push water with gravity or bulb syringes that push allergens further in, Naväge uses gentle powered suction.
      </p>
    </div>

    <div class="navage-steps-grid">
      <!-- Step 1 -->
      <div class="navage-step-card">
        <div class="navage-step-num">1</div>
        <div class="navage-step-icon-area">
          <span class="navage-step-icon">💧</span>
        </div>
        <h3 class="navage-step-title">READY</h3>
        <p class="navage-step-desc">
          Fill the upper tank with warm distilled or filtered water. Drop in an authentic Naväge SaltPod capsule and close the lid to mix perfectly.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="navage-step-card">
        <div class="navage-step-num">2</div>
        <div class="navage-step-icon-area">
          <span class="navage-step-icon">👃</span>
        </div>
        <h3 class="navage-step-title">SET</h3>
        <p class="navage-step-desc">
          Position the soft silicone nose pillows snugly against your nostrils to create a comfortable, gentle seal. Stand upright and relax.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="navage-step-card highlight">
        <div class="navage-step-num">3</div>
        <div class="navage-step-icon-area">
          <span class="navage-step-icon">🌀</span>
        </div>
        <h3 class="navage-step-title">FLOW</h3>
        <p class="navage-step-desc">
          Press the button. Gentle suction pulls refreshing saline into one nostril, loops around the nasal cavity, and flushes gunk into the bottom tank.
        </p>
      </div>
    </div>

    <!-- CTA & Demo Link -->
    <div class="navage-steps-cta-wrap">
      <a href="/products/navage-advanced-nose-cleaner" class="navage-btn-primary">
        GET STARTED WITH NAVÄGE
      </a>
      <a href="/pages/how-does-navage-work" class="navage-btn-link">
        Watch 30-Second Video Demo →
      </a>
    </div>
  </div>
</div>

<style>
  #SectionId-{{ section.id }} {
    padding: 90px 24px;
    background-color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  #SectionId-{{ section.id }} .navage-section-container {
    max-width: 1240px;
    margin: 0 auto;
  }
  #SectionId-{{ section.id }} .navage-section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 60px;
  }
  #SectionId-{{ section.id }} .navage-section-tag {
    color: #00A3E0;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 12px;
  }
  #SectionId-{{ section.id }} .navage-section-heading {
    color: #003B71;
    font-size: 40px;
    font-weight: 900;
    margin: 0 0 16px;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }
  #SectionId-{{ section.id }} .navage-section-subheading {
    color: #556B7D;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }
  #SectionId-{{ section.id }} .navage-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-bottom: 50px;
  }
  #SectionId-{{ section.id }} .navage-step-card {
    background: #F8FBFC;
    border: 1px solid #E1EDF2;
    border-radius: 16px;
    padding: 40px 30px;
    position: relative;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  #SectionId-{{ section.id }} .navage-step-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 59, 113, 0.08);
  }
  #SectionId-{{ section.id }} .navage-step-card.highlight {
    background: #F0F9FD;
    border-color: #BBE4F7;
  }
  #SectionId-{{ section.id }} .navage-step-num {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 32px;
    height: 32px;
    background: #003B71;
    color: #ffffff;
    font-weight: 800;
    font-size: 14px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #SectionId-{{ section.id }} .navage-step-icon-area {
    font-size: 48px;
    margin: 10px 0 20px;
  }
  #SectionId-{{ section.id }} .navage-step-title {
    color: #003B71;
    font-size: 22px;
    font-weight: 900;
    margin: 0 0 12px;
    letter-spacing: 0.5px;
  }
  #SectionId-{{ section.id }} .navage-step-desc {
    color: #556B7D;
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }
  #SectionId-{{ section.id }} .navage-steps-cta-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  #SectionId-{{ section.id }} .navage-btn-primary {
    background-color: #00A3E0;
    color: #ffffff;
    text-decoration: none;
    padding: 16px 36px;
    border-radius: 30px;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.5px;
    transition: background-color 0.2s, transform 0.1s;
    box-shadow: 0 6px 18px rgba(0, 163, 224, 0.3);
  }
  #SectionId-{{ section.id }} .navage-btn-primary:hover {
    background-color: #0087BA;
    transform: translateY(-1px);
  }
  #SectionId-{{ section.id }} .navage-btn-link {
    color: #003B71;
    font-weight: 700;
    text-decoration: none;
    font-size: 15px;
    transition: color 0.2s;
  }
  #SectionId-{{ section.id }} .navage-btn-link:hover {
    color: #00A3E0;
  }
  @media (max-width: 992px) {
    #SectionId-{{ section.id }} .navage-steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "Navage How It Works",
  "settings": []
}
{% endschema %}
