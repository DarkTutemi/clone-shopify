{% comment %}
  ZAVELYN HAIR CARE — Bold Botanical DTC Brand Footer (Section 12)
{% endcomment %}
<footer class="zvhc-footer" style="background: var(--zvhc-forest); color: #FFFFFF; padding: 72px 0 32px; border-top: 4px solid var(--zvhc-orange);">
  <div class="zvhc-container">
    <div class="zvhc-footer-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; margin-bottom: 56px;">
      <!-- Brand Statement -->
      <div class="zvhc-footer-brand" style="max-width: 320px;">
        <a href="/" class="zvhc-logo" style="text-decoration: none; display: inline-block; margin-bottom: 16px;">
          <span class="zvhc-logo-title" style="color: #FFFFFF; font-family: var(--zvhc-font-heading); font-size: 1.6rem; font-weight: 900; letter-spacing: -0.02em;">ZAVELYN</span>
          <span class="zvhc-logo-sub" style="color: var(--zvhc-lime); font-size: 0.65rem; font-weight: 800; letter-spacing: 0.22em; display: block; margin-top: -3px;">HAIR CARE</span>
        </a>
        <p style="font-size: 0.88rem; line-height: 1.6; color: #D5DFD8; margin-bottom: 20px;">
          Dedicated to pure botanical scalp therapy and radiant textured hair. Pure cold-pressed Honduran Batana and bioactive plant lipids formulated to rebuild strong, resilient strands.
        </p>
        <div style="font-size: 0.82rem; color: #A8BAAE; line-height: 1.6;">
          📍 Zavelyn Care Labs, 13101 Preston Rd, Suite 110, Dallas, TX 75240<br>
          ✉️ <a href="mailto:support@tryzavelyn.com" style="color: var(--zvhc-lime); text-decoration: none; font-weight: 700;">support@tryzavelyn.com</a>
        </div>
      </div>

      <!-- Column 1: Collections -->
      <div class="zvhc-footer-col">
        <h4 style="color: var(--zvhc-lime); font-size: 0.82rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 18px;">HAIR CARE COLLECTIONS</h4>
        <ul class="zvhc-footer-links" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem;">
          <li><a href="/collections/zvhc-all" style="color: #E2ECE5; text-decoration: none;">Shop All 7 Essentials</a></li>
          <li><a href="/collections/zvhc-batana" style="color: #E2ECE5; text-decoration: none;">Batana Hair Care</a></li>
          <li><a href="/collections/zvhc-curl" style="color: #E2ECE5; text-decoration: none;">Curl &amp; Coily Care</a></li>
          <li><a href="/collections/zvhc-scalp" style="color: #E2ECE5; text-decoration: none;">Scalp &amp; Edge Therapy</a></li>
          <li><a href="/collections/zvhc-coverage" style="color: #E2ECE5; text-decoration: none;">Instant Hair Coverage</a></li>
        </ul>
      </div>

      <!-- Column 2: Trust & Support -->
      <div class="zvhc-footer-col">
        <h4 style="color: var(--zvhc-lime); font-size: 0.82rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 18px;">CUSTOMER CARE</h4>
        <ul class="zvhc-footer-links" style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 0.88rem;">
          <li><a href="/#faq" style="color: #E2ECE5; text-decoration: none;">30-Day Money-Back Guarantee</a></li>
          <li><a href="/pages/track-order" style="color: #E2ECE5; text-decoration: none;">Track Your Package</a></li>
          <li><a href="/policies/shipping-policy" style="color: #E2ECE5; text-decoration: none;">Shipping Policy (US 2-5 Days)</a></li>
          <li><a href="/policies/refund-policy" style="color: #E2ECE5; text-decoration: none;">Returns &amp; Refund Policy</a></li>
          <li><a href="/policies/privacy-policy" style="color: #E2ECE5; text-decoration: none;">Privacy Policy</a></li>
          <li><a href="/policies/terms-of-service" style="color: #E2ECE5; text-decoration: none;">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Column 3: Newsletter -->
      <div class="zvhc-footer-col">
        <h4 style="color: var(--zvhc-lime); font-size: 0.82rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 18px;">JOIN THE HAIR RITUAL</h4>
        <p style="font-size: 0.85rem; color: #D5DFD8; margin-bottom: 14px; line-height: 1.5;">
          Subscribe to receive VIP botanical wellness guides, curl care tips, and exclusive bundle discounts.
        </p>
        <form action="/contact#contact_form" method="post" style="display: flex; gap: 8px;">
          <input type="email" name="contact[email]" placeholder="Enter your email" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); padding: 12px 14px; border-radius: 999px; color: #FFFFFF; font-size: 0.85rem; width: 100%; outline: none;" required>
          <button type="submit" style="background: var(--zvhc-orange); color: #FFFFFF; font-weight: 800; border: none; padding: 12px 20px; border-radius: 999px; cursor: pointer; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">JOIN</button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="zvhc-footer-bottom" style="border-top: 1px solid rgba(255,255,255,0.15); padding-top: 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; font-size: 0.82rem; color: #A8BAAE;">
      <div>&copy; {{ 'now' | date: '%Y' }} Zavelyn Hair Care Inc. All rights reserved.</div>
      <div style="display: flex; gap: 16px; align-items: center;">
        <span>🇺🇸 Shipped from Regional US Centers</span>
        <span>•</span>
        <span>🔒 256-Bit SSL Encrypted Checkout</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "ZVHC Footer",
  "settings": []
}
{% endschema %}
