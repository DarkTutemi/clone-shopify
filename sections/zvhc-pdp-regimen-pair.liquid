<section class="zvhc-editorial-section zvhc-regimen-pair-section" style="padding: 64px 0; background: var(--zvhc-t01-bg, #FAF6F8); border-top: 1px solid var(--zvhc-t01-border, #EAD7DD);">
  <div class="zvhc-container">
    <div style="background: #FFFFFF; border-radius: 16px; border: 1px solid var(--zvhc-t01-border, #EAD7DD); padding: 36px 32px; box-shadow: 0 4px 20px rgba(43,27,36,0.04);">
      <div style="display: grid; grid-template-columns: auto 1fr auto; gap: 28px; align-items: center;" class="zvhc-pair-grid">
        <!-- Product Thumbnail -->
        <div style="width: 120px; height: 120px; border-radius: 12px; overflow: hidden; border: 1px solid var(--zvhc-t01-border, #EAD7DD); background: #FAF6F8; flex-shrink: 0;">
          <img src="{{ pair_img }}" alt="{{ pair_name }}" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>

        <!-- Copy Details -->
        <div>
          <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 4px;">
            PERFECT RITUAL COMPANION · {{ pair_step }}
          </div>
          <h3 class="zvhc-h3" style="font-size: 1.25rem; margin-bottom: 4px; color: var(--zvhc-t01-text-main, #2B1B24);">{{ pair_name }}</h3>
          <div style="font-size: 0.85rem; color: var(--zvhc-t01-text-muted, #5A4651); font-weight: 600; margin-bottom: 8px;">{{ pair_spec }}</div>
          <p style="font-size: 0.9rem; color: var(--zvhc-t01-text-muted, #5A4651); line-height: 1.5; margin: 0; max-width: 600px;">
            {{ pair_desc }}
          </p>
        </div>

        <!-- Action / Buy Box -->
        <div style="text-align: right; flex-shrink: 0;" class="zvhc-pair-cta">
          <div style="font-size: 1.4rem; font-weight: 800; color: var(--zvhc-t01-text-main, #2B1B24); margin-bottom: 8px;">{{ pair_price }}</div>
          <button 
            type="button" 
            class="zvhc-btn-secondary" 
            style="width: 100%; min-width: 170px; padding: 12px 20px; font-size: 0.85rem; font-weight: 800;"
            onclick="zvhcQuickAddVariant('{{ pair_vid }}', this)"
          >
            + ADD TO RITUAL
          </button>
          <div style="margin-top: 6px;">
            <a href="/products/{{ pair_handle }}" style="font-size: 0.78rem; color: var(--zvhc-t01-accent-rose, #B0476E); font-weight: 700; text-decoration: underline;">
              View Full Details →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
function zvhcQuickAddVariant(vid, btn) {
  if (!vid) return;
  const originalText = btn.textContent;
  btn.textContent = 'ADDING...';
  btn.disabled = true;

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ id: vid, quantity: 1 })
  })
  .then(res => res.json())
  .then(data => {
    btn.textContent = '✓ ADDED';
    setTimeout(() => {
      window.location.href = '/cart';
    }, 400);
  })
  .catch(err => {
    console.error('Error adding pair item:', err);
    btn.textContent = originalText;
    btn.disabled = false;
  });
}
</script>
