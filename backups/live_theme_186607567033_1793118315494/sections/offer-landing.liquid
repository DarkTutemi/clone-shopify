                  assign vf = grp_vreviews.settings.item_2_fallback
                  assign vv = grp_vreviews.settings.item_2_video
                  assign vt = grp_vreviews.settings.item_2_title
                  assign vtx = grp_vreviews.settings.item_2_text
                  assign va = grp_vreviews.settings.item_2_author
                when 3
                  assign vp = grp_vreviews.settings.item_3_poster
                  assign vf = grp_vreviews.settings.item_3_fallback
                  assign vv = grp_vreviews.settings.item_3_video
                  assign vt = grp_vreviews.settings.item_3_title
                  assign vtx = grp_vreviews.settings.item_3_text
                  assign va = grp_vreviews.settings.item_3_author
                when 4
