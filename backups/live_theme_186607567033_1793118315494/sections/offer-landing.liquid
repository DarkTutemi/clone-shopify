                    </div>
                    {% render 'offer-img', image: ba_after_img, fallback: 'offer-ba-after.jpg', class: 'offer-ba__photo', alt: 'After', width: 206, height: 206, loading: 'lazy' %}
                  </div>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign day_blocks = section.blocks | where: 'type', 'timeline_day' -%}
