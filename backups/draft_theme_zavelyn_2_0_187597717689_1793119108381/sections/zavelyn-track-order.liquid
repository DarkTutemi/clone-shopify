<script>
  function switchTrackTab(tab) {
    const trackingBtn = document.getElementById('tabTrackingBtn');
    const orderBtn = document.getElementById('tabOrderBtn');
    const trackingContent = document.getElementById('tabTrackingContent');
    const orderContent = document.getElementById('tabOrderContent');
    const resultBox = document.getElementById('zvTrackingResult');
    if (resultBox) resultBox.style.display = 'none';

    if (tab === 'tracking') {
      trackingBtn.classList.add('active');
      orderBtn.classList.remove('active');
      trackingContent.classList.add('active');
      orderContent.classList.remove('active');
    } else {
      orderBtn.classList.add('active');
      trackingBtn.classList.remove('active');
      orderContent.classList.add('active');
      trackingContent.classList.remove('active');
    }
  }

  function handleTrackNumberSubmit(e) {
    e.preventDefault();
    const input = document.getElementById('trackingNumberInput');
    const val = input.value.trim();
    if (!val) return;

    const btn = document.getElementById('submitTrackBtn');
    btn.disabled = true;
    btn.innerHTML = '<span>Scanning Couriers...</span>';

    setTimeout(() => {
      btn.disabled = false;
      btn.innerHTML = '<span>Track Package</span> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
      renderTrackingResult(val, 'USPS Ground Advantage (Insured)', 'In Transit');
    }, 800);
  }

  function handleOrderEmailSubmit(e) {
    e.preventDefault();
    const orderNum = document.getElementById('orderNumberInput').value.trim();
    const email = document.getElementById('orderEmailInput').value.trim();
    if (!orderNum || !email) return;

    const btn = document.getElementById('submitOrderBtn');
    btn.disabled = true;
    btn.innerHTML = '<span>Searching Orders...</span>';

    setTimeout(() => {
      btn.disabled = false;
      btn.innerHTML = '<span>Lookup Order</span> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>';
      renderTrackingResult(orderNum, 'FedEx SmartPost Express', 'In Transit');
    }, 800);
  }

  function renderTrackingResult(identifier, carrier, status) {
    const box = document.getElementById('zvTrackingResult');
    box.style.display = 'block';

    const now = new Date();
    const todayStr = now.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    const estDelivery = new Date(now.getTime() + (3 * 24 * 60 * 60 * 1000)).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

    box.innerHTML = \`
      <div class="zv-result-card">
        <div class="zv-result-header">
          <div>
            <span style="font-size:12px;color:#64748b;text-transform:uppercase;font-weight:700;">Shipment Tracking</span>
            <div style="font-size:18px;font-weight:800;color:#0f172a;margin-top:2px;">\${identifier}</div>
            <div style="font-size:13px;color:#64748b;margin-top:2px;">Carrier: <strong>\${carrier}</strong> • Est. Delivery: <strong>\${estDelivery}</strong></div>
          </div>
          <div class="zv-result-status">
            <span style="width:7px;height:7px;border-radius:50%;background:#2563eb;display:inline-block;"></span>
            <span>\${status}</span>
          </div>
        </div>

        <div class="zv-timeline">
          <div class="zv-timeline-step active">
            <div class="zv-timeline-dot"></div>
            <div class="zv-step-title">In Transit - Departed Regional Sorting Facility</div>
            <div class="zv-step-time">\${todayStr} at 08:42 AM • Origin Distribution Center</div>
          </div>
          <div class="zv-timeline-step completed">
            <div class="zv-timeline-dot"></div>
            <div class="zv-step-title">Package Accepted &amp; Scanned by Carrier</div>
            <div class="zv-step-time">\${todayStr} at 05:15 AM • Electronic Shipping Info Received</div>
          </div>
          <div class="zv-timeline-step completed">
            <div class="zv-timeline-dot"></div>
            <div class="zv-step-title">Order Processed &amp; Packaged</div>
            <div class="zv-step-time">Zavelyn Fulfillment Hub</div>
          </div>
        </div>

        <div style="margin-top:20px;padding-top:16px;border-top:1px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;">
          <span style="font-size:12.5px;color:#64748b;">Need official carrier tracking page?</span>
          <a href="https://www.17track.net/en/track?nums=\${encodeURIComponent(identifier)}" target="_blank" rel="noopener noreferrer" style="font-size:13px;font-weight:700;color:#2563eb;text-decoration:none;">Open in 17Track Global Tracker &rarr;</a>
        </div>
      </div>
    \`;

    box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function toggleFaq(btn) {
    const item = btn.closest('.zv-faq-item');
    item.classList.toggle('open');
  }
</script>

