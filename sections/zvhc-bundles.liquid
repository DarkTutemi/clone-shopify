{% comment %}
  ZAVELYN HAIR CARE — Routine Bundles (Section 10)
{% endcomment %}
<section class="zvhc-bundles-section" id="bundles" style="padding: 80px 0; background: #FFFFFF;">
  <div class="zvhc-container">
    <div class="zvhc-section-header" style="text-align: center; max-width: 680px; margin: 0 auto 52px;">
      <div class="zvhc-eyebrow" style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 8px;">CURATED ROUTINES</div>
      <h2 class="zvhc-heading-md" style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: clamp(2rem, 3.8vw, 2.8rem); font-weight: 900; letter-spacing: -0.02em; margin: 0 0 14px;">Complete Multi-Product Sets</h2>
      <p style="color: var(--zvhc-forest); font-size: 1.05rem; line-height: 1.5; opacity: 0.85;">Save up to 40% when pairing our targeted scalp therapies with styling essentials. Complete routines designed to work better together.</p>
    </div>

    <div class="zvhc-bundles-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px;">
      
      <!-- Bundle 1: Scalp & Edge Duo -->
      <div style="background: var(--zvhc-ivory); border-radius: 24px; padding: 32px 24px; border: 2px solid rgba(1,93,71,0.08); display: flex; flex-direction: column; position: relative;">
        <span style="position: absolute; top: 18px; right: 18px; background: var(--zvhc-green); color: var(--zvhc-lime); font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; text-transform: uppercase;">Save 33%</span>
        <div style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 6px;">Daily Edge Recovery</div>
        <h3 style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: 1.4rem; font-weight: 900; margin: 0 0 10px;">Scalp &amp; Edge Care Duo</h3>
        <p style="font-size: 0.9rem; color: #555; line-height: 1.45; margin-bottom: 18px;">Combines Pure Batana Scalp Oil (60ml) and Precision Hairline Shadow Compact (4g) for daily nourishment plus instant temple perfecting.</p>
        
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" alt="Batana Oil" style="width: 72px; height: 72px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(0,0,0,0.08);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256808781854155-hero.jpg?v=1795264431" alt="Hairline Compact" style="width: 72px; height: 72px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(0,0,0,0.08);">
        </div>

        <div style="display: flex; align-items: baseline; gap: 10px; margin-top: auto; margin-bottom: 20px;">
          <span style="font-size: 1.6rem; font-weight: 900; color: var(--zvhc-forest);">$49.99</span>
          <span style="font-size: 1rem; text-decoration: line-through; color: #888;">$74.98</span>
          <span style="font-size: 0.8rem; font-weight: 800; color: var(--zvhc-orange); background: rgba(253,85,10,0.1); padding: 2px 8px; border-radius: 6px;">You Save $24.99</span>
        </div>
        <a href="/products/zvhc-batana-hair-growth-oil" style="display: block; text-align: center; background: var(--zvhc-forest); color: var(--zvhc-lime); font-weight: 800; font-size: 0.95rem; padding: 14px 20px; border-radius: 999px; text-decoration: none;">
          BUILD THIS DUO →
        </a>
      </div>

      <!-- Bundle 2: Instant Density Kit -->
      <div style="background: var(--zvhc-ivory); border-radius: 24px; padding: 32px 24px; border: 3px solid var(--zvhc-orange); display: flex; flex-direction: column; position: relative; box-shadow: 0 12px 36px rgba(253,85,10,0.12);">
        <span style="position: absolute; top: -14px; left: 50%; transform: translateX(-50%); background: var(--zvhc-orange); color: #FFF; font-size: 0.75rem; font-weight: 900; padding: 5px 14px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.05em;">★ MOST POPULAR KIT</span>
        <div style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 6px;">Instant Fullness</div>
        <h3 style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: 1.4rem; font-weight: 900; margin: 0 0 10px;">Instant Density 3-Piece Kit</h3>
        <p style="font-size: 0.9rem; color: #555; line-height: 1.45; margin-bottom: 18px;">The ultimate cosmetic fullness kit: Keratin Building Fibers (100g) + Root-Lift Powder (10g) + Precision Hairline Shadow Compact (4g).</p>
        
        <div style="display: flex; gap: 12px; margin-bottom: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811885406846-hero.jpg?v=1795264423" alt="Keratin Fibers" style="width: 72px; height: 72px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(0,0,0,0.08);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256810605010511-hero.jpg?v=1795264427" alt="Root Powder" style="width: 72px; height: 72px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(0,0,0,0.08);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256808781854155-hero.jpg?v=1795264431" alt="Hairline Compact" style="width: 72px; height: 72px; object-fit: cover; border-radius: 12px; border: 1px solid rgba(0,0,0,0.08);">
        </div>

        <div style="display: flex; align-items: baseline; gap: 10px; margin-top: auto; margin-bottom: 20px;">
          <span style="font-size: 1.6rem; font-weight: 900; color: var(--zvhc-forest);">$69.99</span>
          <span style="font-size: 1rem; text-decoration: line-through; color: #888;">$94.97</span>
          <span style="font-size: 0.8rem; font-weight: 800; color: var(--zvhc-orange); background: rgba(253,85,10,0.1); padding: 2px 8px; border-radius: 6px;">You Save $24.98</span>
        </div>
        <a href="/products/zvhc-keratin-hair-building-fibers" style="display: block; text-align: center; background: var(--zvhc-orange); color: #FFF; font-weight: 800; font-size: 0.95rem; padding: 14px 20px; border-radius: 999px; text-decoration: none; box-shadow: 0 6px 18px rgba(253,85,10,0.3);">
          GET THE DENSITY KIT →
        </a>
      </div>

      <!-- Bundle 3: Wash-to-Style Routine -->
      <div style="background: var(--zvhc-ivory); border-radius: 24px; padding: 32px 24px; border: 2px solid rgba(1,93,71,0.08); display: flex; flex-direction: column; position: relative;">
        <span style="position: absolute; top: 18px; right: 18px; background: var(--zvhc-green); color: var(--zvhc-lime); font-size: 0.75rem; font-weight: 800; padding: 4px 10px; border-radius: 999px; text-transform: uppercase;">Save 35%</span>
        <div style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.8rem; text-transform: uppercase; margin-bottom: 6px;">Total Hair Wellness</div>
        <h3 style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: 1.4rem; font-weight: 900; margin: 0 0 10px;">Wash-to-Style 4-Piece Routine</h3>
        <p style="font-size: 0.9rem; color: #555; line-height: 1.45; margin-bottom: 18px;">Complete botanical regimen: Scalp Balm (20g) + Batana Oil (60ml) + Curl Cream (100ml) + 7-in-1 Elixir (60ml).</p>
        
        <div style="display: flex; gap: 8px; margin-bottom: 20px;">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807671072569-hero.jpg?v=1795264435" alt="Scalp Balm" style="width: 58px; height: 58px; object-fit: cover; border-radius: 10px; border: 1px solid rgba(0,0,0,0.08);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" alt="Batana Oil" style="width: 58px; height: 58px; object-fit: cover; border-radius: 10px; border: 1px solid rgba(0,0,0,0.08);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811372233630-hero.jpg?v=1795264440" alt="Curl Cream" style="width: 58px; height: 58px; object-fit: cover; border-radius: 10px; border: 1px solid rgba(0,0,0,0.08);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811903160451-hero.jpg?v=1795264444" alt="7-in-1 Elixir" style="width: 58px; height: 58px; object-fit: cover; border-radius: 10px; border: 1px solid rgba(0,0,0,0.08);">
        </div>

        <div style="display: flex; align-items: baseline; gap: 10px; margin-top: auto; margin-bottom: 20px;">
          <span style="font-size: 1.6rem; font-weight: 900; color: var(--zvhc-forest);">$89.99</span>
          <span style="font-size: 1rem; text-decoration: line-through; color: #888;">$134.96</span>
          <span style="font-size: 0.8rem; font-weight: 800; color: var(--zvhc-orange); background: rgba(253,85,10,0.1); padding: 2px 8px; border-radius: 6px;">You Save $44.97</span>
        </div>
        <a href="/products/zvhc-botanical-curl-cream" style="display: block; text-align: center; background: var(--zvhc-forest); color: var(--zvhc-lime); font-weight: 800; font-size: 0.95rem; padding: 14px 20px; border-radius: 999px; text-decoration: none;">
          BUILD WASH ROUTINE →
        </a>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "ZVHC Bundles",
  "settings": []
}
{% endschema %}
