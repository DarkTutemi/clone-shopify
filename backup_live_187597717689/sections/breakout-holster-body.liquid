      font-size: 24px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--bh-black);
      margin: 0 0 12px 0;
    }

    #Section-{{ section.id }} .bh-feature-pills-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 20px;
    }

    #Section-{{ section.id }} .bh-feature-pill-box {
      background: #FFF5F5;
      border: 1px solid #F8D7DA;
      border-radius: 10px;
      padding: 14px 16px;
