<style>
  #MainContent { overflow-x: hidden; }
  /* Sticky Product Bar */
  .thx-sticky-atc-bar {
    position: fixed;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(120px);
    background: #ffffff;
    border-radius: 50px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px 14px 8px 10px;
    z-index: 9999;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    opacity: 0;
    max-width: 95vw;
  }
  .thx-sticky-atc-bar.is-visible {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }
  .thx-sticky-atc-bar img {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }
  .thx-sticky-title {
    font-weight: 700;
    font-size: 14px;
    color: #111;
  }
  .thx-sticky-price {
    font-weight: 800;
    font-size: 15px;
    color: #ff6e26;
  }
  .thx-sticky-compare {
    font-size: 13px;
    color: #888;
    text-decoration: line-through;
    margin-left: 4px;
  }
  .thx-sticky-select {
    border: 1px solid #ddd;
    border-radius: 20px;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
    background: #fdfdfd;
    cursor: pointer;
    outline: none;
  }
  .thx-sticky-btn {
    background: linear-gradient(135deg, #ff7e1b, #f35900);
    color: #ffffff;
    font-weight: 800;
    font-size: 14px;
    padding: 10px 20px;
    border-radius: 30px;
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(243, 89, 0, 0.4);
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .thx-sticky-btn:hover {
    filter: brightness(1.08);
    transform: scale(1.02);
  }

  /* Quantity break card active style */
  .quantity-break {
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .quantity-breaks-container input[type="radio"]:checked + .quantity-break {
    border-color: #ff6e26 !important;
    box-shadow: 0 0 0 1px #ff6e26;
  }
</style>
