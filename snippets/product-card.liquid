{%- liquid
  assign card_product = product
  assign savings_pct = 0
  if card_product.compare_at_price > card_product.price
    assign savings_pct = card_product.compare_at_price | minus: card_product.price | times: 100.0 | divided_by: card_product.compare_at_price | round
  endif

  assign catalog_img = card_product.featured_image
  assign catalog_fit = 'contain'

  for block in section.blocks
    if block.type == 'product_image_override' or block.type == 'cutout_override'
      if block.settings.enable_override and block.settings.reset_original != true
        if block.settings.product.id == card_product.id or block.settings.product.handle == card_product.handle or block.settings.product == card_product.handle
          if block.settings.catalog_image != blank
            assign catalog_img = block.settings.catalog_image
            assign catalog_fit = block.settings.catalog_image_fit | default: 'contain'
          elsif block.settings.use_same_image and block.settings.showroom_image != blank
            assign catalog_img = block.settings.showroom_image
          elsif block.settings.use_same_image and block.settings.cutout_image != blank
            assign catalog_img = block.settings.cutout_image
          endif
        endif
      endif
    endif
  endfor

  if catalog_img == card_product.featured_image and card_product.metafields.custom.catalog_image != blank
    assign catalog_img = card_product.metafields.custom.catalog_image
  endif
-%}

<div class="zv-prod-card" data-product-id="{{ card_product.id }}">
  <a href="{{ card_product.url }}" class="zv-prod-media">
    {%- if catalog_img -%}
      <img class="zv-img-primary" src="{{ catalog_img | image_url: width: 600 }}" alt="{{ card_product.title | escape }}" loading="lazy" style="object-fit: {{ catalog_fit }};">
      {%- if card_product.images.size > 1 -%}
        <img class="zv-img-secondary" src="{{ card_product.images[1] | image_url: width: 600 }}" alt="{{ card_product.title | escape }}" loading="lazy">
      {%- endif -%}
    {%- else -%}
      <img class="zv-img-primary" src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/placeholder.jpg" alt="{{ card_product.title | escape }}" loading="lazy">
    {%- endif -%}

    <div class="zv-badges-wrap">
      {%- if savings_pct > 0 -%}
        <span class="zv-badge-sale">SAVE {{ savings_pct }}%</span>
      {%- endif -%}
    </div>

    <span class="zv-badge-tag">★ TOP RATED</span>
  </a>

  <div class="zv-prod-body">
    {%- case card_product.handle -%}
      {%- when 'zvhc-batana-hair-growth-oil' -%}
        {%- assign card_tp_rating = '4.9' -%}
        {%- assign card_tp_reviews = '28,490' -%}
      {%- when 'zvhc-raw-batana-scalp-balm' -%}
        {%- assign card_tp_rating = '4.9' -%}
        {%- assign card_tp_reviews = '31,240' -%}
      {%- when 'zvhc-7-in-1-growth-elixir' -%}
        {%- assign card_tp_rating = '4.8' -%}
        {%- assign card_tp_reviews = '26,180' -%}
      {%- when 'zvhc-precision-hairline-compact' -%}
        {%- assign card_tp_rating = '4.8' -%}
        {%- assign card_tp_reviews = '22,650' -%}
      {%- when 'zvhc-keratin-hair-building-fibers' -%}
        {%- assign card_tp_rating = '4.8' -%}
        {%- assign card_tp_reviews = '19,340' -%}
      {%- when 'zvhc-botanical-curl-cream' -%}
        {%- assign card_tp_rating = '4.7' -%}
        {%- assign card_tp_reviews = '16,850' -%}
      {%- when 'zvhc-root-lift-styling-powder' -%}
        {%- assign card_tp_rating = '4.7' -%}
        {%- assign card_tp_reviews = '13,920' -%}
      {%- when 'zvhc-batana-deep-conditioning-hair-mask' -%}
        {%- assign card_tp_rating = '4.9' -%}
        {%- assign card_tp_reviews = '24,310' -%}
      {%- else -%}
        {%- assign c_mod = card_product.id | default: 123456 | modulo: 4 -%}
        {%- if c_mod == 0 -%}{%- assign card_tp_rating = '4.9' -%}{%- assign card_tp_reviews = '27,850' -%}
        {%- elsif c_mod == 1 -%}{%- assign card_tp_rating = '4.8' -%}{%- assign card_tp_reviews = '21,430' -%}
        {%- elsif c_mod == 2 -%}{%- assign card_tp_rating = '4.7' -%}{%- assign card_tp_reviews = '18,620' -%}
        {%- else -%}{%- assign card_tp_rating = '4.6' -%}{%- assign card_tp_reviews = '14,290' -%}
        {%- endif -%}
    {%- endcase -%}
    <div class="zv-rating-row" style="display:inline-flex;align-items:center;gap:6px;">
      {% render 'trustpilot-stars', width: 72, height: 14 %}
      <span class="zv-rating-num" style="font-weight:700;font-size:0.85rem;color:#111827;">{{ card_tp_rating }}</span>
      <span class="zv-review-count" style="font-size:0.78rem;color:#6b7280;">({{ card_tp_reviews }})</span>
    </div>

    <h3 class="zv-prod-title">
      <a href="{{ card_product.url }}" title="{{ card_product.title | escape }}">{{ card_product.title }}</a>
    </h3>

    <div class="zv-prod-price-row">
      <span class="zv-price-current">{{ card_product.price | money }}</span>
      {%- if card_product.compare_at_price > card_product.price -%}
        <span class="zv-price-compare">{{ card_product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>

    <div class="zv-card-action">
      {%- if card_product.available -%}
        <button type="button" class="zv-atc-btn" onclick="zvQuickAddToCart('{{ card_product.first_available_variant.id }}', this)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
          <span>Add to Cart</span>
        </button>
      {%- else -%}
        <button type="button" class="zv-atc-btn sold-out" disabled>
          <span>Sold Out</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
