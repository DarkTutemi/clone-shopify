{% comment %}
  ZAVELYN HAIR CARE — T01 Style Editorial Campaign Hero
{% endcomment %}
<section class="zvhc-editorial-section" style="padding: 56px 0 72px;">
  <div class="zvhc-container">
    <div class="zvhc-editorial-grid">
      <!-- Left Content Column -->
      <div>
        <div style="display: inline-flex; align-items: center; gap: 6px; background: var(--zvhc-t01-pill-bg, #F8E4EB); color: var(--zvhc-t01-accent-rose, #B0476E); font-size: 0.78rem; font-weight: 800; letter-spacing: 0.08em; padding: 6px 14px; border-radius: 9999px; text-transform: uppercase; margin-bottom: 20px;">
          <span>✦ PURE BOTANICAL STRAND THERAPY</span>
        </div>
        
        <h1 class="zvhc-h1" style="margin-bottom: 18px;">
          {{ section.settings.headline | default: 'Transform Dry Strands Into Resilient, Radiant Hair' }}
        </h1>
        
        <p style="font-size: 1.05rem; line-height: 1.6; margin-bottom: 28px; max-width: 520px;">
          {{ section.settings.subhead | default: 'Formulated with pure cold-pressed Honduran Batana and bioactive plant lipids to deeply nourish the scalp, seal damaged cuticles, and rebuild hair resilience.' }}
        </p>
        
        <div style="display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-bottom: 32px;">
          <a href="{{ section.settings.primary_cta_url | default: '/collections/zvhc-all' }}" class="zvhc-btn-primary" style="width: auto;">
            {{ section.settings.primary_cta_text | default: 'SHOP ALL 8 BOTANICAL ESSENTIALS →' }}
          </a>
          <a href="{{ section.settings.secondary_cta_url | default: '#routine' }}" class="zvhc-btn-secondary">
            {{ section.settings.secondary_cta_text | default: 'EXPLORE THE 4-STEP RITUAL' }}
          </a>
        </div>
        
        <!-- Botanical Formulation Line -->
        <div style="display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--zvhc-t01-border, #EAD7DD); padding-top: 20px;">
          <div class="zvhc-stars" style="color: var(--zvhc-t01-star-gold, #E0A33A);">★★★★★</div>
          <div style="font-size: 0.88rem; font-weight: 600; color: var(--zvhc-t01-text-muted, #5A4651);">
            Pure Honduran Batana &amp; Bioactive Plant Lipids · Clean Cosmetic Formulation
          </div>
        </div>
      </div>

      <!-- Right Visual Column -->
      <div style="text-align: center;">
        <div style="position: relative; display: inline-block; width: 100%; max-width: 480px; border-radius: var(--zvhc-radius-img, 16px); overflow: hidden; box-shadow: 0 12px 36px rgba(43,27,36,0.08); border: 1px solid var(--zvhc-t01-border, #EAD7DD); background: #FFF;">
          <img 
            src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" 
            alt="Pure Honduran Batana Hair Growth Oil" 
            style="width: 100%; height: auto; display: block; object-fit: cover;"
            loading="eager"
          >
          <div style="padding: 16px 20px; background: #FFFFFF; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--zvhc-t01-border, #EAD7DD); text-align: left;">
            <div>
              <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase;">100% Raw Batana Oil</div>
              <div style="font-size: 0.95rem; font-weight: 700; color: var(--zvhc-t01-text-main, #2B1B24);">Pure Scalp &amp; Hair Ritual (60ml)</div>
            </div>
            <div style="font-weight: 800; font-size: 1.15rem; color: var(--zvhc-t01-text-main, #2B1B24);">$39.99</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ZVHC T01 Hero",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Transform Dry Strands Into Resilient, Radiant Hair"
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Formulated with pure cold-pressed Honduran Batana and bioactive plant lipids to deeply nourish the scalp, seal damaged cuticles, and rebuild hair resilience."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "SHOP ALL 7 ESSENTIALS →"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "EXPLORE THE 4-STEP RITUAL"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA URL"
    }
  ]
}
{% endschema %}
