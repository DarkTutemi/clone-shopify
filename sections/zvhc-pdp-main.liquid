{% comment %}
  ZAVELYN HAIR CARE — T01 Main Product Buy Box (v5.0 Master Integrated Fix)
  Decoupled data model for all 8 SKUs, verified INCI & safety, accurate savings math,
  authentic trust indicators, Shopify official payment badges, accessible ARIA states.
{% endcomment %}

{% assign has_shades = false %}
{% for option in product.options_with_values %}
  {% assign opt_name = option.name | downcase %}
  {% if opt_name == 'shade' or opt_name == 'color' %}
    {% assign has_shades = true %}
    {% assign shade_option = option %}
  {% endif %}
{% endfor %}

{% comment %} Calculate initial tier prices dynamically from actual product variants {% endcomment %}
{% if product.handle == 'zavelyn-botanaroots-organic-batana-hair-growth-oil' %}
  {% assign tier1_price = '$39.99' %}
  {% assign tier1_compare = '$80.00' %}
  {% assign tier1_num = 39.99 %}

  {% assign tier2_price = '$79.98' %}
  {% assign tier2_compare = '$160.00' %}
  {% assign tier2_num = 79.98 %}

  {% assign tier3_price = '$95.99' %}
  {% assign tier3_compare = '$240.00' %}
  {% assign tier3_num = 95.99 %}

  {% assign default_cta_price = '$79.98' %}
{% elsif product.variants.size >= 3 %}
  {% assign tier1_price = product.variants[0].price | money %}
  {% assign tier1_compare = product.variants[0].compare_at_price | money %}
  {% assign tier1_num = product.variants[0].price | divided_by: 100.0 %}

  {% assign tier2_price = product.variants[1].price | money %}
  {% assign tier2_compare = product.variants[1].compare_at_price | money %}
  {% assign tier2_num = product.variants[1].price | divided_by: 100.0 %}

  {% assign tier3_price = product.variants[2].price | money %}
  {% assign tier3_compare = product.variants[2].compare_at_price | money %}
  {% assign tier3_num = product.variants[2].price | divided_by: 100.0 %}

  {% assign default_cta_price = product.variants[1].price | money %}
{% else %}
  {% assign tier1_price = product.price | money %}
  {% assign tier1_compare = product.compare_at_price | money %}
  {% assign tier1_num = product.price | divided_by: 100.0 %}
  {% assign tier2_price = product.price | money %}
  {% assign tier2_compare = product.compare_at_price | money %}
  {% assign tier2_num = product.price | divided_by: 100.0 %}
  {% assign tier3_price = product.price | money %}
  {% assign tier3_compare = product.compare_at_price | money %}
  {% assign tier3_num = product.price | divided_by: 100.0 %}
  {% assign default_cta_price = product.price | money %}
{% endif %}

{% comment %} Calculate real unit-baseline savings percentage {% endcomment %}
{% assign duo_baseline = tier1_num | times: 2 %}
{% assign duo_savings_val = duo_baseline | minus: tier2_num %}
{% if duo_savings_val > 0 and duo_baseline > 0 %}
  {% assign duo_save_pct = duo_savings_val | divided_by: duo_baseline | times: 100 | round %}
{% else %}
  {% assign duo_save_pct = 0 %}
{% endif %}

{% assign trio_baseline = tier1_num | times: 3 %}
{% assign trio_savings_val = trio_baseline | minus: tier3_num %}
{% if trio_savings_val > 0 and trio_baseline > 0 %}
  {% assign trio_save_pct = trio_savings_val | divided_by: trio_baseline | times: 100 | round %}
{% else %}
  {% assign trio_save_pct = 0 %}
{% endif %}

