{%- liquid
  if request.page_type == 'product' and product != blank
    assign offer_product = product
  elsif section.settings.product != blank
    assign offer_product = section.settings.product
  else
    assign offer_product = all_products['zavelyn-rehabilitation-glove']
  endif
  if offer_product == blank
    assign offer_product = collections.all.products.first
  endif
  assign product = offer_product
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
  assign brand = s.brand_name | default: 'Zavelyn'
  assign cta_label = s.cta_label | default: 'BUY NOW'
  assign sec_gallery = section.blocks | where: 'type', 'sec_gallery' | first
  assign sec_hero = section.blocks | where: 'type', 'sec_hero' | first
  assign hs = sec_hero.settings
  assign sec_marquee = section.blocks | where: 'type', 'sec_marquee' | first
  assign sec_story = section.blocks | where: 'type', 'sec_story' | first
  assign sec_reps = section.blocks | where: 'type', 'sec_reps' | first
  assign sec_train = section.blocks | where: 'type', 'sec_train' | first
  assign sec_features = section.blocks | where: 'type', 'sec_features' | first
  assign sec_journey = section.blocks | where: 'type', 'sec_journey' | first
  assign sec_routine = section.blocks | where: 'type', 'sec_routine' | first
  assign sec_howto = section.blocks | where: 'type', 'sec_howto' | first
  assign sec_practice = section.blocks | where: 'type', 'sec_practice' | first
  assign sec_benefits = section.blocks | where: 'type', 'sec_benefits' | first
  assign sec_realistic = section.blocks | where: 'type', 'sec_realistic' | first
  assign sec_stats = section.blocks | where: 'type', 'sec_stats' | first
  assign sec_compare = section.blocks | where: 'type', 'sec_compare' | first
  assign sec_timeline = section.blocks | where: 'type', 'sec_timeline' | first
  assign sec_reviews = section.blocks | where: 'type', 'sec_reviews' | first
  assign sec_faq = section.blocks | where: 'type', 'sec_faq' | first
  assign sec_footer = section.blocks | where: 'type', 'sec_footer' | first

  assign side_option = blank
  assign size_option = blank
  if product != blank
    for opt in product.options_with_values
      assign oname = opt.name | downcase
      if oname contains 'side' or oname contains 'hand'
        assign side_option = opt
      elsif oname contains 'size'
        assign size_option = opt
      endif
    endfor
  endif

  assign pack1_variant = current_variant
  assign rg_unit = 8900
  assign rg_pair_before = rg_unit | times: 2
  assign rg_pair = rg_pair_before | times: 85 | divided_by: 100
  assign rg_compare = pack1_variant.compare_at_price | default: 18000
  if rg_compare <= rg_unit
    assign rg_compare = 18000
  endif
  assign rg_save = rg_compare | minus: rg_unit
  if product.variants.size > 0
    assign pack1_variant = product.variants.first
  endif
  # Buy 2 uses same variant id x2 quantity when no dedicated pack variant
  assign sticky_copy = 'Zavelyn Rehabilitation Glove'
  if sec_footer and sec_footer.settings.sticky_copy != blank
    assign sticky_copy = sec_footer.settings.sticky_copy
  endif
-%}
{% render 'offer-seo', product: product, section: section %}
{{ 'offer-zavelyn.css' | asset_url | stylesheet_tag }}

<script type="application/json" id="RgVariantMap">
[
{%- for v in product.variants -%}
  {"id":{{ v.id }},"available":{{ v.available | json }},"price":{{ v.price | json }},"compare":{{ v.compare_at_price | default: 0 | json }},"option1":{{ v.option1 | json }},"option2":{{ v.option2 | json }},"option3":{{ v.option3 | json }},"title":{{ v.title | json }},"money":{{ v.price | money_without_trailing_zeros | json }},"compare_money":{{ v.compare_at_price | money_without_trailing_zeros | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
</script>

<div class="offer-page offer-page--zavelyn" id="OfferTop">
  <div class="offer-ticker">
    <p class="offer-ticker__line">📦 {{ s.ticker_text | default: 'FREE Worldwide Shipping —' }} <span>{{ s.ticker_highlight | default: 'This Week Only!' }}</span></p>
  </div>
  {% render 'offer-header', brand: brand, product: product %}

  {%- comment -%} ===== HERO + BUY BOX ===== {%- endcomment -%}
  <section class="offer-hero">
    <div class="offer-hero__grid">
      <div class="offer-hero__left">
        <div class="offer-media" data-offer-gallery>
          <div class="offer-media__stage">
            {%- if sec_gallery and sec_gallery.settings.image_1 != blank -%}
              {%- assign main_src = sec_gallery.settings.image_1 | image_url: width: 1200 -%}
            {%- elsif sec_gallery and sec_gallery.settings.fallback_1 != blank -%}
              {%- assign main_src = sec_gallery.settings.fallback_1 | asset_url -%}
            {%- else -%}
              {%- assign main_src = 'zavelyn-gallery-1.png' | asset_url -%}
            {%- endif -%}
            <button type="button" class="offer-media__zoom" data-offer-zoom aria-label="Open gallery">
              <img data-offer-main src="{{ main_src }}" alt="{{ product.title | escape }}" width="1200" height="1200" fetchpriority="high">
            </button>
            <video class="offer-media__video" data-offer-main-video hidden playsinline controls preload="metadata"></video>
            <iframe class="offer-media__video" data-offer-main-frame hidden title="Product video" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
            <button type="button" class="offer-media__nav offer-media__nav--prev" data-offer-prev aria-label="Previous">❮</button>
            <button type="button" class="offer-media__nav offer-media__nav--next" data-offer-next aria-label="Next">❯</button>
          </div>
          <div class="offer-thumbs" role="list" {% if sec_gallery %}{{ sec_gallery.shopify_attributes }}{% endif %}>
            {%- if sec_gallery -%}
              {% render 'offer-group-slots', group: sec_gallery, mode: 'gallery', count: 7 %}
            {%- else -%}
              {%- assign galleries = 'zavelyn-gallery-1.png,zavelyn-gallery-2.png,zavelyn-gallery-3.png,zavelyn-gallery-4.png,zavelyn-gallery-5.png,zavelyn-gallery-6.png,zavelyn-gallery-7.png' | split: ',' -%}
              {%- for file in galleries -%}
                <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-offer-thumb data-index="{{ forloop.index0 }}" data-src="{{ file | asset_url }}" aria-label="Image {{ forloop.index }}">
                  <img src="{{ file | asset_url }}" alt="" width="60" height="60" {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="offer-hero__right">
        <a class="rg-rating-bar" href="#REVIEW">
          <span class="rg-rating-bar__stars" aria-hidden="true">★★★★★</span>
          <span><strong>{{ hs.rating_score | default: '4.8/5' }}</strong> • {{ hs.rating_note | default: 'Trusted by stroke survivors and caregivers' }}</span>
        </a>
        <h1 class="offer-title">{{ product.title | default: 'Zavelyn | Rehabilitation Glove' }}</h1>

        <div class="rg-perks" {% if sec_hero %}{{ sec_hero.shopify_attributes }}{% endif %}>
          <div class="rg-perk">{%- assign perk_1_fb = hs.perk_1_fallback | default: 'zavelyn-icon-hand.png' -%}{% render 'offer-img', image: hs.perk_1_icon, fallback: perk_1_fb, alt: '', width: 40, height: 40, loading: 'eager' %}<span>{{ hs.perk_1 | default: 'Guided hand opening & closing' }}</span></div>
          <div class="rg-perk">{%- assign perk_2_fb = hs.perk_2_fallback | default: 'zavelyn-icon-home.png' -%}{% render 'offer-img', image: hs.perk_2_icon, fallback: perk_2_fb, alt: '', width: 40, height: 40, loading: 'eager' %}<span>{{ hs.perk_2 | default: 'Use It Alone or With a Helper' }}</span></div>
          <div class="rg-perk">{%- assign perk_3_fb = hs.perk_3_fallback | default: 'zavelyn-icon-muscle.png' -%}{% render 'offer-img', image: hs.perk_3_icon, fallback: perk_3_fb, alt: '', width: 40, height: 40, loading: 'eager' %}<span>{{ hs.perk_3 | default: '300+ Assisted reps in 20 Minutes' }}</span></div>
          <div class="rg-perk">{%- assign perk_4_fb = hs.perk_4_fallback | default: 'zavelyn-icon-brain.png' -%}{% render 'offer-img', image: hs.perk_4_icon, fallback: perk_4_fb, alt: '', width: 40, height: 40, loading: 'eager' %}<span>{{ hs.perk_4 | default: '3 Therapy Modes for Every Stage of Recovery' }}</span></div>
        </div>

        <div class="rg-trial-divider" aria-hidden="true"><span>{{ hs.trial_label | default: '30-Day At-Home Trial' }}</span></div>

        <div class="rg-countdown" data-rg-countdown data-minutes="{{ hs.countdown_minutes | default: 10 }}">
          <span>{{ hs.countdown_text | default: 'CAREGIVER OFFER — 50% OFF ENDS IN' }} ⏳ <strong data-rg-countdown-label>10:00</strong>!</span>
        </div>

        {% form 'product', product, id: 'OfferAddForm', class: 'offer-buy-form' %}
          <input type="hidden" name="id" id="OfferVariantId" value="{{ pack1_variant.id }}">
          <input type="hidden" name="quantity" id="OfferQuantity" value="1">

          <div class="rg-packs" id="OfferPackages" data-rg-packs data-discount-code="ZAVELYN15">
            <div class="rg-pack is-active" data-rg-pack="1">
              <div class="rg-pack__main">
                <span class="rg-pack__radio" aria-hidden="true"></span>
                {%- assign pack_1_fb = hs.pack_1_fallback | default: 'zavelyn-bundle-1.png' -%}
                {% render 'offer-img', image: hs.pack_1_image, fallback: pack_1_fb, alt: 'Buy 1 One Hand', class: 'rg-pack__img', width: 88, height: 88, loading: 'eager' %}
                <div class="rg-pack__info">
                  <div class="rg-pack__title-row">
                    <p class="rg-pack__title">{{ hs.pack_1_title | default: 'Buy 1' }}</p>
                    <span class="rg-pack__pill">{{ hs.pack_1_pill | default: 'ONE HAND' }}</span>
                  </div>
                  <span class="rg-pack__save">SAVE {{ rg_save | money_without_trailing_zeros }}</span>
                </div>
                <div class="rg-pack__prices">
                  <span class="rg-pack__price" data-rg-pack1-price>{{ rg_unit | money_without_trailing_zeros }}</span>
                  <span class="rg-pack__compare" data-rg-pack1-compare>{{ rg_compare | money_without_trailing_zeros }}</span>
                </div>
              </div>
              <div class="rg-pack__opts">
                {% if side_option != blank %}
                  <label>Side of Hand &amp;
                    <select data-rg-side aria-label="Side of Hand">
                      {% for value in side_option.values %}
                        <option value="{{ value | escape }}" {% if pack1_variant.option1 == value or pack1_variant.option2 == value %}selected{% endif %}>{{ value }}</option>
                      {% endfor %}
                    </select>
                  </label>
                {% endif %}
                {% if size_option != blank %}
                  <label>Size (Required)
                    <select data-rg-size aria-label="Size">
                      {% for value in size_option.values %}
                        <option value="{{ value | escape }}" {% if pack1_variant.option1 == value or pack1_variant.option2 == value %}selected{% endif %}>{{ value }}</option>
                      {% endfor %}
                    </select>
                  </label>
                {% endif %}
              </div>
              <div class="rg-pack__bonus">{{ hs.bonus_label | default: '+ FREE 30-Day Recovery Guide' }}</div>
            </div>

            <div class="rg-pack" data-rg-pack="2">
              <span class="rg-pack__badge">{{ hs.pack_2_badge | default: 'BEST VALUE' }}</span>
              <div class="rg-pack__main">
                <span class="rg-pack__radio" aria-hidden="true"></span>
                {%- assign pack_2_fb = hs.pack_2_fallback | default: 'zavelyn-bundle-2.png' -%}
                {% render 'offer-img', image: hs.pack_2_image, fallback: pack_2_fb, alt: 'Buy 2 Both Hands', class: 'rg-pack__img', width: 88, height: 88, loading: 'lazy' %}
                <div class="rg-pack__info">
                  <div class="rg-pack__title-row">
                    <p class="rg-pack__title">{{ hs.pack_2_title | default: 'Buy 2' }}</p>
                    <span class="rg-pack__pill">{{ hs.pack_2_pill | default: '2 GLOVES' }}</span>
                  </div>
                  <span class="rg-pack__save">{{ hs.pack_2_save | default: 'Extra 15%' }}</span>
                </div>
                <div class="rg-pack__prices">
                  <span class="rg-pack__price" data-rg-pack2-price>{{ rg_pair | money_without_trailing_zeros }}</span>
                  <span class="rg-pack__compare">{{ rg_pair_before | money_without_trailing_zeros }}</span>
                </div>
              </div>
              <div class="rg-pack__opts rg-pack__opts--pair">
                <div class="rg-pack__hand">
                  <p class="rg-pack__hand-label">Glove 1</p>
                  <div class="rg-pack__hand-grid">
                    {% if side_option != blank %}
                      <label>Side of Hand
                        <select data-rg-side-a aria-label="Glove 1 side">
                          {% for value in side_option.values %}
                            <option value="{{ value | escape }}" {% if pack1_variant.option1 == value or pack1_variant.option2 == value %}selected{% endif %}>{{ value }}</option>
                          {% endfor %}
                        </select>
                      </label>
                    {% endif %}
                    {% if size_option != blank %}
                      <label>Size
                        <select data-rg-size-a aria-label="Glove 1 size">
                          {% for value in size_option.values %}
                            <option value="{{ value | escape }}" {% if pack1_variant.option1 == value or pack1_variant.option2 == value %}selected{% endif %}>{{ value }}</option>
                          {% endfor %}
                        </select>
                      </label>
                    {% endif %}
                  </div>
                </div>
                <div class="rg-pack__hand">
                  <p class="rg-pack__hand-label">Glove 2</p>
                  <div class="rg-pack__hand-grid">
                    {% if side_option != blank %}
                      <label>Side of Hand
                        <select data-rg-side-b aria-label="Glove 2 side">
                          {% for value in side_option.values %}
                            <option value="{{ value | escape }}" {% if pack1_variant.option1 == value or pack1_variant.option2 == value %}selected{% endif %}>{{ value }}</option>
                          {% endfor %}
                        </select>
                      </label>
                    {% endif %}
                    {% if size_option != blank %}
                      <label>Size
                        <select data-rg-size-b aria-label="Glove 2 size">
                          {% for value in size_option.values %}
                            <option value="{{ value | escape }}" {% if pack1_variant.option1 == value or pack1_variant.option2 == value %}selected{% endif %}>{{ value }}</option>
                          {% endfor %}
                        </select>
                      </label>
                    {% endif %}
                  </div>
                </div>
              </div>
              <div class="rg-pack__bonus">{{ hs.bonus_label | default: '+ FREE 30-Day Recovery Guide' }}</div>
            </div>
          </div>

          <button class="offer-cta rg-atc" type="submit" name="add" data-offer-checkout data-rg-cta {% unless pack1_variant.available %}disabled{% endunless %}>
            <span class="offer-cta__label">{{ cta_label }}</span>
            <span class="offer-cta__sep" aria-hidden="true">—</span>
            <span class="offer-cta__price" data-rg-cta-price>{{ rg_unit | money_without_trailing_zeros }}</span>
          </button>
        {% endform %}

        <div class="rg-pay" aria-label="Payment methods">
          {%- assign rg_payment_types = 'visa,master,american_express,apple_pay,google_pay,paypal,shopify_pay' | split: ',' -%}
          {%- for type in rg_payment_types -%}
            <img
              src="{{ type | payment_type_img_url }}"
              alt="{{ type | replace: '_', ' ' | capitalize }}"
              width="38"
              height="24"
              loading="lazy"
              decoding="async"
            >
          {%- endfor -%}
        </div>

        <div class="rg-trust">
          <div class="rg-trust__item"><span aria-hidden="true">{{ hs.trust_1_icon | default: '🚚' }}</span><span>{{ hs.trust_1 | default: 'Free Shipping' }}</span></div>
          <div class="rg-trust__item"><span aria-hidden="true">{{ hs.trust_2_icon | default: '💙' }}</span><span>{{ hs.trust_2 | default: '30-Day Guarantee' }}</span></div>
          <div class="rg-trust__item"><span aria-hidden="true">{{ hs.trust_3_icon | default: '💬' }}</span><span>{{ hs.trust_3 | default: '24/7 Chat Support' }}</span></div>
        </div>

        <button type="button" class="rg-size-btn" data-rg-size-open>{{ hs.size_btn | default: 'Find Your Correct Size' }}</button>
        <a class="rg-watch-btn" href="#howto" data-rg-watch-open>{{ hs.watch_btn | default: 'Click To Watch How To Use Zavelyn' }}</a>

        <div class="rg-replica" role="note">
          <strong>{{ hs.replica_title | default: 'Watch Out For Cheap Replicas' }}</strong>
          <span>{{ hs.replica_text | default: 'Only our brand guarantees the high quality product used by thousands for pain relief.' }}</span>
        </div>

        <div class="offer-faq device-accordion" data-offer-accordion>
          {%- for i in (1..5) -%}
            {%- capture qk -%}buy_q_{{ i }}{%- endcapture -%}
            {%- capture ak -%}buy_a_{{ i }}{%- endcapture -%}
            {%- assign qv = hs[qk] -%}
            {%- assign av = hs[ak] -%}
            {%- if qv != blank -%}
              <div class="offer-faq__item">
                <button type="button" class="offer-faq__trigger" aria-expanded="false">{{ qv }}</button>
                <div class="offer-faq__panel" hidden><div class="offer-faq__body">
                  {{ av }}
                  {%- if i == 2 -%}
                    <p><button type="button" class="rg-size-btn" data-rg-size-open style="margin:0">{{ hs.size_chart_label | default: 'Open Size Chart' }}</button></p>
                  {%- endif -%}
                </div></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <div class="rg-marquee pause-on-hover" aria-hidden="true" {% if sec_marquee %}{{ sec_marquee.shopify_attributes }}{% endif %}>
    <div class="rg-marquee__track">
      {%- capture rg_marquee_group -%}
        <div class="rg-marquee__group">
          <div class="rg-marquee__item">
            <span class="rg-marquee__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
            </span>
            <span>{{ sec_marquee.settings.item_1 | default: 'PREMIUM QUALITY' }}</span>
          </div>
          <div class="rg-marquee__item">
            <span class="rg-marquee__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-6 0H5V6h9v2zm-9 11.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm12 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
            </span>
            <span>{{ sec_marquee.settings.item_2 | default: 'FAST SHIPPING' }}</span>
          </div>
          <div class="rg-marquee__item">
            <span class="rg-marquee__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </span>
            <span>{{ sec_marquee.settings.item_3 | default: 'SATISFACTION GUARANTEED' }}</span>
          </div>
        </div>
      {%- endcapture -%}
      {{ rg_marquee_group }}{{ rg_marquee_group }}{{ rg_marquee_group }}{{ rg_marquee_group }}
    </div>
  </div>

  <section class="offer-sec offer-sec--iwt-story" {% if sec_story %}{{ sec_story.shopify_attributes }}{% endif %}>
    <div class="rg-iwt rg-iwt--rev rg-iwt--story">
      <div class="rg-iwt__media">
        {%- assign story_fb = sec_story.settings.fallback | default: 'zavelyn-iwt-therapy.gif' -%}
        {%- assign story_alt = sec_story.settings.image_alt | default: 'Zavelyn guided hand therapy' -%}
        {% render 'zavelyn-media', image: sec_story.settings.image, fallback: story_fb, video: sec_story.settings.video, video_url: sec_story.settings.video_url, source: sec_story.settings.video_source, alt: story_alt, width: 900, height: 900, loading: 'lazy' %}
      </div>
      <div class="rg-iwt__copy">
        <h2>{{ sec_story.settings.heading | default: 'When Therapy Ends, Your Hand Still Needs Daily Movement' }}</h2>
        <p>{{ sec_story.settings.p1 }}</p>
        <p>{{ sec_story.settings.p2 }}</p>
        <p>{{ sec_story.settings.p3 }}</p>
      </div>
    </div>
  </section>

  <section class="offer-sec offer-sec--iwt-blue" {% if sec_reps %}{{ sec_reps.shopify_attributes }}{% endif %}>
    <div class="rg-iwt rg-iwt--story rg-iwt--on-blue">
      <div class="rg-iwt__media">
        {%- assign reps_fb = sec_reps.settings.fallback | default: 'zavelyn-iwt-300.png' -%}
        {%- assign reps_alt = sec_reps.settings.image_alt | default: 'Up to 300 guided reps' -%}
        {% render 'zavelyn-media', image: sec_reps.settings.image, fallback: reps_fb, video: sec_reps.settings.video, video_url: sec_reps.settings.video_url, source: sec_reps.settings.video_source, alt: reps_alt, width: 900, height: 900, loading: 'lazy' %}
      </div>
      <div class="rg-iwt__copy">
        <h2>{{ sec_reps.settings.heading | default: 'Support Real Hand Movement — Up To 300 Guided Reps Per Session' }}</h2>
        <p>{{ sec_reps.settings.p1 }}</p>
        <p>{{ sec_reps.settings.p2 }}</p>
        <p>{{ sec_reps.settings.p3 }}</p>
        <p>{{ sec_reps.settings.p4 }}</p>
        <a class="rg-iwt__cta rg-iwt__cta--light" href="#OfferPackages">{{ sec_reps.settings.cta | default: 'Start Your Recovery now →' }}</a>
      </div>
    </div>
  </section>

  <section class="offer-sec offer-sec--train" aria-label="How Zavelyn Trains Your Hand" {% if sec_train %}{{ sec_train.shopify_attributes }}{% endif %}>
    <div class="offer-head rg-train-head">
      <h2>{{ sec_train.settings.heading | default: 'How Zavelyn Trains' }} <span>{{ sec_train.settings.accent | default: 'Your Hand' }}</span></h2>
    </div>
    <div class="rg-train">
      {%- for i in (1..3) -%}
        {%- capture tk -%}card_{{ i }}_title{%- endcapture -%}
        {%- capture pk -%}card_{{ i }}_text{%- endcapture -%}
        {%- capture ik -%}card_{{ i }}_image{%- endcapture -%}
        {%- capture fk -%}card_{{ i }}_fallback{%- endcapture -%}
        {%- capture vk -%}card_{{ i }}_video{%- endcapture -%}
        {%- capture vuk -%}card_{{ i }}_video_url{%- endcapture -%}
        {%- capture vsk -%}card_{{ i }}_video_source{%- endcapture -%}
        {%- assign card_title = sec_train.settings[tk] -%}
        {%- assign card_text = sec_train.settings[pk] -%}
        {%- assign card_img = sec_train.settings[ik] -%}
        {%- assign card_fb = sec_train.settings[fk] -%}
        {%- assign card_video = sec_train.settings[vk] -%}
        {%- assign card_video_url = sec_train.settings[vuk] -%}
