<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      {%- if section.settings.show_newsletter -%}
        <div class="footer__block">
          <h2 class="footer__heading">{{ section.settings.newsletter_heading }}</h2>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="footer__text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}
          {% form 'customer', class: 'footer__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.label' | t }}</label>
            <input
              id="FooterEmail"
              class="field__input"
              type="email"
              name="contact[email]"
              placeholder="{{ 'newsletter.placeholder' | t }}"
              required
              autocomplete="email"
            >
            <button type="submit" class="button button--primary">{{ 'newsletter.submit' | t }}</button>
          {% endform %}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        <div class="footer__block" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'link_list' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="footer__links" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>
              {%- endif -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div>
        <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
        {%- if section.settings.show_social -%}
          <div class="footer__social" style="margin-block-start: 0.75rem;">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', icon: 'instagram' %}</a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', icon: 'tiktok' %}</a>
            {%- endif -%}
            {%- if settings.social_pinterest != blank -%}
              <a href="{{ settings.social_pinterest }}" aria-label="Pinterest" rel="noopener" target="_blank">{% render 'icon', icon: 'pinterest' %}</a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', icon: 'facebook' %}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_payment_icons -%}
        <div class="footer__payment" aria-label="{{ 'sections.footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in the know"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "New arrivals, private sales, and editorial notes."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share store details, promotions, or brand content.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      },
      {
        "type": "text"
      }
    ]
  }
}
{% endschema %}
