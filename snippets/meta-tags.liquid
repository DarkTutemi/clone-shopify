{%- comment -%}
  ZAVELYN HAIR CARE — Brand Meta Tags & Social Graph Snippet (v5.0)
  Strict multi-funnel isolation: Zero Sakerplus pollution, authentic brand metadata
{%- endcomment -%}

{%- liquid
  assign is_haircare_route = false
  if request.page_type == 'index'
    assign is_haircare_route = true
  elsif template.suffix contains 'zvhc'
    assign is_haircare_route = true
  elsif collection.handle contains 'zvhc' or request.path contains '/collections/zvhc'
    assign is_haircare_route = true
  elsif request.path contains '/pages/our-story' or page.handle == 'our-story'
    assign is_haircare_route = true
  elsif request.path contains '/pages/track-order' or page.handle == 'track-order'
    assign is_haircare_route = true
  endif

  # Protected legacy funnels isolation
  if product.handle == 'zavelyn-botanaroots-organic-batana-hair-growth-oil' or product.handle == 'zavelyn-botanaroots-bogo-special' or product.handle == 'breakout-2-0-holster-built-for-maximum-concealment-copy' or product.handle == 'zavelyn-rehabilitation-glove' or product.handle == 'babiguard-head-protector' or product.handle == 'the-yeoman-sweep' or product.handle contains 'saker' or product.handle contains 'srefalsteam'
    unless template.suffix contains 'zvhc'
      assign is_haircare_route = false
    endunless
  endif

  if is_haircare_route
    assign brand_site_name = 'Zavelyn Hair Care'
    assign brand_default_desc = 'Pure botanical scalp and strand therapy. Formulated with unrefined Honduran Batana oil and nourishing bio-lipids to restore resilient, radiant hair.'
  else
    assign brand_site_name = 'Zavelyn'
    assign brand_default_desc = 'Zavelyn Official Store — Quality lifestyle essentials and innovative solutions.'
  endif

  assign og_title = page_title | default: brand_site_name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: brand_default_desc

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<meta property="og:site_name" content="{{ brand_site_name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- elsif is_haircare_route -%}
  <meta property="og:image" content="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419">
  <meta property="og:image:secure_url" content="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419">
  <meta property="og:image:width" content="1000">
  <meta property="og:image:height" content="1000">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if is_haircare_route -%}
  <meta name="twitter:site" content="@tryzavelyn">
{%- endif -%}
