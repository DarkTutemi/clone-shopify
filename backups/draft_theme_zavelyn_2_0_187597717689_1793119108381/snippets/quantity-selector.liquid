{%- comment -%}
  {% render 'quantity-selector', name: 'quantity', value: 1, min: 1 %}
{%- endcomment -%}
<zavelyn-quantity-selector class="quantity-selector">
  <button
    type="button"
    class="quantity-selector__button"
    data-quantity-minus
    aria-label="{{ 'products.product.quantity_decrease' | t }}"
  >
    {% render 'icon', icon: 'minus', size: 'sm' %}
  </button>
  <input
    class="quantity-selector__input"
    type="number"
    name="{{ name | default: 'quantity' }}"
    id="{{ id | default: 'Quantity' }}"
    value="{{ value | default: 1 }}"
    min="{{ min | default: 1 }}"
    {% if max %}max="{{ max }}"{% endif %}
    data-quantity-input
    aria-label="{{ 'products.product.quantity' | t }}"
  >
  <button
    type="button"
    class="quantity-selector__button"
    data-quantity-plus
    aria-label="{{ 'products.product.quantity_increase' | t }}"
  >
    {% render 'icon', icon: 'plus', size: 'sm' %}
  </button>
</zavelyn-quantity-selector>
