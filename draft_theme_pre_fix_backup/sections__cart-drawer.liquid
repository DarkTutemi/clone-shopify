<zavelyn-cart-drawer
  class="cart-drawer"
  id="CartDrawer"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="CartDrawerTitle"
>
  <div class="cart-drawer__overlay" data-cart-drawer-overlay></div>
  <div class="cart-drawer__panel" data-cart-drawer-panel tabindex="-1">
    <div class="cart-drawer__header" data-cart-drawer-header>
      <h2 class="cart-drawer__title" id="CartDrawerTitle" data-cart-drawer-title>
        {{ 'cart.general.title' | t }}
        {%- if cart.item_count > 0 -%}
          <span>({{ cart.item_count }})</span>
        {%- endif -%}
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    <div class="cart-drawer__body" data-cart-drawer-body>
      {% render 'free-shipping-bar' %}

      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          <p>{{ 'cart.general.empty' | t }}</p>
          <a class="button button--secondary" href="{{ routes.all_products_collection_url }}" data-cart-drawer-close>
            {{ 'cart.general.continue' | t }}
          </a>
        </div>
      {%- else -%}
        <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm">
          {%- for item in cart.items -%}
            {% render 'cart-item', item: item, index: forloop.index %}
          {%- endfor -%}
        </form>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer" data-cart-drawer-footer>
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__note">{{ 'cart.general.taxes_and_shipping' | t }}</p>
        <a class="button button--secondary button--full" href="{{ routes.cart_url }}">{{ 'cart.general.view_cart' | t }}</a>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--primary button--full">
            {{ 'cart.general.checkout' | t }}
          </button>
        </form>
      </div>
    {%- endif -%}
  </div>
</zavelyn-cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
