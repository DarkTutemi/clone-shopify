    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .zv-tab-btn:hover {
    color: #0f172a;
  }
  .zv-tab-btn.active {
    background: #ffffff;
    color: #0f172a;
