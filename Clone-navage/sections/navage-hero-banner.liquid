{% comment %}
  Clone-navage/sections/navage-hero-banner.liquid
  1:1 Full-Fidelity Hero with original MP4 Background Video, Centered Headline & Dual Pill CTAs
{% endcomment %}

<div id="SectionId-{{ section.id }}" class="navage-hero-section">
  <div class="navage-hero-video-wrapper">
    <video
      class="navage-hero-video"
      autoplay
      muted
      loop
      playsinline
      poster="https://navage.com/cdn/shop/files/Navage_Advanced_B__Main_Update_V2.jpg?v=1788963959&width=1600"
    >
      <source src="https://cdn.shopify.com/videos/c/o/v/5034861873ab40fba0b18bf807e95606.mp4" type="video/mp4">
    </video>
    <div class="navage-hero-overlay"></div>
  </div>

  <div class="navage-hero-content-wrapper">
    <div class="navage-hero-inner">
      <h1 class="navage-hero-title">Nasal Irrigation, Reinvented.</h1>
      <p class="navage-hero-subtitle">
        9 out of 10 users say Naväge works better than anything they've tried.*
      </p>
      <div class="navage-hero-actions">
        <a href="/products/navage-advanced-nose-cleaner" class="navage-btn navage-btn-primary">Shop Now</a>
        <a href="/pages/whynavage" class="navage-btn navage-btn-secondary">Why Naväge</a>
      </div>
    </div>
  </div>
</div>

<style>
  #SectionId-{{ section.id }} {
    position: relative;
    width: 100%;
    min-height: 640px;
    height: 75vh;
    max-height: 850px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #03254c;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  #SectionId-{{ section.id }} .navage-hero-video-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  #SectionId-{{ section.id }} .navage-hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #SectionId-{{ section.id }} .navage-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(3, 37, 76, 0.45) 0%, rgba(3, 37, 76, 0.75) 100%);
    z-index: 2;
  }

  #SectionId-{{ section.id }} .navage-hero-content-wrapper {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 900px;
    padding: 0 24px;
    margin: 0 auto;
    text-align: center;
    color: #ffffff;
  }

  #SectionId-{{ section.id }} .navage-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  #SectionId-{{ section.id }} .navage-hero-title {
    font-size: 58px;
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -1.2px;
    color: #ffffff;
    margin: 0;
    text-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
  }

  #SectionId-{{ section.id }} .navage-hero-subtitle {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.35;
    color: #f0f7ff;
    max-width: 780px;
    margin: 0 auto;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  #SectionId-{{ section.id }} .navage-hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 14px;
  }

  #SectionId-{{ section.id }} .navage-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 38px;
    font-size: 17px;
    font-weight: 700;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    letter-spacing: 0.2px;
  }

  #SectionId-{{ section.id }} .navage-btn-primary {
    background-color: #ffffff;
    color: #002b54;
    border: 2px solid #ffffff;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }

  #SectionId-{{ section.id }} .navage-btn-primary:hover {
    background-color: #f0f7ff;
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
  }

  #SectionId-{{ section.id }} .navage-btn-secondary {
    background-color: transparent;
    color: #ffffff;
    border: 2px solid #ffffff;
  }

  #SectionId-{{ section.id }} .navage-btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    #SectionId-{{ section.id }} {
      min-height: 520px;
      height: 70vh;
    }
    #SectionId-{{ section.id }} .navage-hero-title {
      font-size: 38px;
    }
    #SectionId-{{ section.id }} .navage-hero-subtitle {
      font-size: 18px;
    }
    #SectionId-{{ section.id }} .navage-hero-actions {
      flex-direction: column;
      width: 100%;
      gap: 12px;
    }
    #SectionId-{{ section.id }} .navage-btn {
      width: 100%;
      max-width: 300px;
      padding: 13px 24px;
      font-size: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Navage Hero Video Banner",
  "settings": []
}
{% endschema %}
