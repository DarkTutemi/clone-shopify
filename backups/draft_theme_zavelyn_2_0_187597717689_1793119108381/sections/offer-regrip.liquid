<script>
(function () {
  var main = document.querySelector('[data-offer-main]');
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-offer-thumb]'));
  var sources = thumbs.map(function (t) { return t.dataset.src; });
  var index = 0;
  function setSlide(i) {
    if (!main || !sources.length) return;
    index = (i + sources.length) % sources.length;
    main.src = sources[index];
    thumbs.forEach(function (t, n) { t.classList.toggle('is-active', n === index); });
  }
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () { setSlide(Number(thumb.dataset.index)); });
  });
  var prev = document.querySelector('[data-offer-prev]');
  var next = document.querySelector('[data-offer-next]');
  if (prev) prev.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index - 1); });
  if (next) next.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index + 1); });

  var fancyboxLoading = null;
  function loadFancybox(cb) {
    if (window.Fancybox) { cb(); return; }
    if (fancyboxLoading) { fancyboxLoading.then(cb); return; }
    fancyboxLoading = new Promise(function (resolve) {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css';
      document.head.appendChild(css);
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js';
      s.onload = function () { resolve(); };
      s.onerror = function () { resolve(); };
      document.body.appendChild(s);
    });
    fancyboxLoading.then(cb);
  }
  var zoom = document.querySelector('[data-offer-zoom]');
  if (zoom) {
    zoom.addEventListener('click', function () {
      if (!sources.length) return;
      loadFancybox(function () {
        if (!window.Fancybox) return;
        window.Fancybox.show(sources.map(function (src) { return { src: src, type: 'image' }; }), { startIndex: index });
      });
    });
  }

  document.querySelectorAll('[data-offer-accordion]').forEach(function (accordion, aIdx) {
    var items = Array.prototype.slice.call(accordion.querySelectorAll('.offer-faq__item'));
    items.forEach(function (item, i) {
      var trigger = item.querySelector('.offer-faq__trigger');
      var panel = item.querySelector('.offer-faq__panel');
      if (!trigger || !panel) return;
      var panelId = 'rg-faq-' + aIdx + '-' + i;
      panel.id = panelId;
      trigger.setAttribute('aria-controls', panelId);
      panel.setAttribute('role', 'region');
      trigger.setAttribute('aria-expanded', 'false');
      panel.setAttribute('hidden', '');
      trigger.addEventListener('click', function () {
        var willOpen = !item.classList.contains('is-open');
        items.forEach(function (other) {
          var open = other === item && willOpen;
          other.classList.toggle('is-open', open);
          var btn = other.querySelector('.offer-faq__trigger');
          var p = other.querySelector('.offer-faq__panel');
          if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (p) { if (open) p.removeAttribute('hidden'); else p.setAttribute('hidden', ''); }
        });
      });
    });
  });

  /* Journey + howto carousels */
  function bindRgCarousel(trackSel, prevSel, nextSel, cardSel, gap) {
    var track = document.querySelector(trackSel);
    if (!track) return;
    var prev = document.querySelector(prevSel);
    var next = document.querySelector(nextSel);
    function step() {
      var card = track.querySelector(cardSel);
      return card ? card.getBoundingClientRect().width + gap : 240;
    }
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
  }
  bindRgCarousel('[data-rg-journey-track]', '[data-rg-journey-prev]', '[data-rg-journey-next]', '.rg-journey-card', 16);
  bindRgCarousel('[data-rg-howto-track]', '[data-rg-howto-prev]', '[data-rg-howto-next]', '.rg-step', 10);

  /* Size / watch modals */
  function openModal(el) {
    if (!el) return;
    el.hidden = false;
    document.documentElement.style.overflow = 'hidden';
  }
  function closeModal(el) {
    if (!el) return;
    el.hidden = true;
    document.documentElement.style.overflow = '';
    var vid = el.querySelector('video');
    if (vid) { vid.pause(); }
    var stage = el.querySelector('[data-rg-review-stage]');
    if (stage) stage.replaceChildren();
  }
  var sizeModal = document.querySelector('[data-rg-size-modal]');
  var watchModal = document.querySelector('[data-rg-watch-modal]');
  document.querySelectorAll('[data-rg-size-open]').forEach(function (btn) {
    btn.addEventListener('click', function () { openModal(sizeModal); });
  });
  document.querySelectorAll('[data-rg-watch-open]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      openModal(watchModal);
      var vid = watchModal && watchModal.querySelector('video');
      if (vid) { try { vid.play(); } catch (e2) {} }
    });
  });
  document.querySelectorAll('[data-rg-modal-close]').forEach(function (btn) {
    btn.addEventListener('click', function () { closeModal(btn.closest('.rg-modal')); });
  });
  var reviewModal = document.querySelector('[data-rg-review-modal]');
  document.querySelectorAll('[data-rg-review-open]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!reviewModal) return;
      var stage = reviewModal.querySelector('[data-rg-review-stage]');
      if (!stage) return;
      var video = btn.getAttribute('data-video');
      var image = btn.getAttribute('data-image');
      var title = btn.getAttribute('data-title') || 'Review';
      stage.replaceChildren();
      if (video) {
        var frame = document.createElement('iframe');
        frame.src = video + '?autoplay=true&preload=auto';
        frame.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        frame.allowFullscreen = true;
        frame.title = title;
        stage.appendChild(frame);
      } else if (image) {
        var img = document.createElement('img');
        img.src = image;
        img.alt = title;
        stage.appendChild(img);
      }
      openModal(reviewModal);
    });
  });
  [sizeModal, watchModal, reviewModal].forEach(function (modal) {
    if (!modal) return;
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal(modal);
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeModal(sizeModal); closeModal(watchModal); closeModal(reviewModal); }
  });


  /* Countdown 10-min loop like source caregiver offer */
  (function () {
    var root = document.querySelector('[data-rg-countdown]');
    if (!root) return;
    var label = root.querySelector('[data-rg-countdown-label]');
    var minutes = Number(root.getAttribute('data-minutes') || 10);
    var end = Date.now() + minutes * 60 * 1000;
    function tick() {
      var left = Math.max(0, end - Date.now());
      if (left <= 0) { end = Date.now() + minutes * 60 * 1000; left = end - Date.now(); }
      var total = Math.floor(left / 1000);
      var m = Math.floor(total / 60);
      var s = total % 60;
      if (label) label.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }
    tick();
    setInterval(tick, 1000);
  })();

  /* Variant + packs */
  var variantInput = document.getElementById('OfferVariantId');
  var qtyInput = document.getElementById('OfferQuantity');
  var buyForm = document.getElementById('OfferAddForm');
  var packsRoot = document.querySelector('[data-rg-packs]');
  var ctaPriceEls = Array.prototype.slice.call(document.querySelectorAll('[data-rg-cta-price]'));
  var variants = [];
  try {
    var mapEl = document.getElementById('RgVariantMap');
    if (mapEl) variants = JSON.parse(mapEl.textContent || '[]');
  } catch (e) { variants = []; }
  var activePack = 1;

  function findVariant(side, size) {
    if (!variants.length) return null;
    var match = variants.find(function (v) {
      var opts = [v.option1, v.option2, v.option3].filter(Boolean);
      var sideOk = !side || opts.indexOf(side) !== -1;
      var sizeOk = !size || opts.indexOf(size) !== -1;
      return sideOk && sizeOk;
    });
    return match || variants[0];
  }

  function moneyTwice(moneyStr) {
    // naive display for pack 2 when no dedicated price — keep label from markup if parse fails
    return moneyStr;
  }

  function syncFromOptions() {
    var sideEl = document.querySelector('[data-rg-side]');
    var sizeEl = document.querySelector('[data-rg-size]');
    var side = sideEl ? sideEl.value : null;
    var size = sizeEl ? sizeEl.value : null;
    var v = findVariant(side, size);
    if (!v) return;
    if (variantInput) variantInput.value = String(v.id);
    if (qtyInput) qtyInput.value = activePack === 2 ? '2' : '1';
    var price = v.money;
    if (activePack === 2) {
      // show approximate 2x on CTA when using qty 2
      var pack2Label = document.querySelector('[data-rg-pack2-price]');
      price = pack2Label ? pack2Label.textContent.trim() : v.money;
    }
    ctaPriceEls.forEach(function (el) { el.textContent = price; });
    var p1 = document.querySelector('[data-rg-pack1-price]');
    var p1c = document.querySelector('[data-rg-pack1-compare]');
    if (p1) p1.textContent = v.money;
    if (p1c && v.compare_money) p1c.textContent = v.compare_money;
  }

  if (packsRoot) {
    packsRoot.querySelectorAll('[data-rg-pack]').forEach(function (card) {
      card.addEventListener('click', function (e) {
        if (e.target && (e.target.tagName === 'SELECT' || e.target.closest('select'))) return;
        activePack = Number(card.getAttribute('data-rg-pack') || '1');
        packsRoot.querySelectorAll('[data-rg-pack]').forEach(function (c) {
          c.classList.toggle('is-active', c === card);
        });
        syncFromOptions();
      });
    });
  }
  document.querySelectorAll('[data-rg-side], [data-rg-size]').forEach(function (el) {
    el.addEventListener('change', syncFromOptions);
  });
  syncFromOptions();

  var checkoutBtns = Array.prototype.slice.call(document.querySelectorAll('[data-offer-checkout]'));
  var checkoutBusy = false;
  function goToCheckout(trigger) {
    var vid = variantInput ? Number(variantInput.value) : 0;
    if (checkoutBusy || !vid) return;
    var qty = qtyInput ? Number(qtyInput.value || 1) : 1;
    var packLabel = activePack === 2 ? 'Buy 2 · BOTH HANDS' : 'Buy 1 · ONE HAND';
    checkoutBusy = true;
    checkoutBtns.forEach(function (btn) { btn.classList.add('is-loading'); });
    if (trigger && trigger.classList) trigger.classList.add('is-loading');
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({
        items: [{
          id: vid,
          quantity: qty,
          properties: {
            _bundle: 'regrip-pack',
            _bundle_id: 'rg_' + Date.now().toString(36),
            _pack: String(activePack),
            Offer: packLabel
          }
        }]
      })
    })
      .then(function (res) { if (!res.ok) throw new Error('add_failed'); return res.json(); })
      .then(function () { return fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }); })
      .then(function (cart) {
        checkoutBusy = false;
        checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
        if (trigger && trigger.classList) trigger.classList.remove('is-loading');
        if (cart) {
          document.dispatchEvent(new CustomEvent('zavelyn:offer-cart:open', { detail: { cart: cart } }));
          return;
        }
        window.location.href = '/checkout';
      })
      .catch(function () {
        checkoutBusy = false;
        checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
        if (trigger && trigger.classList) trigger.classList.remove('is-loading');
        if (buyForm) buyForm.submit();
      });
  }
  if (buyForm) buyForm.addEventListener('submit', function (e) { e.preventDefault(); goToCheckout(e.submitter); });
  checkoutBtns.forEach(function (btn) {
    if (btn.closest('#OfferAddForm')) return;
    btn.addEventListener('click', function (e) { e.preventDefault(); goToCheckout(btn); });
  });

  var sticky = document.querySelector('[data-offer-sticky]');
  var stickyCta = sticky ? sticky.querySelector('[data-offer-checkout]') : null;
  var hero = document.querySelector('.offer-hero');
  if (sticky && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      var on = !entries[0].isIntersecting;
      sticky.classList.toggle('is-on', on);
      sticky.setAttribute('aria-hidden', on ? 'false' : 'true');
      if (on) sticky.removeAttribute('inert');
      else sticky.setAttribute('inert', '');
      if (stickyCta) stickyCta.tabIndex = on ? 0 : -1;
      document.documentElement.classList.toggle('offer-sticky-on', on);
    }, { threshold: 0.05 }).observe(hero);
  }

  var topBtn = document.querySelector('[data-offer-top]');
  if (topBtn) {
    function syncTopBtn() {
      var show = window.scrollY > 480;
      topBtn.hidden = !show;
      topBtn.classList.toggle('is-on', show);
    }
    window.addEventListener('scroll', syncTopBtn, { passive: true });
    syncTopBtn();
    topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  }
})();
</script>

