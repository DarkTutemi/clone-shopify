        "review_1": {
          "type": "review",
          "settings": {
            "name": "Kevin F.",
            "text": "I really love this glove I've spent months at Occupational therapy and I would never get this type of training its a process but I definitely believe.\nKevin F",
            "stars": 5,
            "verified": true,
            "image_url": "https:\/\/images.loox.io\/uploads\/2026\/5\/7\/rIDcvoZcI_DFyv2cD14_orig.jpg",
            "item": "Right Hand \/ Large",
            "video_url": "https:\/\/iframe.videodelivery.net\/b61f4a4fa0a509831e4cc27ce61a5455",
            "name_2": "Patrick L.",
            "text_2": "I ordered this for my dad mainly to keep his hand moving. It’s easy for him to use and doesn’t require much effort.\nIt won’t replace therapy, but it’s a good way to stay consistent at home.",
            "stars_2": 5,
            "verified_2": false,
            "image_url_2": "https:\/\/images.loox.io\/uploads\/2026\/3\/24\/GulG8YbD2X_r6e-154UI_orig.jpg",
            "video_url_2": "https:\/\/iframe.videodelivery.net\/6e940d8b12f1b5df701f39def9b4d4c8"
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "name": "Daniela R.",
            "text": "Bought this for my mother. She didn’t have the strength or motivation to move her hand regularly on her own. This helps her keep it active without pressure.\nIt’s simple, and she actually uses it — which is the most important part.",
            "stars": 5,
            "verified": false,
            "image_url": "https:\/\/images.loox.io\/uploads\/2026\/3\/24\/RsouYKND0_u9Ef3ysKq_orig.jpg",
            "video_url": "https:\/\/iframe.videodelivery.net\/ef3d3e09dd7596eee2c001eaaa4a7a0a",
            "name_2": "Sabine K.",
            "text_2": "I got this for my husband after his stroke because I was worried his hand would just stay closed over time. He wasn’t very consistent with exercises, but this made it easier for him to do something every day.\nAfter a while, his hand felt less tight and he even started using it a bit more again. That alone made a difference for us.",
            "stars_2": 5,
            "verified_2": false,
            "image_url_2": "https:\/\/images.loox.io\/uploads\/2026\/3\/24\/VQQ_hDNXwu_XAch5_g1t_orig.jpg",
            "video_url_2": "https:\/\/iframe.videodelivery.net\/2161df20d3171ca7c89c3396dc9d73af"
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "name": "Monika E.",
            "text": "Easy to use, no pain, just movement 🙌\nExactly what I needed.",
