{% schema %}
{
  "name": "Earthly PDP Reviews",
  "settings": []
}
{% endschema %}

<section id="shopify-section-reviews-slider" class="shopify-section s-reviews-slider-section">
<style>
  #shopify-section-reviews-slider {
    background: linear-gradient(
      to bottom,
      #ffeca5 10%,
      #ffffff
    );
    padding: 0px 0 48px;
    margin-top: 32px;
  }

  .s-reviews-slider__top-divider {
    height: 106px;
    overflow: hidden;
    display: flex;
    width: 100%;
  }

  .s-reviews-slider__top-divider svg {
    display: block;
    width: 100%;
    height: auto;
    margin: -4px 0;
  }

  .rs__title {
    font-family: Poppins, sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 32px;
    color: #1a1a1a;
    text-align: center;
    margin: 0 auto 28px;
    padding: 0 20px;
    max-width: 900px;
    line-height: 1.2;
  }

  .rs__slider-wrap {
    padding: 0 20px;
    margin: auto;
    max-width: 1420px;
  }

  .rs__cards-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .rs__card {
    background-color: #fcfbf7;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.15);
  }

  .rs__card-image img {
    display: block;
    width: 100%;
    height: 250px;
    object-fit: cover;
  }

  .rs__card-body {
    padding: 14px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
    font-family: Poppins, sans-serif;
  }

  .rs__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-bottom: 0.2px solid #1f1f1f;
    padding: 7.5px 0;
  }

  .rs__card-name {
    font-family: Poppins, sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: #1a1a1a;
  }

  .rs__card-stars svg {
    display: block;
  }

  .rs__card-quote {
    font-family: Poppins, sans-serif;
    font-weight: 600;
    font-size: 13.5px;
    color: #1a1a1a;
    margin: 4px 0 0;
    line-height: 1.35;
  }

  .rs__card-text {
    font-family: Poppins, sans-serif;
    font-size: 11.5px;
    color: #333333;
    line-height: 1.5;
    margin: 0;
  }

  .rs__read-more {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    font-size: inherit;
    color: #1a1a1a;
    text-decoration: underline;
    display: inline;
    font-weight: 600;
  }

  .rs__text-full {
    display: none;
  }
  .rs__text-full.is-visible {
    display: inline;
  }
  .rs__text-truncated.is-hidden {
    display: none;
  }

  @media (max-width: 1100px) {
    .rs__cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .rs__cards-grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 12px;
      gap: 14px;
    }
    .rs__card {
      min-width: 275px;
      scroll-snap-align: start;
    }
    .rs__title {
      font-size: 26px;
      margin-bottom: 20px;
    }
    .s-reviews-slider__top-divider {
      height: 54px;
    }
  }
</style>

<div class="s-reviews-slider__top-divider">
  <svg viewBox="0 0 1440 107" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
