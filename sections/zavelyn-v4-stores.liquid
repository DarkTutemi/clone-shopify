{% comment %}
  ZAVELYN IMMERSIVE COMMERCE THEME V4.1
  SECTION B: REAL-WORLD RETAIL SHOWROOM ENTRANCES
  Replaces generic category cards with authentic architectural retail store facades
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}

<section class="zv-section-pad zv-store-entrances-section" id="zvStores">
  <div class="zv-container">

    <!-- Section Header with Architectural Retail Identity -->
    <div class="zv-stores-header">
      <div class="zv-badge zv-badge-forest" style="margin-bottom: 14px;">
        <span>🏛️ THE ZAVELYN RETAIL SHOWROOMS</span>
      </div>
      <h2 class="zv-stores-heading">
        Walk Into Our Specialized Stores
      </h2>
      <p class="zv-stores-subheading">
        Rather than browsing a flat catalog, step through our architectural storefronts. Each retail environment features specialized physical shelving, curated display lighting, and authentic spatial product exploration.
      </p>
    </div>

    <!-- 4 Architectural Showroom Entrances Grid -->
    <div class="zv-stores-grid">

      <!-- ===================================================================
           STORE 01: HOME & ORGANIZATION SHOWROOM
           =================================================================== -->
      <article class="zv-store-portal zv-portal-home">
        <a href="/collections/home-improvement?view=showroom" class="zv-portal-link" aria-label="Enter Home and Organization Showroom">
          
          <!-- Atmospheric Store Interior Backdrop -->
          <div class="zv-portal-backdrop">
            <div class="zv-portal-sconce"></div>
            <div class="zv-portal-interior-pattern"></div>
          </div>

          <!-- Storefront Architectural Arch & Signage -->
          <div class="zv-portal-facade">
            <div class="zv-portal-badge-row">
              <span class="zv-portal-dept-tag">DEPT 01 &middot; AISLE A</span>
              <span class="zv-portal-live-indicator"><span class="zv-pulse-dot"></span> OPEN FOR BROWSING</span>
            </div>
            <h3 class="zv-portal-store-name">Home &amp; Organization Store</h3>
            <p class="zv-portal-store-desc">Warm oak interior with modular storage bins, pantry organizers, and smart living fixtures.</p>
          </div>

          <!-- Physical 3D Display Pedestal with Hero Products -->
          <div class="zv-portal-stage">
            <div class="zv-portal-pedestal-surface"></div>
            
            <div class="zv-portal-merch-row">
              <!-- Item 1 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-foldable-storage-bins-hero.jpg?v=1793290094" 
                    alt="Storage Bins" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Storage Bins</span>
              </div>

              <!-- Item 2 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/sakerplus_7a036ff3-6ab7-44b3-92ef-2c510ee821e7.png?v=1792790958" 
                    alt="Shelf Liner" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Shelf Liners</span>
              </div>

              <!-- Item 3 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_e6a42e80-7283-4a2a-bfa3-f8e0a4f1ed17.jpg?v=1792791236" 
                    alt="Desk Organizer" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Desk Racks</span>
              </div>
            </div>
          </div>

          <!-- Entrance Action Bar -->
          <div class="zv-portal-footer">
            <span class="zv-portal-action-text">WALK INTO STORE</span>
            <span class="zv-portal-action-arrow">➔</span>
          </div>

        </a>
      </article>

      <!-- ===================================================================
           STORE 02: POWER & TOOLS WORKSHOP
           =================================================================== -->
      <article class="zv-store-portal zv-portal-tools">
        <a href="/collections/power-tools?view=showroom" class="zv-portal-link" aria-label="Enter Power and Tools Workshop">
          
          <!-- Atmospheric Store Interior Backdrop -->
          <div class="zv-portal-backdrop">
            <div class="zv-portal-sconce"></div>
            <div class="zv-portal-interior-pattern"></div>
          </div>

          <!-- Storefront Architectural Arch & Signage -->
          <div class="zv-portal-facade">
            <div class="zv-portal-badge-row">
              <span class="zv-portal-dept-tag">DEPT 02 &middot; WORKSHOP</span>
              <span class="zv-portal-live-indicator"><span class="zv-pulse-dot"></span> OPEN FOR BROWSING</span>
            </div>
            <h3 class="zv-portal-store-name">Power &amp; Tools Workshop</h3>
            <p class="zv-portal-store-desc">Industrial brushed gunmetal racks with heavy-duty worklights, cutters, and professional gear.</p>
          </div>

          <!-- Physical 3D Display Pedestal with Hero Products -->
          <div class="zv-portal-stage">
            <div class="zv-portal-pedestal-surface"></div>
            
            <div class="zv-portal-merch-row">
              <!-- Item 1 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_ff6ff9ab-a7a7-444c-a984-6562dec0c726.png?v=1792791362" 
                    alt="Drywall Tool" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Board Cutters</span>
              </div>

              <!-- Item 2 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_4fa87677-3733-422d-87ba-0324c1ce93ec.png?v=1792791459" 
                    alt="Magnetic Light" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Magnetic Lights</span>
              </div>

              <!-- Item 3 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_41aa2303-ed98-45f3-90bb-0390ffb5fe8e.jpg?v=1792791252" 
                    alt="Thermal Camera" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Thermal Scanners</span>
              </div>
            </div>
          </div>

          <!-- Entrance Action Bar -->
          <div class="zv-portal-footer">
            <span class="zv-portal-action-text">WALK INTO WORKSHOP</span>
            <span class="zv-portal-action-arrow">➔</span>
          </div>

        </a>
      </article>

      <!-- ===================================================================
           STORE 03: WELLNESS & BOTANICALS BOUTIQUE
           =================================================================== -->
      <article class="zv-store-portal zv-portal-wellness">
        <a href="/collections/all-products?view=showroom" class="zv-portal-link" aria-label="Enter Wellness and Botanicals Boutique">
          
          <!-- Atmospheric Store Interior Backdrop -->
          <div class="zv-portal-backdrop">
            <div class="zv-portal-sconce"></div>
            <div class="zv-portal-interior-pattern"></div>
          </div>

          <!-- Storefront Architectural Arch & Signage -->
          <div class="zv-portal-facade">
            <div class="zv-portal-badge-row">
              <span class="zv-portal-dept-tag">DEPT 03 &middot; SANCTUARY</span>
              <span class="zv-portal-live-indicator"><span class="zv-pulse-dot"></span> OPEN FOR BROWSING</span>
            </div>
            <h3 class="zv-portal-store-name">Wellness &amp; Botanicals</h3>
            <p class="zv-portal-store-desc">Frosted jade spa atmosphere with wild-harvested Batana hair restoration and restorative therapies.</p>
          </div>

          <!-- Physical 3D Display Pedestal with Hero Products -->
          <div class="zv-portal-stage">
            <div class="zv-portal-pedestal-surface"></div>
            
            <div class="zv-portal-merch-row">
              <!-- Item 1 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zavelyn-botana-asset-1.jpg?v=1793191361" 
                    alt="Batana Oil" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Batana Hair Oil</span>
              </div>

              <!-- Item 2 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/sakerplus_30a2782e-1b0d-44a9-9b9b-9a4d87a72b65.jpg?v=1792791437" 
                    alt="Sauna Blanket" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Sauna Blankets</span>
              </div>

              <!-- Item 3 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/Sp_cb49fbea-fa77-4264-9834-d125cb176515.png?v=1792790912" 
                    alt="Sensory Mats" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Sensory Mats</span>
              </div>
            </div>
          </div>

          <!-- Entrance Action Bar -->
          <div class="zv-portal-footer">
            <span class="zv-portal-action-text">WALK INTO BOUTIQUE</span>
            <span class="zv-portal-action-arrow">➔</span>
          </div>

        </a>
      </article>

      <!-- ===================================================================
           STORE 04: ACOUSTIC & MEDITATION STUDIO
           =================================================================== -->
      <article class="zv-store-portal zv-portal-sound">
        <a href="/collections/all-products?view=showroom" class="zv-portal-link" aria-label="Enter Acoustic and Meditation Studio">
          
          <!-- Atmospheric Store Interior Backdrop -->
          <div class="zv-portal-backdrop">
            <div class="zv-portal-sconce"></div>
            <div class="zv-portal-interior-pattern"></div>
          </div>

          <!-- Storefront Architectural Arch & Signage -->
          <div class="zv-portal-facade">
            <div class="zv-portal-badge-row">
              <span class="zv-portal-dept-tag">DEPT 04 &middot; SOUND LAB</span>
              <span class="zv-portal-live-indicator"><span class="zv-pulse-dot"></span> OPEN FOR BROWSING</span>
            </div>
            <h3 class="zv-portal-store-name">Acoustic &amp; Meditation</h3>
            <p class="zv-portal-store-desc">Midnight obsidian listening studio with ambient projection lighting, rain drums, and sensory decor.</p>
          </div>

          <!-- Physical 3D Display Pedestal with Hero Products -->
          <div class="zv-portal-stage">
            <div class="zv-portal-pedestal-surface"></div>
            
            <div class="zv-portal-merch-row">
              <!-- Item 1 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_719c1653-2f69-4a7b-bcb3-c45248ee7ef6.jpg?v=1792791376" 
                    alt="Star Projector" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Star Projectors</span>
              </div>

              <!-- Item 2 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/logo_f3b09dc7-0aba-43f2-8b05-10072673a7a1.png?v=1792791328" 
                    alt="Smart Clock" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Ambient Clocks</span>
              </div>

              <!-- Item 3 -->
              <div class="zv-portal-item">
                <div class="zv-portal-img-wrap">
                  <img 
                    src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/fmsakerplus.jpg?v=1792791077" 
                    alt="Squishy Light" 
                    loading="lazy"
                  >
                  <div class="zv-portal-item-shadow"></div>
                </div>
                <span class="zv-portal-item-tag">Sensory Lights</span>
              </div>
            </div>
          </div>

          <!-- Entrance Action Bar -->
          <div class="zv-portal-footer">
            <span class="zv-portal-action-text">WALK INTO STUDIO</span>
            <span class="zv-portal-action-arrow">➔</span>
