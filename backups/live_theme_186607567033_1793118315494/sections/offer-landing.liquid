              {% render 'offer-img', image: di, fallback: df, class: 'offer-day__icon', width: 55, height: 55, loading: 'lazy', alt: '' %}
              <div class="offer-day__body">
                <div class="offer-day__label">{{ dl }}</div>
                <h3 class="offer-day__title">{{ dt }}</h3>
                <p class="offer-day__text">{{ dtx }}</p>
                <ul class="offer-day__perks">
                  {%- if dp1 != blank -%}<li>{{ dp1 }}</li>{%- endif -%}
                  {%- if dp2 != blank -%}<li>{{ dp2 }}</li>{%- endif -%}
                  {%- if dp3 != blank -%}<li>{{ dp3 }}</li>{%- endif -%}
                </ul>
                {%- if dq != blank -%}
                  <div class="offer-day__quote">
                    {% render 'offer-img', image: s.quote_icon, fallback: 'offer-quote-icon.png', width: 34, height: 34, alt: '' %}
