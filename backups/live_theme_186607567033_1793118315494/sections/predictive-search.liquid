{%- if predictive_search.performed -%}
  <div data-predictive-results-markup>
    {%- if predictive_search.resources.products.size > 0 -%}
      <div class="predictive-search__group" data-predictive-group>
        <h3 class="predictive-search__group-title">{{ 'general.search.predictive.products' | t }}</h3>
        {%- for product in predictive_search.resources.products -%}
          <a class="predictive-search__item" href="{{ product.url }}" data-predictive-item role="option">
            <div class="predictive-search__item-image">
              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 100
                  | image_tag: loading: 'lazy', alt: product.featured_media.alt | default: product.title | escape
                }}
              {%- endif -%}
            </div>
            <div>
              <p class="predictive-search__item-title">{{ product.title }}</p>
              <p class="predictive-search__item-price">{{ product.price | money }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.collections.size > 0 -%}
      <div class="predictive-search__group" data-predictive-group>
        <h3 class="predictive-search__group-title">{{ 'general.search.predictive.collections' | t }}</h3>
        {%- for collection in predictive_search.resources.collections -%}
          <a class="predictive-search__item" href="{{ collection.url }}" data-predictive-item role="option" style="grid-template-columns: 1fr;">
            <p class="predictive-search__item-title">{{ collection.title }}</p>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.pages.size > 0 -%}
      <div class="predictive-search__group" data-predictive-group>
        <h3 class="predictive-search__group-title">{{ 'general.search.predictive.pages' | t }}</h3>
        {%- for page in predictive_search.resources.pages -%}
          <a class="predictive-search__item" href="{{ page.url }}" data-predictive-item role="option" style="grid-template-columns: 1fr;">
            <p class="predictive-search__item-title">{{ page.title }}</p>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.articles.size > 0 -%}
      <div class="predictive-search__group" data-predictive-group>
        <h3 class="predictive-search__group-title">{{ 'general.search.predictive.articles' | t }}</h3>
        {%- for article in predictive_search.resources.articles -%}
          <a class="predictive-search__item" href="{{ article.url }}" data-predictive-item role="option" style="grid-template-columns: 1fr;">
            <p class="predictive-search__item-title">{{ article.title }}</p>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if predictive_search.resources.products.size == 0
      and predictive_search.resources.collections.size == 0
      and predictive_search.resources.pages.size == 0
      and predictive_search.resources.articles.size == 0
    -%}
      <div class="predictive-search__status">{{ 'general.search.predictive.no_results' | t }}</div>
    {%- else -%}
      <a class="predictive-search__view-all" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}" data-predictive-view-all>
        {{ 'general.search.predictive.view_all' | t }}
      </a>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Predictive search",
  "settings": []
}
{% endschema %}
