{% comment %}
  ZAVELYN HAIR CARE — T01 4-Step Ritual Section
{% endcomment %}
<section class="zvhc-editorial-section alt-bg" id="routine">
  <div class="zvhc-container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 52px;">
      <div style="font-size: 0.78rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px;">THE BOTANICAL RITUAL</div>
      <h2 class="zvhc-h2">The 4-Step Healthy Strand Ritual</h2>
      <p>Designed to harmoniously feed the scalp microbiome, strengthen hair follicles, define textures, and perfect everyday styling.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
      <!-- Step 1 -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column;">
        <div style="font-family: var(--zvhc-font-serif, serif); font-size: 2.2rem; font-weight: 600; color: var(--zvhc-t01-accent-rose, #B0476E); margin-bottom: 10px;">01</div>
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-text-subtle, #7A6670); text-transform: uppercase; margin-bottom: 6px;">SCALP PREP &amp; MELT</div>
        <h3 class="zvhc-h3" style="margin-bottom: 10px;">Raw Batana Balm</h3>
        <p style="font-size: 0.9rem; flex-grow: 1; margin-bottom: 16px;">Warm a pea-sized amount between fingertips to melt into nutrient-rich butter. Massage gently into scalp tension zones 20 mins prior to wash.</p>
        <span style="font-size: 0.82rem; font-weight: 700; color: var(--zvhc-t01-trust-green, #3F8F6B);">✓ Soothed scalp barrier</span>
      </div>

      <!-- Step 2 -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column;">
        <div style="font-family: var(--zvhc-font-serif, serif); font-size: 2.2rem; font-weight: 600; color: var(--zvhc-t01-accent-rose, #B0476E); margin-bottom: 10px;">02</div>
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-text-subtle, #7A6670); text-transform: uppercase; margin-bottom: 6px;">NOURISH &amp; SEAL</div>
        <h3 class="zvhc-h3" style="margin-bottom: 10px;">Batana Scalp &amp; Hair Oil</h3>
        <p style="font-size: 0.9rem; flex-grow: 1; margin-bottom: 16px;">Apply 3-5 drops of pure Batana Oil onto damp roots and shaft. Comb gently through strands to seal moisture and lock the cuticle.</p>
        <span style="font-size: 0.82rem; font-weight: 700; color: var(--zvhc-t01-trust-green, #3F8F6B);">✓ Up to 85% reduced breakage</span>
      </div>

      <!-- Step 3 -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column;">
        <div style="font-family: var(--zvhc-font-serif, serif); font-size: 2.2rem; font-weight: 600; color: var(--zvhc-t01-accent-rose, #B0476E); margin-bottom: 10px;">03</div>
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-text-subtle, #7A6670); text-transform: uppercase; margin-bottom: 6px;">SHAPE &amp; DEFINE</div>
        <h3 class="zvhc-h3" style="margin-bottom: 10px;">Curl Cream or Root Powder</h3>
        <p style="font-size: 0.9rem; flex-grow: 1; margin-bottom: 16px;">Work Botanical Curl Cream through damp curls for defined spirals, or tap Root-Lift Powder at dry roots for instant matte lift.</p>
        <span style="font-size: 0.82rem; font-weight: 700; color: var(--zvhc-t01-trust-green, #3F8F6B);">✓ Touchable bounce, zero crunch</span>
      </div>

      <!-- Step 4 -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column;">
        <div style="font-family: var(--zvhc-font-serif, serif); font-size: 2.2rem; font-weight: 600; color: var(--zvhc-t01-accent-rose, #B0476E); margin-bottom: 10px;">04</div>
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-text-subtle, #7A6670); text-transform: uppercase; margin-bottom: 6px;">PERFECT &amp; COVER</div>
        <h3 class="zvhc-h3" style="margin-bottom: 10px;">Fibers &amp; Hairline Compact</h3>
        <p style="font-size: 0.9rem; flex-grow: 1; margin-bottom: 16px;">Dab the Hairline Shadow Compact along temples or sprinkle Keratin Fibers over crown thinning for undetectable 24hr coverage.</p>
        <span style="font-size: 0.82rem; font-weight: 700; color: var(--zvhc-t01-trust-green, #3F8F6B);">✓ Camera-ready hairline confidence</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ZVHC T01 Routine",
  "settings": []
}
{% endschema %}
