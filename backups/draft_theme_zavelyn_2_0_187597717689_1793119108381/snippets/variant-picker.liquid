{%- comment -%}
  {% render 'variant-picker', product: product %}
{%- endcomment -%}
{%- unless product.has_only_default_variant -%}
  <zavelyn-variant-picker class="variant-picker">
    <script type="application/json" data-variant-json>
      {{ product.variants | json }}
    </script>

    {%- for option in product.options_with_values -%}
      {%- assign option_index = forloop.index -%}
      <fieldset class="variant-picker__option" data-option-group data-option-position="{{ option_index }}">
        <legend class="variant-picker__label">
          {{ option.name }}:
          <span data-option-selected-value>
            {{ option.selected_value }}
          </span>
        </legend>

        {%- if option.name == 'Color' or option.name == 'Colour' -%}
          <div class="variant-picker__values" role="radiogroup" aria-label="{{ option.name }}">
            {%- for value in option.values -%}
              <input
                type="radio"
                id="Option-{{ section.id }}-{{ option_index }}-{{ forloop.index }}"
                name="options[{{ option.name | escape }}]"
                value="{{ value | escape }}"
                data-option-position="{{ option_index }}"
                {% if option.selected_value == value %}checked{% endif %}
                class="visually-hidden"
              >
              <label
                class="variant-picker__button"
                for="Option-{{ section.id }}-{{ option_index }}-{{ forloop.index }}"
                data-option-value="{{ value | escape }}"
                data-option-position="{{ option_index }}"
                role="radio"
                aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
              >
                {{ value }}
              </label>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="variant-picker__values" role="radiogroup" aria-label="{{ option.name }}">
            {%- for value in option.values -%}
              <input
                type="radio"
                id="Option-{{ section.id }}-{{ option_index }}-{{ forloop.index }}"
                name="options[{{ option.name | escape }}]"
                value="{{ value | escape }}"
                data-option-position="{{ option_index }}"
                {% if option.selected_value == value %}checked{% endif %}
                class="visually-hidden"
              >
              <label
                class="variant-picker__button"
                for="Option-{{ section.id }}-{{ option_index }}-{{ forloop.index }}"
                data-option-value="{{ value | escape }}"
                data-option-position="{{ option_index }}"
                role="radio"
                aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
              >
                {{ value }}
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}
  </zavelyn-variant-picker>
{%- endunless -%}
