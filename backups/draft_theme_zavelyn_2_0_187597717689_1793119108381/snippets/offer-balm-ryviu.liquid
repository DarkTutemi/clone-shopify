{%- liquid
  if group != blank
    assign b = group.settings
  endif
  if b.pair_1 != blank
    assign pair_1 = b.pair_1 | image_url: width: 600
  endif
  if b.pair_2 != blank
    assign pair_2 = b.pair_2 | image_url: width: 600
  endif
  if b.r8_photo != blank
    assign r8_photo = b.r8_photo | image_url: width: 800
  endif
-%}
{%- unless b.show == false -%}
<section class="mb-ry" aria-label="Customer reviews" {% if group %}{{ group.shopify_attributes }}{% endif %}>
  <div class="mb-ry__inner">
    <div class="mb-ry__head">
      <div class="mb-ry__score">
        <div class="mb-ry__avgline">
          <span class="mb-ry__avg">{{ b.average | default: '4.9' }}</span>
          <span class="mb-ry-stars" aria-label="Rated 4.9 out of 5">
            <i class="mb-ry-star is-on"></i><i class="mb-ry-star is-on"></i><i class="mb-ry-star is-on"></i><i class="mb-ry-star is-on"></i><i class="mb-ry-star is-part"></i>
          </span>
          <span class="mb-ry__count"><b>{{ b.total | default: '1,529' }}</b> reviews</span>
        </div>
        <table class="mb-ry__rates" aria-label="Rate list">
          <tr><th class="mb-ry__rate-name">5<i class="mb-ry-star is-on"></i></th><th><span class="mb-ry__track"><span class="mb-ry__fill" style="width:99.2%"></span></span></th><th class="mb-ry__rate-count">{{ b.star_5 | default: '1,517' }}</th></tr>
          <tr><th class="mb-ry__rate-name">4<i class="mb-ry-star is-on"></i></th><th><span class="mb-ry__track"><span class="mb-ry__fill" style="width:0.8%"></span></span></th><th class="mb-ry__rate-count">{{ b.star_4 | default: '12' }}</th></tr>
          <tr><th class="mb-ry__rate-name">3<i class="mb-ry-star is-on"></i></th><th><span class="mb-ry__track"><span class="mb-ry__fill" style="width:0%"></span></span></th><th class="mb-ry__rate-count">{{ b.star_3 | default: '0' }}</th></tr>
          <tr><th class="mb-ry__rate-name">2<i class="mb-ry-star is-on"></i></th><th><span class="mb-ry__track"><span class="mb-ry__fill" style="width:0%"></span></span></th><th class="mb-ry__rate-count">{{ b.star_2 | default: '0' }}</th></tr>
          <tr><th class="mb-ry__rate-name">1<i class="mb-ry-star is-on"></i></th><th><span class="mb-ry__track"><span class="mb-ry__fill" style="width:0%"></span></span></th><th class="mb-ry__rate-count">{{ b.star_1 | default: '0' }}</th></tr>
        </table>
      </div>
      <div class="mb-ry__side">
        <div class="mb-ry__photos">
          <h3>{{ b.photos_title | default: 'Customer Photos' }}</h3>
          <ul class="mb-ry__thumbs">
            <li><img src="{% if b.photo_1 != blank %}{{ b.photo_1 | image_url: width: 300 }}{% else %}{{ 'mb-ry-p1.jpg' | asset_url }}{% endif %}" alt="Customer photo" width="300" height="400" loading="lazy"></li>
            <li><img src="{% if b.photo_2 != blank %}{{ b.photo_2 | image_url: width: 300 }}{% else %}{{ 'mb-ry-p2.jpg' | asset_url }}{% endif %}" alt="Customer photo" width="300" height="400" loading="lazy"></li>
            <li><img src="{% if b.photo_3 != blank %}{{ b.photo_3 | image_url: width: 300 }}{% else %}{{ 'mb-ry-p3.jpg' | asset_url }}{% endif %}" alt="Customer photo" width="300" height="400" loading="lazy"></li>
            <li><img src="{% if b.photo_4 != blank %}{{ b.photo_4 | image_url: width: 300 }}{% else %}{{ 'mb-ry-p4.jpg' | asset_url }}{% endif %}" alt="Customer photo" width="300" height="666" loading="lazy"></li>
            <li>
              <img src="{% if b.photo_5 != blank %}{{ b.photo_5 | image_url: width: 300 }}{% else %}{{ 'mb-ry-p5.jpg' | asset_url }}{% endif %}" alt="Customer photo" width="300" height="400" loading="lazy">
              <span class="mb-ry__more">{{ b.more_label | default: '+10' }}</span>
            </li>
          </ul>
        </div>
        <button type="button" class="mb-ry__write">{{ b.write_label | default: 'Write a review' }}</button>
      </div>
    </div>

    <div class="mb-ry__tools">
      <p class="mb-ry__showing">{{ b.showing | default: 'Showing 1 - 10 of 1,529 reviews' }}</p>
      <div class="mb-ry__filters">
        <select id="mb-ry-filter" aria-label="Filter reviews">
          <option>All</option>
          <option>Excellent</option>
          <option>Good</option>
          <option>Images</option>
        </select>
        <select id="mb-ry-sort" aria-label="Sort by reviews">
          <option>Latest</option>
          <option>Oldest</option>
          <option>Images</option>
          <option>Most likes</option>
        </select>
      </div>
    </div>

    <div class="mb-ry__cols">
      <div class="mb-ry__col">
        {%- liquid
  assign card_letter = b.r1_letter | default: 'l'
  assign card_color = b.r1_color | default: '#25c5a3'
  assign card_name = b.r1_name | default: 'Lynne W.'
  assign card_date = b.r1_date | default: 'last month'
  assign card_stars = b.r1_stars | default: 4
  assign card_title = b.r1_title | default: 'Anazing'
  assign card_short = b.r1_short | default: 'I have suffered for 4 months with this, spent hundreds of pounds on various creams and insoles all highly recommended- n'
  assign card_full = b.r1_full | default: 'I have suffered for 4 months with this, spent hundreds of pounds on various creams and insoles all highly recommended- nothing helped much. Thought why not try this when it came up on FB - it’s brilliant I can walk for a reasonable time where before after Q10mons I was limping. Suggest you try and use 3 times a day can’t recommend it enough.'
  assign card_up = b.r1_up | default: 9
  assign card_down = b.r1_down | default: 1
-%}
