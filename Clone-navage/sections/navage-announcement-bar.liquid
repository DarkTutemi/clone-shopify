{% comment %}
  Clone-navage/sections/navage-announcement-bar.liquid
  Full-fidelity Naväge Top Bar matching navage.com
{% endcomment %}

<div id="SectionId-{{ section.id }}" class="navage-announcement-bar">
  <div class="navage-announcement-container">
    <div class="navage-announcement-center">
      <span class="navage-badge-new">NEW</span>
      <span class="navage-announcement-msg">
        <strong>Meet the Naväge Advanced Nose Cleaner.</strong> Your Naväge, leveled up — Digital Controls, 3 Comfort Settings &amp; More!
      </span>
      <a href="/products/navage-advanced-nose-cleaner" class="navage-see-whats-new">See what's new &rarr;</a>
    </div>
  </div>
</div>

<style>
  #SectionId-{{ section.id }} {
    background-color: #0b2540;
    color: #ffffff;
    font-size: 13px;
    line-height: 1.4;
    padding: 9px 16px;
    position: relative;
    z-index: 100;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  #SectionId-{{ section.id }} .navage-announcement-container {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  #SectionId-{{ section.id }} .navage-announcement-center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    text-align: center;
  }
  #SectionId-{{ section.id }} .navage-badge-new {
    background-color: #ffd000;
    color: #111111;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.6px;
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
    display: inline-block;
  }
  #SectionId-{{ section.id }} .navage-announcement-msg {
    font-size: 13px;
    color: #f0f4f8;
  }
  #SectionId-{{ section.id }} .navage-see-whats-new {
    color: #ffffff;
    text-decoration: underline;
    font-weight: 600;
    margin-left: 6px;
    transition: color 0.2s ease;
  }
  #SectionId-{{ section.id }} .navage-see-whats-new:hover {
    color: #00A3E0;
  }
  @media (max-width: 768px) {
    #SectionId-{{ section.id }} {
      font-size: 11px;
      padding: 7px 12px;
    }
    #SectionId-{{ section.id }} .navage-announcement-msg {
      font-size: 11px;
    }
  }
</style>

{% schema %}
{
  "name": "Navage Announcement Bar",
  "settings": []
}
{% endschema %}
