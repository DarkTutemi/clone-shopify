{% comment %}
  ZAVELYN IMMERSIVE COMMERCE THEME V4.1
  CORE FEATURE: 2.5D REAL-WORLD PHYSICAL RETAIL SHOWROOM
  Features:
  - 6-Layer Architectural Retail Shelving
  - Shelf-Edge Channel Price Tags (No tall card blocks under products!)
  - Authentic Grounded Product Shadow Discs & Acrylic Merchandising Risers
  - Hero Pedestal Showcase for Single-Product Collections
  - Positional Zoom Spatial Inspection Bay (Replaces centered popup on desktop)
{% endcomment %}

{{ 'zavelyn-v4-tokens.css' | asset_url | stylesheet_tag }}
{{ 'zavelyn-v4-showroom.css' | asset_url | stylesheet_tag }}

{% assign shelf_style = section.settings.shelf_style | default: 'wood' %}
{% if collection.handle contains 'tool' or collection.handle contains 'power' %}
  {% assign shelf_style = 'metal' %}
{% elsif collection.handle contains 'handpan' or collection.handle contains 'drum' or collection.handle contains 'sound' %}
  {% assign shelf_style = 'tech' %}
{% elsif collection.handle contains 'wellness' or collection.handle contains 'denture' or collection.handle contains 'batana' %}
  {% assign shelf_style = 'boutique' %}
{% endif %}

<div class="zv-showroom-wrapper shelf-theme-{{ shelf_style }}">

  <!-- =======================================================================
       1. SHOWROOM ATMOSPHERIC ARCHITECTURAL HEADER
       ======================================================================= -->
  <header class="zv-showroom-header">
    <div class="zv-container">
      <div class="zv-showroom-title-row">
        <div>
          <div class="zv-showroom-eyebrow">
            <span>🏛️ ZAVELYN RETAIL ENVIRONMENT</span>
            <span>&middot;</span>
            <span class="zv-shelf-style-badge">{{ shelf_style | capitalize }} Department</span>
          </div>
          <h1 class="zv-showroom-h1">{{ collection.title }}</h1>
          <div class="zv-showroom-desc">
            {{ collection.description | default: "Step into our physical retail showroom. Products are displayed on authentic architectural shelves. Click any item to pull it forward for spatial inspection and instant checkout." }}
          </div>
        </div>

        <!-- Controls Toolbar (View Toggle & Inventory Count) -->
        <div class="zv-showroom-toolbar">
          <div class="zv-showroom-stats">
            <span class="zv-live-status-dot"></span>
            <strong>{{ collection.products_count }}</strong> Items on Display
          </div>

          <div class="zv-view-switcher" role="group" aria-label="Display View Mode">
            <button type="button" class="zv-view-btn active" data-view-mode="shelf" title="2.5D Physical Showroom Shelves">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
              <span>Showroom</span>
            </button>
            <button type="button" class="zv-view-btn" data-view-mode="grid" title="Standard Catalog Grid">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              <span>Grid</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- =======================================================================
       2. 2.5D SHELF SHOWROOM STAGE (PHYSICAL DISPLAY ENVIRONMENT)
       ======================================================================= -->
  <main class="zv-showroom-stage" id="zvShowroomStage">
    
    <!-- Architectural Fixture Columns (Store Wall Frame) -->
    <div class="zv-fixture-column zv-fixture-left" aria-hidden="true"></div>
    <div class="zv-fixture-column zv-fixture-right" aria-hidden="true"></div>

    <div class="zv-container">

      {% paginate collection.products by 24 %}
        {% assign total_products = collection.products.size %}

        {% if total_products > 0 %}
          {% assign items_per_shelf = 4 %}

          {% for product in collection.products %}
            {% assign mod_index = forloop.index0 | modulo: items_per_shelf %}
            {% assign mod2_index = forloop.index0 | modulo: 2 %}
            {% assign current_variant = product.selected_or_first_available_variant %}
            {% assign has_compare = false %}
            {% if current_variant.compare_at_price > current_variant.price %}
              {% assign has_compare = true %}
              {% assign save_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round %}
            {% endif %}

            {% comment %} Open a new Desktop Shelf Tier every 4 products {% endcomment %}
            {% if mod_index == 0 %}
              {% assign remaining_items = forloop.length | minus: forloop.index0 %}
              {% if remaining_items >= 4 %}
                {% assign current_row_count = 4 %}
              {% else %}
                {% assign current_row_count = remaining_items %}
              {% endif %}

              <div class="zv-shelf-tier" data-tier-index="{{ forloop.index0 | divided_by: 4 }}" data-tier-count="{{ current_row_count }}">
                
                <!-- Overhead Directional Lighting Beam -->
                <div class="zv-fixture-lightbar" aria-hidden="true">
                  <div class="zv-spotlight-beam" style="left: 12.5%;"></div>
                  <div class="zv-spotlight-beam" style="left: 37.5%;"></div>
                  <div class="zv-spotlight-beam" style="left: 62.5%;"></div>
                  <div class="zv-spotlight-beam" style="left: 87.5%;"></div>
                </div>

                <!-- Shelf Stage: Holds continuous wooden plank and product columns -->
                <div class="zv-shelf-stage">

                  <!-- 1. Authentic Continuous Solid Wooden Plank (Desktop-Only: >= 992px) -->
                  <div class="zv-continuous-wooden-shelf zv-shelf-desktop-only" aria-hidden="true">
                    <div class="zv-wood-top-surface">
                      <div class="zv-wood-grain-texture"></div>
                      <div class="zv-wood-top-highlight"></div>
                    </div>
                    <div class="zv-wood-front-fascia">
                      <div class="zv-wood-bevel-edge"></div>
                      <div class="zv-wood-front-grain"></div>
                      <div class="zv-wood-bottom-bevel"></div>
                    </div>
                    <div class="zv-wood-under-shadow"></div>
                  </div>

                  <!-- 2. Products Columns Grid -->
                  <div class="zv-shelf-columns-grid zv-grid--{{ current_row_count }}">
            {% endif %}

            {% comment %} Open a Mobile Shelf Pair every 2 products {% endcomment %}
            {% if mod2_index == 0 %}
              {% assign remaining_in_pair = forloop.length | minus: forloop.index0 %}
              {% if remaining_in_pair >= 2 and mod_index != 3 %}
                {% assign pair_count = 2 %}
              {% else %}
                {% assign pair_count = 1 %}
              {% endif %}

              <div class="zv-shelf-pair zv-pair--{{ pair_count }}" data-pair-count="{{ pair_count }}">
                <!-- Authentic Continuous Solid Wooden Plank (Mobile/Tablet-Only: < 992px) -->
                <div class="zv-continuous-wooden-shelf zv-shelf-mobile-only" aria-hidden="true">
                  <div class="zv-wood-top-surface">
                    <div class="zv-wood-grain-texture"></div>
                    <div class="zv-wood-top-highlight"></div>
                  </div>
                  <div class="zv-wood-front-fascia">
                    <div class="zv-wood-bevel-edge"></div>
                    <div class="zv-wood-front-grain"></div>
                    <div class="zv-wood-bottom-bevel"></div>
                  </div>
                  <div class="zv-wood-under-shadow"></div>
                </div>

                <div class="zv-pair-products">
            {% endif %}

            <!-- Individual Product Column -->
            <div class="zv-shelf-column" data-col-index="{{ mod_index }}" data-product-handle="{{ product.handle }}">
              
              {% assign has_override = false %}
              {% assign is_cutout = false %}
              {% assign showroom_img_url = '' %}
              {% assign catalog_img_url = '' %}
              {% assign catalog_fit = 'contain' %}
              {% assign display_scale = 100 %}
              {% assign mobile_scale = 100 %}
              {% assign baseline_offset = 0 %}
              {% assign horizontal_offset = 0 %}
              {% assign enable_contact_shadow = true %}
              {% assign shadow_width = 70 %}
              {% assign shadow_opacity = 0.70 %}
              {% assign shadow_softness = 12 %}
              {% assign is_reset = false %}

              {% comment %} Check Theme Editor Blocks {% endcomment %}
              {% for block in section.blocks %}
                {% if block.type == 'product_image_override' or block.type == 'cutout_override' %}
                  {% if block.settings.enable_override %}
                    {% if block.settings.product.id == product.id or block.settings.product.handle == product.handle or block.settings.product == product.handle %}
                      {% if block.settings.reset_original %}
                        {% assign is_reset = true %}
                      {% else %}
                        {% assign has_override = true %}
                        {% assign catalog_fit = block.settings.catalog_image_fit | default: 'contain' %}
                        {% assign display_scale = block.settings.display_scale | default: 100 %}
                        {% assign mobile_scale = block.settings.mobile_scale | default: display_scale %}
                        {% assign baseline_offset = block.settings.baseline_offset | default: 0 %}
                        {% assign horizontal_offset = block.settings.horizontal_offset | default: 0 %}
                        {% if block.settings.enable_contact_shadow != nil %}
                          {% assign enable_contact_shadow = block.settings.enable_contact_shadow %}
                        {% endif %}
                        {% assign shadow_width = block.settings.shadow_width | default: 70 %}
                        {% if block.settings.shadow_opacity != blank %}
                          {% assign shadow_opacity = block.settings.shadow_opacity | divided_by: 100.0 %}
                        {% endif %}
                        {% assign shadow_softness = block.settings.shadow_softness | default: 12 %}

                        {% if block.settings.use_same_image %}
                          {% if block.settings.showroom_image != blank %}
                            {% assign showroom_img_url = block.settings.showroom_image | image_url: width: 800 %}
                            {% assign catalog_img_url = showroom_img_url %}
                            {% assign is_cutout = true %}
                          {% elsif block.settings.catalog_image != blank %}
                            {% assign catalog_img_url = block.settings.catalog_image | image_url: width: 800 %}
                            {% assign showroom_img_url = catalog_img_url %}
                            {% assign is_cutout = true %}
                          {% elsif block.settings.cutout_image != blank %}
                            {% assign showroom_img_url = block.settings.cutout_image | image_url: width: 800 %}
                            {% assign catalog_img_url = showroom_img_url %}
                            {% assign is_cutout = true %}
                          {% endif %}
                        {% else %}
                          {% if block.settings.showroom_image != blank %}
                            {% assign showroom_img_url = block.settings.showroom_image | image_url: width: 800 %}
                            {% assign is_cutout = true %}
                          {% elsif block.settings.cutout_image != blank %}
                            {% assign showroom_img_url = block.settings.cutout_image | image_url: width: 800 %}
                            {% assign is_cutout = true %}
                          {% endif %}

                          {% if block.settings.catalog_image != blank %}
                            {% assign catalog_img_url = block.settings.catalog_image | image_url: width: 800 %}
                          {% endif %}
                        {% endif %}
                      {% endif %}
                    {% endif %}
                  {% endif %}
                {% endif %}
              {% endfor %}

              {% comment %} Check Product Metafields if not overridden or reset {% endcomment %}
              {% unless is_reset %}
                {% if showroom_img_url == blank and product.metafields.custom.showroom_cutout != blank %}
                  {% assign is_cutout = true %}
                  {% assign showroom_img_url = product.metafields.custom.showroom_cutout | image_url: width: 800 %}
                {% endif %}
                {% if catalog_img_url == blank and product.metafields.custom.catalog_image != blank %}
                  {% assign catalog_img_url = product.metafields.custom.catalog_image | image_url: width: 800 %}
                {% endif %}
              {% endunless %}

              {% comment %} Approved Presets (Space Heater & Dough Mixer) if not overridden or reset {% endcomment %}
              {% unless is_reset %}
                {% if showroom_img_url == blank %}
                  {% if product.handle == 'sakerplus®-1500w-flame-effect-oscillating-space-heater' %}
                    {% assign is_cutout = true %}
                    {% assign showroom_img_url = 'zavelyn-cutout-space-heater.png' | asset_url %}
                    {% assign shadow_width = 70 %}
                    {% assign shadow_opacity = 0.72 %}
                  {% elsif product.handle == 'zavelyn-automatic-dough-mixer-with-ferment-function' %}
                    {% assign is_cutout = true %}
                    {% assign showroom_img_url = 'zavelyn-cutout-dough-mixer.png' | asset_url %}
                    {% assign shadow_width = 75 %}
                    {% assign shadow_opacity = 0.62 %}
                  {% endif %}
                {% endif %}
              {% endunless %}

              {% comment %} Fallback to featured_image {% endcomment %}
              {% if showroom_img_url == blank and product.featured_image %}
                {% assign showroom_img_url = product.featured_image | image_url: width: 600 %}
              {% endif %}
              {% if catalog_img_url == blank and product.featured_image %}
                {% assign catalog_img_url = product.featured_image | image_url: width: 600 %}
              {% endif %}

              {% capture safe_product_json %}
              {
                "id": {{ product.id }},
                "title": {{ product.title | json }},
                "handle": {{ product.handle | json }},
                "url": {{ product.url | json }},
                "featured_image": {{ product.featured_image | image_url: width: 600 | json }},
                "variants": [
                  {% for variant in product.variants %}
                    {
                      "id": {{ variant.id }},
                      "title": {{ variant.title | json }},
                      "price": {{ variant.price }},
                      "compare_at_price": {{ variant.compare_at_price | default: 0 }},
                      "available": {{ variant.available }},
                      "featured_image": {% if variant.featured_image %}{{ variant.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }
              {% endcapture %}

              <!-- A. SHOWROOM 2.5D SHELF VIEW (Active in Showroom Mode) -->
              <div class="zv-showroom-view-wrap">
                <article 
                  class="zv-shelf-item" 
                  data-product-id="{{ product.id }}" 
                  data-product-handle="{{ product.handle }}"
                  data-product-url="{{ product.url }}"
                  data-product-json="{{ safe_product_json | escape }}"
                  data-col="{{ mod_index }}"
                  {% if is_cutout and showroom_img_url != '' %}data-cutout-src="{{ showroom_img_url }}"{% endif %}
                  tabindex="0"
                  role="button"
                  aria-label="{{ product.title | escape }} - {{ current_variant.price | money }}"
                >
                  <div 
                    class="zv-merch-display" 
                    style="--shadow-w: {{ shadow_width }}%; --shadow-op: {{ shadow_opacity }}; --shadow-h: {{ shadow_softness }}px;"
                  >
                    {% if is_cutout and showroom_img_url != '' %}
                      <div 
                        class="zv-cutout-container"
                        style="--scale-d: {{ display_scale | divided_by: 100.0 }}; --scale-m: {{ mobile_scale | divided_by: 100.0 }}; --trans-x: {{ horizontal_offset }}px; --trans-y: {{ baseline_offset }}px;"
                      >
                        <img 
                          src="{{ showroom_img_url }}" 
                          alt="{{ product.title | escape }}" 
                          loading="lazy" 
                          class="zv-merch-img zv-cutout-img"
                          width="260"
                          height="260"
                        >
                      </div>
                      {% if enable_contact_shadow %}
                        <div class="zv-shelf-contact-shadow"></div>
                        <div class="zv-shelf-ambient-shadow"></div>
                      {% endif %}
                    {% else %}
                      <div class="zv-fallback-container">
                        {% if product.featured_image %}
                          <img 
                            src="{{ product.featured_image | image_url: width: 480 }}" 
                            alt="{{ product.title | escape }}" 
                            loading="lazy" 
                            class="zv-merch-img zv-fallback-img"
                            width="240"
                            height="240"
                          >
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'zv-merch-img' }}
                        {% endif %}
                      </div>
                      <div class="zv-shelf-contact-shadow" style="--shadow-w: 70%; --shadow-op: 0.22;"></div>
                    {% endif %}
                  </div>
                </article>

                <!-- Shelf-Edge Price Tag hanging directly from the front edge of the shelf! -->
                <div 
                  class="zv-shelf-clip-tag" 
                  data-product-id="{{ product.id }}"
                  data-product-json="{{ safe_product_json | escape }}"
                  tabindex="0"
                  role="button"
                  aria-label="Inspect {{ product.title | escape }} - {{ current_variant.price | money }}"
                >
                  <div class="zv-tag-clip-bracket" aria-hidden="true"></div>
                  <div class="zv-tag-card">
                    <div class="zv-tag-title" title="{{ product.title | escape }}">
                      {{ product.title }}
                    </div>
                    <div class="zv-tag-pricing">
                      <span class="zv-tag-price-curr">{{ current_variant.price | money }}</span>
                      {% if has_compare %}
                        <span class="zv-tag-price-old">{{ current_variant.compare_at_price | money }}</span>
                        <span class="zv-tag-save-badge">-{{ save_percent }}%</span>
                      {% endif %}
                    </div>
                    <div class="zv-tag-action-row">
                      <span class="zv-tag-action-hint">PULL SHELF ⚡</span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- B. CATALOG GRID CARD VIEW (Active in Grid Mode) -->
              <div class="zv-catalog-view-wrap">
                <div class="zv-cat-card" data-product-id="{{ product.id }}">
                  <a href="{{ product.url }}" class="zv-cat-card-media" aria-label="{{ product.title | escape }}">
                    <img 
                      src="{{ catalog_img_url }}" 
                      alt="{{ product.title | escape }}" 
                      loading="lazy" 
                      class="zv-cat-card-img" 
                      style="object-fit: {{ catalog_fit }};"
                    >
                    {% if has_compare %}
                      <span class="zv-cat-sale-badge">SAVE {{ save_percent }}%</span>
                    {% endif %}
                  </a>
                  <div class="zv-cat-card-body">
                    <div class="zv-cat-rating">
                      <span class="zv-stars">★★★★★</span>
                      <span class="zv-cat-rating-num">4.9</span>
                      <span class="zv-cat-review-count">({{ product.id | modulo: 800 | plus: 240 }})</span>
                    </div>
                    <h3 class="zv-cat-card-title">
                      <a href="{{ product.url }}" title="{{ product.title | escape }}">{{ product.title }}</a>
                    </h3>
                    <div class="zv-cat-price-row">
                      <span class="zv-cat-price-curr">{{ current_variant.price | money }}</span>
                      {% if has_compare %}
                        <span class="zv-cat-price-old">{{ current_variant.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                    <div class="zv-cat-card-actions">
                      {% if product.available %}
                        <button type="button" class="zv-cat-atc-btn" onclick="zvShowroomDirectAddToCart('{{ current_variant.id }}', this)">
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                          <span>Add to Cart</span>
                        </button>
                      {% else %}
                        <button type="button" class="zv-cat-atc-btn sold-out" disabled>
                          <span>Sold Out</span>
                        </button>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>

            </div> <!-- /.zv-shelf-column -->

            {% comment %} Close Mobile Pair every 2 products or at end of loop or at tier boundary {% endcomment %}
            {% if mod2_index == 1 or forloop.last or mod_index == 3 %}
                </div> <!-- /.zv-pair-products -->
              </div> <!-- /.zv-shelf-pair -->
            {% endif %}

            {% comment %} Close Desktop Tier every 4 products or at end of loop {% endcomment %}
            {% if mod_index == 3 or forloop.last %}
                    </div> <!-- /.zv-shelf-columns-grid -->
                  </div> <!-- /.zv-shelf-stage -->
                </div> <!-- /.zv-shelf-tier -->
            {% endif %}

          {% endfor %}

        {% else %}
          <div style="text-align: center; padding: 72px 0; color: var(--zv-muted);">
            <h3>No products found in this showroom department.</h3>
            <p>Please browse our other store departments or return to the main hall.</p>
          </div>
        {% endif %}

        <!-- Accessible Pagination -->
        {% if paginate.pages > 1 %}
          <div class="zv-showroom-pagination">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}

      {% endpaginate %}

    </div>
  </main>

  <!-- =======================================================================
       3. POSITIONAL ZOOM: SPATIAL PRODUCT INSPECTION BAY (DESKTOP)
       Anchored directly to the selected shelf item's on-screen coordinates
       ======================================================================= -->
  <div class="zv-spatial-inspect-bay" id="zvSpatialInspectBay" aria-hidden="true" role="dialog" aria-modal="true">
    
    <!-- Atmospheric Showroom Dimming Backdrop -->
    <div class="zv-inspect-backdrop" id="zvInspectBackdrop"></div>

    <!-- Active Inspection Stage Container -->
    <div class="zv-inspect-stage-wrap" id="zvInspectStageWrap">

      <!-- Zoomed Product Focal Image (FLIP-animated from shelf position) -->
      <div class="zv-inspect-focal-frame" id="zvInspectFocalFrame">
        <div class="zv-focal-spotlight"></div>
        <img src="" alt="" class="zv-focal-img" id="zvInspectFocalImg">
        <div class="zv-focal-ground-shadow"></div>
      </div>

      <!-- Anchored Product Information Panel (Slides out beside the product) -->
      <div class="zv-inspect-anchored-panel" id="zvInspectAnchoredPanel">
        
        <!-- Header & Close Button -->
        <div class="zv-anchored-header">
          <div class="zv-badge zv-badge-forest" style="font-size: 11px;">
            <span>🏛️ SPATIAL SHELF INSPECTION</span>
          </div>
          <button type="button" class="zv-anchored-close-btn" id="zvInspectCloseBtn" aria-label="Return product to shelf">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <!-- Product Identity -->
        <h2 class="zv-anchored-title" id="zvInspectTitle">Product Title</h2>

        <!-- Pricing & Value Strip -->
        <div class="zv-anchored-price-strip">
          <span class="zv-anchored-price-curr" id="zvInspectPriceCurr">$0.00</span>
          <span class="zv-anchored-price-old" id="zvInspectPriceOld">$0.00</span>
          <span class="zv-badge zv-badge-lime" id="zvInspectSaveBadge">SAVE 20%</span>
        </div>

        <!-- Verified Value Props -->
        <ul class="zv-anchored-benefits-list">
          <li>
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>In stock &middot; Dispatches directly from US warehouse</span>
          </li>
          <li>
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>30-Day risk-free home trial with 100% money-back guarantee</span>
          </li>
        </ul>

        <!-- Variant Options Pills Container -->
        <div class="zv-anchored-variants" id="zvInspectVariants"></div>

        <!-- Commerce Action Buttons -->
        <div class="zv-anchored-actions">
          <button type="button" class="zv-btn zv-btn-primary zv-btn-block zv-btn-lg" id="zvInspectAtcBtn">
            <span>ADD TO CART ➔</span>
          </button>
          
          <a href="#" class="zv-anchored-pdp-link" id="zvInspectPdpLink">
            <span>View Full Product Page &amp; Video Reviews &rarr;</span>
          </a>
        </div>

        <!-- Safe Shipping & Security Guarantee -->
        <div class="zv-anchored-trust-footer">
          <span>🔒 256-bit Encrypted Checkout</span>
          <span>&bull;</span>
          <span>🚚 Fast 3-5 Day Delivery</span>
        </div>

      </div>

    </div>
  </div>

  <!-- =======================================================================
       4. MOBILE SHOWROOM BOTTOM SHEET (< 768px Viewports)
       ======================================================================= -->
  <div class="zv-mobile-sheet-overlay" id="zvMobileSheetOverlay" aria-hidden="true">
    <div class="zv-mobile-sheet" id="zvMobileSheet">
      <div class="zv-mobile-sheet-handle"></div>
      
      <div class="zv-mobile-sheet-header">
        <button type="button" class="zv-mobile-sheet-close" id="zvMobileSheetClose" aria-label="Close bottom sheet">&times;</button>
      </div>

      <div class="zv-mobile-sheet-body">
        <div class="zv-mobile-sheet-img-wrap">
