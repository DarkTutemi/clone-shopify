{% comment %}
  ZAVELYN — Real Carrier Order Tracking Experience
  Replaces insecure mock tracking with authentic carrier routing and Shopify Account lookup.
  Aesthetic: ShopSideK T01 Refined Editorial Card
{% endcomment %}

<div class="zvhc-track-page" id="zvhcTrackPage">
  <!-- Hero Section -->
  <header class="zvhc-track-hero">
    <div class="zvhc-track-container">
      <span class="zvhc-track-badge">
        <span class="zvhc-track-status-dot"></span>
        <span>OFFICIAL CARRIER TRACKING</span>
      </span>
      <h1 class="zvhc-track-title">Track Your Order</h1>
      <p class="zvhc-track-sub">
        Enter your carrier tracking number to look up live, verified delivery status directly on the official carrier network.
      </p>

      <!-- Trust highlights -->
      <div class="zvhc-track-trust-strip">
        <div class="zvhc-ttrust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>Tracked Transit</span>
        </div>
        <div class="zvhc-ttrust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span>24–48h Dispatch</span>
        </div>
        <div class="zvhc-ttrust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <span>30-Day Satisfaction Guarantee</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Tracking Box -->
  <main class="zvhc-track-container zvhc-track-main">
    <div class="zvhc-track-card">
      
      <!-- Tabs Switcher -->
      <div class="zvhc-track-tabs" role="tablist">
        <button type="button" class="zvhc-tab-btn is-active" id="zvhcTabTrackBtn" role="tab" aria-selected="true" aria-controls="zvhcTabTrackContent" onclick="zvhcSwitchTab('tracking')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          <span>Carrier Tracking Number</span>
        </button>
        <button type="button" class="zvhc-tab-btn" id="zvhcTabOrderBtn" role="tab" aria-selected="false" aria-controls="zvhcTabOrderContent" onclick="zvhcSwitchTab('order')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          <span>Order Number &amp; Account</span>
        </button>
      </div>

      <!-- Tab 1: Carrier Tracking Number -->
      <div class="zvhc-tab-panel is-active" id="zvhcTabTrackContent" role="tabpanel" aria-labelledby="zvhcTabTrackBtn">
        <form class="zvhc-track-form" onsubmit="zvhcHandleTrackSubmit(event)">
          <div class="zvhc-field-group">
            <label for="zvhcTrackingInput" class="zvhc-field-label">Tracking Number</label>
            <div class="zvhc-input-wrap">
              <svg class="zvhc-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <input 
                type="text" 
                id="zvhcTrackingInput" 
                class="zvhc-track-input" 
                placeholder="e.g. 9400111899562847192031 (USPS) or 785641298412 (FedEx)" 
                required
                autocomplete="off"
              >
            </div>
            <span class="zvhc-field-hint">Found in your dispatch confirmation email or SMS notification.</span>
          </div>

          <div class="zvhc-field-group">
            <label for="zvhcCarrierSelect" class="zvhc-field-label">Carrier Network</label>
            <select id="zvhcCarrierSelect" class="zvhc-track-select">
              <option value="auto">Auto-Detect Carrier</option>
              <option value="usps">USPS (United States Postal Service)</option>
              <option value="fedex">FedEx Express &amp; Ground</option>
              <option value="ups">UPS (United Parcel Service)</option>
              <option value="dhl">DHL Express</option>
              <option value="17track">Universal Global Tracking (17Track)</option>
            </select>
          </div>

          <button type="submit" class="zvhc-btn-track" id="zvhcTrackBtn">
            <span>Verify &amp; Track Package</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </button>
        </form>

        <!-- Dynamic Verified Result Notification -->
        <div id="zvhcRealResult" class="zvhc-real-result" style="display: none;" role="region" aria-live="polite">
          <div class="zvhc-result-box">
            <div class="zvhc-result-top">
              <div class="zvhc-result-badge" id="zvhcResultCarrierBadge">USPS Official Tracking</div>
              <span class="zvhc-result-secure-tag">🔒 Authenticated Carrier Portal</span>
            </div>
            <div class="zvhc-result-code-wrap">
              <span class="zvhc-result-label">Tracking Number:</span>
              <strong class="zvhc-result-code" id="zvhcResultCode"></strong>
            </div>
            <p class="zvhc-result-desc">
              To ensure 100% data authenticity, GPS transit milestone timestamps, and carrier proof-of-delivery signatures, tracking records are securely viewed directly on the official carrier server.
            </p>
            <div class="zvhc-result-actions">
              <a href="#" id="zvhcCarrierOutLink" target="_blank" rel="noopener noreferrer" class="zvhc-btn-carrier-link">
                <span>Open Live Official Carrier Tracking</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Tab 2: Order Number & Email / Account Lookup -->
      <div class="zvhc-tab-panel" id="zvhcTabOrderContent" role="tabpanel" aria-labelledby="zvhcTabOrderBtn">
        <div class="zvhc-order-lookup-info">
          <div class="zvhc-lookup-step">
            <div class="zvhc-step-num">1</div>
            <div>
              <h3 class="zvhc-step-title">Order Confirmation Email</h3>
              <p class="zvhc-step-desc">
                When your order was placed, an email confirmation was dispatched from <strong>support@tryzavelyn.com</strong> containing your unique 4-digit order number (e.g. #1048) and an authenticated link to view your live order status.
              </p>
            </div>
          </div>

          <div class="zvhc-lookup-step">
            <div class="zvhc-step-num">2</div>
            <div>
              <h3 class="zvhc-step-title">Customer Account Portal</h3>
              <p class="zvhc-step-desc">
                Log into your customer account using the email address you entered at checkout to view complete order history, fulfillment status, and shipping labels.
              </p>
              <a href="/account" class="zvhc-btn-account-link">Sign In to Customer Account &rarr;</a>
            </div>
          </div>

          <div class="zvhc-lookup-step">
            <div class="zvhc-step-num">3</div>
            <div>
              <h3 class="zvhc-step-title">Need Order Assistance?</h3>
              <p class="zvhc-step-desc">
                If you have not received your tracking number within 48 business hours, our care team is ready to verify your fulfillment status.
              </p>
              <a href="mailto:support@tryzavelyn.com?subject=Order%20Tracking%20Assistance" class="zvhc-btn-support-link">Email support@tryzavelyn.com</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Carrier Logos Footer -->
      <div class="zvhc-track-carriers-strip">
        <span class="zvhc-carriers-label">Seamless integration with verified carrier networks:</span>
        <div class="zvhc-carriers-tags">
          <span class="zvhc-carrier-pill">USPS</span>
          <span class="zvhc-carrier-pill">FedEx</span>
          <span class="zvhc-carrier-pill">UPS</span>
          <span class="zvhc-carrier-pill">DHL Express</span>
          <span class="zvhc-carrier-pill">17Track</span>
        </div>
      </div>

    </div>

    <!-- Customer Care Help Box -->
    <div class="zvhc-track-help-card">
      <div class="zvhc-help-icon">✉️</div>
      <div class="zvhc-help-content">
        <h3 class="zvhc-help-title">Dedicated Customer Care</h3>
        <p class="zvhc-help-desc">
          Questions regarding transit delays, address corrections, or product returns? Our team responds within 24 business hours.
        </p>
        <a href="mailto:support@tryzavelyn.com?subject=Order%20Inquiry" class="zvhc-btn-help">Contact Support Team</a>
      </div>
    </div>
  </main>
</div>

<style>
