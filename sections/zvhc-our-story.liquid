{% comment %}
  ZAVELYN HAIR CARE — Our Story Editorial Page Section
  Aesthetic: ShopSideK T01 Editorial Brand Narrative
  Sections:
  1. Editorial Hero
  2. Our Approach
  3. What We Believe (Three Pillars)
  4. Our Collections
  5. Our Commitment
  6. Closing CTA
{% endcomment %}

<article class="zvhc-story-page" aria-label="Our Story — Zavelyn Hair Care">
  
  <!-- 1. Editorial Hero -->
  <section class="zvhc-story-hero">
    <div class="zvhc-story-container">
      <div class="zvhc-story-hero-header">
        <span class="zvhc-story-pill">🌿 THE PHILOSOPHY OF ZAVELYN HAIR CARE</span>
        <h1 class="zvhc-story-hero-title">{{ section.settings.hero_title | default: 'Care for Every Strand. Confidence in Every Ritual.' }}</h1>
        <p class="zvhc-story-hero-sub">{{ section.settings.hero_sub | default: 'Discover a more thoughtful way to care for curls, coils, scalp and strands.' }}</p>
      </div>

      <div class="zvhc-story-hero-media">
        <img 
          src="{{ section.settings.hero_image | default: 'https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264440' }}" 
          alt="Zavelyn Hair Care botanical ritual and scalp wellness" 
          width="1200" 
          height="640" 
          loading="eager"
          class="zvhc-story-hero-img"
        >
      </div>
    </div>
  </section>

  <!-- 2. Our Approach -->
  <section class="zvhc-story-section zvhc-story-approach">
    <div class="zvhc-story-container">
      <div class="zvhc-story-grid-2col">
        <div class="zvhc-story-media-wrap">
          <img 
            src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811885406846-hero.jpg?v=1795264440" 
            alt="Zavelyn Hair Care nourishing routine" 
            width="600" 
            height="500" 
            loading="lazy"
            class="zvhc-story-img-card"
          >
        </div>
        <div class="zvhc-story-text-wrap">
          <span class="zvhc-story-eyebrow">OUR APPROACH</span>
          <h2 class="zvhc-story-heading">Routines Rooted in Simplicity &amp; Texture Respect</h2>
          <div class="zvhc-story-prose">
            <p>
              At Zavelyn Hair Care, we believe exceptional hair begins with deep, attentive scalp nourishment. For too long, healthy hair routines have been complicated by overwhelming multi-step regimens, synthetic fillers, and unrealistic claims.
            </p>
            <p>
              Our philosophy is intentionally grounded: nutrient-dense botanicals, restorative bio-lipids, and weightless hydration formulated to support your natural texture. Whether you are nurturing curls, restoring thinning edges, or seeking daily volume, we craft products designed to bring ease, comfort, and undeniable confidence to your ritual.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. What We Believe (Three Editorial Pillars) -->
  <section class="zvhc-story-section zvhc-story-pillars">
    <div class="zvhc-story-container">
      <div class="zvhc-story-section-header">
        <span class="zvhc-story-eyebrow">CORE PILLARS</span>
        <h2 class="zvhc-story-heading">What We Believe</h2>
        <p class="zvhc-story-sub">Three foundational commitments guiding every formula and ritual we develop.</p>
      </div>

      <div class="zvhc-pillars-grid">
        <!-- Pillar 1 -->
        <div class="zvhc-pillar-card">
          <div class="zvhc-pillar-icon" aria-hidden="true">🌿</div>
          <h3 class="zvhc-pillar-title">Thoughtful Hair Care</h3>
          <p class="zvhc-pillar-desc">
            Every formula is anchored in pure, cold-pressed botanicals and unrefined lipids. We respect your scalp's micro-barrier and avoid unnecessary synthetic weight.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="zvhc-pillar-card">
          <div class="zvhc-pillar-icon" aria-hidden="true">🎯</div>
          <h3 class="zvhc-pillar-title">Products with Purpose</h3>
          <p class="zvhc-pillar-desc">
            From root-lifting texture to precision hairline fullness and restorative overnight care, every essential in our line serves a verified purpose with zero guesswork.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="zvhc-pillar-card">
          <div class="zvhc-pillar-icon" aria-hidden="true">✨</div>
          <h3 class="zvhc-pillar-title">Confidence in Every Texture</h3>
          <p class="zvhc-pillar-desc">
            Waves, curls, coils, and delicate strands all deserve tailored nourishment. We celebrate every hair pattern with formulations that honor and elevate your individuality.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Our Collections -->
  <section class="zvhc-story-section zvhc-story-collections">
    <div class="zvhc-story-container">
      <div class="zvhc-story-section-header">
        <span class="zvhc-story-eyebrow">CURATED BOTANICAL SYSTEMS</span>
        <h2 class="zvhc-story-heading">Our Collections</h2>
        <p class="zvhc-story-sub">Designed to work seamlessly alone or combined into a comprehensive routine.</p>
      </div>

      <div class="zvhc-collections-grid">
        <!-- Collection 1 -->
        <a href="/collections/zvhc-batana" class="zvhc-collection-card">
          <div class="zvhc-collection-badge">RESTORATION</div>
          <h3 class="zvhc-collection-title">Batana Care</h3>
          <p class="zvhc-collection-desc">Unrefined Honduran Batana oil and bio-active scalp balms formulated for deep follicle vitality and strand elasticity.</p>
          <span class="zvhc-collection-link">Explore Batana Rituals &rarr;</span>
        </a>

        <!-- Collection 2 -->
        <a href="/collections/zvhc-curl" class="zvhc-collection-card">
          <div class="zvhc-collection-badge">HYDRATION</div>
          <h3 class="zvhc-collection-title">Curl &amp; Coily Care</h3>
          <p class="zvhc-collection-desc">Botanical curl creams that impart spring, definition, and lasting moisture without flaking, crunch, or greasy buildup.</p>
          <span class="zvhc-collection-link">Explore Curl Rituals &rarr;</span>
        </a>

        <!-- Collection 3 -->
        <a href="/collections/zvhc-scalp" class="zvhc-collection-card">
          <div class="zvhc-collection-badge">PRECISION</div>
          <h3 class="zvhc-collection-title">Scalp &amp; Edge Care</h3>
          <p class="zvhc-collection-desc">Targeted nutrient density for fragile temple areas, delicate baby hairs, and stressed scalp environments.</p>
          <span class="zvhc-collection-link">Explore Scalp Care &rarr;</span>
        </a>

        <!-- Collection 4 -->
        <a href="/collections/zvhc-coverage" class="zvhc-collection-card">
          <div class="zvhc-collection-badge">INSTANT FULLNESS</div>
          <h3 class="zvhc-collection-title">Instant Hair Coverage</h3>
          <p class="zvhc-collection-desc">Electrostatic keratin fibers and precision hairline compacts that seamlessly blend for undetectable daily density.</p>
          <span class="zvhc-collection-link">Explore Coverage Rituals &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Our Commitment -->
  <section class="zvhc-story-section zvhc-story-commitment">
    <div class="zvhc-story-container">
      <div class="zvhc-commitment-box">
        <span class="zvhc-story-eyebrow">OUR PROMISE TO YOU</span>
        <h2 class="zvhc-story-heading" style="color: #2B1B24;">Transparency, Quality &amp; Responsive Care</h2>
        <div class="zvhc-commitment-grid">
          <div class="zvhc-commit-item">
            <span class="zvhc-commit-num">01</span>
            <h4>Clear, Honest Formulas</h4>
            <p>Every ingredient and usage direction is transparently detailed so you can make informed decisions for your hair health.</p>
          </div>
          <div class="zvhc-commit-item">
            <span class="zvhc-commit-num">02</span>
            <h4>Real Customer Support</h4>
            <p>Our dedicated care team is available at <a href="mailto:support@tryzavelyn.com" style="color: var(--zvhc-t01-accent-rose, #B0476E);">support@tryzavelyn.com</a> to assist with routine questions and product guidance.</p>
          </div>
          <div class="zvhc-commit-item">
            <span class="zvhc-commit-num">03</span>
            <h4>30-Day Satisfaction</h4>
            <p>Try any Zavelyn Hair Care product with confidence. If you are not satisfied within 30 days of delivery, our support team will make it right.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Closing CTA -->
  <section class="zvhc-story-cta">
    <div class="zvhc-story-container">
      <div class="zvhc-cta-inner">
        <h2 class="zvhc-cta-title">Find Your Hair Care Ritual</h2>
        <p class="zvhc-cta-sub">Explore our complete 7-essential botanical system and discover the right balance for your strands.</p>
        <div class="zvhc-cta-actions">
          <a href="/collections/zvhc-all" class="zvhc-btn-story-primary">Shop All 7 Essentials</a>
          <a href="/collections/zvhc-batana" class="zvhc-btn-story-secondary">Discover Batana Care</a>
        </div>
      </div>
    </div>
  </section>

</article>

<style>
/* ==========================================================================
   OUR STORY — SHOPSIDEK T01 EDITORIAL STYLING
   ========================================================================== */
.zvhc-story-page {
  background-color: var(--zvhc-t01-bg, #FBF8F5);
  color: var(--zvhc-t01-text-main, #2B1B24);
  font-family: var(--zvhc-font-sans, -apple-system, BlinkMacSystemFont, sans-serif);
}

.zvhc-story-container {
  max-width: 1140px;
  margin: 0 auto;
  padding: 0 24px;
}

/* 1. Hero */
.zvhc-story-hero {
  padding: 64px 0 40px;
  text-align: center;
}

.zvhc-story-hero-header {
  max-width: 780px;
  margin: 0 auto 36px;
}

.zvhc-story-pill {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--zvhc-t01-accent-rose, #B0476E);
  background: rgba(176, 71, 110, 0.08);
  padding: 6px 14px;
  border-radius: 30px;
  margin-bottom: 18px;
}

.zvhc-story-hero-title {
  font-family: var(--zvhc-font-serif, 'Fraunces', serif);
  font-size: clamp(2.2rem, 4.5vw, 3.4rem);
  font-weight: 700;
  line-height: 1.18;
  color: var(--zvhc-t01-text-main, #2B1B24);
  letter-spacing: -0.02em;
  margin: 0 0 16px;
}

.zvhc-story-hero-sub {
  font-size: 1.15rem;
  line-height: 1.6;
  color: rgba(43, 27, 36, 0.75);
  margin: 0 auto;
}

.zvhc-story-hero-media {
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 16px 40px rgba(43, 27, 36, 0.08);
  border: 1px solid var(--zvhc-t01-border, #EAD7DD);
}

.zvhc-story-hero-img {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
  max-height: 540px;
}

/* 2. Sections Shared */
.zvhc-story-section {
  padding: 72px 0;
}

.zvhc-story-eyebrow {
  display: inline-block;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--zvhc-t01-accent-rose, #B0476E);
  margin-bottom: 10px;
}

.zvhc-story-heading {
  font-family: var(--zvhc-font-serif, 'Fraunces', serif);
  font-size: clamp(1.8rem, 3.2vw, 2.5rem);
  font-weight: 700;
  line-height: 1.25;
  color: var(--zvhc-t01-text-main, #2B1B24);
  letter-spacing: -0.015em;
  margin: 0 0 14px;
}

.zvhc-story-sub {
  font-size: 1rem;
  color: rgba(43, 27, 36, 0.7);
  max-width: 620px;
  line-height: 1.55;
  margin: 0;
}

/* 2. Our Approach Grid */
.zvhc-story-grid-2col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 52px;
  align-items: center;
}

.zvhc-story-media-wrap {
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 12px 32px rgba(43, 27, 36, 0.06);
  border: 1px solid var(--zvhc-t01-border, #EAD7DD);
}

.zvhc-story-img-card {
  width: 100%;
  height: auto;
  display: block;
  object-fit: cover;
}

.zvhc-story-prose p {
  font-size: 1.02rem;
  line-height: 1.7;
  color: rgba(43, 27, 36, 0.8);
  margin: 0 0 16px;
}

/* 3. Pillars Grid */
.zvhc-story-section-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 48px;
}

.zvhc-story-section-header .zvhc-story-sub {
  margin: 0 auto;
}

.zvhc-pillars-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.zvhc-pillar-card {
  background: #FFFFFF;
  border: 1px solid var(--zvhc-t01-border, #EAD7DD);
  border-radius: 16px;
  padding: 36px 28px;
  box-shadow: 0 4px 20px rgba(43, 27, 36, 0.03);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.zvhc-pillar-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(43, 27, 36, 0.08);
}

.zvhc-pillar-icon {
  font-size: 2rem;
  margin-bottom: 16px;
  display: inline-block;
}

.zvhc-pillar-title {
  font-family: var(--zvhc-font-serif, 'Fraunces', serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--zvhc-t01-text-main, #2B1B24);
  margin: 0 0 10px;
}

.zvhc-pillar-desc {
  font-size: 0.92rem;
  line-height: 1.6;
  color: rgba(43, 27, 36, 0.72);
  margin: 0;
}

/* 4. Collections Grid */
.zvhc-collections-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.zvhc-collection-card {
  background: #FFFFFF;
  border: 1px solid var(--zvhc-t01-border, #EAD7DD);
  border-radius: 16px;
  padding: 32px 28px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
}

.zvhc-collection-card:hover {
  transform: translateY(-3px);
  border-color: var(--zvhc-t01-accent-rose, #B0476E);
  box-shadow: 0 12px 28px rgba(176, 71, 110, 0.1);
}

.zvhc-collection-badge {
  display: inline-block;
  align-self: flex-start;
  font-size: 0.68rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--zvhc-t01-accent-rose, #B0476E);
  background: rgba(176, 71, 110, 0.08);
  padding: 4px 10px;
  border-radius: 20px;
  margin-bottom: 14px;
}

.zvhc-collection-title {
  font-family: var(--zvhc-font-serif, 'Fraunces', serif);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--zvhc-t01-text-main, #2B1B24);
  margin: 0 0 8px;
}

.zvhc-collection-desc {
  font-size: 0.9rem;
  line-height: 1.55;
  color: rgba(43, 27, 36, 0.7);
  margin: 0 0 18px;
  flex: 1;
}

.zvhc-collection-link {
  font-size: 0.88rem;
  font-weight: 700;
  color: var(--zvhc-t01-accent-rose, #B0476E);
}

/* 5. Commitment Box */
.zvhc-commitment-box {
  background: linear-gradient(135deg, #F5EAEF 0%, #FFFFFF 100%);
  border: 1px solid var(--zvhc-t01-border, #EAD7DD);
  border-radius: 20px;
  padding: 48px 40px;
  box-shadow: 0 8px 30px rgba(43, 27, 36, 0.04);
}

.zvhc-commitment-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  margin-top: 32px;
}

.zvhc-commit-item {
  border-top: 2px solid var(--zvhc-t01-accent-rose, #B0476E);
  padding-top: 16px;
}

.zvhc-commit-num {
  font-size: 0.8rem;
  font-weight: 800;
  color: var(--zvhc-t01-accent-rose, #B0476E);
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 6px;
}

.zvhc-commit-item h4 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--zvhc-t01-text-main, #2B1B24);
  margin: 0 0 8px;
}

.zvhc-commit-item p {
  font-size: 0.88rem;
  line-height: 1.55;
  color: rgba(43, 27, 36, 0.7);
  margin: 0;
}

/* 6. Closing CTA */
.zvhc-story-cta {
  background: #1B1418;
  color: #FFFFFF;
  padding: 80px 0;
  text-align: center;
}

.zvhc-cta-inner {
  max-width: 640px;
  margin: 0 auto;
}

.zvhc-cta-title {
  font-family: var(--zvhc-font-serif, 'Fraunces', serif);
  font-size: clamp(2rem, 3.8vw, 2.8rem);
  font-weight: 700;
  color: #FFFFFF;
  letter-spacing: -0.015em;
  margin: 0 0 14px;
}

.zvhc-cta-sub {
  font-size: 1.05rem;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.75);
  margin: 0 auto 32px;
}

.zvhc-cta-actions {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.zvhc-btn-story-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52px;
  padding: 0 32px;
  background: var(--zvhc-t01-cta-bg, #6B1E46);
  color: #FFFFFF;
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
  border-radius: 12px;
  transition: transform 0.2s, background-color 0.2s;
}

.zvhc-btn-story-primary:hover {
  background: #842657;
  transform: translateY(-2px);
}

.zvhc-btn-story-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52px;
  padding: 0 28px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  border-radius: 12px;
  transition: background-color 0.2s;
}

.zvhc-btn-story-secondary:hover {
  background: rgba(255, 255, 255, 0.18);
}

/* Responsive */
@media (max-width: 992px) {
  .zvhc-story-grid-2col {
    grid-template-columns: 1fr;
    gap: 36px;
  }
  .zvhc-pillars-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .zvhc-collections-grid {
    grid-template-columns: 1fr;
  }
  .zvhc-commitment-grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  .zvhc-commitment-box {
    padding: 32px 24px;
  }
}
</style>

