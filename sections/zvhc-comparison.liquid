{% comment %}
  ZAVELYN HAIR CARE — Product Comparison Matrix (Section 8)
{% endcomment %}
<section class="zvhc-comparison-section" id="comparison" style="padding: 72px 0; background: #FFFFFF;">
  <div class="zvhc-container">
    <div class="zvhc-section-header" style="text-align: center; max-width: 680px; margin: 0 auto 48px;">
      <div class="zvhc-eyebrow" style="color: var(--zvhc-orange); font-weight: 800; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 8px;">WHICH FORMULA IS RIGHT FOR YOU?</div>
      <h2 class="zvhc-heading-md" style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: clamp(2rem, 3.8vw, 2.8rem); font-weight: 900; letter-spacing: -0.02em; margin: 0 0 14px;">The Complete Formula Comparison</h2>
      <p style="color: var(--zvhc-forest); font-size: 1.05rem; line-height: 1.5; opacity: 0.85;">Select the exact botanical solution designed for your hair density, texture, and immediate styling goals.</p>
    </div>

    <!-- Responsive Table Wrapper -->
    <div style="overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 18px; border: 2px solid rgba(1,93,71,0.08); box-shadow: 0 8px 30px rgba(0,0,0,0.04);">
      <table style="width: 100%; border-collapse: collapse; min-width: 650px; background: #FFFFFF; font-size: 0.95rem; text-align: left;">
        <thead>
          <tr style="background: var(--zvhc-forest); color: #FFFFFF; font-family: var(--zvhc-font-heading); font-weight: 800;">
            <th style="padding: 18px 20px;">Product Name</th>
            <th style="padding: 18px 16px;">Primary Purpose</th>
            <th style="padding: 18px 16px;">Texture &amp; Format</th>
            <th style="padding: 18px 16px;">Best For</th>
            <th style="padding: 18px 16px;">Price</th>
          </tr>
        </thead>
        <tbody>
          <!-- Row 1 -->
          <tr style="border-bottom: 1px solid rgba(1,93,71,0.08);">
            <td style="padding: 18px 20px; font-weight: 700; color: var(--zvhc-forest);">
              <a href="/products/zvhc-batana-hair-growth-oil" style="color: var(--zvhc-forest); text-decoration: underline;">Pure Batana Hair Oil</a>
            </td>
            <td style="padding: 18px 16px; color: #444;">Follicle nourishment &amp; shaft sealing</td>
            <td style="padding: 18px 16px; color: #444;">Liquid oil dropper (60ml)</td>
            <td style="padding: 18px 16px; font-weight: 600; color: var(--zvhc-green);">Thinning strands &amp; dry ends</td>
            <td style="padding: 18px 16px; font-weight: 800; color: var(--zvhc-orange);">$39.99</td>
          </tr>
          <!-- Row 2 -->
          <tr style="border-bottom: 1px solid rgba(1,93,71,0.08); background: #FAF8F5;">
            <td style="padding: 18px 20px; font-weight: 700; color: var(--zvhc-forest);">
              <a href="/products/zvhc-keratin-hair-building-fibers" style="color: var(--zvhc-forest); text-decoration: underline;">Keratin Hair Building Fibers</a>
            </td>
            <td style="padding: 18px 16px; color: #444;">Instant cosmetic coverage</td>
            <td style="padding: 18px 16px; color: #444;">Electrostatic microfibers (100g)</td>
            <td style="padding: 18px 16px; font-weight: 600; color: var(--zvhc-green);">Crown thinning &amp; wide parts</td>
            <td style="padding: 18px 16px; font-weight: 800; color: var(--zvhc-orange);">$34.99</td>
          </tr>
          <!-- Row 3 -->
          <tr style="border-bottom: 1px solid rgba(1,93,71,0.08);">
            <td style="padding: 18px 20px; font-weight: 700; color: var(--zvhc-forest);">
              <a href="/products/zvhc-root-lift-styling-powder" style="color: var(--zvhc-forest); text-decoration: underline;">Root-Lift Styling Powder</a>
            </td>
            <td style="padding: 18px 16px; color: #444;">Volume &amp; scalp oil absorption</td>
            <td style="padding: 18px 16px; color: #444;">Mattifying shaker bottle (10g)</td>
            <td style="padding: 18px 16px; font-weight: 600; color: var(--zvhc-green);">Flat, limp or oily roots</td>
            <td style="padding: 18px 16px; font-weight: 800; color: var(--zvhc-orange);">$19.99</td>
          </tr>
          <!-- Row 4 -->
          <tr style="border-bottom: 1px solid rgba(1,93,71,0.08); background: #FAF8F5;">
            <td style="padding: 18px 20px; font-weight: 700; color: var(--zvhc-forest);">
              <a href="/products/zvhc-precision-hairline-compact" style="color: var(--zvhc-forest); text-decoration: underline;">Precision Hairline Compact</a>
            </td>
            <td style="padding: 18px 16px; color: #444;">Hairline shadow &amp; grey coverage</td>
            <td style="padding: 18px 16px; color: #444;">Pressed powder + puff (4g)</td>
            <td style="padding: 18px 16px; font-weight: 600; color: var(--zvhc-green);">Receding temples &amp; roots</td>
            <td style="padding: 18px 16px; font-weight: 800; color: var(--zvhc-orange);">$24.99</td>
          </tr>
          <!-- Row 5 -->
          <tr style="border-bottom: 1px solid rgba(1,93,71,0.08);">
            <td style="padding: 18px 20px; font-weight: 700; color: var(--zvhc-forest);">
              <a href="/products/zvhc-raw-batana-scalp-balm" style="color: var(--zvhc-forest); text-decoration: underline;">Raw Batana Scalp Balm</a>
            </td>
            <td style="padding: 18px 16px; color: #444;">Deep barrier repair &amp; hydration</td>
            <td style="padding: 18px 16px; color: #444;">Melt-on-contact solid butter (20g)</td>
            <td style="padding: 18px 16px; font-weight: 600; color: var(--zvhc-green);">Extremely dry or flaky scalp</td>
            <td style="padding: 18px 16px; font-weight: 800; color: var(--zvhc-orange);">$19.99</td>
          </tr>
          <!-- Row 6 -->
          <tr style="border-bottom: 1px solid rgba(1,93,71,0.08); background: #FAF8F5;">
            <td style="padding: 18px 20px; font-weight: 700; color: var(--zvhc-forest);">
              <a href="/products/zvhc-botanical-curl-cream" style="color: var(--zvhc-forest); text-decoration: underline;">Botanical Curl Cream</a>
            </td>
            <td style="padding: 18px 16px; color: #444;">Curl definition &amp; frizz shield</td>
            <td style="padding: 18px 16px; color: #444;">Botanical styling cream (100ml)</td>
            <td style="padding: 18px 16px; font-weight: 600; color: var(--zvhc-green);">Type 3 &amp; 4 curls, waves, coils</td>
            <td style="padding: 18px 16px; font-weight: 800; color: var(--zvhc-orange);">$29.99</td>
          </tr>
          <!-- Row 7 -->
          <tr>
            <td style="padding: 18px 20px; font-weight: 700; color: var(--zvhc-forest);">
              <a href="/products/zvhc-7-in-1-growth-elixir" style="color: var(--zvhc-forest); text-decoration: underline;">7-in-1 Multi-Oil Elixir</a>
            </td>
            <td style="padding: 18px 16px; color: #444;">Comprehensive multi-oil therapy</td>
            <td style="padding: 18px 16px; color: #444;">Infused herbal botanical blend (60ml)</td>
            <td style="padding: 18px 16px; font-weight: 600; color: var(--zvhc-green);">All hair types daily therapy</td>
            <td style="padding: 18px 16px; font-weight: 800; color: var(--zvhc-orange);">$39.99</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

