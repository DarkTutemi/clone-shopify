      flex-direction: column;
    }
    .sticky-bar-title {
      font-size: 14px;
      font-weight: 700;
      color: #1e293b;
    }
    .sticky-bar-discount {
      font-size: 12px;
      font-weight: 600;
      color: #e53e3e;
    }
    .sticky-bar-btn {
      background-color: #4c9a95;
      color: #ffffff !important;
      padding: 10px 24px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 15px;
      text-decoration: none !important;
      transition: background-color 0.2s, transform 0.2s;
      white-space: nowrap;
      box-shadow: 0 4px 12px rgba(76, 154, 149, 0.4);
    }
    .sticky-bar-btn:hover {
      background-color: #3b827e;
      transform: translateY(-1px);
    }
    @media (max-width: 640px) {
      .sticky-bar-title {
        font-size: 12px;
        max-width: 170px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .sticky-bar-btn {
        padding: 9px 16px;
        font-size: 13px;
      }
    }
