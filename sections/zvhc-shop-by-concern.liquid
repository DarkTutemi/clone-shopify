{% comment %}
  ZAVELYN HAIR CARE — T01 Shop By Concern
{% endcomment %}
<section class="zvhc-editorial-section alt-bg" id="concerns">
  <div class="zvhc-container">
    <div style="text-align: center; max-width: 640px; margin: 0 auto 48px;">
      <div style="font-size: 0.78rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px;">TARGETED BOTANICAL CARE</div>
      <h2 class="zvhc-h2">Shop by Hair Concern</h2>
      <p>Whether your goal is deep follicle nourishment, moisture locking, or instant cosmetic fullness, our clean formulas provide targeted solutions.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
      <!-- Concern 1 -->
      <a href="/collections/zvhc-batana" class="zvhc-editorial-card" style="display: flex; flex-direction: column; text-decoration: none;">
        <div style="border-radius: 12px; overflow: hidden; margin-bottom: 18px; aspect-ratio: 1/1; background: var(--zvhc-t01-bg, #E9E4E6);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" alt="Dry Hair & Conditioning" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
        <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 4px;">CONCERN 01</div>
        <h3 class="zvhc-h3" style="margin-bottom: 8px;">Dry Hair &amp; Breakage</h3>
        <p style="font-size: 0.9rem; flex-grow: 1; margin-bottom: 16px;">Restore dry, brittle strands with pure unrefined Batana oil that locks in deep cellular moisture.</p>
        <span style="font-weight: 700; font-size: 0.88rem; color: var(--zvhc-t01-accent-rose, #B0476E);">Explore Collection &rarr;</span>
      </a>

      <!-- Concern 2 -->
      <a href="/collections/zvhc-curl" class="zvhc-editorial-card" style="display: flex; flex-direction: column; text-decoration: none;">
        <div style="border-radius: 12px; overflow: hidden; margin-bottom: 18px; aspect-ratio: 1/1; background: var(--zvhc-t01-bg, #E9E4E6);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811372233630-hero.jpg?v=1795264440" alt="Curl Definition" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
        <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 4px;">CONCERN 02</div>
        <h3 class="zvhc-h3" style="margin-bottom: 8px;">Curl Definition &amp; Frizz</h3>
        <p style="font-size: 0.9rem; flex-grow: 1; margin-bottom: 16px;">Enhance natural curl patterns, eliminate frizz, and provide flexible touchable hold with plant-based styling polymers.</p>
        <span style="font-weight: 700; font-size: 0.88rem; color: var(--zvhc-t01-accent-rose, #B0476E);">Explore Collection &rarr;</span>
      </a>

      <!-- Concern 3 -->
      <a href="/collections/zvhc-scalp" class="zvhc-editorial-card" style="display: flex; flex-direction: column; text-decoration: none;">
        <div style="border-radius: 12px; overflow: hidden; margin-bottom: 18px; aspect-ratio: 1/1; background: var(--zvhc-t01-bg, #E9E4E6);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807671072569-hero.jpg?v=1795264435" alt="Scalp & Edge Care" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
        <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 4px;">CONCERN 03</div>
        <h3 class="zvhc-h3" style="margin-bottom: 8px;">Scalp &amp; Edge Therapy</h3>
        <p style="font-size: 0.9rem; flex-grow: 1; margin-bottom: 16px;">Target sensitive scalps, nourish fragile edges, and comfort tension with solid Batana balm &amp; 7-in-1 multi-oil elixir.</p>
        <span style="font-weight: 700; font-size: 0.88rem; color: var(--zvhc-t01-accent-rose, #B0476E);">Explore Collection &rarr;</span>
      </a>

      <!-- Concern 4 -->
      <a href="/collections/zvhc-coverage" class="zvhc-editorial-card" style="display: flex; flex-direction: column; text-decoration: none;">
        <div style="border-radius: 12px; overflow: hidden; margin-bottom: 18px; aspect-ratio: 1/1; background: var(--zvhc-t01-bg, #E9E4E6);">
          <img src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256811885406846-hero.jpg?v=1795264423" alt="Instant Hair Coverage" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        </div>
        <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 4px;">CONCERN 04</div>
        <h3 class="zvhc-h3" style="margin-bottom: 8px;">Instant Hair Coverage</h3>
        <p style="font-size: 0.9rem; flex-grow: 1; margin-bottom: 16px;">Instantly conceal visible scalp, widen part lines, and thinning temples with natural electrostatic keratin fibers &amp; hairline compact.</p>
        <span style="font-weight: 700; font-size: 0.88rem; color: var(--zvhc-t01-accent-rose, #B0476E);">Explore Collection &rarr;</span>
      </a>
    </div>
  </div>
</section>

