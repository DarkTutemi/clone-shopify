{% comment %}
  ZAVELYN HAIR CARE — Main Header & Navigation
{% endcomment %}
<header class="zvhc-header" id="zvhcHeader">
  <div class="zvhc-container">
    <div class="zvhc-header-inner">
      <!-- Brand Logo -->
      <a href="/" class="zvhc-logo" aria-label="Zavelyn Hair Care Homepage">
        <span class="zvhc-logo-title">ZAVELYN</span>
        <span class="zvhc-logo-sub">HAIR CARE</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="zvhc-nav" aria-label="Main Navigation">
        <a href="/products/zavelyn-botanaroots-organic-batana-hair-growth-oil" class="zvhc-nav-link">Batana Hair Routine</a>
        <a href="/#concerns" class="zvhc-nav-link">Shop by Concern</a>
        <a href="/#how-it-works" class="zvhc-nav-link">4-Step Ritual</a>
        <a href="/#ingredients" class="zvhc-nav-link">Ingredients</a>
        <a href="/#reviews" class="zvhc-nav-link">Real Results</a>
        <a href="/#faq" class="zvhc-nav-link">FAQ</a>
      </nav>

      <!-- Right Actions: Bag Icon -->
      <div class="zvhc-header-actions">
        <button type="button" class="zvhc-bag-btn" onclick="if(window.openZvhcCart){window.openZvhcCart();}else if(window.openWillaCart){window.openWillaCart();}" aria-label="Shopping Bag">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="zvhc-bag-count" id="zvhcHeaderBagCount">{{ cart.item_count }}</span>
        </button>

        <button type="button" class="zvhc-mobile-menu-toggle" onclick="toggleZvhcMobileMenu()" aria-label="Toggle mobile menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  window.addEventListener('scroll', function() {
    const header = document.getElementById('zvhcHeader');
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }
  });

  function toggleZvhcMobileMenu() {
    const nav = document.querySelector('.zvhc-nav');
    if (nav) {
      if (nav.style.display === 'flex') {
        nav.style.display = 'none';
      } else {
        nav.style.display = 'flex';
        nav.style.flexDirection = 'column';
        nav.style.position = 'absolute';
        nav.style.top = '72px';
        nav.style.left = '0';
        nav.style.width = '100%';
        nav.style.background = '#FFFFFF';
        nav.style.padding = '20px';
        nav.style.boxShadow = '0 10px 25px rgba(0,0,0,0.1)';
      }
    }
  }
</script>

{% schema %}
{
  "name": "ZVHC Header",
  "settings": []
}
{% endschema %}

