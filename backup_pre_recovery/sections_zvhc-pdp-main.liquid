<script>
  window.ZVHC_PRODUCT_DATA = {{ product | json }};
  {% if product.selling_plan_groups.size > 0 %}
    window.ZVHC_SELLING_PLAN_ID = '{{ product.selling_plan_groups[0].selling_plans[0].id }}';
  {% else %}
    window.ZVHC_SELLING_PLAN_ID = '6199738553';
  {% endif %}
</script>

{% schema %}
{
  "name": "ZAVELYN PDP Main",
  "settings": [
    {
      "type": "checkbox",
      "id": "countdown_enabled",
      "label": "Enable Campaign Countdown Banner",
      "default": false
    },
    {
      "type": "text",
      "id": "campaign_badge",
      "label": "Campaign Badge",
      "default": "LIMITED BOTANICAL ALLOCATION"
    },
    {
      "type": "text",
      "id": "campaign_heading",
      "label": "Campaign Heading",
      "default": "Save up to 45% + Free US Shipping over $69.99"
    },
    {
      "type": "text",
      "id": "countdown_end",
      "label": "Countdown End (ISO / DateTime)",
      "default": "2026-12-01T23:59:59"
    }
  ],
  "presets": [
    {
      "name": "ZAVELYN PDP Main"
    }
  ]
}
{% endschema %}
