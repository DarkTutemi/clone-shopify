{% comment %}
  Clone-navage/sections/navage-how-it-works.liquid
  1:1 From Congested to Clear in 3 Simple Steps with Original Photos
{% endcomment %}

<div id="SectionId-{{ section.id }}" class="navage-steps-section">
  <div class="navage-steps-container">
    <div class="navage-steps-header">
      <h2 class="navage-steps-title">From Congested to Clear in 3 Simple Steps</h2>
      <p class="navage-steps-subtitle">
        Relief has never been easier. Follow these simple steps for effective nasal irrigation.
      </p>
    </div>

    <div class="navage-steps-grid">
      <div class="navage-step-card">
        <div class="navage-step-circle-wrap">
          <img
            src="https://navage.com/cdn/shop/files/READY-updated_1a6be14b-1f59-4d4a-8de1-524dee845e33.png?v=1731609026&width=800"
            alt="Step 1 Ready - Fill water and drop SaltPod"
            loading="lazy"
            class="navage-step-img"
          >
        </div>
        <h3 class="navage-step-heading">Ready</h3>
        <p class="navage-step-desc">
          Fill the tank with distilled or bottled water and add a pre-measured SaltPod for perfect saline solution.
        </p>
      </div>

      <div class="navage-step-card">
        <div class="navage-step-circle-wrap">
          <img
            src="https://navage.com/cdn/shop/files/Set_-_Image.png?v=1723135597&width=800"
            alt="Step 2 Set - Place nose pillows and press button"
            loading="lazy"
            class="navage-step-img"
          >
        </div>
        <h3 class="navage-step-heading">Set</h3>
        <p class="navage-step-desc">
          Place nose pillows in nostrils, press the button, and let the powered suction do the work.
        </p>
      </div>

      <div class="navage-step-card">
        <div class="navage-step-circle-wrap">
          <img
            src="https://navage.com/cdn/shop/files/Flow_-_Image.png?v=1723135601&width=800"
            alt="Step 3 Flow - Gentle suction flushes allergens"
            loading="lazy"
            class="navage-step-img"
          >
        </div>
        <h3 class="navage-step-heading">Flow</h3>
        <p class="navage-step-desc">
          Experience relief in as little as 30 seconds. Rinse, clean, and enjoy clear breathing.
        </p>
      </div>
    </div>

    <div class="navage-steps-action">
      <a href="/pages/how-does-navage-work" class="navage-steps-btn">Watch Live Demo</a>
    </div>
  </div>
</div>

<style>
  #SectionId-{{ section.id }} {
    background-color: #ffffff;
    padding: 70px 24px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  #SectionId-{{ section.id }} .navage-steps-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }
  #SectionId-{{ section.id }} .navage-steps-title {
    font-size: 38px;
    font-weight: 800;
    color: #0b4a82;
    margin: 0 0 12px 0;
    letter-spacing: -0.5px;
  }
  #SectionId-{{ section.id }} .navage-steps-subtitle {
    font-size: 15px;
    color: #14b8a6;
    font-weight: 600;
    margin: 0 0 50px 0;
  }
  #SectionId-{{ section.id }} .navage-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 36px;
    margin-bottom: 45px;
  }
  #SectionId-{{ section.id }} .navage-step-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  #SectionId-{{ section.id }} .navage-step-circle-wrap {
    width: 210px;
    height: 210px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 24px;
    box-shadow: 0 0 0 10px #e6f6fd, 0 10px 25px rgba(0, 163, 224, 0.15);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  #SectionId-{{ section.id }} .navage-step-card:hover .navage-step-circle-wrap {
    transform: translateY(-4px);
    box-shadow: 0 0 0 12px #d0f0fc, 0 14px 30px rgba(0, 163, 224, 0.25);
  }
  #SectionId-{{ section.id }} .navage-step-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #SectionId-{{ section.id }} .navage-step-heading {
    font-size: 26px;
    font-weight: 800;
    color: #14b8a6;
    margin: 0 0 12px 0;
  }
  #SectionId-{{ section.id }} .navage-step-desc {
    font-size: 15px;
    line-height: 1.55;
    color: #3b5166;
    margin: 0;
    max-width: 320px;
  }
  #SectionId-{{ section.id }} .navage-steps-action {
    display: flex;
    justify-content: center;
  }
  #SectionId-{{ section.id }} .navage-steps-btn {
    background-color: #8ca3d7;
    color: #002244;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 13px 40px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  #SectionId-{{ section.id }} .navage-steps-btn:hover {
    background-color: #7994d1;
    transform: translateY(-2px);
  }
  @media (max-width: 860px) {
    #SectionId-{{ section.id }} .navage-steps-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    #SectionId-{{ section.id }} .navage-steps-title {
      font-size: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Navage 3 Simple Steps",
  "settings": []
}
{% endschema %}
