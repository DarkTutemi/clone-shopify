    font-weight: 700;
    padding: 5px 14px;
    border-radius: 9999px;
    margin-bottom: 16px;
  }
  .zv-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16,185,129,0.25);
    display: inline-block;
  }
  .zv-track-title {
    font-size: 38px;
    font-weight: 850;
    color: #0f172a;
    letter-spacing: -0.8px;
    margin: 0 0 12px 0;
  }
  .zv-track-subtitle {
    max-width: 640px;
    margin: 0 auto 24px auto;
    font-size: 15.5px;
    color: #475569;
    line-height: 1.6;
  }
  .zv-hero-trust {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    font-size: 13px;
    font-weight: 600;
    color: #334155;
  }
  .zv-htrust-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .zv-htrust-item svg {
    color: #2563eb;
  }

  /* Form Container */
  .zv-form-container {
    margin-top: -30px;
    position: relative;
    z-index: 10;
  }
  .zv-track-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
