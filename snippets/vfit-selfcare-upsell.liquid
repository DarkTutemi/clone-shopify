            <div class="zv-gallery-slider" id="sliderFace">
              <div class="zv-gallery-slide"><img src="{{ facemask_img_1 }}" alt="Face Mask Slide 1" loading="lazy"></div>
              <div class="zv-gallery-slide"><img src="{{ facemask_img_2 }}" alt="Face Mask Slide 2" loading="lazy"></div>
              <div class="zv-gallery-slide"><img src="{{ facemask_img_3 }}" alt="Face Mask Slide 3" loading="lazy"></div>
              <div class="zv-gallery-slide"><img src="{{ facemask_img_4 }}" alt="Face Mask Slide 4" loading="lazy"></div>
            </div>
            <button type="button" class="zv-gallery-arrow zv-gallery-prev" onclick="prevVfitSlide('faceMask'); event.stopPropagation();">‹</button>
            <button type="button" class="zv-gallery-arrow zv-gallery-next" onclick="nextVfitSlide('faceMask'); event.stopPropagation();">›</button>
            <span class="zv-card-badge">✨ AT-HOME RED LIGHT FACIAL</span>
          </div>
          <div class="zv-thumbs-strip" id="thumbsFace">
