                  assign rtx = grp_reviews.settings.item_2_text
                  assign rp = grp_reviews.settings.item_2_photo
                  assign rf = grp_reviews.settings.item_2_fallback
                  assign rv = grp_reviews.settings.item_2_verified
                when 3
                  assign rn = grp_reviews.settings.item_3_name
                  assign rd = grp_reviews.settings.item_3_date
                  assign rtx = grp_reviews.settings.item_3_text
                  assign rp = grp_reviews.settings.item_3_photo
                  assign rf = grp_reviews.settings.item_3_fallback
                  assign rv = grp_reviews.settings.item_3_verified
                when 4
                  assign rn = grp_reviews.settings.item_4_name
                  assign rd = grp_reviews.settings.item_4_date
                  assign rtx = grp_reviews.settings.item_4_text
                  assign rp = grp_reviews.settings.item_4_photo
                  assign rf = grp_reviews.settings.item_4_fallback
                  assign rv = grp_reviews.settings.item_4_verified
                when 5
                  assign rn = grp_reviews.settings.item_5_name
                  assign rd = grp_reviews.settings.item_5_date
                  assign rtx = grp_reviews.settings.item_5_text
                  assign rp = grp_reviews.settings.item_5_photo
                  assign rf = grp_reviews.settings.item_5_fallback
                  assign rv = grp_reviews.settings.item_5_verified
                when 6
                  assign rn = grp_reviews.settings.item_6_name
                  assign rd = grp_reviews.settings.item_6_date
                  assign rtx = grp_reviews.settings.item_6_text
                  assign rp = grp_reviews.settings.item_6_photo
                  assign rf = grp_reviews.settings.item_6_fallback
                  assign rv = grp_reviews.settings.item_6_verified
              endcase
            -%}
            {%- if rn != blank -%}
              <article class="offer-review-item">
                <div class="offer-review-item__aside">
                  <strong>{{ rn }}</strong>
                  <span class="offer-review-item__verified">{{ rv | default: 'Verified buyer' }}</span>
                </div>
                <div class="offer-review-item__content">
                  <div class="offer-review-item__top">
                    {% render 'offer-img', image: s.review_stars_image, fallback: 'offer-star5.webp', class: 'offer-review-item__stars', alt: '5 stars', width: 100, height: 20, loading: 'lazy' %}
                    <span class="offer-review-item__date">{{ rd }}</span>
                  </div>
                  <p>{{ rtx }}</p>
                </div>
                {% render 'offer-img', image: rp, fallback: rf, class: 'offer-review-item__photo', alt: rn, width: 200, height: 267, loading: 'lazy' %}
              </article>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
          {%- if review_blocks.size > 0 -%}
            {%- for block in review_blocks -%}
              <article class="offer-review-item" {{ block.shopify_attributes }}>
                <div class="offer-review-item__aside">
                  <strong>{{ block.settings.name }}</strong>
                  <span class="offer-review-item__verified">{{ block.settings.verified_label | default: 'Verified buyer' }}</span>
                </div>
                <div class="offer-review-item__content">
                  <div class="offer-review-item__top">
                    {% render 'offer-img', image: s.review_stars_image, fallback: 'offer-star5.webp', class: 'offer-review-item__stars', alt: '5 stars', width: 100, height: 20, loading: 'lazy' %}
                    <span class="offer-review-item__date">{{ block.settings.date }}</span>
                  </div>
                  <p>{{ block.settings.text }}</p>
                </div>
                {% render 'offer-img', image: block.settings.photo, fallback: block.settings.fallback_asset, class: 'offer-review-item__photo', alt: block.settings.name, width: 200, height: 267, loading: 'lazy' %}
              </article>
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if grp_final -%}
  <section class="offer-final" {{ grp_final.shopify_attributes }}>
    <div class="offer-row">
      <div class="offer-final__banner">
        {%- assign final_banner = grp_final.settings.banner_image | default: s.final_banner_image -%}
        {% render 'offer-img', image: final_banner, fallback: 'offer-footer-img.jpg', alt: 'Customer wearing Zavelyn Foot Sleeve', width: 2000, height: 715, loading: 'lazy' %}
        <div class="offer-final__actions">
          <a class="offer-final__cta offer-final__cta--primary" href="#OfferPackages" data-offer-scroll-packages>{{ grp_final.settings.cta_primary | default: s.final_cta_primary | default: 'Buy One Get One FREE' }}</a>
          <a class="offer-final__cta offer-final__cta--ghost" href="#OfferPackages" data-offer-scroll-packages>{{ grp_final.settings.cta_secondary | default: s.final_cta_secondary | default: cta_label }}</a>
        </div>
      </div>
    </div>
  </section>
  {%- endif -%}

  <footer class="offer-foot">
    <div class="offer-foot__inner">
      <div class="offer-foot__logo">{{ brand }}</div>
      <p class="offer-foot__line">© {{ 'now' | date: '%Y' }} {{ brand }}®. {{ s.footer_rights | default: 'All Rights Reserved.' }}</p>
      <p class="offer-foot__line"><a href="{{ privacy_url }}">{{ s.footer_privacy_label | default: 'Privacy Policy' }}</a> - <a href="{{ terms_url }}">{{ s.footer_terms_label | default: 'Terms of Service' }}</a></p>
      <p class="offer-foot__line">{{ s.footer_email | default: 'support@zavelyn.com' }}</p>
    </div>
  </footer>

  <button type="button" class="offer-top" data-offer-top aria-label="Back to top" hidden>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 5v14M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div class="offer-sticky" data-offer-sticky aria-hidden="true" inert>
    <div class="offer-sticky__inner">
      <div class="offer-sticky__copy">{{ s.sticky_copy | default: 'Recovery Sale, Buy One Get One FREE!' }}</div>
      <a class="offer-sticky__cta" href="#OfferPackages" data-offer-scroll-packages tabindex="-1">
        <span class="offer-cta__label">{{ s.sticky_cta | default: cta_label }}</span>
        <span class="offer-cta__sep" aria-hidden="true">—</span>
        <span class="offer-cta__price" data-offer-cta-price>{{ cta_price_cents | money_without_trailing_zeros }}</span>
      </a>
    </div>
  </div>
</div>

<script type="application/json" id="FsBogoFreeMap">
{
{%- if bogo_free_product != blank -%}
  {%- for v in bogo_free_product.variants -%}
  {{ v.option1 | json }}: {{ v.id }}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
{%- endif -%}
}
</script>

<script>
  (function () {
    const main = document.querySelector('[data-offer-main]');
    const thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-offer-thumb]'));
    const sources = thumbs.map(function (t) { return t.dataset.src; });
    var index = 0;

    function setSlide(i) {
      if (!main || !sources.length) return;
      index = (i + sources.length) % sources.length;
      main.src = sources[index];
      thumbs.forEach(function (t, n) {
        t.classList.toggle('is-active', n === index);
      });
    }

    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        setSlide(Number(thumb.dataset.index));
      });
    });

    var prev = document.querySelector('[data-offer-prev]');
    var next = document.querySelector('[data-offer-next]');
    if (prev) prev.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index - 1); });
    if (next) next.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index + 1); });

    var fancyboxLoading = null;
    function loadFancybox(cb) {
      if (window.Fancybox) { cb(); return; }
      if (fancyboxLoading) { fancyboxLoading.then(cb); return; }
      fancyboxLoading = new Promise(function (resolve) {
        var css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css';
        document.head.appendChild(css);
        var s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js';
        s.onload = function () { resolve(); };
        s.onerror = function () { resolve(); };
        document.body.appendChild(s);
      });
      fancyboxLoading.then(cb);
    }

    var zoom = document.querySelector('[data-offer-zoom]');
    if (zoom) {
      zoom.addEventListener('click', function () {
        if (!sources.length) return;
        loadFancybox(function () {
          if (!window.Fancybox) return;
          window.Fancybox.show(
            sources.map(function (src) { return { src: src, type: 'image' }; }),
            { startIndex: index }
          );
        });
      });
    }

    var closeFr = document.querySelector('[data-frontrow-close]');
    if (closeFr) {
      closeFr.addEventListener('click', function (e) {
        e.stopPropagation();
        var fr = document.querySelector('[data-frontrow]');
        if (fr) fr.remove();
      });
    }

    var sticky = document.querySelector('[data-offer-sticky]');
    var stickyCta = sticky ? sticky.querySelector('[data-offer-scroll-packages], [data-offer-checkout]') : null;
    var hero = document.querySelector('.offer-hero');
    if (sticky && hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        var on = !entries[0].isIntersecting;
        sticky.classList.toggle('is-on', on);
        sticky.setAttribute('aria-hidden', on ? 'false' : 'true');
        if (on) sticky.removeAttribute('inert');
        else sticky.setAttribute('inert', '');
        if (stickyCta) stickyCta.tabIndex = on ? 0 : -1;
        document.documentElement.classList.toggle('offer-sticky-on', on);
      }, { threshold: 0.05 }).observe(hero);
    }

    /* Lazy-load Frontrow iframe + script near viewport */
    (function lazyFrontrow() {
      var wrap = document.querySelector('[data-offer-frontrow]');
      var frame = document.getElementById('OfferCliniciansFrame');
      if (!wrap || !frame) return;
      var src = frame.getAttribute('data-src');
      var scriptSrc = frame.getAttribute('data-script');
      function mount() {
        if (frame.getAttribute('src')) return;
        if (src) frame.setAttribute('src', src);
        if (scriptSrc && !document.querySelector('script[data-offer-frontrow-script]')) {
          var s = document.createElement('script');
          s.src = scriptSrc;
          s.defer = true;
          s.setAttribute('data-offer-frontrow-script', '1');
          document.body.appendChild(s);
        }
      }
      if (!('IntersectionObserver' in window)) { mount(); return; }
      new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return;
        mount();
      }, { rootMargin: '200px 0px' }).observe(wrap);
    })();

    var topBtn = document.querySelector('[data-offer-top]');
    if (topBtn) {
      var topThreshold = 480;
      function syncTopBtn() {
        var show = window.scrollY > topThreshold;
        topBtn.hidden = !show;
        topBtn.classList.toggle('is-on', show);
      }
      window.addEventListener('scroll', syncTopBtn, { passive: true });
      syncTopBtn();
      topBtn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    var accordion = document.querySelector('[data-offer-accordion]');
    if (accordion) {
      var items = Array.prototype.slice.call(accordion.querySelectorAll('.offer-faq__item'));
      items.forEach(function (item, i) {
        var trigger = item.querySelector('.offer-faq__trigger');
        var panel = item.querySelector('.offer-faq__panel');
        if (!trigger || !panel) return;
        var panelId = 'offer-faq-panel-' + i;
        panel.id = panelId;
        trigger.setAttribute('aria-controls', panelId);
        trigger.setAttribute('id', 'offer-faq-trigger-' + i);
        panel.setAttribute('role', 'region');
        panel.setAttribute('aria-labelledby', 'offer-faq-trigger-' + i);
        trigger.addEventListener('click', function () {
          var willOpen = !item.classList.contains('is-open');
          items.forEach(function (other) {
            var open = other === item && willOpen;
            other.classList.toggle('is-open', open);
            var btn = other.querySelector('.offer-faq__trigger');
            var otherPanel = other.querySelector('.offer-faq__panel');
            if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (otherPanel) {
              if (open) otherPanel.removeAttribute('hidden');
              else otherPanel.setAttribute('hidden', '');
            }
          });
        });
        panel.setAttribute('hidden', '');
      });
    }

    /* Frontrow iframe auto-height (official event: RESIZE_TESTIMONIALS_HEIGHT) */
    window.addEventListener('message', function (event) {
      if (!event || !event.data) return;
      var data = event.data;
      var height = null;
      if (typeof data === 'object') {
        if (data.name === 'RESIZE_TESTIMONIALS_HEIGHT' || data.type === 'RESIZE_TESTIMONIALS_HEIGHT') {
          height = data.value;
        } else {
          height = data.height || data.iframeHeight || (data.payload && data.payload.height);
          if (!height && data.name && /height|resize/i.test(String(data.name))) {
            height = data.value || data.h;
          }
          if (!height && data.type && /height|resize/i.test(String(data.type))) {
            height = data.value || data.h;
          }
        }
      }
      if (!height && typeof data === 'string') {
        try {
          var parsed = JSON.parse(data);
          height = parsed.height || parsed.iframeHeight || parsed.value;
        } catch (err) {
          var m = data.match(/height[=:](\d+)/i);
          if (m) height = Number(m[1]);
        }
      }
      height = Number(height);
      if (!height || height < 200) return;
      var frame = document.getElementById('OfferCliniciansFrame');
      if (frame) {
        frame.style.height = height + 'px';
        frame.style.minHeight = '0';
      }
    });

    var videoCards = Array.prototype.slice.call(document.querySelectorAll('[data-offer-video]'));
    var soundUnlocked = false;

    function unlockSound() {
      soundUnlocked = true;
      videoCards.forEach(function (card) {
        if (!card.classList.contains('is-playing')) return;
        var v = card.querySelector('video');
        if (!v) return;
        v.muted = false;
        v.volume = 1;
      });
    }
    document.addEventListener('pointerdown', unlockSound, { once: true, passive: true });
    document.addEventListener('keydown', unlockSound, { once: true });

    function stopVideoCard(card) {
      card.classList.remove('is-playing');
      var v = card.querySelector('video');
      if (!v) return;
      v.pause();
      try { v.currentTime = 0; } catch (e) {}
    }

    function playVideoCard(card) {
      var video = card.querySelector('video');
      if (!video) return;
      videoCards.forEach(function (other) {
        if (other !== card) stopVideoCard(other);
      });
      card.classList.add('is-playing');
      video.muted = false;
      video.volume = 1;
      var playPromise = video.play();
      if (playPromise && playPromise.catch) {
        playPromise.catch(function () {
          /* Browser blocked sound without a prior gesture — play muted, unmute after click */
          video.muted = true;
          return video.play().catch(function () {});
        });
      }
    }

    videoCards.forEach(function (card) {
      var video = card.querySelector('video');
      if (!video) return;

      card.addEventListener('mouseenter', function () {
        playVideoCard(card);
      });
      card.addEventListener('mouseleave', function () {
        stopVideoCard(card);
      });

      /* Click unlocks sound + plays with audio (also handles mobile tap) */
      card.addEventListener('click', function (e) {
        unlockSound();
        e.preventDefault();
        if (window.matchMedia('(hover: hover)').matches) {
          if (card.classList.contains('is-playing')) {
            video.muted = false;
            video.volume = 1;
            return;
          }
          playVideoCard(card);
          return;
        }
        if (card.classList.contains('is-playing')) {
          stopVideoCard(card);
        } else {
          playVideoCard(card);
        }
      });
    });

    /* Bundle selector + ATC → Shopify Checkout */
    var bundlesRoot = document.querySelector('[data-offer-bundles]');
    var qtyInput = document.getElementById('OfferQuantity');
    var variantInput = document.getElementById('OfferVariantId');
    var priceEl = document.querySelector('[data-offer-price]');
    var valueEl = document.querySelector('[data-offer-value]');
    var priceDashEl = document.querySelector('[data-offer-price-dash]');
    var buyForm = document.getElementById('OfferAddForm');
    var checkoutBtns = Array.prototype.slice.call(document.querySelectorAll('[data-offer-checkout]'));
    var checkoutBusy = false;

    function formatMoney(cents, format) {
      var amount = (Number(cents) / 100).toFixed(2);
      var withSep = amount.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      if (!format) return '$' + withSep;
      return format
        .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/g, withSep.replace('.', ',').replace(/,(?=\d{3})/g, '.'))
        .replace(/\{\{\s*amount_no_decimals\s*\}\}/g, Math.round(Number(cents) / 100).toString())
        .replace(/\{\{\s*amount\s*\}\}/g, withSep);
    }

    function formatCtaMoney(cents) {
      var n = Number(cents) / 100;
      if (!isFinite(n)) return '';
      if (Math.abs(n - Math.round(n)) < 0.001) return '$' + Math.round(n);
      return '$' + n.toFixed(2);
    }

    var ctaPriceEls = Array.prototype.slice.call(document.querySelectorAll('[data-offer-cta-price]'));

    /* Canonical package map — paid vs free vs physical total (never confuse these) */
    var PACKAGE_MAP = {
      buy1: { package: 'buy1', paidQuantity: 1, freeQuantity: 0, totalQuantity: 1, discountCode: '', title: 'Buy 1' },
      buy2get1: { package: 'buy2get1', paidQuantity: 2, freeQuantity: 1, totalQuantity: 3, discountCode: 'FS21', title: 'Buy 2 Get 1 FREE' },
      buy3get3: { package: 'buy3get3', paidQuantity: 3, freeQuantity: 3, totalQuantity: 6, discountCode: 'FS33', title: 'Buy 3 Get 3 FREE' }
    };

    var selectedSize = null;
    var selectedSizeBtn = bundlesRoot
      ? bundlesRoot.querySelector('.offer-size-pill.is-active:not([disabled])') || bundlesRoot.querySelector('.offer-size-pill:not([disabled])')
      : null;
    if (selectedSizeBtn) selectedSize = selectedSizeBtn.getAttribute('data-offer-size');

    function currentVariantId() {
      if (!bundlesRoot) return variantInput ? String(variantInput.value || '') : '';
      var active = null;
      if (selectedSize) {
        active = bundlesRoot.querySelector('.offer-size-pill.is-active[data-offer-size="' + selectedSize + '"]:not([disabled])');
      }
      if (!active) active = bundlesRoot.querySelector('.offer-size-pill.is-active:not([disabled])');
      if (!active) active = bundlesRoot.querySelector('.offer-size-pill:not([disabled])');
      var id = active ? active.getAttribute('data-variant-id') : '';
      if (id && variantInput) variantInput.value = id;
      return id || (variantInput ? String(variantInput.value || '') : '');
    }

    function syncSelectedSize(size) {
      if (!bundlesRoot || !size) return;
      selectedSize = size;
      bundlesRoot.querySelectorAll('.offer-size-pill').forEach(function (btn) {
        var match = btn.getAttribute('data-offer-size') === size;
        btn.classList.toggle('is-active', match);
      });
      currentVariantId();
    }

    function getOfferState() {
      var checked = bundlesRoot
        ? bundlesRoot.querySelector('input[name="offer_bundle"]:checked')
        : null;
      var key = checked
        ? (checked.getAttribute('data-package') || checked.value || 'buy1')
        : 'buy1';
      if (!PACKAGE_MAP[key]) key = 'buy1';
      var base = PACKAGE_MAP[key];
      var codeFromDom = checked ? (checked.getAttribute('data-discount-code') || '').trim() : '';
      var card = checked && checked.closest('.offer-bundle');
      var titleEl = card && card.querySelector('.offer-bundle__title');
      var title = titleEl ? titleEl.textContent.trim() : base.title;
      var variantId = currentVariantId();
      return {
        package: base.package,
        variantId: variantId ? Number(variantId) : 0,
        size: selectedSize || '',
        paidQuantity: base.paidQuantity,
        freeQuantity: base.freeQuantity,
        totalQuantity: base.totalQuantity,
        unitsPerPack: base.totalQuantity,
        discountCode: codeFromDom || base.discountCode || '',
        title: title,
        baseTitle: title,
        qty: base.paidQuantity,
        free: base.freeQuantity,
        cartQty: base.totalQuantity
      };
    }

    /* Back-compat alias */
    function selectedBundle() { return getOfferState(); }

    function syncOfferState() {
      if (!bundlesRoot) return;
      var unit = Number(bundlesRoot.getAttribute('data-unit-price') || 0);
      var compare = Number(bundlesRoot.getAttribute('data-compare-price') || unit);
      var format = bundlesRoot.getAttribute('data-money-format') || '${{amount}}';
      var state = getOfferState();

      /* UI price = amount customer PAYS (paidQuantity × unit), never totalQuantity */
      var paidCents = unit * state.paidQuantity;
      var valueCents = Math.max(compare, unit) * state.totalQuantity;

      if (qtyInput) qtyInput.value = String(state.totalQuantity);
      if (variantInput && state.variantId) variantInput.value = String(state.variantId);

      bundlesRoot.querySelectorAll('.offer-bundle').forEach(function (card) {
        var input = card.querySelector('input[name="offer_bundle"]');
        card.classList.toggle('is-active', !!(input && input.checked));
        var priceNode = card.querySelector('[data-bundle-price]');
        if (priceNode && input) {
          var paid = Number(input.getAttribute('data-paid') || input.getAttribute('data-qty') || 1);
          priceNode.textContent = formatMoney(unit * paid, format);
        }
      });

      if (selectedSize) syncSelectedSize(selectedSize);
      if (priceEl) priceEl.textContent = formatMoney(paidCents, format);
      if (valueEl) {
        if (valueCents > paidCents) {
          valueEl.textContent = formatMoney(valueCents, format);
          valueEl.hidden = false;
          if (priceDashEl) priceDashEl.hidden = false;
        } else {
          valueEl.textContent = '';
          valueEl.hidden = true;
          if (priceDashEl) priceDashEl.hidden = true;
        }
      }
      var ctaMoney = formatCtaMoney(paidCents);
      ctaPriceEls.forEach(function (el) { el.textContent = ctaMoney; });
    }

    function syncBundleUI() { syncOfferState(); }

    function clearDiscountCode() {
      try {
        document.cookie = 'discount_code=; Max-Age=0; Path=/';
        document.cookie = 'discount_code=; Max-Age=0; Path=/; SameSite=Lax';
      } catch (err) {}
      return fetch('/cart/update.js', {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ discount: '' })
      }).catch(function () {});
    }

    function applyDiscountCode(code) {
      if (!code) return clearDiscountCode();
      return fetch('/discount/' + encodeURIComponent(code), {
        credentials: 'same-origin',
        redirect: 'follow'
      }).catch(function () {});
    }

    if (bundlesRoot) {
      bundlesRoot.querySelectorAll('input[name="offer_bundle"]').forEach(function (input) {
        input.addEventListener('change', function () {
          /* Package is source of truth — refresh paid/free/total immediately */
          syncOfferState();
        });
      });
      bundlesRoot.querySelectorAll('[data-offer-size]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          if (btn.disabled) return;
          var card = btn.closest('.offer-bundle');
          var radio = card && card.querySelector('input[name="offer_bundle"]');
          if (radio && !radio.checked) {
            radio.checked = true;
          }
          syncSelectedSize(btn.getAttribute('data-offer-size'));
          syncOfferState();
        });
      });
    }
    syncOfferState();

    /* Size chart popup */
    var sizeChart = document.querySelector('[data-offer-sizechart]');
    var sizeChartLastFocus = null;
    function openSizeChart() {
      if (!sizeChart) return;
      sizeChartLastFocus = document.activeElement;
      sizeChart.hidden = false;
      document.documentElement.classList.add('offer-sizechart-open');
      var closeBtn = sizeChart.querySelector('[data-offer-sizechart-close].offer-sizechart__close');
      if (closeBtn) closeBtn.focus();
    }
    function closeSizeChart() {
      if (!sizeChart || sizeChart.hidden) return;
      sizeChart.hidden = true;
      document.documentElement.classList.remove('offer-sizechart-open');
      if (sizeChartLastFocus && sizeChartLastFocus.focus) sizeChartLastFocus.focus();
    }
    document.querySelectorAll('[data-offer-sizechart-open]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        openSizeChart();
      });
    });
    document.querySelectorAll('[data-offer-sizechart-close]').forEach(function (el) {
      el.addEventListener('click', function (e) {
        e.preventDefault();
        closeSizeChart();
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeSizeChart();
    });

    /* Shipping country from visitor IP (Shopify geo) */
    (function syncShipCountryFromIp() {
      var countryEl = document.querySelector('[data-offer-ship-country]');
      if (!countryEl) return;
      fetch('/browsing_context_suggestions.json', {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      })
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (data) {
          var detected = data && data.detected_values && data.detected_values.country;
          var name = detected && (detected.name || detected.handle);
          if (name) countryEl.textContent = name;
        })
        .catch(function () {});
    })();

    var BOGO_FREE_BY_SIZE = {};
    try {
      var freeMapEl = document.getElementById('FsBogoFreeMap');
      BOGO_FREE_BY_SIZE = freeMapEl ? JSON.parse(freeMapEl.textContent) : {};
    } catch (err) {
      BOGO_FREE_BY_SIZE = {};
    }

    function newBundleId() {
      return 'fs_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);
    }

    function buildBundleItems(state) {
      var bundleId = newBundleId();
      var youGet = state.totalQuantity + (state.totalQuantity === 1 ? ' sleeve' : ' sleeves');
      var summary = youGet;
      if (state.freeQuantity > 0) {
        summary = youGet + ' · pay for ' + state.paidQuantity + ' · ' + state.freeQuantity + ' free';
      }
      var shared = {
        _bundle: 'bogo',
        _bundle_id: bundleId,
        _package: state.package,
        _paid: String(state.paidQuantity),
        _free: String(state.freeQuantity),
        _cart_qty: String(state.totalQuantity),
        _units_per_pack: String(state.unitsPerPack),
        Offer: state.title,
        'You get': summary
      };
      if (state.size) shared.Size = state.size;

      var items = [];
      /* Paid line — customer is charged for these units */
      items.push({
        id: state.variantId,
        quantity: state.paidQuantity,
        properties: Object.assign({}, shared, {
          _role: 'paid',
          'Line type': state.freeQuantity > 0 ? 'Paid sleeves' : 'Package'
        })
      });

      /*
        Free line — $0 complimentary variant (same size).
        Keeps physical sleeve count correct without cart-wide BXGY
        fighting when multiple different packages share one cart.
      */
      if (state.freeQuantity > 0) {
        var freeId = state.size ? BOGO_FREE_BY_SIZE[state.size] : null;
        if (freeId) {
          items.push({
            id: Number(freeId),
            quantity: state.freeQuantity,
            properties: Object.assign({}, shared, {
              _role: 'free',
              'Line type': 'Free sleeves (included)',
              'You get': state.freeQuantity + (state.freeQuantity === 1 ? ' free sleeve' : ' free sleeves')
            })
          });
        } else {
          /* Fallback: paid variant + rely on FS21/FS33 (single-package carts) */
          items[0].quantity = state.totalQuantity;
          items[0].properties._role = 'combined';
          items[0].properties._discount_code = state.discountCode || '';
          items[0].properties['Line type'] = 'Package';
        }
      }
      return { items: items, bundleId: bundleId, summary: summary, usedFreeProduct: !!(state.freeQuantity > 0 && state.size && BOGO_FREE_BY_SIZE[state.size]) };
    }

    function goToCheckout(trigger) {
      if (checkoutBusy) return;

      /* Live package + size only — never stale qty from a previous selection */
      syncOfferState();
      var state = getOfferState();
      if (!state.variantId || !state.paidQuantity) {
        window.location.href = '#OfferPackages';
        return;
      }

      checkoutBusy = true;
      checkoutBtns.forEach(function (btn) { btn.classList.add('is-loading'); });
      if (trigger && trigger.classList) trigger.classList.add('is-loading');

      /*
        APPEND mode: each ATC is an independent package/bundle.
        Do NOT clear the cart. Do NOT replace prior packages.
        Same package + same size may merge; different packages stay separate.
      */
      /*
        Always APPEND a new independent bundle (_bundle_id).
        Never clear cart. Never replace prior packages.
      */
      var built = buildBundleItems(state);
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          Accept: 'application/json',
          'Content-Type': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify({ items: built.items })
      })
        .then(function (res) {
          if (!res.ok) throw new Error('add_failed');
          return res.json();
        })
        .then(function () {
          /* BXGY codes are cart-wide and break mixed packages — prefer $0 free units */
          if (!built.usedFreeProduct && state.discountCode) {
            return applyDiscountCode(state.discountCode);
          }
          return clearDiscountCode();
        })
        .then(function () {
          return fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) {
            return r.ok ? r.json() : null;
          });
        })
        .then(function (cart) {
          checkoutBusy = false;
          checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
          if (trigger && trigger.classList) trigger.classList.remove('is-loading');
          if (cart) {
            document.dispatchEvent(new CustomEvent('zavelyn:offer-cart:open', { detail: { cart: cart } }));
            return;
          }
          window.location.href = '/checkout';
        })
        .catch(function () {
          checkoutBusy = false;
          checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
          if (trigger && trigger.classList) trigger.classList.remove('is-loading');
          syncOfferState();
          if (buyForm) buyForm.submit();
        });
    }

    if (buyForm) {
      buyForm.addEventListener('submit', function (e) {
        e.preventDefault();
        goToCheckout(e.submitter || buyForm.querySelector('[data-offer-checkout]'));
      });
    }

    checkoutBtns.forEach(function (btn) {
      if (btn.closest('#OfferAddForm')) return;
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        goToCheckout(btn);
      });
    });

    function scrollToPackages(e) {
      if (e) e.preventDefault();
      var target = document.getElementById('OfferPackages');
      if (!target) return;
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (history && history.replaceState) {
        history.replaceState(null, '', '#OfferPackages');
      }
    }
    document.querySelectorAll('[data-offer-scroll-packages]').forEach(function (link) {
      link.addEventListener('click', scrollToPackages);
    });

    /* Session reserve timer */
    var timerEl = document.querySelector('[data-offer-timer]');
    if (timerEl) {
      var TIMER_KEY = 'zavelyn_offer_reserve_until';
      var DURATION = 10 * 60 * 1000;
      var until = Number(sessionStorage.getItem(TIMER_KEY) || 0);
      var now = Date.now();
      if (!until || until < now) {
        until = now + DURATION;
        sessionStorage.setItem(TIMER_KEY, String(until));
      }
      function tickTimer() {
        var left = Math.max(0, until - Date.now());
        var mins = Math.floor(left / 60000);
        var secs = Math.floor((left % 60000) / 1000);
        timerEl.textContent = mins + ':' + (secs < 10 ? '0' : '') + secs;
        if (left <= 0) {
          until = Date.now() + DURATION;
          sessionStorage.setItem(TIMER_KEY, String(until));
        }
      }
      tickTimer();
      setInterval(tickTimer, 1000);
    }

    /* Scroll reveal */
    (function initOfferReveal() {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var root = document.getElementById('OfferTop') || document;
      var targets = Array.prototype.slice.call(root.querySelectorAll([
        '.offer-card',
        '.offer-day',
        '.offer-mat',
        '.offer-vreview',
        '.offer-review-item',
        '.offer-specialist',
        '.offer-compare',
        '.offer-press',
        '.offer-quote',
        '.offer-final__banner',
        '.offer-timeline-hero',
        '.offer-tech-hero',
        '.offer-head',
        '.offer-ratings',
        '.offer-clinicians-widget'
      ].join(',')));

      if (!targets.length) return;

      targets.forEach(function (el, i) {
        if (el.classList.contains('offer-reveal')) return;
        el.classList.add('offer-reveal');
        if (el.classList.contains('offer-card--rev') || el.classList.contains('offer-compare__media')) {
          el.classList.add('offer-reveal--right');
        } else if (el.classList.contains('offer-card') || el.classList.contains('offer-specialist__media')) {
          el.classList.add('offer-reveal--left');
        } else if (el.classList.contains('offer-final__banner') || el.classList.contains('offer-timeline-hero')) {
          el.classList.add('offer-reveal--scale');
        }
        el.style.transitionDelay = (Math.min(i % 4, 3) * 70) + 'ms';
      });

      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }

      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-in');
          io.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });

      targets.forEach(function (el) {
        var rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight * 0.92) {
          el.classList.add('is-in');
        } else {
          io.observe(el);
        }
      });
    })();
  })();
</script>

