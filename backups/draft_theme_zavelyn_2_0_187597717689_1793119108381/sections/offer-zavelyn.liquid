      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" width="24" height="24" aria-hidden="true"><path d="M128,24A104,104,0,1,0,232,128,104.12,104.12,0,0,0,128,24Zm36.44,132.88a8,8,0,0,1,0,11.31,8.17,8.17,0,0,1-11.31,0L128,143.31l-25.13,24.88a8.17,8.17,0,0,1-11.31,0,8,8,0,0,1,0-11.31L116.69,132,91.56,107.13a8,8,0,0,1,11.31-11.32L128,120.69l25.13-24.88a8,8,0,0,1,11.31,11.32L139.31,132Z" fill="currentColor"/></svg>
    {%- endcapture -%}
    <div class="rg-compare">
      <div class="rg-compare__intro">
        <h2 class="rg-compare__title">{{ sec_compare.settings.heading | default: 'What Makes Zavelyn' }}<span>{{ sec_compare.settings.accent | default: 'the Better Choice' }}</span></h2>
      </div>
      <div class="rg-compare__table-wrap">
        <table class="rg-compare__table">
          <thead>
            <tr>
              <th class="rg-compare__feature-h" scope="col"></th>
              <th class="rg-compare__col rg-compare__col--hi" scope="col"><span>{{ sec_compare.settings.col_us | default: 'Zavelyn' }}</span></th>
              <th class="rg-compare__col" scope="col"><span>{{ sec_compare.settings.col_them | default: 'Others' }}</span></th>
            </tr>
          </thead>
          <tbody>
            {%- for i in (1..6) -%}
              {%- capture lk -%}row_{{ i }}_label{%- endcapture -%}
              {%- capture uk -%}row_{{ i }}_us{%- endcapture -%}
              {%- capture tk -%}row_{{ i }}_them{%- endcapture -%}
              {%- assign row_label = sec_compare.settings[lk] -%}
              {%- if row_label != blank -%}
                <tr>
                  <th scope="row">{{ row_label }}</th>
                  <td class="rg-compare__col rg-compare__col--hi">
                    {%- if sec_compare.settings[uk] -%}
                      <span class="rg-compare__yes" aria-label="Yes">{{ rg_icon_yes }}</span>
                    {%- else -%}
                      <span class="rg-compare__no" aria-label="No">{{ rg_icon_no }}</span>
                    {%- endif -%}
                  </td>
                  <td class="rg-compare__col">
                    {%- if sec_compare.settings[tk] -%}
                      <span class="rg-compare__yes" aria-label="Yes">{{ rg_icon_yes }}</span>
                    {%- else -%}
                      <span class="rg-compare__no" aria-label="No">{{ rg_icon_no }}</span>
                    {%- endif -%}
                  </td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="offer-sec offer-sec--timeline" {% if sec_timeline %}{{ sec_timeline.shopify_attributes }}{% endif %}>
    <div class="rg-timeline">
      <div class="rg-timeline__content">
        <header class="rg-timeline__header">
          <h2 class="rg-timeline__title">{{ sec_timeline.settings.heading | default: 'Your 60-Day Hand' }} <span>{{ sec_timeline.settings.accent | default: 'Recovery Timeline' }}</span></h2>
        </header>
        <ol class="rg-timeline__list">
          {%- for i in (1..4) -%}
            {%- capture dk -%}phase_{{ i }}_days{%- endcapture -%}
            {%- capture hk -%}phase_{{ i }}_title{%- endcapture -%}
            {%- capture bk -%}phase_{{ i }}_items{%- endcapture -%}
            {%- assign phase_days = sec_timeline.settings[dk] -%}
            {%- assign phase_title = sec_timeline.settings[hk] -%}
            {%- assign phase_items = sec_timeline.settings[bk] -%}
            {%- if phase_title != blank -%}
              <li class="rg-phase">
                <span class="rg-phase__dot" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2Z" fill="currentColor"/></svg>
                </span>
                <span class="rg-phase__days">{{ phase_days }}</span>
                <h3>{{ phase_title }}</h3>
                <ul>
                  {%- assign phase_lines = phase_items | newline_to_br | split: '<br />' -%}
                  {%- for line in phase_lines -%}
                    {%- assign line_text = line | strip -%}
                    {%- if line_text != blank -%}<li>{{ line_text }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
      <div class="rg-timeline__media">
        {%- assign timeline_fb = sec_timeline.settings.fallback | default: 'zavelyn-timeline.png' -%}
        {%- assign timeline_alt = sec_timeline.settings.image_alt | default: 'Customer smiling during hand recovery journey' -%}
        {% render 'zavelyn-media', image: sec_timeline.settings.image, fallback: timeline_fb, video: sec_timeline.settings.video, video_url: sec_timeline.settings.video_url, source: sec_timeline.settings.video_source, alt: timeline_alt, width: 870, height: 870, loading: 'lazy' %}
      </div>
    </div>
  </section>

  <section class="offer-sec offer-sec--reviews" id="REVIEW" {% if sec_reviews %}{{ sec_reviews.shopify_attributes }}{% endif %}>
    <div class="offer-head rg-reviews__head">
      <h2>{{ sec_reviews.settings.heading | default: 'Customer Reviews' }}</h2>
      <p>{{ sec_reviews.settings.subtext | default: 'Overall rating: 4.8 / 5 from 351 reviews.' }}</p>
    </div>
    <div class="rg-reviews-track" data-rg-reviews-track>
      {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
      {%- if review_blocks.size > 0 -%}
        {%- for block in review_blocks -%}
          {%- for slot in (1..2) -%}
            {%- liquid
              if slot == 1
                assign sfx = ''
              else
                assign sfx = '_2'
              endif
              assign k_name = 'name' | append: sfx
              assign k_text = 'text' | append: sfx
              assign k_item = 'item' | append: sfx
              assign k_stars = 'stars' | append: sfx
              assign k_verified = 'verified' | append: sfx
              assign k_image = 'image' | append: sfx
              assign k_image_url = 'image_url' | append: sfx
              assign k_video = 'video' | append: sfx
              assign k_video_url = 'video_url' | append: sfx
              assign k_video_source = 'video_source' | append: sfx
              assign review_name = block.settings[k_name]
              assign review_text = block.settings[k_text]
              assign review_item = block.settings[k_item]
              assign review_image = block.settings[k_image]
              assign review_image_url = block.settings[k_image_url]
              assign review_video = block.settings[k_video]
              assign review_video_url = block.settings[k_video_url]
              assign review_source = block.settings[k_video_source]
              assign star_count = block.settings[k_stars] | default: 5
            -%}
            {%- if review_name != blank or review_text != blank or review_image != blank or review_image_url != blank or review_video != blank or review_video_url != blank -%}
              {%- liquid
                assign photo = review_image_url
                if review_image != blank
                  if review_image.src contains '.gif'
                    assign photo = review_image.src
                  else
                    assign photo = review_image | image_url: width: 720
                  endif
                endif
                if review_name == blank
                  assign review_name = 'Customer'
                endif
              -%}
              {%- capture clip -%}{%- render 'zavelyn-video-src', video: review_video, video_url: review_video_url, source: review_source -%}{%- endcapture -%}
              {%- assign clip = clip | strip -%}
              <article class="rg-review-card" {% if slot == 1 %}{{ block.shopify_attributes }}{% endif %}>
                <button type="button" class="rg-review-card__media" data-rg-review-open data-title="{{ review_name | escape }}" {% if photo != blank %}data-image="{{ photo | escape }}"{% endif %} {% if clip != blank %}data-video="{{ clip | escape }}"{% endif %} aria-label="{% if clip != blank %}Play video review by {{ review_name | escape }}{% else %}View review photo by {{ review_name | escape }}{% endif %}">
                  {%- if photo != blank -%}
                    <img src="{{ photo | escape }}" alt="Review by {{ review_name | escape }}" width="720" height="1280" loading="lazy">
                  {%- endif -%}
                  {%- if clip != blank -%}
                    <span class="rg-review-card__play" aria-hidden="true"><svg viewBox="0 0 64 64" width="56" height="56" focusable="false"><circle cx="32" cy="32" r="30" fill="rgba(255,255,255,.92)"/><path d="M26 20v24l20-12z" fill="#111"/></svg></span>
                  {%- endif -%}
                </button>
                <div class="rg-review-card__body">
                  <div class="rg-review-card__who">
                    <strong>{{ review_name }}</strong>
                    {%- if block.settings[k_verified] -%}
                      <span class="rg-review-card__verified"><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg> Verified</span>
                    {%- endif -%}
                  </div>
                  <div class="rg-review-card__stars" aria-label="{{ star_count }} out of 5">{% for s in (1..star_count) %}★{% endfor %}</div>
                  {%- if review_text != blank -%}<p>{{ review_text | newline_to_br }}</p>{%- endif -%}
                  {%- if review_item != blank -%}
                    <p class="rg-review-card__item"><span>Item type:</span> {{ review_item }}</p>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {% render 'zavelyn-loox-reviews' %}
      {%- endif -%}
    </div>
  </section>

  <section class="offer-sec offer-sec--faq" id="faq" {% if sec_faq %}{{ sec_faq.shopify_attributes }}{% endif %}>
    <div class="offer-head rg-faq__head"><h2>{{ sec_faq.settings.heading | default: 'Frequently Asked Questions' }}</h2></div>
    <div class="rg-faq" data-offer-accordion>
      {%- if sec_faq and sec_faq.settings.q_1 != blank -%}
        <div class="rg-faq__col offer-faq">
          {%- for i in (1..6) -%}
            {%- capture qk -%}q_{{ i }}{%- endcapture -%}
            {%- capture ak -%}a_{{ i }}{%- endcapture -%}
            {%- assign qv = sec_faq.settings[qk] -%}
            {%- assign av = sec_faq.settings[ak] -%}
            {%- if qv != blank -%}
              <div class="offer-faq__item">
                <button type="button" class="offer-faq__trigger" aria-expanded="false">{{ qv }}</button>
                <div class="offer-faq__panel" hidden><div class="offer-faq__body">{{ av }}</div></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="rg-faq__col offer-faq">
          {%- for i in (7..12) -%}
            {%- capture qk -%}q_{{ i }}{%- endcapture -%}
            {%- capture ak -%}a_{{ i }}{%- endcapture -%}
            {%- assign qv = sec_faq.settings[qk] -%}
            {%- assign av = sec_faq.settings[ak] -%}
            {%- if qv != blank -%}
              <div class="offer-faq__item">
                <button type="button" class="offer-faq__trigger" aria-expanded="false">{{ qv }}</button>
                <div class="offer-faq__panel" hidden><div class="offer-faq__body">{{ av }}</div></div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  <footer class="offer-foot">
    <div class="offer-foot__inner">
      <div class="offer-foot__logo">{{ brand }}</div>
      <p class="offer-foot__line">© {{ 'now' | date: '%Y' }} {{ brand }}®. All Rights Reserved.</p>
      <p class="offer-foot__line"><a href="/pages/privacy-policy">Privacy Policy</a> - <a href="/pages/terms-of-service">Terms of Service</a></p>
      <p class="offer-foot__line">{% if sec_footer and sec_footer.settings.email != blank %}{{ sec_footer.settings.email }}{% else %}support@zavelyn.com{% endif %}</p>
    </div>
  </footer>

  <button type="button" class="offer-top" data-offer-top aria-label="Back to top" hidden>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="offer-sticky" data-offer-sticky aria-hidden="true" inert>
    <div class="offer-sticky__inner">
      <div class="offer-sticky__copy">{{ sticky_copy }}</div>
      <a class="offer-sticky__cta" href="#OfferTop" data-offer-checkout data-rg-cta tabindex="-1">
        <span class="offer-cta__label">{{ cta_label }}</span>
        <span class="offer-cta__sep" aria-hidden="true">—</span>
        <span class="offer-cta__price" data-rg-cta-price>{{ pack1_variant.price | money_without_trailing_zeros }}</span>
      </a>
    </div>
  </div>
</div>

<div class="rg-modal" id="RgSizeModal" hidden data-rg-size-modal>
  <div class="rg-modal__dialog" role="dialog" aria-modal="true" aria-label="Size chart">
    <button type="button" class="rg-modal__close" data-rg-modal-close aria-label="Close">×</button>
    {%- assign chart_fb = hs.size_chart_fallback | default: 'zavelyn-size-chart.png' -%}
    {% render 'offer-img', image: hs.size_chart_image, fallback: chart_fb, alt: 'Zavelyn size chart', width: 1200, height: 1200, loading: 'lazy' %}
  </div>
</div>

<div class="rg-modal" id="RgWatchModal" hidden data-rg-watch-modal>
  <div class="rg-modal__dialog" role="dialog" aria-modal="true" aria-label="How to use Zavelyn">
    <button type="button" class="rg-modal__close" data-rg-modal-close aria-label="Close">×</button>
    {%- capture watch_src -%}{%- render 'zavelyn-video-src', video: hs.watch_file, video_url: hs.watch_video, source: hs.watch_source -%}{%- endcapture -%}
    {%- assign watch_src = watch_src | strip -%}
    {%- if watch_src == blank -%}
      {%- assign watch_src = 'https://cdn.shopify.com/videos/c/o/v/f95bbb1ef6fe45e5be0776964abbbe10.mp4' -%}
    {%- endif -%}
    {%- if watch_src contains '.mp4' or watch_src contains '.webm' or watch_src contains '.mov' or watch_src contains '.m4v' -%}
      <video controls playsinline preload="none" data-rg-watch-video src="{{ watch_src | escape }}"></video>
    {%- else -%}
      <iframe data-rg-watch-frame src="{{ watch_src | escape }}" title="How to use Zavelyn" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
    {%- endif -%}
  </div>
</div>

<div class="rg-modal" id="RgReviewModal" hidden data-rg-review-modal>
  <div class="rg-modal__dialog rg-modal__dialog--review" role="dialog" aria-modal="true" aria-label="Customer review">
    <button type="button" class="rg-modal__close" data-rg-modal-close aria-label="Close">×</button>
    <div class="rg-review-stage" data-rg-review-stage></div>
  </div>
</div>

<script>
(function () {
  var main = document.querySelector('[data-offer-main]');
  var stageVideo = document.querySelector('[data-offer-main-video]');
  var stageFrame = document.querySelector('[data-offer-main-frame]');
  var thumbs = Array.prototype.slice.call(document.querySelectorAll('[data-offer-thumb]'));
  var sources = thumbs.map(function (t) { return t.dataset.src; });
  var index = 0;
  function isFileVideo(url) {
    return /\.(mp4|webm|mov|m4v)(\?|#|$)/i.test(url || '');
  }
  function hideStageMedia() {
    if (stageVideo) {
      stageVideo.pause();
      stageVideo.hidden = true;
      stageVideo.removeAttribute('src');
    }
    if (stageFrame) {
      stageFrame.hidden = true;
      stageFrame.removeAttribute('src');
    }
  }
  function setSlide(i) {
    if (!main || !sources.length) return;
    index = (i + sources.length) % sources.length;
    var clip = thumbs[index].dataset.video || '';
    if (clip && isFileVideo(clip) && stageVideo) {
      if (stageFrame) {
        stageFrame.hidden = true;
        stageFrame.removeAttribute('src');
      }
      main.hidden = true;
      stageVideo.hidden = false;
      if (stageVideo.getAttribute('src') !== clip) stageVideo.src = clip;
    } else if (clip && stageFrame) {
      if (stageVideo) {
        stageVideo.pause();
        stageVideo.hidden = true;
        stageVideo.removeAttribute('src');
      }
      main.hidden = true;
      stageFrame.hidden = false;
      if (stageFrame.getAttribute('src') !== clip) stageFrame.src = clip;
    } else {
      hideStageMedia();
      main.hidden = false;
      main.src = sources[index];
    }
    thumbs.forEach(function (t, n) { t.classList.toggle('is-active', n === index); });
  }
  thumbs.forEach(function (thumb) {
    thumb.addEventListener('click', function () { setSlide(Number(thumb.dataset.index)); });
  });
  var prev = document.querySelector('[data-offer-prev]');
  var next = document.querySelector('[data-offer-next]');
  if (prev) prev.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index - 1); });
  if (next) next.addEventListener('click', function (e) { e.stopPropagation(); setSlide(index + 1); });

  var fancyboxLoading = null;
  function loadFancybox(cb) {
    if (window.Fancybox) { cb(); return; }
    if (fancyboxLoading) { fancyboxLoading.then(cb); return; }
    fancyboxLoading = new Promise(function (resolve) {
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css';
      document.head.appendChild(css);
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js';
      s.onload = function () { resolve(); };
      s.onerror = function () { resolve(); };
      document.body.appendChild(s);
    });
    fancyboxLoading.then(cb);
  }
  var zoom = document.querySelector('[data-offer-zoom]');
  if (zoom) {
    zoom.addEventListener('click', function () {
      if (!sources.length) return;
      loadFancybox(function () {
        if (!window.Fancybox) return;
        window.Fancybox.show(thumbs.map(function (thumb) {
          if (thumb.dataset.video && isFileVideo(thumb.dataset.video)) {
            return { src: thumb.dataset.video, type: 'html5video' };
          }
          if (thumb.dataset.video) {
            return { src: thumb.dataset.video, type: 'iframe' };
          }
          return { src: thumb.dataset.src, type: 'image' };
        }), { startIndex: index });
      });
    });
  }

  document.querySelectorAll('[data-offer-accordion]').forEach(function (accordion, aIdx) {
    var items = Array.prototype.slice.call(accordion.querySelectorAll('.offer-faq__item'));
    items.forEach(function (item, i) {
      var trigger = item.querySelector('.offer-faq__trigger');
      var panel = item.querySelector('.offer-faq__panel');
      if (!trigger || !panel) return;
      var panelId = 'rg-faq-' + aIdx + '-' + i;
      panel.id = panelId;
      trigger.setAttribute('aria-controls', panelId);
      panel.setAttribute('role', 'region');
      trigger.setAttribute('aria-expanded', 'false');
      panel.setAttribute('hidden', '');
      trigger.addEventListener('click', function () {
        var willOpen = !item.classList.contains('is-open');
        items.forEach(function (other) {
          var open = other === item && willOpen;
          other.classList.toggle('is-open', open);
          var btn = other.querySelector('.offer-faq__trigger');
          var p = other.querySelector('.offer-faq__panel');
          if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          if (p) { if (open) p.removeAttribute('hidden'); else p.setAttribute('hidden', ''); }
        });
      });
    });
  });

  /* Journey + howto carousels */
  function bindRgCarousel(trackSel, prevSel, nextSel, cardSel, gap) {
    var track = document.querySelector(trackSel);
    if (!track) return;
    var prev = document.querySelector(prevSel);
    var next = document.querySelector(nextSel);
    function step() {
      var card = track.querySelector(cardSel);
      return card ? card.getBoundingClientRect().width + gap : 240;
    }
    if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
  }
  bindRgCarousel('[data-rg-journey-track]', '[data-rg-journey-prev]', '[data-rg-journey-next]', '.rg-journey-card', 16);
  bindRgCarousel('[data-rg-howto-track]', '[data-rg-howto-prev]', '[data-rg-howto-next]', '.rg-step', 10);

  /* Size / watch modals */
  function openModal(el) {
    if (!el) return;
    el.hidden = false;
    document.documentElement.style.overflow = 'hidden';
  }
  function closeModal(el) {
    if (!el) return;
    el.hidden = true;
    document.documentElement.style.overflow = '';
    var vid = el.querySelector('video');
    if (vid) { vid.pause(); }
    var frame = el.querySelector('iframe');
    if (frame) {
      var frameSrc = frame.getAttribute('src');
      frame.removeAttribute('src');
      if (frameSrc) frame.setAttribute('src', frameSrc);
    }
    var stage = el.querySelector('[data-rg-review-stage]');
    if (stage) stage.replaceChildren();
  }
  var sizeModal = document.querySelector('[data-rg-size-modal]');
  var watchModal = document.querySelector('[data-rg-watch-modal]');
  document.querySelectorAll('[data-rg-size-open]').forEach(function (btn) {
    btn.addEventListener('click', function () { openModal(sizeModal); });
  });
  document.querySelectorAll('[data-rg-watch-open]').forEach(function (btn) {
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      openModal(watchModal);
      var vid = watchModal && watchModal.querySelector('video');
      if (vid) { try { vid.play(); } catch (e2) {} }
    });
  });
  document.querySelectorAll('[data-rg-modal-close]').forEach(function (btn) {
    btn.addEventListener('click', function () { closeModal(btn.closest('.rg-modal')); });
  });
  var reviewModal = document.querySelector('[data-rg-review-modal]');
  document.querySelectorAll('[data-rg-review-open]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!reviewModal) return;
      var stage = reviewModal.querySelector('[data-rg-review-stage]');
      if (!stage) return;
      var video = btn.getAttribute('data-video');
      var image = btn.getAttribute('data-image');
      var title = btn.getAttribute('data-title') || 'Review';
      stage.replaceChildren();
      if (video) {
        var fileVideo = /\.(mp4|webm|mov|m4v)(\?|$)/i.test(video);
        if (fileVideo) {
          var vid = document.createElement('video');
          vid.src = video;
          vid.controls = true;
          vid.autoplay = true;
          vid.playsInline = true;
          vid.setAttribute('playsinline', '');
          stage.appendChild(vid);
        } else {
          var frame = document.createElement('iframe');
          var join = video.indexOf('?') === -1 ? '?' : '&';
          frame.src = video + join + 'autoplay=true&preload=auto';
          frame.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
          frame.allowFullscreen = true;
          frame.title = title;
          stage.appendChild(frame);
        }
      } else if (image) {
        var img = document.createElement('img');
        img.src = image;
        img.alt = title;
        stage.appendChild(img);
      }
      openModal(reviewModal);
    });
  });
  [sizeModal, watchModal, reviewModal].forEach(function (modal) {
    if (!modal) return;
    modal.addEventListener('click', function (e) {
      if (e.target === modal) closeModal(modal);
    });
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { closeModal(sizeModal); closeModal(watchModal); closeModal(reviewModal); }
  });


  /* Countdown 10-min loop like source caregiver offer */
  (function () {
    var root = document.querySelector('[data-rg-countdown]');
    if (!root) return;
    var label = root.querySelector('[data-rg-countdown-label]');
    var minutes = Number(root.getAttribute('data-minutes') || 10);
    var end = Date.now() + minutes * 60 * 1000;
    function tick() {
      var left = Math.max(0, end - Date.now());
      if (left <= 0) { end = Date.now() + minutes * 60 * 1000; left = end - Date.now(); }
      var total = Math.floor(left / 1000);
      var m = Math.floor(total / 60);
      var s = total % 60;
      if (label) label.textContent = String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }
    tick();
    setInterval(tick, 1000);
  })();

  /* Variant + packs */
  var variantInput = document.getElementById('OfferVariantId');
  var qtyInput = document.getElementById('OfferQuantity');
  var buyForm = document.getElementById('OfferAddForm');
  var packsRoot = document.querySelector('[data-rg-packs]');
  var ctaPriceEls = Array.prototype.slice.call(document.querySelectorAll('[data-rg-cta-price]'));
  var variants = [];
  try {
    var mapEl = document.getElementById('RgVariantMap');
    if (mapEl) variants = JSON.parse(mapEl.textContent || '[]');
  } catch (e) { variants = []; }
  var activePack = 1;

  function findVariant(side, size) {
    if (!variants.length) return null;
    var match = variants.find(function (v) {
      var opts = [v.option1, v.option2, v.option3].filter(Boolean);
      var sideOk = !side || opts.indexOf(side) !== -1;
      var sizeOk = !size || opts.indexOf(size) !== -1;
      return sideOk && sizeOk;
    });
    return match || variants[0];
  }

  function packPriceLabel() {
    var sel = activePack === 2 ? '[data-rg-pack2-price]' : '[data-rg-pack1-price]';
    var node = document.querySelector(sel);
    return node ? node.textContent.trim() : '';
  }

  function gloveVariant(sideAttr, sizeAttr) {
    var sideEl = document.querySelector(sideAttr);
    var sizeEl = document.querySelector(sizeAttr);
    return findVariant(sideEl ? sideEl.value : null, sizeEl ? sizeEl.value : null);
  }

  function syncFromOptions() {
    var v = activePack === 2 ? gloveVariant('[data-rg-side-a]', '[data-rg-size-a]') : gloveVariant('[data-rg-side]', '[data-rg-size]');
    if (!v) return;
    if (variantInput) variantInput.value = String(v.id);
    if (qtyInput) qtyInput.value = activePack === 2 ? '2' : '1';
    var price = packPriceLabel();
    if (price) ctaPriceEls.forEach(function (el) { el.textContent = price; });
  }

  if (packsRoot) {
    packsRoot.querySelectorAll('[data-rg-pack]').forEach(function (card) {
      card.addEventListener('click', function (e) {
        if (e.target && (e.target.tagName === 'SELECT' || e.target.closest('select'))) return;
        activePack = Number(card.getAttribute('data-rg-pack') || '1');
        packsRoot.querySelectorAll('[data-rg-pack]').forEach(function (c) {
          c.classList.toggle('is-active', c === card);
        });
        syncFromOptions();
      });
    });
  }
  document.querySelectorAll('[data-rg-side], [data-rg-size], [data-rg-side-a], [data-rg-size-a], [data-rg-side-b], [data-rg-size-b]').forEach(function (el) {
    el.addEventListener('change', syncFromOptions);
  });
  syncFromOptions();

  var checkoutBtns = Array.prototype.slice.call(document.querySelectorAll('[data-offer-checkout]'));
  var checkoutBusy = false;
  function goToCheckout(trigger) {
    var first = activePack === 2 ? gloveVariant('[data-rg-side-a]', '[data-rg-size-a]') : gloveVariant('[data-rg-side]', '[data-rg-size]');
    var second = activePack === 2 ? gloveVariant('[data-rg-side-b]', '[data-rg-size-b]') : null;
    if (checkoutBusy || !first) return;
    var bundleId = 'rg_' + Date.now().toString(36);
    var packLabel = activePack === 2 ? 'Buy 2 · Extra 15%' : 'Buy 1 · ONE HAND';
    var props = {
      _bundle: 'zavelyn-pack',
      _bundle_id: bundleId,
      _pack: String(activePack),
      Offer: packLabel
    };
    var items;
    if (activePack === 2 && second) {
      if (String(first.id) === String(second.id)) {
        items = [{ id: first.id, quantity: 2, properties: props }];
      } else {
        items = [
          { id: first.id, quantity: 1, properties: props },
          { id: second.id, quantity: 1, properties: props }
        ];
      }
    } else {
      items = [{ id: first.id, quantity: 1, properties: props }];
    }
    var discountCode = activePack === 2 && packsRoot ? (packsRoot.getAttribute('data-discount-code') || '') : '';
    checkoutBusy = true;
    checkoutBtns.forEach(function (btn) { btn.classList.add('is-loading'); });
    if (trigger && trigger.classList) trigger.classList.add('is-loading');
    if (variantInput) variantInput.value = String(first.id);
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ items: items })
    })
      .then(function (res) { if (!res.ok) throw new Error('add_failed'); return res.json(); })
      .then(function () {
        if (!discountCode) return null;
        return fetch('/discount/' + encodeURIComponent(discountCode), {
          credentials: 'same-origin',
          redirect: 'follow'
        }).catch(function () { return null; });
      })
      .then(function () { return fetch('/cart.js', { credentials: 'same-origin' }).then(function (r) { return r.ok ? r.json() : null; }); })
      .then(function (cart) {
        checkoutBusy = false;
        checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
        if (trigger && trigger.classList) trigger.classList.remove('is-loading');
        if (cart) {
          document.dispatchEvent(new CustomEvent('zavelyn:offer-cart:open', { detail: { cart: cart } }));
          return;
        }
        window.location.href = '/checkout';
      })
      .catch(function () {
        checkoutBusy = false;
        checkoutBtns.forEach(function (btn) { btn.classList.remove('is-loading'); });
        if (trigger && trigger.classList) trigger.classList.remove('is-loading');
        if (buyForm) buyForm.submit();
      });
  }
  if (buyForm) buyForm.addEventListener('submit', function (e) { e.preventDefault(); goToCheckout(e.submitter); });
  checkoutBtns.forEach(function (btn) {
    if (btn.closest('#OfferAddForm')) return;
    btn.addEventListener('click', function (e) { e.preventDefault(); goToCheckout(btn); });
  });

  var sticky = document.querySelector('[data-offer-sticky]');
  var stickyCta = sticky ? sticky.querySelector('[data-offer-checkout]') : null;
  var hero = document.querySelector('.offer-hero');
  if (sticky && hero && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      var on = !entries[0].isIntersecting;
      sticky.classList.toggle('is-on', on);
      sticky.setAttribute('aria-hidden', on ? 'false' : 'true');
      if (on) sticky.removeAttribute('inert');
      else sticky.setAttribute('inert', '');
      if (stickyCta) stickyCta.tabIndex = on ? 0 : -1;
      document.documentElement.classList.toggle('offer-sticky-on', on);
    }, { threshold: 0.05 }).observe(hero);
  }

  var topBtn = document.querySelector('[data-offer-top]');
  if (topBtn) {
    function syncTopBtn() {
      var show = window.scrollY > 480;
      topBtn.hidden = !show;
      topBtn.classList.toggle('is-on', show);
    }
    window.addEventListener('scroll', syncTopBtn, { passive: true });
    syncTopBtn();
    topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });
  }
})();
</script>

