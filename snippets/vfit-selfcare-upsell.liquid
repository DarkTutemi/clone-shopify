        <!-- Item 2: Eye Mask (with Quantity Stepper) -->
        <div class="zv-summary-item" id="zvSummaryEye" style="display: none;">
          <div class="zv-summary-item-left">
            <span class="zv-item-dot"></span>
            <span class="zv-item-name" id="zvSummaryEyeName">Zavelyn Red Light Eye Care Mask</span>
            <span class="zv-item-tag" style="background:#EAF4EE; color:#183324;">OPTIONAL ADD-ON</span>
          </div>
          <div class="zv-summary-item-right">
            <div class="zv-mini-qty-stepper">
              <button type="button" class="zv-mini-qty-btn" onclick="changeAddonQty('eyeMask', -1);" aria-label="Decrease Eye Mask quantity">−</button>
              <span class="zv-mini-qty-num" id="zvSummaryEyeQty">1</span>
              <button type="button" class="zv-mini-qty-btn" onclick="changeAddonQty('eyeMask', 1);" aria-label="Increase Eye Mask quantity">+</button>
            </div>
            <span class="zv-item-price" id="zvSummaryEyePrice">$89.99</span>
          </div>
        </div>

        <!-- Item 3: Face Mask (with Quantity Stepper) -->
        <div class="zv-summary-item" id="zvSummaryFace" style="display: none;">
          <div class="zv-summary-item-left">
            <span class="zv-item-dot"></span>
            <span class="zv-item-name" id="zvSummaryFaceName">Zavelyn LED Red Light Face Mask</span>
            <span class="zv-item-tag" style="background:#EAF4EE; color:#183324;">OPTIONAL ADD-ON</span>
          </div>
          <div class="zv-summary-item-right">
            <div class="zv-mini-qty-stepper">
              <button type="button" class="zv-mini-qty-btn" onclick="changeAddonQty('faceMask', -1);" aria-label="Decrease Face Mask quantity">−</button>
              <span class="zv-mini-qty-num" id="zvSummaryFaceQty">1</span>
              <button type="button" class="zv-mini-qty-btn" onclick="changeAddonQty('faceMask', 1);" aria-label="Increase Face Mask quantity">+</button>
            </div>
            <span class="zv-item-price" id="zvSummaryFacePrice">$129.99</span>
          </div>
        </div>
      </div>

      <div class="zv-summary-total-row">
        <div>
          <span class="zv-total-label">PACKAGE TOTAL</span>
          <span class="zv-total-savings" id="zvSummarySavings">TOTAL SAVINGS VS. MSRP: $300.01 (BASED ON VERIFIED LIST PRICES)</span>
        </div>
        <div class="zv-total-numbers">
          <div class="zv-total-price-large" id="zvSummaryTotal">$149.99</div>
          <div class="zv-total-compare-strike" id="zvSummaryCompare">$450.00</div>
        </div>
      </div>

      <button type="button" class="zv-package-cta-btn" id="zvSelfCareCtaBtn">
        <span id="zvSelfCareCtaLabel">CLAIM vFIT WELLNESS DEVICE — $149.99</span>
        <span>→</span>
      </button>

      <div class="zv-summary-tax-note">
        Taxes & shipping calculated at checkout • Standard Tracked Shipping Available
      </div>

      <div class="zv-summary-trust-row">
        <span>🛡️ 30-Day Return Policy</span>
        <span>🚚 Standard Tracked US Shipping</span>
        <span>🔒 Safe 256-Bit SSL Checkout</span>
      </div>
    </div>

  </div>
</section>

<!-- Lightbox Modal -->
<div class="zv-modal-backdrop" id="zvSelfCareModal" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="zv-modal-card">
    <button type="button" class="zv-modal-close" onclick="closeVfitModal();" aria-label="Close modal">✕</button>
    <div id="zvSelfCareModalBody"></div>
  </div>
</div>

<script>
(function() {
  'use strict';

  const DATA = {
    vfit: {
      id: {{ vfit_var_id }},
      price: {{ vfit_price | divided_by: 100.0 }},
      comparePrice: {{ vfit_compare | divided_by: 100.0 }}
    },
    eye: {
      id: {{ eye_var_id }},
      price: {{ eye_price | divided_by: 100.0 }},
      comparePrice: {{ eye_compare | divided_by: 100.0 }}
    },
    face: {
      id: {{ face_var_id }},
      price: {{ face_price | divided_by: 100.0 }},
      comparePrice: {{ face_compare | divided_by: 100.0 }}
    }
  };

  const state = {
    vfitQuantity: 1,
    eyeSelected: false,
    eyeQuantity: 1,
    faceSelected: false,
    faceQuantity: 1,
    galleries: {
      eyeMask: { activeIndex: 0 },
      faceMask: { activeIndex: 0 }
    }
  };

  function formatMoney(centsOrNum) {
    return '$' + Number(centsOrNum).toFixed(2);
  }

  function recalculate() {
    const vfitQty = state.vfitQuantity;
    const eyeQty = state.eyeSelected ? state.eyeQuantity : 0;
    const faceQty = state.faceSelected ? state.faceQuantity : 0;

    const vfitTotal = DATA.vfit.price * vfitQty;
    const vfitCompareTotal = DATA.vfit.comparePrice * vfitQty;

    const eyeTotal = DATA.eye.price * eyeQty;
    const eyeCompareTotal = DATA.eye.comparePrice * eyeQty;

    const faceTotal = DATA.face.price * faceQty;
    const faceCompareTotal = DATA.face.comparePrice * faceQty;

    const orderTotal = vfitTotal + eyeTotal + faceTotal;
    const orderCompare = vfitCompareTotal + eyeCompareTotal + faceCompareTotal;
    const savings = orderCompare - orderTotal;

    const totalItemsCount = vfitQty + eyeQty + faceQty;
    const addonsTypeCount = (state.eyeSelected ? 1 : 0) + (state.faceSelected ? 1 : 0);

    // Sync vFit Buy Box UI if present on page
    const vfitQtyDisplay = document.getElementById('vfitQtyDisplay');
    const vfitQtyMinus = document.getElementById('vfitQtyMinus');
    const zvBuy1Price = document.getElementById('zvBuy1Price');
    const zvPriceCurrent = document.getElementById('zvPriceCurrent');
    const zvPriceCompare = document.getElementById('zvPriceCompare');
    const zvPriceSave = document.getElementById('zvPriceSave');

    if (vfitQtyDisplay) vfitQtyDisplay.textContent = vfitQty;
    if (vfitQtyMinus) vfitQtyMinus.disabled = (vfitQty <= 1);
    if (zvBuy1Price) zvBuy1Price.textContent = formatMoney(vfitTotal);
    if (zvPriceCurrent) zvPriceCurrent.textContent = formatMoney(vfitTotal);
    if (zvPriceCompare) zvPriceCompare.textContent = formatMoney(vfitCompareTotal);
    if (zvPriceSave) {
      const pct = Math.round(((vfitCompareTotal - vfitTotal) / vfitCompareTotal) * 100);
      zvPriceSave.textContent = 'SAVE ' + formatMoney(vfitCompareTotal - vfitTotal) + ' (' + pct + '% OFF)';
    }

    // Sync input[name="quantity"] in main form
    const mainQtyInput = document.querySelector('form[action*="/cart/add"] input[name="quantity"]');
    if (mainQtyInput) mainQtyInput.value = vfitQty;

    // Summary Card Elements
    const nameEl = document.getElementById('zvSummaryVfitName');
    const priceEl = document.getElementById('zvSummaryVfitPrice');
    const summaryVfitQty = document.getElementById('zvSummaryVfitQty');

    const eyeRow = document.getElementById('zvSummaryEye');
    const eyeNameEl = document.getElementById('zvSummaryEyeName');
    const eyePriceEl = document.getElementById('zvSummaryEyePrice');
    const eyeQtyEl = document.getElementById('zvSummaryEyeQty');

    const faceRow = document.getElementById('zvSummaryFace');
    const faceNameEl = document.getElementById('zvSummaryFaceName');
    const facePriceEl = document.getElementById('zvSummaryFacePrice');
    const faceQtyEl = document.getElementById('zvSummaryFaceQty');

    const tierBadge = document.getElementById('zvSummaryTierBadge');
    const totalEl = document.getElementById('zvSummaryTotal');
    const compareEl = document.getElementById('zvSummaryCompare');
    const savingsEl = document.getElementById('zvSummarySavings');
    const ctaLabel = document.getElementById('zvSelfCareCtaLabel');

    if (nameEl) nameEl.textContent = 'Zavelyn vFit™ Red Light Device × ' + vfitQty;
    if (priceEl) priceEl.textContent = formatMoney(vfitTotal);
    if (summaryVfitQty) summaryVfitQty.textContent = vfitQty;

    if (eyeRow) {
      eyeRow.style.display = state.eyeSelected ? 'flex' : 'none';
      if (eyeNameEl) eyeNameEl.textContent = 'Zavelyn Red Light Eye Care Mask × ' + state.eyeQuantity;
      if (eyePriceEl) eyePriceEl.textContent = formatMoney(eyeTotal);
      if (eyeQtyEl) eyeQtyEl.textContent = state.eyeQuantity;
    }

    if (faceRow) {
      faceRow.style.display = state.faceSelected ? 'flex' : 'none';
      if (faceNameEl) faceNameEl.textContent = 'Zavelyn LED Red Light Face Mask × ' + state.faceQuantity;
      if (facePriceEl) facePriceEl.textContent = formatMoney(faceTotal);
      if (faceQtyEl) faceQtyEl.textContent = state.faceQuantity;
    }

    // Stepper on Eye Mask Card
    const cardQtyEye = document.getElementById('displayCardQtyEye');
    if (cardQtyEye) cardQtyEye.textContent = state.eyeQuantity;

    // Stepper on Face Mask Card
    const cardQtyFace = document.getElementById('displayCardQtyFace');
    if (cardQtyFace) cardQtyFace.textContent = state.faceQuantity;

    // Tier badge label
    if (tierBadge) {
      if (addonsTypeCount === 0) {
        tierBadge.textContent = vfitQty > 1 ? 'CORE WELLNESS (' + vfitQty + ' UNITS)' : 'CORE INTIMATE WELLNESS';
      } else if (addonsTypeCount === 1) {
        tierBadge.textContent = state.eyeSelected ? 'DUO EYE & WELLNESS RITUAL' : 'DUO FACIAL & WELLNESS RITUAL';
      } else {
        tierBadge.textContent = 'COMPLETE REJUVENATION SUITE (' + totalItemsCount + ' ITEMS)';
      }
    }

    if (totalEl) totalEl.textContent = formatMoney(orderTotal);
    if (compareEl) compareEl.textContent = formatMoney(orderCompare);
    if (savingsEl) savingsEl.textContent = 'TOTAL SAVINGS VS. MSRP: ' + formatMoney(savings) + ' (BASED ON VERIFIED LIST PRICES)';

    if (ctaLabel) {
      if (addonsTypeCount === 0) {
        ctaLabel.textContent = 'CLAIM vFIT WELLNESS DEVICE — ' + formatMoney(orderTotal);
      } else {
        ctaLabel.textContent = 'CLAIM YOUR WELLNESS PACKAGE (' + totalItemsCount + ' ITEMS) — ' + formatMoney(orderTotal);
      }
    }

    // Card selected states and pills
    const cardEye = document.getElementById('zvCardEye');
    const pillEye = document.getElementById('pillEye');
    if (cardEye) {
      cardEye.classList.toggle('selected', state.eyeSelected);
      if (pillEye) {
        pillEye.textContent = state.eyeSelected 
          ? (state.eyeQuantity > 1 ? '✓ ' + state.eyeQuantity + ' ADDED' : '✓ ADDED')
          : '+ ADD TO ORDER';
      }
    }

    const cardFace = document.getElementById('zvCardFace');
    const pillFace = document.getElementById('pillFace');
    if (cardFace) {
      cardFace.classList.toggle('selected', state.faceSelected);
      if (pillFace) {
        pillFace.textContent = state.faceSelected 
          ? (state.faceQuantity > 1 ? '✓ ' + state.faceQuantity + ' ADDED' : '✓ ADDED')
          : '+ ADD TO ORDER';
      }
    }
  }

  // Gallery slider controls
  window.setVfitSlide = function(key, idx) {
    state.galleries[key].activeIndex = idx;
    const slider = document.getElementById(key === 'eyeMask' ? 'sliderEye' : 'sliderFace');
    if (slider) slider.style.transform = 'translateX(-' + (idx * 100) + '%)';
    const thumbs = document.querySelectorAll('#thumbs' + (key === 'eyeMask' ? 'Eye' : 'Face') + ' .zv-thumb-item');
    thumbs.forEach((t, i) => t.classList.toggle('active', i === idx));
  };

  window.nextVfitSlide = function(key) {
    let idx = (state.galleries[key].activeIndex + 1) % 4;
    window.setVfitSlide(key, idx);
  };

  window.prevVfitSlide = function(key) {
    let idx = (state.galleries[key].activeIndex - 1 + 4) % 4;
    window.setVfitSlide(key, idx);
  };

  // vFit Quantity Functions (Accessible globally)
  window.changeVfitQty = function(delta) {
    const newQty = state.vfitQuantity + delta;
    if (newQty >= 1 && newQty <= 10) {
      state.vfitQuantity = newQty;
      recalculate();
    }
  };

  // Addon Quantity Functions
  window.changeAddonQty = function(key, delta) {
    if (key === 'eyeMask') {
      if (!state.eyeSelected) {
        state.eyeSelected = true;
        state.eyeQuantity = 1;
      } else {
        const newQty = state.eyeQuantity + delta;
        if (newQty <= 0) {
          state.eyeSelected = false;
          state.eyeQuantity = 1;
        } else if (newQty <= 10) {
          state.eyeQuantity = newQty;
        }
      }
    } else if (key === 'faceMask') {
      if (!state.faceSelected) {
        state.faceSelected = true;
        state.faceQuantity = 1;
      } else {
        const newQty = state.faceQuantity + delta;
        if (newQty <= 0) {
          state.faceSelected = false;
          state.faceQuantity = 1;
        } else if (newQty <= 10) {
          state.faceQuantity = newQty;
        }
      }
    }
    recalculate();
  };

  // Toggle selection on card click
  document.getElementById('zvCardEye')?.addEventListener('click', function(e) {
    if (e.target.closest('.zv-link-details') || e.target.closest('.zv-gallery-zoom-btn') || 
        e.target.closest('.zv-gallery-arrow') || e.target.closest('.zv-thumb-item') ||
        e.target.closest('.zv-card-qty-stepper')) return;
    state.eyeSelected = !state.eyeSelected;
    if (state.eyeSelected && state.eyeQuantity < 1) state.eyeQuantity = 1;
    recalculate();
  });

  document.getElementById('zvCardFace')?.addEventListener('click', function(e) {
    if (e.target.closest('.zv-link-details') || e.target.closest('.zv-gallery-zoom-btn') || 
        e.target.closest('.zv-gallery-arrow') || e.target.closest('.zv-thumb-item') ||
        e.target.closest('.zv-card-qty-stepper')) return;
    state.faceSelected = !state.faceSelected;
    if (state.faceSelected && state.faceQuantity < 1) state.faceQuantity = 1;
    recalculate();
  });

  // Bind Buy Box stepper buttons if present on page
  document.getElementById('vfitQtyPlus')?.addEventListener('click', function(e) {
    e.preventDefault();
    window.changeVfitQty(1);
  });
  document.getElementById('vfitQtyMinus')?.addEventListener('click', function(e) {
    e.preventDefault();
    window.changeVfitQty(-1);
  });

  // Multi-item add to cart
  document.getElementById('zvSelfCareCtaBtn')?.addEventListener('click', async function() {
    const btn = this;
    btn.style.opacity = '0.7';

    const items = [
      { id: DATA.vfit.id, quantity: state.vfitQuantity }
    ];
    if (state.eyeSelected && state.eyeQuantity > 0) {
      items.push({ id: DATA.eye.id, quantity: state.eyeQuantity, properties: { '_addon_routine': 'vFit' } });
    }
    if (state.faceSelected && state.faceQuantity > 0) {
      items.push({ id: DATA.face.id, quantity: state.faceQuantity, properties: { '_addon_routine': 'vFit' } });
    }

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
      });
      const cart = await res.json();
      
      // Check if Willa cart drawer exists
      if (typeof window.willaOpenCartDrawer === 'function') {
        if (typeof window.willaRefreshCart === 'function') await window.willaRefreshCart();
        window.willaOpenCartDrawer();
      } else {
        window.location.href = '/checkout';
      }
    } catch(err) {
      console.warn('Cart error handled:', err);
    } finally {
      btn.style.opacity = '1';
    }
  });

  // Modal handlers
  window.openVfitModal = function(key) {
    const modal = document.getElementById('zvSelfCareModal');
    const body = document.getElementById('zvSelfCareModalBody');
    if (!modal || !body) return;

    if (key === 'eyeMask') {
      body.innerHTML = '<h3 style="font-size: 22px; font-weight: 800; color: #183324; margin-top:0;">Zavelyn Red Light Eye Care Mask</h3>' +
        '<p style="color: #667085; font-size: 14px; line-height: 1.6;">Precision medical-grade 660nm red photon LEDs designed specifically for the delicate periorbital zone around the eyes.</p>' +
        '<div style="margin: 16px 0; display: flex; flex-direction: column; gap: 10px;">' +
        '<div style="display:flex; gap:10px; font-size:13.5px; color:#344054;"><strong style="color:#234E3E;">✓</strong><span><strong>30 Dual-Chipset LEDs:</strong> Concentrated biological photon delivery soothing micro-vessels.</span></div>' +
        '<div style="display:flex; gap:10px; font-size:13.5px; color:#344054;"><strong style="color:#234E3E;">✓</strong><span><strong>Collagen Activation:</strong> Targets fine lines, puffiness, and undereye fatigue bags.</span></div>' +
        '<div style="display:flex; gap:10px; font-size:13.5px; color:#344054;"><strong style="color:#234E3E;">✓</strong><span><strong>Zero Light-Leak Cushion:</strong> Soft memory silicone blackout rim.</span></div>' +
        '<div style="display:flex; gap:10px; font-size:13.5px; color:#344054;"><strong style="color:#234E3E;">✓</strong><span><strong>10-Min Timer:</strong> Effortless hands-free operation before bedtime.</span></div>' +
        '</div>';
    } else {
      body.innerHTML = '<h3 style="font-size: 22px; font-weight: 800; color: #183324; margin-top:0;">Zavelyn LED Red Light Face Mask</h3>' +
        '<p style="color: #667085; font-size: 14px; line-height: 1.6;">Full-coverage facial photon therapy delivering 630nm biological red wavelengths for a spa-grade at-home skincare ritual.</p>' +
        '<div style="margin: 16px 0; display: flex; flex-direction: column; gap: 10px;">' +
        '<div style="display:flex; gap:10px; font-size:13.5px; color:#344054;"><strong style="color:#234E3E;">✓</strong><span><strong>Uniform Optical Net Exposure:</strong> Even distribution across forehead, cheeks, and chin.</span></div>' +
        '<div style="display:flex; gap:10px; font-size:13.5px; color:#344054;"><strong style="color:#234E3E;">✓</strong><span><strong>7-Wavelength Bio-Light Therapy:</strong> Collagen, redness soothing, and blemish care.</span></div>' +
        '<div style="display:flex; gap:10px; font-size:13.5px; color:#344054;"><strong style="color:#234E3E;">✓</strong><span><strong>Food-Grade Bio-Silicone:</strong> Adapts comfortably to all facial contours.</span></div>' +
