{% comment %}
  ZAVELYN HAIR CARE — Bold Botanical Campaign Hero
{% endcomment %}
<section class="zvhc-hero" style="background: var(--zvhc-orange); color: var(--zvhc-ivory); position: relative; overflow: hidden; padding: 56px 0 72px;">
  <div class="zvhc-container">
    <div class="zvhc-hero-grid" style="display: grid; grid-template-columns: 1fr; gap: 40px; align-items: center;">
      <!-- Left Content Column -->
      <div class="zvhc-hero-content" style="z-index: 2;">
        <div class="zvhc-hero-badge" style="display: inline-flex; align-items: center; background: var(--zvhc-lime); color: var(--zvhc-forest); font-weight: 800; font-size: 0.78rem; letter-spacing: 0.08em; padding: 6px 14px; border-radius: 999px; text-transform: uppercase; margin-bottom: 20px; box-shadow: 0 4px 14px rgba(0,0,0,0.12);">
          <span>{{ section.settings.badge_text | default: '🌿 BOLD BOTANICAL BEAUTY · 100% CLEAN' }}</span>
        </div>
        
        <h1 class="zvhc-hero-title" style="color: #FFFFFF; font-family: var(--zvhc-font-heading); font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 900; line-height: 1.04; letter-spacing: -0.03em; margin: 0 0 20px;">
          {{ section.settings.headline | default: 'YOUR HAIR.<br><span style="color: var(--zvhc-lime);">YOUR RITUAL.</span>' }}
        </h1>
        
        <p class="zvhc-hero-subtitle" style="color: #FFF9EE; font-size: clamp(1.05rem, 1.8vw, 1.25rem); font-weight: 500; line-height: 1.5; max-width: 520px; margin: 0 0 32px; opacity: 0.95;">
          {{ section.settings.subhead | default: 'Botanical care for curls, coils & every beautiful strand. Powered by pure Honduran Batana and nourishing plant bio-lipids.' }}
        </p>
        
        <div class="zvhc-hero-cta-group" style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center;">
          <a href="{{ section.settings.primary_cta_url | default: '/collections/zvhc-all' }}" class="zvhc-btn zvhc-btn-primary" style="background: var(--zvhc-forest); color: var(--zvhc-lime); font-weight: 800; font-size: 1rem; letter-spacing: 0.04em; padding: 16px 32px; border-radius: 999px; text-decoration: none; border: 2px solid var(--zvhc-forest); transition: all 0.2s ease; box-shadow: 0 8px 24px rgba(23,45,32,0.3);">
            {{ section.settings.primary_cta_text | default: 'SHOP HAIR CARE →' }}
          </a>
          <a href="{{ section.settings.secondary_cta_url | default: '#routine' }}" class="zvhc-btn zvhc-btn-secondary" style="background: transparent; color: #FFFFFF; font-weight: 700; font-size: 1rem; letter-spacing: 0.04em; padding: 16px 28px; border-radius: 999px; text-decoration: none; border: 2px solid rgba(255,255,255,0.8); transition: all 0.2s ease;">
            {{ section.settings.secondary_cta_text | default: 'EXPLORE THE ROUTINE' }}
          </a>
        </div>
        
        <!-- Social Proof Stats -->
        <div class="zvhc-hero-proof" style="display: flex; align-items: center; gap: 18px; margin-top: 36px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.25);">
          <div style="display: flex; color: var(--zvhc-lime); font-size: 1.15rem; letter-spacing: 2px;">★★★★★</div>
          <div style="font-size: 0.88rem; font-weight: 600; color: #FFF9EE;">
            Trusted by <strong>14,000+ happy strand rituals</strong> across the US
          </div>
        </div>
      </div>

      <!-- Right Visual Column -->
      <div class="zvhc-hero-visual" style="position: relative; text-align: center;">
        <div style="position: relative; display: inline-block; border-radius: 28px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,0.25); border: 4px solid var(--zvhc-lime);">
          <img 
            src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" 
            alt="Zavelyn Hair Care Signature Botanical Treatment" 
            style="width: 100%; max-width: 480px; height: auto; display: block; object-fit: cover;"
            loading="eager"
          >
          <div style="position: absolute; bottom: 16px; left: 16px; right: 16px; background: rgba(23,45,32,0.9); backdrop-filter: blur(8px); padding: 12px 16px; border-radius: 14px; text-align: left; display: flex; align-items: center; justify-content: space-between;">
            <div>
              <div style="color: var(--zvhc-lime); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;">Pure Batana Oil</div>
              <div style="color: #FFFFFF; font-size: 0.92rem; font-weight: 700;">Honduran Scalp Therapy</div>
            </div>
            <div style="background: var(--zvhc-orange); color: #FFF; font-weight: 800; font-size: 0.85rem; padding: 4px 10px; border-radius: 6px;">
              $39.99
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ZVHC Signature Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "🌿 BOLD BOTANICAL BEAUTY · 100% CLEAN"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "YOUR HAIR. YOUR RITUAL."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Botanical care for curls, coils & every beautiful strand. Powered by pure Honduran Batana and nourishing plant bio-lipids."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary CTA Text",
      "default": "SHOP HAIR CARE →"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary CTA Text",
      "default": "EXPLORE THE ROUTINE"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary CTA URL"
    }
  ]
}
{% endschema %}
