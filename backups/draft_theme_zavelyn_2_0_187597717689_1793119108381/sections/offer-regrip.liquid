{%- liquid
  if request.page_type == 'product' and product != blank
    assign offer_product = product
  elsif section.settings.product != blank
    assign offer_product = section.settings.product
  else
    assign offer_product = all_products['regrip']
  endif
  if offer_product == blank
    assign offer_product = collections.all.products.first
  endif
  assign product = offer_product
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
  assign brand = s.brand_name | default: 'Zavelyn'
  assign cta_label = s.cta_label | default: 'BUY NOW'
  assign sec_gallery = section.blocks | where: 'type', 'sec_gallery' | first
  assign sec_hero = section.blocks | where: 'type', 'sec_hero' | first
  assign sec_faq = section.blocks | where: 'type', 'sec_faq' | first
  assign sec_footer = section.blocks | where: 'type', 'sec_footer' | first

  assign side_option = blank
  assign size_option = blank
  if product != blank
    for opt in product.options_with_values
      assign oname = opt.name | downcase
      if oname contains 'side' or oname contains 'hand'
        assign side_option = opt
      elsif oname contains 'size'
        assign size_option = opt
      endif
    endfor
  endif

  assign pack1_variant = current_variant
  assign pack2_variant = blank
  assign pack2_price = 0
  assign pack2_compare = 0
  if product.variants.size > 0
    assign pack1_variant = product.variants.first
  endif
  # Buy 2 uses same variant id x2 quantity when no dedicated pack variant
  assign sticky_copy = 'ReGrip™ Rehabilitation Glove'
  if sec_footer and sec_footer.settings.sticky_copy != blank
    assign sticky_copy = sec_footer.settings.sticky_copy
  endif
-%}
{% render 'offer-seo', product: product, section: section %}
{{ 'zavelyn-regrip.css' | asset_url | stylesheet_tag }}

<script type="application/json" id="RgVariantMap">
[
{%- for v in product.variants -%}
  {"id":{{ v.id }},"available":{{ v.available | json }},"price":{{ v.price | json }},"compare":{{ v.compare_at_price | default: 0 | json }},"option1":{{ v.option1 | json }},"option2":{{ v.option2 | json }},"option3":{{ v.option3 | json }},"title":{{ v.title | json }},"money":{{ v.price | money_without_trailing_zeros | json }},"compare_money":{{ v.compare_at_price | money_without_trailing_zeros | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
</script>

<div class="offer-page offer-page--regrip" id="OfferTop">
  <div class="offer-ticker">
    <p class="offer-ticker__line">📦 {{ s.ticker_text | default: 'FREE Worldwide Shipping —' }} <span>{{ s.ticker_highlight | default: 'This Week Only!' }}</span></p>
  </div>
  {% render 'offer-header', brand: brand, product: product %}

  {%- comment -%} ===== HERO + BUY BOX ===== {%- endcomment -%}
  <section class="offer-hero">
    <div class="offer-hero__grid">
      <div class="offer-hero__left">
        <div class="offer-media" data-offer-gallery>
          <div class="offer-media__stage">
            {%- if sec_gallery and sec_gallery.settings.image_1 != blank -%}
              {%- assign main_src = sec_gallery.settings.image_1 | image_url: width: 1200 -%}
            {%- elsif sec_gallery and sec_gallery.settings.fallback_1 != blank -%}
              {%- assign main_src = sec_gallery.settings.fallback_1 | asset_url -%}
            {%- else -%}
              {%- assign main_src = 'rg-gallery-1.png' | asset_url -%}
            {%- endif -%}
            <button type="button" class="offer-media__zoom" data-offer-zoom aria-label="Open gallery">
              <img data-offer-main src="{{ main_src }}" alt="{{ product.title | escape }}" width="1200" height="1200" fetchpriority="high">
            </button>
            <button type="button" class="offer-media__nav offer-media__nav--prev" data-offer-prev aria-label="Previous">❮</button>
            <button type="button" class="offer-media__nav offer-media__nav--next" data-offer-next aria-label="Next">❯</button>
          </div>
          <div class="offer-thumbs" role="list">
            {%- assign galleries = 'rg-gallery-1.png,rg-gallery-2.png,rg-gallery-3.png,rg-gallery-4.png,rg-gallery-5.png,rg-gallery-6.png,rg-gallery-7.png' | split: ',' -%}
            {%- for file in galleries -%}
              <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-offer-thumb data-index="{{ forloop.index0 }}" data-src="{{ file | asset_url }}" aria-label="Image {{ forloop.index }}">
                <img src="{{ file | asset_url }}" alt="" width="60" height="60" {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
              </button>
            {%- endfor -%}
          </div>
        </div>
      </div>

      <div class="offer-hero__right">
        <a class="rg-rating-bar" href="#REVIEW">
          <span class="rg-rating-bar__stars" aria-hidden="true">★★★★★</span>
          <span><strong>4.8/5</strong> • Trusted by stroke survivors and caregivers</span>
        </a>
        <h1 class="offer-title">{{ product.title | default: 'ReGrip™ | Rehabilitation Glove' }}</h1>

        <div class="rg-perks" {% if sec_hero %}{{ sec_hero.shopify_attributes }}{% endif %}>
          <div class="rg-perk"><img src="{{ 'rg-icon-hand.png' | asset_url }}" alt="" width="40" height="40" loading="eager"><span>{{ sec_hero.settings.perk_1 | default: 'Guided hand opening & closing' }}</span></div>
          <div class="rg-perk"><img src="{{ 'rg-icon-home.png' | asset_url }}" alt="" width="40" height="40" loading="eager"><span>{{ sec_hero.settings.perk_2 | default: 'Use It Alone or With a Helper' }}</span></div>
          <div class="rg-perk"><img src="{{ 'rg-icon-muscle.png' | asset_url }}" alt="" width="40" height="40" loading="eager"><span>{{ sec_hero.settings.perk_3 | default: '300+ Assisted reps in 20 Minutes' }}</span></div>
          <div class="rg-perk"><img src="{{ 'rg-icon-brain.png' | asset_url }}" alt="" width="40" height="40" loading="eager"><span>{{ sec_hero.settings.perk_4 | default: '3 Therapy Modes for Every Stage of Recovery' }}</span></div>
        </div>

        <div class="rg-trial-divider" aria-hidden="true"><span>30-Day At-Home Trial</span></div>

        <div class="rg-countdown" data-rg-countdown data-minutes="10">
          <span>CAREGIVER OFFER — 50% OFF ENDS IN ⏳ <strong data-rg-countdown-label>10:00</strong>!</span>
        </div>

        {% form 'product', product, id: 'OfferAddForm', class: 'offer-buy-form' %}
          <input type="hidden" name="id" id="OfferVariantId" value="{{ pack1_variant.id }}">
          <input type="hidden" name="quantity" id="OfferQuantity" value="1">

          <div class="rg-packs" data-rg-packs>
            <div class="rg-pack is-active" data-rg-pack="1">
              <div class="rg-pack__main">
                <span class="rg-pack__radio" aria-hidden="true"></span>
                <img class="rg-pack__img" src="{{ 'rg-bundle-1.png' | asset_url }}" alt="Buy 1 One Hand" width="88" height="88" loading="eager">
                <div class="rg-pack__info">
                  <div class="rg-pack__title-row">
                    <p class="rg-pack__title">Buy 1</p>
                    <span class="rg-pack__pill">ONE HAND</span>
                  </div>
                  <span class="rg-pack__save">SAVE $90.05</span>
                </div>
                <div class="rg-pack__prices">
                  <span class="rg-pack__price" data-rg-pack1-price>{{ pack1_variant.price | money_without_trailing_zeros }}</span>
                  {% if pack1_variant.compare_at_price > pack1_variant.price %}
                    <span class="rg-pack__compare" data-rg-pack1-compare>{{ pack1_variant.compare_at_price | money_without_trailing_zeros }}</span>
                  {% else %}
                    <span class="rg-pack__compare" data-rg-pack1-compare>$180.00</span>
                  {% endif %}
                </div>
              </div>
              <div class="rg-pack__opts">
                {% if side_option != blank %}
                  <label>Side of Hand &amp;
                    <select data-rg-side aria-label="Side of Hand">
                      {% for value in side_option.values %}
                        <option value="{{ value | escape }}" {% if pack1_variant.option1 == value or pack1_variant.option2 == value %}selected{% endif %}>{{ value }}</option>
                      {% endfor %}
                    </select>
                  </label>
                {% endif %}
                {% if size_option != blank %}
                  <label>Size (Required)
                    <select data-rg-size aria-label="Size">
                      {% for value in size_option.values %}
                        <option value="{{ value | escape }}" {% if pack1_variant.option1 == value or pack1_variant.option2 == value %}selected{% endif %}>{{ value }}</option>
                      {% endfor %}
                    </select>
                  </label>
                {% endif %}
              </div>
              <div class="rg-pack__bonus">+ FREE 30-Day Recovery Guide</div>
            </div>

            <div class="rg-pack" data-rg-pack="2">
              <span class="rg-pack__badge">BEST VALUE</span>
              <div class="rg-pack__main">
                <span class="rg-pack__radio" aria-hidden="true"></span>
                <img class="rg-pack__img" src="{{ 'rg-bundle-2.png' | asset_url }}" alt="Buy 2 Both Hands" width="88" height="88" loading="lazy">
                <div class="rg-pack__info">
                  <div class="rg-pack__title-row">
                    <p class="rg-pack__title">Buy 2</p>
                    <span class="rg-pack__pill">BOTH HANDS</span>
                  </div>
                  <span class="rg-pack__save">SAVE $180.10</span>
                </div>
                <div class="rg-pack__prices">
                  <span class="rg-pack__price" data-rg-pack2-price>$179.90</span>
                  <span class="rg-pack__compare">$360.00</span>
                </div>
              </div>
              <div class="rg-pack__opts">
                {% if side_option != blank %}
                  <label>Side of Hand &amp;
                    <select data-rg-side-2 aria-label="Side of Hand pack 2" disabled>
                      {% for value in side_option.values %}
                        <option value="{{ value | escape }}">{{ value }}</option>
                      {% endfor %}
                    </select>
                  </label>
                {% endif %}
                {% if size_option != blank %}
                  <label>Size (Required)
                    <select data-rg-size-2 aria-label="Size pack 2" disabled>
                      {% for value in size_option.values %}
                        <option value="{{ value | escape }}">{{ value }}</option>
                      {% endfor %}
                    </select>
                  </label>
                {% endif %}
              </div>
              <div class="rg-pack__bonus">+ FREE 30-Day Recovery Guide</div>
            </div>
          </div>

          <label class="rg-upsell">
            <input type="checkbox" data-rg-upsell>
            <img src="{{ 'rg-upsell-heat.png' | asset_url }}" alt="Heat Therapy Wrist Band" width="72" height="72" loading="lazy">
            <span class="rg-upsell__body">
              <span class="rg-upsell__title">Heat Therapy Wrist Band</span>
              <span class="rg-upsell__meta">Save $42.05! <strong>$17.95</strong> <s>$60.00</s></span>
            </span>
          </label>

          <button class="offer-cta rg-atc" type="submit" name="add" data-offer-checkout data-rg-cta {% unless pack1_variant.available %}disabled{% endunless %}>
            <span class="offer-cta__label">{{ cta_label }}</span>
            <span class="offer-cta__sep" aria-hidden="true">—</span>
            <span class="offer-cta__price" data-rg-cta-price>{{ pack1_variant.price | money_without_trailing_zeros }}</span>
          </button>
        {% endform %}

        <div class="rg-pay" aria-label="Payment methods">
          {%- assign rg_payment_types = 'visa,master,american_express,apple_pay,google_pay,paypal,shopify_pay' | split: ',' -%}
          {%- for type in rg_payment_types -%}
            <img
              src="{{ type | payment_type_img_url }}"
              alt="{{ type | replace: '_', ' ' | capitalize }}"
              width="38"
              height="24"
              loading="lazy"
              decoding="async"
            >
          {%- endfor -%}
        </div>

        <div class="rg-trust">
          <div class="rg-trust__item"><span aria-hidden="true">🚚</span><span>Free Shipping</span></div>
          <div class="rg-trust__item"><span aria-hidden="true">💙</span><span>30-Day Guarantee</span></div>
          <div class="rg-trust__item"><span aria-hidden="true">💬</span><span>24/7 Chat Support</span></div>
        </div>

        <button type="button" class="rg-size-btn" data-rg-size-open>Find Your Correct Size</button>
        <a class="rg-watch-btn" href="#howto" data-rg-watch-open>Click To Watch How To Use ReGrip™</a>

        <div class="rg-replica" role="note">
          <strong>Watch Out For Cheap Replicas</strong>
          <span>Only our brand guarantees the high quality product used by thousands for pain relief.</span>
        </div>

        <div class="offer-faq device-accordion" data-offer-accordion>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">How It Works</button>
            <div class="offer-faq__panel" hidden><div class="offer-faq__body">
              <p>🖐 <strong>ReGrip™ supports your hand with tension-assisted motion</strong> → helping your fingers open and close smoothly.</p>
              <p>🧠 <strong>This controlled movement reactivates the connection between your brain and hand</strong> → helping rebuild coordination and strength safely from home.</p>
              <p>⚙️ <strong>Using the smart display, you can easily adjust therapy modules and intensity</strong> → so every session is personalized for your recovery.</p>
            </div></div>
          </div>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">Find Your Correct Size</button>
            <div class="offer-faq__panel" hidden><div class="offer-faq__body">
              <p><strong>ReGrip™ Glove Size Guide</strong></p>
              <p>Choose your size based on <strong>hand width, hand length, and finger circumference</strong>.</p>
              <p><button type="button" class="rg-size-btn" data-rg-size-open style="margin:0">Open Size Chart</button></p>
            </div></div>
          </div>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">Works For These Conditions</button>
            <div class="offer-faq__panel" hidden><div class="offer-faq__body">
              <p><strong>ReGrip™ can support hand mobility and recovery for:</strong></p>
              <ul>
                <li>Stroke (Hemiparesis / Hemiplegia)</li>
                <li>Brachial plexus injuries</li>
                <li>Multiple sclerosis (MS)</li>
                <li>Parkinson’s-related hand stiffness</li>
                <li>Nerve damage / neuropathy in the hand</li>
                <li>Post-surgery recovery (hand, wrist, fingers)</li>
                <li>Hand paralysis after injury or trauma</li>
                <li>Cerebral palsy (adult hand mobility)</li>
                <li>Spasticity and muscle stiffness in the hand</li>
                <li>Tendon or nerve compression issues</li>
                <li>Weak grip strength in older adults</li>
                <li>Early recovery after fractures (once cleared by a doctor)</li>
                <li>General hand weakness or loss of coordination</li>
                <li>Individuals with pacemakers*</li>
              </ul>
              <p><small>* ReGrip™ does not use electrical stimulation. Patients with implanted medical devices should consult their physician before use.</small></p>
            </div></div>
          </div>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">Our Guarantee</button>
            <div class="offer-faq__panel" hidden><div class="offer-faq__body">
              <p>If you're not 100% satisfied <strong>within the first 30 days</strong>, just send it back to us and we'll give you a full refund.</p>
              <p>No need to worry about the return shipping — <strong>we've got you covered!</strong></p>
              <p>Contact support at <a href="mailto:support@zavelyn.com">support@zavelyn.com</a>.</p>
            </div></div>
          </div>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">Shipping Info</button>
            <div class="offer-faq__panel" hidden><div class="offer-faq__body">
              <p>We offer fast and reliable shipping on all orders. You can expect to receive it within <strong>7–14 business days based on your location</strong>.</p>
              <p>Please contact our customer service team if you have any questions about your shipment.</p>
            </div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="rg-marquee pause-on-hover" aria-hidden="true">
    <div class="rg-marquee__track">
      {%- capture rg_marquee_group -%}
        <div class="rg-marquee__group">
          <div class="rg-marquee__item">
            <span class="rg-marquee__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
            </span>
            <span>PREMIUM QUALITY</span>
          </div>
          <div class="rg-marquee__item">
            <span class="rg-marquee__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zm-6 0H5V6h9v2zm-9 11.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm12 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
            </span>
            <span>FAST SHIPPING</span>
          </div>
          <div class="rg-marquee__item">
            <span class="rg-marquee__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" focusable="false"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
            </span>
            <span>SATISFACTION GUARANTEED</span>
          </div>
        </div>
      {%- endcapture -%}
      {{ rg_marquee_group }}{{ rg_marquee_group }}{{ rg_marquee_group }}{{ rg_marquee_group }}
    </div>
  </div>

  <section class="offer-sec offer-sec--iwt-story">
    <div class="rg-iwt rg-iwt--rev rg-iwt--story">
      <div class="rg-iwt__media">
        <img src="{{ 'rg-iwt-therapy.gif' | asset_url }}" alt="ReGrip guided hand therapy" width="900" height="900" loading="lazy">
      </div>
      <div class="rg-iwt__copy">
        <h2>When Therapy Ends, Your Hand Still Needs Daily Movement</h2>
        <p>After a stroke, your <strong>hand may feel stiff, heavy, weak, or slow</strong> to respond.</p>
        <p>Simple tasks like <strong>holding a cup</strong>, opening your fingers, <strong>gripping a fork</strong>, or <strong>getting dressed</strong> can suddenly feel frustrating.</p>
        <p>ReGrip™ helps support <strong>gentle, guided hand opening and closing at home</strong> — so your affected hand gets a simple <strong>daily routine</strong> instead of staying inactive.</p>
      </div>
    </div>
  </section>

  <section class="offer-sec offer-sec--iwt-blue">
    <div class="rg-iwt rg-iwt--story rg-iwt--on-blue">
      <div class="rg-iwt__media">
        <img src="{{ 'rg-iwt-300.png' | asset_url }}" alt="Up to 300 guided reps" width="900" height="900" loading="lazy">
      </div>
      <div class="rg-iwt__copy">
        <h2>Support Real Hand Movement — Up To 300 Guided Reps Per Session</h2>
        <p>ReGrip™ uses gentle <strong>air-pressure assistance</strong> to guide your fingers through <strong>opening and closing movements</strong>.</p>
        <p>In just <strong>20 minutes, your hand can complete up to 300 assisted repetitions</strong> — helping you keep the affected hand active with gentle movement you can adjust.</p>
        <p>These repeated movements <strong>support mobility, coordination</strong>, and daily hand practice at home.</p>
        <p>Use the control panel to <strong>choose a comfortable intensity level</strong> and follow a routine that <strong>fits into your day.</strong></p>
        <a class="rg-iwt__cta rg-iwt__cta--light" href="#OfferTop" data-offer-checkout>Start Your Recovery now →</a>
      </div>
    </div>
  </section>

  <section class="offer-sec offer-sec--train" aria-label="How ReGrip™ Trains Your Hand">
    <div class="offer-head rg-train-head">
      <h2>How ReGrip™ Trains <span>Your Hand</span></h2>
    </div>
    <div class="rg-train">
      <article class="rg-train-card">
        <div class="rg-train-card__media">
          <img src="{{ 'rg-train-open.gif' | asset_url }}" alt="1. Hand Opening" width="600" height="600" loading="lazy">
        </div>
        <div class="rg-train-card__body">
          <h3>1. Hand Opening</h3>
          <p>ReGrip™ gently opens your fingers through guided air pressure, helping reduce stiffness and maintain joint mobility during rehabilitation.</p>
        </div>
      </article>
      <article class="rg-train-card">
        <div class="rg-train-card__media">
          <img src="{{ 'rg-train-close.gif' | asset_url }}" alt="2. Hand Closing" width="600" height="600" loading="lazy">
        </div>
        <div class="rg-train-card__body">
          <h3>2. Hand Closing</h3>
          <p>The glove assists your hand in closing and gripping motions, supporting muscle activation and improving coordination over time.</p>
        </div>
      </article>
      <article class="rg-train-card">
        <div class="rg-train-card__media">
          <img src="{{ 'rg-train-finger.gif' | asset_url }}" alt="3. Finger Activation" width="600" height="600" loading="lazy">
        </div>
        <div class="rg-train-card__body">
          <h3>3. Finger Activation</h3>
          <p>Each finger moves individually and repeatedly, helping stimulate muscle memory and strengthen the brain-to-hand connection.</p>
        </div>
      </article>
    </div>
  </section>

  {%- capture rg_feature_check -%}
    <span class="rg-features__check" aria-hidden="true"><svg viewBox="0 0 123 101" focusable="false"><path fill="currentColor" d="M4.43 63.63c-2.87-2.76-4.35-6.42-4.43-10.11-.07-3.69 1.26-7.41 4.02-10.28 2.75-2.87 6.42-4.35 10.11-4.43 3.69-.08 7.41 1.26 10.28 4.01l24.79 23.85L98.54 3.99l1.77 1.35c.14-.18.3-.34.48-.47 2.94-2.54 6.62-3.69 10.22-3.5l.18.02c3.62.24 7.16 1.85 9.78 4.77 2.66 2.97 3.86 6.73 3.66 10.41l-.02.18c-.24 3.56-1.79 7.04-4.61 9.63l-59.22 72.09c-.11.14-.24.26-.37.37-2.77 2.44-6.28 3.63-9.76 3.57-3.51-.06-7.02-1.4-9.74-4.02L4.43 63.63z"/></svg></span>
  {%- endcapture -%}
  <section class="offer-sec offer-sec--features" aria-label="Guided finger movement features">
    <div class="rg-features">
      <h2 class="rg-features__title">Guided finger movement to support stroke and nerve recovery</h2>
      <ul class="rg-features__list">
        {%- assign rg_feature_labels = 'Gentle Motion|Daily Therapy|Easy to Use|Adjustable Levels|Neuro Support|Home Therapy' | split: '|' -%}
        {%- for label in rg_feature_labels -%}
          <li class="rg-features__item">{{ rg_feature_check }}{{ label }}</li>
        {%- endfor -%}
      </ul>
    </div>
