<section class="zvhc-editorial-section zvhc-vs-drugstore-section" id="vs-drugstore" style="padding: 72px 0; background: #FFFFFF; border-bottom: 1px solid var(--zvhc-t01-border, #EAD7DD);">
  <div class="zvhc-container">
    
    <!-- Section Header -->
    <div style="text-align: center; max-width: 720px; margin: 0 auto 52px;">
