
{{ 'zhp-collection.css' | asset_url | stylesheet_tag }}
<div class="zhp-wrapper">
  <div class="zhp-marquee-bar" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
