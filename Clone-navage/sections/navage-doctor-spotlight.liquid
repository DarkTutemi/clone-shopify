{% comment %}
  Clone-navage/sections/navage-doctor-spotlight.liquid
  1:1 Why Doctors Recommend Naväge Over Traditional Rinses - Dr. Howard Levine
{% endcomment %}

<div id="SectionId-{{ section.id }}" class="navage-doctor-section">
  <div class="navage-doctor-container">
    <div class="navage-doctor-grid">
      <div class="navage-doctor-media">
        <img
          src="https://navage.com/cdn/shop/files/Dr._Levine_53cddeae-d75f-4c84-8432-692036e4c8d4.png?v=1778010891&width=1200"
          alt="Dr. Howard Levine, MD - Medical Director"
          loading="lazy"
          class="navage-doctor-img"
        >
      </div>

      <div class="navage-doctor-content">
        <h2 class="navage-doctor-title">Why Doctors Recommend Naväge Over Traditional Rinses</h2>
        <p class="navage-doctor-text">
          Saline nasal irrigation is one of the most evidence-backed recommendations in ENT medicine. Naväge takes it further — combining powered suction with precise saline concentrate SaltPods so patients actually use it consistently, comfortably, and correctly.
        </p>

        <div class="navage-doctor-stats">
          <div class="navage-stat-item">
            <span class="navage-stat-number">10+</span>
            <span class="navage-stat-label">Years of<br>Trust</span>
          </div>
          <div class="navage-stat-item">
            <span class="navage-stat-number">2-to-1</span>
            <span class="navage-stat-label">Consumer<br>Preferred</span>
          </div>
          <div class="navage-stat-item">
            <span class="navage-stat-number">100k+</span>
            <span class="navage-stat-label">5-Star<br>Reviews</span>
          </div>
        </div>

        <div class="navage-doctor-action">
          <a href="/products/navage-advanced-nose-cleaner" class="navage-doctor-btn">SHOP NOW</a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #SectionId-{{ section.id }} {
    background-color: #0b4a82;
    padding: 70px 24px;
    color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  #SectionId-{{ section.id }} .navage-doctor-container {
    max-width: 1280px;
    margin: 0 auto;
  }
  #SectionId-{{ section.id }} .navage-doctor-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 50px;
    align-items: center;
  }
  #SectionId-{{ section.id }} .navage-doctor-media {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
  }
  #SectionId-{{ section.id }} .navage-doctor-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    object-fit: cover;
  }
  #SectionId-{{ section.id }} .navage-doctor-content {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  #SectionId-{{ section.id }} .navage-doctor-title {
    font-size: 38px;
    font-weight: 800;
    line-height: 1.15;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.5px;
  }
  #SectionId-{{ section.id }} .navage-doctor-text {
    font-size: 16px;
    line-height: 1.6;
    color: #e0ecf8;
    margin: 0;
  }
  #SectionId-{{ section.id }} .navage-doctor-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  #SectionId-{{ section.id }} .navage-stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  #SectionId-{{ section.id }} .navage-stat-number {
    font-size: 36px;
    font-weight: 900;
    color: #58c5f5;
    line-height: 1;
  }
  #SectionId-{{ section.id }} .navage-stat-label {
    font-size: 13px;
    font-weight: 600;
    color: #ffffff;
    line-height: 1.25;
  }
  #SectionId-{{ section.id }} .navage-doctor-btn {
    align-self: flex-start;
    background-color: #8ca3d7;
    color: #002244;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.6px;
    padding: 14px 44px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  #SectionId-{{ section.id }} .navage-doctor-btn:hover {
    background-color: #7994d1;
    transform: translateY(-2px);
  }
  @media (max-width: 900px) {
    #SectionId-{{ section.id }} .navage-doctor-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    #SectionId-{{ section.id }} .navage-doctor-title {
      font-size: 28px;
    }
  }
</style>

{% schema %}
{
  "name": "Navage Doctor Spotlight",
  "settings": []
}
{% endschema %}
