<script>
function openEarthlyDiscountModal() {
  const modal = document.getElementById('earthlyDiscountModal');
  const teaser = document.getElementById('earthlyKlaviyoTeaser');
  if (modal) {
    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }
  if (teaser) {
    teaser.style.display = 'none';
  }
}

function closeEarthlyDiscountModal() {
  const modal = document.getElementById('earthlyDiscountModal');
  const teaser = document.getElementById('earthlyKlaviyoTeaser');
  if (modal) {
    modal.classList.remove('is-open');
    document.body.style.overflow = '';
  }
  if (teaser) {
    teaser.style.display = 'block';
  }
}

function handleEarthlyModalBackdrop(e) {
  if (e.target.id === 'earthlyDiscountModal') {
    closeEarthlyDiscountModal();
  }
}

document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeEarthlyDiscountModal();
  }
});

function handleEarthlyDiscountSubmit(e) {
  e.preventDefault();
  const input = document.getElementById('earthlyDiscountEmail');
  if (!input || !input.value || !input.checkValidity()) {
    input.focus();
    return;
  }

  // Hide form & show coupon code
  document.getElementById('earthlyDiscountForm').style.display = 'none';
  document.getElementById('earthlyDiscountSuccess').style.display = 'block';
}

function copyEarthlyCode(btn) {
  navigator.clipboard.writeText('EARTHLY5').then(function() {
    btn.innerText = 'COPIED TO CLIPBOARD! ✓';
    btn.style.background = '#1a3800';
    setTimeout(function() {
      closeEarthlyDiscountModal();
    }, 1200);
  }).catch(function() {
    closeEarthlyDiscountModal();
  });
}
</script>
