{{ 'zhp-collection.css' | asset_url | stylesheet_tag }}

<div class="zhp-wrapper">
  <section class="zhp-compare-section" id="compare-models">
    <div class="zhp-container">
      <div class="zhp-sec-header">
        <span class="zhp-sec-tag">SIDE-BY-SIDE EVALUATION</span>
        <h2 class="zhp-sec-title">Compare Zavelyn Models</h2>
        <p class="zhp-sec-subtitle">
          Find the ideal instrument tailored to your musical journey, spatial setting, and acoustic goals.
        </p>
      </div>

      <div class="zhp-table-wrap">
        <table class="zhp-compare-table">
          <thead>
            <tr>
              <th>Model</th>
              <th>Dimensions</th>
              <th>Notes / Tones</th>
              <th>Scale & Tuning</th>
              <th>Acoustic Material</th>
              <th>Included Accessories</th>
              <th>Recommended For</th>
              <th>Price</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <!-- Master -->
            <tr>
              <td>
                <span class="zhp-table-model-name">Zavelyn Handpan™ Master</span>
                <span class="zhp-table-badge">Flagship Concert</span>
              </td>
              <td><strong>22 Inches</strong> (55 cm)</td>
              <td>12 Tone Fields (Ding + 11 Dimples)</td>
              <td>D-Minor Kurd Scale</td>
              <td>Hand-Hammered Nitrided Carbon-Titanium Steel</td>
              <td>Tripod Stand, Padded Travel Backpack, Mallets, Braided Edge Rope</td>
              <td>Concert Performers, Sound Bath Therapy, Studio Recordings</td>
              <td><span class="zhp-table-price">$599.00</span></td>
              <td><a href="/products/zavelyn-handpan-master" class="zhp-table-cta">View Master</a></td>
            </tr>

            <!-- Pro -->
            <tr>
              <td>
                <span class="zhp-table-model-name">Zavelyn Drum™ Pro</span>
                <span class="zhp-table-badge" style="background:#EAF9D7; color:#276B19;">Most Popular</span>
              </td>
              <td><strong>15 Inches</strong> (38 cm)</td>
              <td>15 Tones (2 Full Octaves)</td>
              <td>D-Major Scale</td>
              <td>Tempered Carbon-Titanium Alloy Steel</td>
              <td>Padded Backpack, Bamboo Mallets, 20+ Songbook, Finger Picks, Edge Braid</td>
              <td>Serious Beginners, Meditators, Broad Musical Expression</td>
              <td><span class="zhp-table-price">$259.95</span></td>
              <td><a href="/products/zavelyn-drum-pro" class="zhp-table-cta">View Pro</a></td>
            </tr>

            <!-- Plus -->
            <tr>
              <td>
                <span class="zhp-table-model-name">Zavelyn Drum™ Plus</span>
                <span class="zhp-table-badge">Best Value</span>
              </td>
              <td><strong>11 Inches</strong> (28 cm)</td>
              <td>11 Tones</td>
              <td>D-Major Scale</td>
              <td>Tempered Alloy Steel with Pearlescent Coating</td>
              <td>Shoulder Travel Bag, Bamboo Mallets, Songbook, Finger Picks</td>
              <td>Daily Mindfulness, Family Music, Living Room Acoustics</td>
              <td><span class="zhp-table-price">$159.95</span></td>
              <td><a href="/products/zavelyn-drum-plus" class="zhp-table-cta">View Plus</a></td>
            </tr>

            <!-- Mini -->
            <tr>
              <td>
                <span class="zhp-table-model-name">Zavelyn Drum™ Mini</span>
                <span class="zhp-table-badge">Beginner Favorite</span>
              </td>
              <td><strong>6 Inches</strong> (15 cm)</td>
              <td>8 Tones</td>
              <td>C-Major Scale</td>
              <td>Carbon Steel Alloy with Baked Enamel</td>
              <td>Travel Pouch, Pair of Mallets, Songbook, Number Stickers</td>
              <td>Children, Complete Beginners, Travel, Desk Play</td>
              <td><span class="zhp-table-price">$109.95</span></td>
              <td><a href="/products/zavelyn-drum-mini" class="zhp-table-cta">View Mini</a></td>
            </tr>

            <!-- Rain Drum -->
            <tr>
              <td>
                <span class="zhp-table-model-name">Zavelyn Rain Drum™</span>
                <span class="zhp-table-badge">Pocket Chime</span>
              </td>
              <td><strong>3 Inches</strong> (8 cm)</td>
              <td>6 Tones</td>
              <td>Harmonic Pentatonic</td>
              <td>All-Weather Weatherproof Rust-Proof Steel</td>
              <td>Velvet Pouch, Wooden Mallet</td>
              <td>Outdoor Patios, Gardens, Desks, Rain Resonator</td>
              <td><span class="zhp-table-price">$59.00</span></td>
              <td><a href="/products/zavelyn-rain-drum" class="zhp-table-cta">View Rain</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

