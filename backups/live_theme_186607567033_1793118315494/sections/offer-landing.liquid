                <h3 class="offer-day__title">{{ block.settings.title }}</h3>
                <p class="offer-day__text">{{ block.settings.text }}</p>
                <ul class="offer-day__perks">
                  {%- if block.settings.perk_1 != blank -%}<li>{{ block.settings.perk_1 }}</li>{%- endif -%}
                  {%- if block.settings.perk_2 != blank -%}<li>{{ block.settings.perk_2 }}</li>{%- endif -%}
                  {%- if block.settings.perk_3 != blank -%}<li>{{ block.settings.perk_3 }}</li>{%- endif -%}
                </ul>
                {%- if block.settings.quote != blank -%}
                  <div class="offer-day__quote">
                    {% render 'offer-img', image: s.quote_icon, fallback: 'offer-quote-icon.png', width: 34, height: 34, alt: '' %}
                    <span>{{ block.settings.quote }}</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.style == '30' -%}
                  <div class="offer-ba">
                    {% render 'offer-img', image: s.ba_before_image, fallback: 'offer-ba-before.jpg', class: 'offer-ba__photo', alt: 'Before', width: 206, height: 206, loading: 'lazy' %}
                    <div class="offer-ba__col">
                      <div class="offer-ba__tag">
                        {% render 'offer-img', image: s.ba_cross_icon, fallback: 'offer-cross.png', width: 26, height: 26, alt: '' %}
                        <strong>{{ s.ba_before_label | default: 'Before Zavelyn' }}</strong>
                      </div>
                      <p>{{ s.ba_before_quote }}</p>
                    </div>
                    {% render 'offer-img', image: s.ba_arrow_icon, fallback: 'offer-ba-arrow.png', class: 'offer-ba__arrow', width: 26, height: 26, alt: '' %}
                    <div class="offer-ba__col offer-ba__col--after">
                      <div class="offer-ba__tag">
                        {% render 'offer-img', image: s.ba_check_icon, fallback: 'offer-check.png', width: 26, height: 26, alt: '' %}
