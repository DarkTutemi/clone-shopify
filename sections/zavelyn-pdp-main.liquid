{% schema %}
{
  "name": "Zavelyn PDP Main V2",
  "settings": [
    {
      "type": "header",
      "content": "Product Media Gallery (Group A)"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Thumbnail Layout",
      "options": [
        {
          "value": "thumbnails_bottom",
          "label": "Thumbnails Bottom"
        },
        {
          "value": "thumbnails_left",
          "label": "Thumbnails Left"
        },
        {
          "value": "stacked",
          "label": "Stacked Images"
        }
      ],
      "default": "thumbnails_bottom"
    },
    {
      "type": "checkbox",
      "id": "enable_image_zoom",
      "label": "Enable Click-to-Zoom",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_thumbnails",
      "label": "Mobile Gallery Display",
      "options": [
        {
          "value": "dots",
          "label": "Pagination Dots"
        },
        {
          "value": "thumbnails",
          "label": "Mini Thumbnails"
        },
        {
          "value": "hidden",
          "label": "Swipe Only (Hidden)"
        }
      ],
      "default": "thumbnails"
    },
    {
      "type": "header",
      "content": "Product Information (Group B)"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Subtitle",
      "default": "ZAVELYN INNOVATIONS · INDUSTRIAL GRADE"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Alert Text",
      "default": "High US Demand · Limited Units Remaining at Clearance Pricing"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "4.9 / 5.0 · 3,420+ Verified Reviews"
    },
    {
      "type": "header",
      "content": "BotanaRoots Bundle Custom Images & Layout"
    },
    {
      "type": "text",
      "id": "bundle_header_label",
      "label": "Bundle Section Header Label",
      "default": "CHOOSE YOUR QUANTITY:"
    },
    {
      "type": "text",
      "id": "guarantee_badge_text",
      "label": "Guarantee Badge Text",
      "default": "30-Day Returns"
    },
    {
      "type": "image_picker",
      "id": "botana_img_buy3",
      "label": "Buy 3 Card Image",
      "info": "Custom product image for Buy 3 bundle card (leave empty to use default)"
    },
    {
      "type": "text",
      "id": "buy3_badge",
      "label": "Buy 3 Banner Badge Text",
      "default": "BEST VALUE · FREE SHIPPING · EXTRA 20% OFF"
    },
    {
      "type": "image_picker",
      "id": "botana_img_buy2",
      "label": "Buy 2 Card Image",
      "info": "Custom product image for Buy 2 bundle card (leave empty to use default)"
    },
    {
      "type": "text",
      "id": "buy2_badge",
      "label": "Buy 2 Banner Badge Text",
      "default": "🔥 MOST POPULAR"
    },
    {
      "type": "image_picker",
      "id": "botana_img_buy1",
      "label": "Buy 1 Card Image",
      "info": "Custom product image for Buy 1 bundle card (leave empty to use default)"
    },
    {
      "type": "text",
      "id": "buy1_badge",
      "label": "Buy 1 Badge Text",
      "default": "Shipping +$4.95"
    },
    {
      "type": "header",
      "content": "Bottle Size Upsell (60ml -> 120ml)"
    },
    {
      "type": "image_picker",
      "id": "botana_img_upsell",
      "label": "Size Upsell Image (120ml Upgrade)",
      "info": "Custom graphic for 120ml bottle size upgrade card (leave empty to use default)"
    },
    {
      "type": "range",
      "id": "upsell_img_width",
      "label": "Desktop Upsell Image Width (px)",
      "min": 60,
      "max": 140,
      "step": 2,
      "default": 88,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "upsell_mobile_img_width",
      "label": "Mobile Upsell Image Width (px)",
      "min": 50,
      "max": 110,
      "step": 1,
      "default": 75,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "upsell_img_fit",
      "label": "Upsell Image Fit",
      "options": [
        {
          "value": "contain",
          "label": "Contain (Recommended)"
        },
        {
          "value": "cover",
          "label": "Cover"
        }
      ],
      "default": "contain"
    },
    {
      "type": "text",
      "id": "upsell_section_title",
      "label": "Upsell Section Title",
      "default": "UPGRADE YOUR BOTTLE SIZE"
    },
    {
      "type": "text",
      "id": "upsell_badge",
      "label": "Upsell Badge Text",
      "default": "SPECIAL OFFER"
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Upsell Main Heading",
      "default": "Double the Size!"
    },
    {
      "type": "text",
      "id": "upsell_description",
      "label": "Upsell Description",
      "default": "Upgrade each bottle from 60ml to 120ml."
    },
    {
      "type": "header",
      "content": "Call To Action & Checkout"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Primary CTA Button Text",
      "default": "CLAIM OFFER"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Enable Sticky Add to Cart Bar",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Product Gallery Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Gallery Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt Text"
        }
      ]
    },

    {
      "type": "trust_card",
      "name": "Trust Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Card Icon",
          "options": [
            {
              "value": "return",
              "label": "30-Day Return / Shield"
            },
            {
              "value": "shipping",
              "label": "Shipping / Truck"
            },
            {
              "value": "lock",
              "label": "SSL / Security Lock"
            },
            {
              "value": "star",
              "label": "Star / Quality Guarantee"
            }
          ],
          "default": "return"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "30-Day Returns"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Supporting Text",
          "default": "If you're not satisfied, return within 30 days"
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "Short FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does the 30-Day Return Guarantee work?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Order Zavelyn BotanaRoots with complete confidence. If you are not satisfied with your results within 30 days of receiving your order, simply reach out to our dedicated support team for an effortless return process."
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Default Open",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zavelyn PDP Main V2",
      "blocks": [
        {
          "type": "trust_card",
          "settings": {
            "icon": "return",
            "title": "30-Day Returns",
            "subtext": "If you're not satisfied, return within 30 days"
          }
        },
        {
          "type": "trust_card",
          "settings": {
            "icon": "shipping",
            "title": "Free Tracked Shipping",
            "subtext": "Fast delivery with real-time tracking updates"
          }
        },
        {
          "type": "trust_card",
          "settings": {
            "icon": "lock",
            "title": "Safe 256-Bit SSL",
            "subtext": "Encrypted & secure checkout guaranteed"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How does the 30-Day Return Guarantee work?",
            "answer": "Order Zavelyn BotanaRoots with complete confidence. If you are not satisfied with your results within 30 days of receiving your order, simply reach out to our dedicated support team for an effortless return process.",
            "default_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Shipping, Delivery & Returns",
            "answer": "All orders are dispatched from our US logistics hub within 24–48 hours. Standard tracked delivery takes 3–5 business days. You will receive real-time tracking updates via email as soon as your package leaves the warehouse.",
            "default_open": false
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Is payment safe and encrypted?",
            "answer": "Yes, 100%. We use bank-grade 256-bit SSL encryption to protect your transaction. Your payment information is processed directly by certified tier-1 merchant gateways and is never stored on our servers.",
            "default_open": false
          }
        }
      ]
    }
  ]
}
{% endschema %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- if product.handle == 'livestock-heating-lamp' -%}
  {%- assign default_variant = product.variants | where: 'title', '3 Pack' | first -%}
  {%- if default_variant -%}
    {%- assign current_variant = default_variant -%}
  {%- endif -%}
{%- elsif product.handle == 'zavelyn-custom-fit-home-dentures' -%}
  {%- assign default_variant = product.variants | where: 'title', '3 Complete Sets' | first -%}
  {%- if default_variant -%}
    {%- assign current_variant = default_variant -%}
  {%- endif -%}
{%- elsif product.handle == 'zavelyn-foldable-zippered-storage-bins' -%}
  {%- assign default_variant = product.variants | where: 'title', '6 Storage Bins' | first -%}
  {%- if default_variant -%}
    {%- assign current_variant = default_variant -%}
  {%- endif -%}
{%- endif -%}
{%- assign has_compare = false -%}
{%- if current_variant.compare_at_price > current_variant.price -%}
  {%- assign has_compare = true -%}
  {%- assign savings_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
{%- endif -%}

{%- comment -%} Detect Bundle Option Index (e.g. Option named 'Bundle', or containing 'Buy 1') {%- endcomment -%}
{%- assign bundle_opt_idx = -1 -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_name_down = opt.name | downcase -%}
  {%- if opt_name_down contains 'bundle' or opt_name_down contains 'package' or opt_name_down contains 'tier' or opt.values.first contains 'Buy 1' or product.handle == 'zavelyn-foldable-zippered-storage-bins' -%}
    {%- if bundle_opt_idx == -1 -%}
      {%- assign bundle_opt_idx = forloop.index0 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="zv-pdp-section-wrap" id="zvPdpSection">
  <div class="zv-pdp-container">
    <div class="zv-pdp-layout">

      <!-- LEFT COLUMN: PRODUCT GALLERY -->
      <div class="zv-pdp-gallery-col">
        <div class="zv-pdp-gallery-inner">
          {%- assign is_botanaroots = false -%}
          {%- if product.handle == 'zavelyn-botanaroots-organic-batana-hair-growth-oil' -%}
            {%- assign is_botanaroots = true -%}
          {%- endif -%}

          {%- assign gallery_blocks = section.blocks | where: "type", "gallery_image" -%}
          {%- if is_botanaroots and gallery_blocks.size > 0 -%}
            {%- assign first_gallery_block = gallery_blocks.first -%}
            {%- assign main_img_src = first_gallery_block.settings.image | image_url: width: 1200 -%}
            {%- if main_img_src == blank -%}
              {%- assign featured_img = current_variant.featured_image | default: product.featured_image -%}
              {%- assign main_img_src = featured_img | image_url: width: 1200 -%}
            {%- endif -%}
            <div class="zv-pdp-main-media" id="zvMainMediaWrap">
              {% if has_compare %}
                <div class="zv-media-badge" id="zvMediaBadge">SAVE {{ savings_percent }}%</div>
              {% endif %}
              <img 
                id="zvMainImg" 
                src="{{ main_img_src }}" 
                alt="{{ first_gallery_block.settings.alt | default: product.title | escape }}"
                width="600"
                height="600"
                loading="eager"
              >
            </div>
            {% if gallery_blocks.size > 1 %}
              <div class="zv-pdp-thumbs-row" id="zvThumbnails">
                {% for block in gallery_blocks %}
                  {% assign thumb_src = block.settings.image | image_url: width: 1200 %}
                  {% assign thumb_thumb = block.settings.image | image_url: width: 160 %}
                  {% if thumb_src == blank %}
                    {% for p_img in product.images offset: forloop.index0 limit: 1 %}
                      {% assign thumb_src = p_img | image_url: width: 1200 %}
                      {% assign thumb_thumb = p_img | image_url: width: 160 %}
                    {% endfor %}
                  {% endif %}
                  <button 
                    type="button" 
                    class="zv-thumb-btn {% if forloop.first %}active{% endif %}" 
                    data-img-src="{{ thumb_src }}" 
                    data-thumb-index="{{ forloop.index0 }}"
                    aria-label="View image {{ forloop.index }}"
                    {{ block.shopify_attributes }}
                  >
                    <img src="{{ thumb_thumb }}" alt="{{ block.settings.alt | default: product.title | escape }}" width="80" height="80" loading="lazy">
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          {%- else -%}
            <div class="zv-pdp-main-media" id="zvMainMediaWrap">
              {% if has_compare %}
                <div class="zv-media-badge" id="zvMediaBadge">SAVE {{ savings_percent }}%</div>
              {% endif %}
              
              {% assign featured_img = current_variant.featured_image | default: product.featured_image %}
              <img 
                id="zvMainImg" 
                src="{{ featured_img | image_url: width: 1200 }}" 
                alt="{{ featured_img.alt | default: product.title | escape }}"
                width="600"
                height="600"
                loading="eager"
              >
            </div>

            {% if product.images.size > 1 %}
              <div class="zv-pdp-thumbs-row" id="zvThumbnails">
                {% for image in product.images %}
                  <button 
                    type="button" 
                    class="zv-thumb-btn {% if forloop.first %}active{% endif %}" 
                    data-img-src="{{ image | image_url: width: 1200 }}" 
                    data-thumb-index="{{ forloop.index0 }}"
                    aria-label="View image {{ forloop.index }}"
                  >
                    <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | default: product.title | escape }}" width="80" height="80" loading="lazy">
                  </button>
                {% endfor %}
              </div>
            {% endif %}
          {%- endif -%}
        </div>
      </div>

      <!-- RIGHT COLUMN: BUY BOX (1:1 KITTY COLLECTIVE ANATOMY) -->
      <div class="zv-pdp-info-col">
        <div class="zv-pdp-buybox">
          
          <!-- Eyebrow Subtitle -->
          <div class="zv-pdp-eyebrow">
            {{ section.settings.eyebrow_text }}
          </div>

          <!-- Product Title -->
          <h1 class="zv-pdp-title">{{ product.title }}</h1>

          <!-- Price Row -->
          <div class="kc-base-price" id="zvBasePrice">
            <span class="kc-base-price__current" id="zvPriceCurrent">{{ current_variant.price | money }}</span>
            {% if has_compare %}
              <s id="zvPriceCompare">{{ current_variant.compare_at_price | money }}</s>
              <span class="kc-base-price__save" id="zvPriceSave">SAVE {{ savings_percent }}%</span>
            {% endif %}
          </div>

          <!-- Divider Line -->
          <div class="zv-divider-line"></div>

          <!-- Value Proposition & Benefits -->
          {%- include 'zavelyn-pdp-data' -%}
          <div class="zv-benefits-block">
            {% if zv_vp_b0 != blank %}
              <p class="zv-lead-prop">
                {{ zv_vp_sub }}
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">⚡</span><span><strong>{{ zv_vp_b0 }}</strong></span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛡️</span><span><strong>{{ zv_vp_b1 }}</strong></span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🔧</span><span><strong>{{ zv_vp_b2 }}</strong></span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🚚</span><span><strong>Dispatched within 24–48h</strong> from US fulfillment hubs</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">💚</span><span><strong>30-Day Money-Back Guarantee</strong> — peace of mind guarantee</span></div>
              </div>
            {% elsif product.handle == 'zavelyn-foldable-zippered-storage-bins' %}
              <p class="zv-lead-prop">
                An extra-large foldable storage container engineered for bulky quilts, blankets, winter coats, and seasonal linens.
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🧺</span><span><strong>XXL 210L Capacity</strong> — effortlessly stores 3 thick comforters or up to 200 seasonal garments</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🧵</span><span><strong>Reinforced Carrying Handles</strong> — cross-stitched webbing handles for secure, balanced lifting</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🔒</span><span><strong>Smooth Dual Zippers</strong> — robust two-way stainless steel zippers for wide, hassle-free packing</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🌿</span><span><strong>Breathable Dust Protection</strong> — premium fabric shields linens while keeping airflow fresh</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">📐</span><span><strong>Collapsible Space Saver</strong> — folds completely flat into a slim profile when not in use</span></div>
              </div>
            {% elsif product.handle == 'zavelyn-custom-fit-home-dentures' %}
              <p class="zv-lead-prop">
                A removable denture kit designed for at-home fitting, with a natural-looking appearance and an adjustable molding process.
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🦷</span><span><strong>Natural-Looking Smile</strong> — designed to resemble the appearance of natural teeth and realistic gum tones</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">✨</span><span><strong>At-Home Fitting</strong> — adjustable thermal molding system for a personalized suction fit</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">💧</span><span><strong>Removable & Easy to Maintain</strong> — designed for everyday removal, hygienic soaking, and simple cleaning</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🚚</span><span><strong>Tracked US Shipping</strong> — dispatched within 24–48h from US fulfillment hubs</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛡️</span><span><strong>30-Day Returns</strong> — backed by Zavelyn customer protection (unopened/sealed oral hygiene items eligible)</span></div>
              </div>
            {% elsif product.handle == 'zavelyn-botanaroots-organic-batana-hair-growth-oil' %}
              <p class="zv-lead-prop">
                Nourish your scalp and bring dry, fragile hair back to life with Zavelyn BotanaRoots Batana Hair Oil. A simple, natural addition to your hair care routine.
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🌿</span><span><strong>Pure Batana Oil</strong> — rich, nourishing care for your hair and scalp.</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">✨</span><span><strong>Fuller, Healthier-Looking Hair</strong> — helps hair look smoother, shinier, and more vibrant.</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">💧</span><span><strong>Deep Moisture &amp; Nourishment</strong> — helps soften dry strands and reduce the appearance of frizz.</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🚚</span><span><strong>Tracked US Shipping</strong> — estimated delivery in 7–15 business days.</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛡️</span><span><strong>30-Day Returns</strong> — shop with confidence under our return policy.</span></div>
              </div>
            {% elsif product.handle contains 'diesel' or product.handle contains 'injector' %}
              <p class="zv-lead-prop">
                Stop fighting seized injectors for hours with slide hammers that damage cylinder heads. Power through rock-solid carbon in under 5 minutes.
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛠️</span><span><strong>High-frequency pneumatic vibration</strong> breaks carbon bonds effortlessly</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛡️</span><span><strong>Zero cylinder head damage</strong> — balanced vertical shock eliminates snapped threads</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🧰</span><span><strong>21-piece master adapter set</strong> fits Bosch, Delphi, Denso & Siemens injectors</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🚚</span><span><strong>Dispatched within 24–48h</strong> from US warehouses with insured tracking</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">💚</span><span><strong>30-Day Money-Back Guarantee</strong> — if she won't budge, get every cent back</span></div>
              </div>
            {% else %}
              <p class="zv-lead-prop">
                Engineered for maximum reliability and daily performance. Experience precision build quality backed by our ironclad satisfaction guarantee.
              </p>
              <div class="zv-bullet-list">
                <div class="zv-bullet-item"><span class="zv-bullet-icon">⚡</span><span><strong>Instant High Performance</strong> — tested and calibrated for immediate daily use</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🛡️</span><span><strong>Heavy-Duty Premium Materials</strong> — built to outlast ordinary alternatives</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">🚚</span><span><strong>Dispatched within 24–48h</strong> from US regional fulfillment centers</span></div>
                <div class="zv-bullet-item"><span class="zv-bullet-icon">💚</span><span><strong>30-Day Money-Back Guarantee</strong> — protected by our 30-day return policy</span></div>
              </div>
            {% endif %}
          </div>

          {%- if product.handle == 'zavelyn-botanaroots-organic-batana-hair-growth-oil' -%}
            {%- render 'botanaroots-bundle-upsell',
                img_buy3: section.settings.botana_img_buy3,
                img_buy2: section.settings.botana_img_buy2,
                img_buy1: section.settings.botana_img_buy1,
                img_upsell: section.settings.botana_img_upsell
            -%}
          {%- elsif product.handle == 'zavelyn-vfit-red-light-intimate-wellness-device' -%}
            <!-- vfit-buybox-injected: vFit Dedicated Starter Kit + Quantity Stepper -->
            <style>
              .zv-buy1-container {
                background: #FFFFFF;
                border: 2px solid #234E3E;
                border-radius: 14px;
                padding: 16px 18px;
                margin-bottom: 20px;
                box-shadow: 0 4px 16px rgba(35, 78, 62, 0.06);
              }
              .zv-buy1-card {
                display: flex;
                align-items: center;
