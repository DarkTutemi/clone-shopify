{%- comment -%}
  Usage: {% render 'icon', icon: 'cart' %}
  Optional: class, size (sm|lg)
{%- endcomment -%}
{%- liquid
  assign icon_name = icon | default: 'cart'
  assign icon_class = 'icon'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
  if size == 'sm'
    assign icon_class = icon_class | append: ' icon--sm'
  elsif size == 'lg'
    assign icon_class = icon_class | append: ' icon--lg'
  endif
-%}

<svg class="{{ icon_class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case icon_name -%}
    {%- when 'cart' -%}
      <path d="M6 6h15l-1.5 9h-12z"/>
      <path d="M6 6 5 3H2"/>
      <circle cx="9" cy="20" r="1"/>
      <circle cx="18" cy="20" r="1"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/>
      <path d="m20 20-3.5-3.5"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/>
      <path d="M4 20c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'minus' -%}
      <path d="M6 12h12"/>
    {%- when 'plus' -%}
      <path d="M12 6v12M6 12h12"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"/>
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/>
    {%- when 'facebook' -%}
      <path d="M14 9h3V6h-3c-2 0-3 1-3 3v2H9v3h2v7h3v-7h3l1-3h-4V9c0-.5.5-1 1-1z"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9"/>
      <path d="M12 7c-2.5 0-4 1.6-4 3.6 0 1.4.7 2.2 1.8 2.2.3 0 .6-.2.7-.5l.2-.7c.1-.4 0-.5-.3-.8-.3-.4-.5-.8-.5-1.3 0-1.3 1-2.4 2.7-2.4 1.5 0 2.6 1 2.6 2.6 0 1.7-.8 2.9-1.8 2.9-.6 0-1-.5-.9-1.1l.3-1.3c.1-.5.1-1-.5-1-.7 0-1.2.8-1.2 1.7 0 .6.2 1 .2 1L10 17"/>
    {%- when 'tiktok' -%}
      <path d="M14 4v9.2a3.2 3.2 0 1 1-2.4-3.1V8.2A5.4 5.4 0 1 0 16.8 13V8.4A6.5 6.5 0 0 0 20 9.2V6.6A6.5 6.5 0 0 1 14 4z"/>
    {%- when 'filter' -%}
      <path d="M4 6h16M7 12h10M10 18h4"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
