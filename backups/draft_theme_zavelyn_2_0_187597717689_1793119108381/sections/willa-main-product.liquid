<script>
  let willaCurrentPdpVariantId = '{{ product.selected_or_first_available_variant.id }}';
  let willaCurrentPdpQty = 1;

  function switchPdpImg(src) {
    const main = document.getElementById('willaPdpMainImg');
    if (main && src) {
      main.style.opacity = '0.5';
      setTimeout(() => {
        main.src = src;
        main.style.opacity = '1';
      }, 150);
    }
    document.querySelectorAll('.willa-pdp-thumb').forEach(t => {
      if (t.src === src) t.classList.add('active');
      else t.classList.remove('active');
    });
  }

  
  
  const willaProductVariantsData = {{ product.variants | json }};
  let willaCurrentTierBundle = '{% if bundle_option %}{{ bundle_option.values.first | escape }}{% endif %}';
  let willaCurrentTierColor = '{% if color_option %}{{ color_option.values.first | escape }}{% endif %}';

  function updateTierVariant() {
    if (!willaProductVariantsData || willaProductVariantsData.length === 0) return;
    const matched = willaProductVariantsData.find(v => {
      const matchOpt1 = (v.option1 === willaCurrentTierBundle) || (!v.option1);
      const matchOpt2 = (v.option2 === willaCurrentTierColor) || (!v.option2);
      return matchOpt1 && matchOpt2;
    });

    if (matched) {
      willaCurrentPdpVariantId = matched.id;
      const priceFormatted = (matched.price / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
      const priceEl = document.getElementById('willaPdpPrice');
      if (priceEl) priceEl.innerText = priceFormatted;

      const stickyPriceEl = document.getElementById('willaStickyPrice');
      if (stickyPriceEl) stickyPriceEl.innerText = priceFormatted;

      if (matched.compare_at_price) {
        const compFormatted = (matched.compare_at_price / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
        const compEl = document.getElementById('willaPdpComparePrice');
        if (compEl) compEl.innerText = compFormatted;
      }

      if (matched.featured_image && matched.featured_image.src) {
        switchPdpImg(matched.featured_image.src);
      }
    }
  }

  function selectTierBundle(bundleVal, price, comparePrice, cardEl) {
    willaCurrentTierBundle = bundleVal;
    document.querySelectorAll('.wf-bundle-card').forEach(c => c.classList.remove('active'));
    if (cardEl) cardEl.classList.add('active');
    updateTierVariant();
  }

  function selectTierColor(colorVal, imgUrl, btnEl) {
    willaCurrentTierColor = colorVal;
    document.querySelectorAll('.willa-color-swatch-btn').forEach(b => {
      b.classList.remove('active');
      b.style.borderColor = '#e2e8f0';
    });
    if (btnEl) {
      btnEl.classList.add('active');
      btnEl.style.borderColor = '#8a2c13';
    }
    const label = document.getElementById('willaSelectedColorLabel');
    if (label) label.innerText = colorVal;
    if (imgUrl) switchPdpImg(imgUrl);
    updateTierVariant();
  }

  function selectPdpBundleCard(id, price, comparePrice, imgUrl, el) {
    willaCurrentPdpVariantId = id;
    document.querySelectorAll('.wf-bundle-card').forEach(c => c.classList.remove('active'));
    if (el) el.classList.add('active');

    const priceEl = document.getElementById('willaPdpPrice');
    if (priceEl) priceEl.innerText = price;

    const stickyPriceEl = document.getElementById('willaStickyPrice');
    if (stickyPriceEl) stickyPriceEl.innerText = price;

    const compEl = document.getElementById('willaPdpComparePrice');
    if (compEl && comparePrice) compEl.innerText = comparePrice;

    if (imgUrl) switchPdpImg(imgUrl);
  }

  function selectPdpVariant(id, price, comparePrice, imgUrl, btn) {
    willaCurrentPdpVariantId = id;
    document.querySelectorAll('.willa-variant-chip').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    const priceEl = document.getElementById('willaPdpPrice');
    if (priceEl) priceEl.innerText = price;

    const stickyPriceEl = document.getElementById('willaStickyPrice');
    if (stickyPriceEl) stickyPriceEl.innerText = price;

    const compEl = document.getElementById('willaPdpComparePrice');
    if (compEl && comparePrice) compEl.innerText = comparePrice;

    if (imgUrl) switchPdpImg(imgUrl);
  }

  function adjustPdpQty(delta) {
    const input = document.getElementById('willaPdpQty');
    if (!input) return;
    let val = parseInt(input.value) || 1;
    val += delta;
    if (val < 1) val = 1;
    if (val > 10) val = 10;
    input.value = val;
    willaCurrentPdpQty = val;
  }

  
  async function submitPdpDirectCheckout() {
    const btn = document.getElementById('willaPdpShopNowBtn');
    if (btn) {
      btn.disabled = true;
      btn.innerText = '⚡ PROCEEDING TO CHECKOUT...';
    }
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{
            id: willaCurrentPdpVariantId,
            quantity: willaCurrentPdpQty
          }]
        })
      });
      window.location.href = '/checkout';
    } catch (e) {
      window.location.href = '/cart/' + willaCurrentPdpVariantId + ':' + willaCurrentPdpQty;
    }
  }

  async function submitPdpOrder() {
    const btn = document.getElementById('willaPdpAtcBtn');
    if (btn) {
      btn.disabled = true;
      btn.innerText = 'ADDING...';
    }
    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          items: [{ id: willaCurrentPdpVariantId, quantity: willaCurrentPdpQty }]
        })
      });

      if (res.ok) {
        if (typeof window.willaOpenCartDrawer === 'function') {
          await window.willaRefreshCart();
          window.willaOpenCartDrawer();
          btn.disabled = false;
          btn.innerText = 'ADD TO CART ➔';
        } else {
          window.location.href = '/cart';
        }
      } else {
        window.location.href = '/cart/' + willaCurrentPdpVariantId + ':' + willaCurrentPdpQty;
      }
    } catch (e) {
      window.location.href = '/cart/' + willaCurrentPdpVariantId + ':' + willaCurrentPdpQty;
    }
  }

  function initStickyBar() {
    const mainAtc = document.getElementById('willaPdpAtcBtn');
    const stickyBar = document.getElementById('willaStickyAtc');
    if (!mainAtc || !stickyBar) return;

    function checkSticky() {
      const rect = mainAtc.getBoundingClientRect();
      if (rect.bottom < 0) {
        stickyBar.classList.add('visible');
      } else {
        stickyBar.classList.remove('visible');
      }
    }

    window.addEventListener('scroll', checkSticky, { passive: true });
    window.addEventListener('resize', checkSticky, { passive: true });
    checkSticky();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStickyBar);
  } else {
    initStickyBar();
  }
</script>

