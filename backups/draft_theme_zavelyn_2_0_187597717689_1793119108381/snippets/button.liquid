{%- comment -%}
  {% render 'button', label: 'Shop', link: '/collections/all', style: 'primary' %}
{%- endcomment -%}
{%- liquid
  assign btn_style = style | default: 'primary'
  assign btn_class = 'button button--' | append: btn_style
  if full
    assign btn_class = btn_class | append: ' button--full'
  endif
  if class != blank
    assign btn_class = btn_class | append: ' ' | append: class
  endif
-%}

{%- if link != blank -%}
  <a
    href="{{ link }}"
    class="{{ btn_class }}"
    {% if external %}target="_blank" rel="noopener noreferrer"{% endif %}
    {% if attributes %}{{ attributes }}{% endif %}
  >
    {{ label }}
  </a>
{%- else -%}
  <button
    type="{{ type | default: 'button' }}"
    class="{{ btn_class }}"
    {% if disabled %}disabled aria-disabled="true"{% endif %}
    {% if name %}name="{{ name }}"{% endif %}
    {% if attributes %}{{ attributes }}{% endif %}
  >
    {{ label }}
  </button>
{%- endif -%}
