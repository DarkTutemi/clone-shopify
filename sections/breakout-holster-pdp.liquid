<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">

<div class="bh-pdp-wrapper" id="Section-{{ section.id }}">
  <style>
    #Section-{{ section.id }} {
      --bh-red: #E52D27;
      --bh-red-dark: #B31217;
      --bh-red-bg: #FFF0F0;
      --bh-black: #111111;
      --bh-dark: #1E1E1E;
      --bh-gray-light: #F8F9FA;
      --bh-border: #E0E0E0;
      --bh-text: #222222;
      --bh-text-muted: #666666;
      --bh-green: #2E7D32;
      --bh-gold: #FFB800;

      background: #FFFFFF;
      padding: 0 0 50px 0;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--bh-text);
      line-height: 1.5;
      overflow-x: hidden;
      width: 100%;
      max-width: 100%;
    }

    #Section-{{ section.id }} * {
      box-sizing: border-box;
    }

    /* TOP ANNOUNCEMENT BANNER */
    #Section-{{ section.id }} .bh-announcement {
      background: var(--bh-red);
      color: #FFFFFF;
      text-align: center;
      padding: 11px 16px;
      font-size: 14.5px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      box-shadow: 0 2px 8px rgba(229, 45, 39, 0.25);
    }

    #Section-{{ section.id }} .bh-container {
      max-width: 1220px;
      margin: 0 auto;
      padding: 32px 24px 0 24px;
      width: 100%;
      box-sizing: border-box;
    }

    #Section-{{ section.id }} .bh-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr);
      gap: 48px;
      align-items: start;
    }

    /* LEFT GALLERY */
    #Section-{{ section.id }} .bh-gallery-wrap {
      position: sticky;
      top: 24px;
      display: flex;
      flex-direction: column;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    #Section-{{ section.id }} .bh-main-box {
      position: relative;
      background: #000000;
      border-radius: 18px;
      overflow: hidden;
      aspect-ratio: 1 / 1;
      width: 100%;
      border: 1px solid #E5E5E5;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    #Section-{{ section.id }} .bh-main-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: opacity 0.2s ease;
    }

    #Section-{{ section.id }} .bh-badges-overlay {
      position: absolute;
      top: 16px;
      left: 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      z-index: 2;
    }

    #Section-{{ section.id }} .bh-badge-pill {
      background: rgba(17, 17, 17, 0.88);
      color: #FFFFFF;
      backdrop-filter: blur(6px);
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    #Section-{{ section.id }} .bh-thumbs-strip {
      display: flex;
      gap: 10px;
      margin-top: 14px;
      overflow-x: auto;
      padding-bottom: 6px;
      scrollbar-width: thin;
      -webkit-overflow-scrolling: touch;
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }

    #Section-{{ section.id }} .bh-thumb-btn {
      width: 72px;
      height: 72px;
      border-radius: 10px;
      border: 2px solid transparent;
      overflow: hidden;
      cursor: pointer;
      padding: 0;
      flex-shrink: 0;
      background: #000000;
      transition: all 0.2s ease;
    }

    #Section-{{ section.id }} .bh-thumb-btn.active {
      border-color: var(--bh-red);
      box-shadow: 0 2px 10px rgba(229, 45, 39, 0.3);
    }

    #Section-{{ section.id }} .bh-thumb-btn img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* RIGHT BUY BOX */
    #Section-{{ section.id }} .bh-buybox {
      display: flex;
      flex-direction: column;
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    #Section-{{ section.id }} .bh-rating-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }

    #Section-{{ section.id }} .bh-stars {
      color: var(--bh-red);
      font-size: 16px;
      letter-spacing: 2px;
    }

    #Section-{{ section.id }} .bh-rating-text {
      font-size: 14px;
      font-weight: 700;
      color: #444444;
    }

    #Section-{{ section.id }} .bh-title {
      font-family: 'Oswald', 'Plus Jakarta Sans', sans-serif;
      font-size: 38px;
      font-weight: 700;
      line-height: 1.1;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--bh-black);
      margin: 0 0 10px 0;
    }

    /* PRICE ROW */
    #Section-{{ section.id }} .bh-price-row {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 12px;
    }

    #Section-{{ section.id }} .bh-price {
      font-size: 34px;
      font-weight: 900;
      color: var(--bh-black);
      line-height: 1;
    }

    #Section-{{ section.id }} .bh-compare {
      font-size: 20px;
      color: #999999;
      text-decoration: line-through;
      font-weight: 600;
    }

    #Section-{{ section.id }} .bh-save-badge {
      background: var(--bh-black);
      color: #FFFFFF;
      font-size: 12px;
      font-weight: 800;
      padding: 4px 10px;
      border-radius: 4px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    #Section-{{ section.id }} .bh-pitch {
      font-size: 15px;
      color: #444444;
      margin: 0 0 16px 0;
      line-height: 1.5;
    }

    #Section-{{ section.id }} .bh-checklist {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 20px;
      background: var(--bh-gray-light);
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid #ECECEC;
    }

    #Section-{{ section.id }} .bh-check-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 14px;
      font-weight: 700;
      color: var(--bh-dark);
    }

    #Section-{{ section.id }} .bh-check-icon {
      color: var(--bh-red);
      font-size: 16px;
      font-weight: 900;
    }

    /* BOGO OFFER PROMO BOX */
    #Section-{{ section.id }} .bh-bogo-box {
      background: #FFF5F5;
      border: 2px solid var(--bh-red);
      border-radius: 14px;
      padding: 18px 20px;
      margin-bottom: 22px;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    #Section-{{ section.id }} .bh-bogo-title {
      font-family: 'Oswald', sans-serif;
      font-size: 19px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--bh-red);
      margin: 0 0 4px 0;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    #Section-{{ section.id }} .bh-bogo-desc {
      font-size: 13.5px;
      color: #555555;
      margin: 0 0 16px 0;
    }

    /* GUN CONFIGURATION CARDS */
    #Section-{{ section.id }} .bh-config-group {
      background: #FFFFFF;
      border: 1px solid #E5D5D8;
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 12px;
      width: 100%;
      max-width: 100%;
      box-sizing: border-box;
    }

    #Section-{{ section.id }} .bh-config-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    #Section-{{ section.id }} .bh-config-title {
      font-size: 14px;
      font-weight: 800;
      color: var(--bh-black);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    #Section-{{ section.id }} .bh-free-pill {
      background: var(--bh-red);
      color: #FFFFFF;
      font-size: 11px;
      font-weight: 800;
      padding: 2px 8px;
      border-radius: 4px;
      text-transform: uppercase;
    }

    #Section-{{ section.id }} .bh-select-label {
      font-size: 12.5px;
      font-weight: 750;
      color: #333333;
      margin-bottom: 5px;
      display: block;
    }

    #Section-{{ section.id }} .bh-dropdown {
      width: 100%;
      max-width: 100%;
      height: 44px;
      border-radius: 8px;
      border: 1.5px solid #D5D5D5;
      background: #FFFFFF;
      padding: 0 12px;
      font-size: 14px;
      font-weight: 600;
      color: var(--bh-black);
      cursor: pointer;
      outline: none;
      transition: border-color 0.2s ease;
      margin-bottom: 12px;
      box-sizing: border-box;
    }

    #Section-{{ section.id }} .bh-dropdown:focus {
      border-color: var(--bh-red);
    }

    #Section-{{ section.id }} .bh-hand-pills {
      display: flex;
      gap: 10px;
      width: 100%;
      max-width: 100%;
    }

    #Section-{{ section.id }} .bh-hand-btn {
      flex: 1 1 0;
      min-width: 0;
      height: 40px;
      border-radius: 8px;
      border: 1.5px solid #D5D5D5;
      background: #FFFFFF;
      font-size: 13.5px;
      font-weight: 750;
      color: #444444;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
    }

    #Section-{{ section.id }} .bh-hand-btn.active {
      border-color: var(--bh-red);
      background: #FFF5F5;
      color: var(--bh-red);
      font-weight: 800;
    }

    /* MATERIAL SWATCHES */
    #Section-{{ section.id }} .bh-material-row {
      margin-top: 14px;
    }

    #Section-{{ section.id }} .bh-swatches {
      display: flex;
      gap: 12px;
      margin-top: 6px;
      width: 100%;
      max-width: 100%;
    }

    #Section-{{ section.id }} .bh-swatch-btn {
      flex: 1 1 0;
      min-width: 0;
      height: 48px;
      border-radius: 8px;
      border: 2px solid #D5D5D5;
      background: #FFFFFF;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 14px;
      cursor: pointer;
      transition: all 0.2s ease;
      box-sizing: border-box;
    }

    #Section-{{ section.id }} .bh-swatch-btn.active {
      border-color: var(--bh-red);
      box-shadow: 0 2px 8px rgba(229, 45, 39, 0.2);
    }

    #Section-{{ section.id }} .bh-swatch-thumb {
      width: 28px;
      height: 28px;
      border-radius: 4px;
      border: 1px solid #444444;
    }

    #Section-{{ section.id }} .bh-swatch-thumb.matte {
      background: #1A1A1A;
    }

    #Section-{{ section.id }} .bh-swatch-thumb.carbon {
      background: repeating-linear-gradient(45deg, #222, #222 3px, #333 3px, #333 6px);
    }

    #Section-{{ section.id }} .bh-swatch-name {
      font-size: 13px;
      font-weight: 750;
      color: var(--bh-black);
    }

    /* SAVINGS ACCENT BANNER */
    #Section-{{ section.id }} .bh-savings-banner {
      background: #E8F5E9;
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 14px;
      font-size: 13.5px;
      font-weight: 800;
      color: #1B5E20;
    }

    /* CTA BUTTON */
    #Section-{{ section.id }} .bh-cta-btn {
      width: 100%;
      background: var(--bh-red);
      color: #FFFFFF;
      border: none;
      border-radius: 12px;
      padding: 16px 20px;
      font-size: 18px;
      font-weight: 900;
      letter-spacing: 0.5px;
      cursor: pointer;
      box-shadow: 0 6px 22px rgba(229, 45, 39, 0.35);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      transition: all 0.2s ease;
      text-decoration: none;
      text-transform: uppercase;
    }

    #Section-{{ section.id }} .bh-cta-btn:hover {
      background: var(--bh-red-dark);
      transform: translateY(-1px);
      box-shadow: 0 8px 26px rgba(229, 45, 39, 0.45);
    }

    #Section-{{ section.id }} .bh-cta-sub {
      font-size: 12px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.92);
      letter-spacing: 0.5px;
    }

    /* TRUST BADGES ROW */
    #Section-{{ section.id }} .bh-trust-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #EEEEEE;
      text-align: center;
    }

    #Section-{{ section.id }} .bh-trust-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }

    #Section-{{ section.id }} .bh-trust-icon {
      font-size: 24px;
    }

    #Section-{{ section.id }} .bh-trust-text {
      font-size: 12.5px;
      font-weight: 800;
      color: var(--bh-dark);
    }

    /* INSTRUCTOR TESTIMONIAL */
    #Section-{{ section.id }} .bh-instructor-quote {
      background: var(--bh-gray-light);
      border-left: 4px solid var(--bh-red);
      border-radius: 0 10px 10px 0;
      padding: 14px 16px;
      margin-top: 18px;
      display: flex;
      gap: 14px;
      align-items: center;
    }

    #Section-{{ section.id }} .bh-instructor-img {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }

    #Section-{{ section.id }} .bh-instructor-body {
      font-size: 12.5px;
      line-height: 1.45;
      color: #333333;
    }

    #Section-{{ section.id }} .bh-instructor-author {
      font-weight: 800;
      color: var(--bh-black);
      margin-top: 4px;
      display: block;
    }

    /* ACCORDIONS */
    #Section-{{ section.id }} .bh-pdp-accordion {
      margin-top: 20px;
      border-top: 1px solid #ECECEC;
    }

    #Section-{{ section.id }} .bh-acc-item {
      border-bottom: 1px solid #ECECEC;
    }

    #Section-{{ section.id }} .bh-acc-summary {
      padding: 14px 0;
      font-size: 14.5px;
      font-weight: 800;
      color: var(--bh-black);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: space-between;
      list-style: none;
    }

    #Section-{{ section.id }} .bh-acc-summary::-webkit-details-marker {
      display: none;
    }

    #Section-{{ section.id }} .bh-acc-summary::after {
      content: '▼';
      font-size: 10px;
      color: #888888;
      transition: transform 0.2s ease;
    }

    #Section-{{ section.id }} .bh-acc-item[open] .bh-acc-summary::after {
      transform: rotate(180deg);
      color: var(--bh-red);
    }

    #Section-{{ section.id }} .bh-acc-content {
      padding: 0 0 14px 0;
      font-size: 13.5px;
      color: #555555;
      line-height: 1.55;
    }

    /* MOBILE STICKY BOTTOM DOCK */
    .bh-mobile-sticky-dock {
      display: none;
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      background: #FFFFFF;
      padding: 12px 18px;
      border-top: 1px solid #E5E5E5;
      box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.1);
      z-index: 9999;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .bh-mobile-sticky-dock .bh-dock-price {
      font-size: 19px;
      font-weight: 900;
      color: var(--bh-black);
      line-height: 1.1;
    }

    .bh-mobile-sticky-dock .bh-dock-sub {
      font-size: 11px;
      color: var(--bh-red);
      font-weight: 800;
      text-transform: uppercase;
    }

    .bh-mobile-sticky-dock .bh-dock-btn {
      flex: 1;
      max-width: 220px;
      background: var(--bh-red);
      color: #FFFFFF;
      border: none;
      border-radius: 10px;
      padding: 13px 18px;
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
      text-align: center;
      text-transform: uppercase;
      box-shadow: 0 4px 14px rgba(229, 45, 39, 0.35);
    }

    /* RESPONSIVE */
    @media (max-width: 991px) {
      #Section-{{ section.id }} .bh-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 24px;
        width: 100%;
      }
      #Section-{{ section.id }} .bh-gallery-wrap {
        position: static;
        width: 100%;
        min-width: 0;
        max-width: 100%;
      }
      #Section-{{ section.id }} .bh-buybox {
        width: 100%;
        min-width: 0;
        max-width: 100%;
      }
      #Section-{{ section.id }} .bh-title {
        font-size: 28px;
      }
      .bh-mobile-sticky-dock {
        display: flex;
      }
    }

    @media (max-width: 640px) {
      #Section-{{ section.id }} .bh-announcement {
        font-size: 11px;
        padding: 8px 6px;
        letter-spacing: 0.5px;
      }
      #Section-{{ section.id }} .bh-container {
        padding: 16px 12px 0 12px;
      }
      #Section-{{ section.id }} .bh-bogo-box {
        padding: 14px 10px;
      }
      #Section-{{ section.id }} .bh-config-group {
        padding: 12px 8px;
      }
      #Section-{{ section.id }} .bh-hand-btn {
        font-size: 12.5px;
        padding: 0 4px;
        height: 38px;
      }
      #Section-{{ section.id }} .bh-swatches {
        flex-direction: column;
        gap: 8px;
      }
    }
  </style>

