{% render 'breadcrumbs' %}

<section class="section" id="Collection-{{ section.id }}">
  <div class="page-width">
    <header class="section__header">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="section__subheader rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>

    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="collection-layout{% if section.settings.enable_filtering %} collection-layout--with-filters{% endif %}">
        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside class="collection-filters" aria-label="{{ 'collections.general.filter' | t }}">
            {% render 'facets', results: collection, enable_filtering: section.settings.enable_filtering, enable_sorting: section.settings.enable_sorting %}
          </aside>
        {%- endif -%}

        <div>
          <div class="collection-toolbar">
            <p class="collection-toolbar__count">
              {{ 'collections.general.items_with_count' | t: count: collection.products_count }}
            </p>
          </div>

          {%- if collection.products.size == 0 -%}
            <div class="empty-state">
              <p>{{ 'collections.general.empty' | t }}</p>
            </div>
          {%- else -%}
            <div class="product-grid product-grid--{{ section.settings.columns }}">
              {%- for product in collection.products -%}
                {% render 'product-card', product: product, eager: forloop.first, show_vendor: section.settings.show_vendor %}
              {%- endfor -%}
            </div>
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "label": "Products per page",
      "default": 16
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    }
  ]
}
{% endschema %}
