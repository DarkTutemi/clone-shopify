<section class="section" style="min-height: 80vh; display: grid; place-items: center;">
  <div class="page-width page-width--narrow" style="text-align: center;">
    <h1 style="margin-block-end: 0.5rem;">{{ shop.name }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="section__subheader" style="margin-inline: auto; margin-block-end: 2rem;">{{ section.settings.text }}</p>
    {%- endif -%}

    {% form 'storefront_password', class: 'newsletter-section__form' %}
      <label class="visually-hidden" for="Password">Password</label>
      <input
        id="Password"
        class="field__input"
        type="password"
        name="password"
        placeholder="Enter password"
        required
      >
      <button type="submit" class="button button--primary">Enter</button>
      {%- if form.errors -%}
        <div class="field__error" role="alert" style="width: 100%; margin-block-start: 0.75rem;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Opening soon. Enter the store password to continue."
    }
  ]
}
{% endschema %}
