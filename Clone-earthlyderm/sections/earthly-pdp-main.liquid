<script>
var currentPdpImages = [
  {% for image in product.images %}
    "{{ image | image_url: width: 1000 }}",
  {% endfor %}
];
var currentImageIndex = 0;

function switchPdpThumb(btn, src, idx) {
  document.querySelectorAll('.pdp-thumb-card').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');
  var main = document.getElementById('pdpMainImage');
  if (main) main.src = src;
  currentImageIndex = idx;
}

function navPdpImage(direction) {
  if (!currentPdpImages.length) return;
  currentImageIndex = (currentImageIndex + direction + currentPdpImages.length) % currentPdpImages.length;
  var main = document.getElementById('pdpMainImage');
  if (main) main.src = currentPdpImages[currentImageIndex];
  var thumbs = document.querySelectorAll('.pdp-thumb-card');
  thumbs.forEach(function(t, i) {
    if (i === currentImageIndex) t.classList.add('active');
    else t.classList.remove('active');
  });
}

function selectKachingDeal(card, bundleNumber, variantId, curPrice, compPrice) {
  document.querySelectorAll('.kaching-bar').forEach(function(b) { b.classList.remove('active'); });
  card.classList.add('active');

  document.getElementById('pdpSelectedVariantId').value = variantId;
  document.getElementById('pdpLivePrice').textContent = curPrice;
  document.getElementById('pdpLiveCompare').textContent = compPrice;
  document.getElementById('atcPriceText').textContent = curPrice;
  document.getElementById('atcCompareText').textContent = compPrice;
}

function toggleSubscription(cb) {
  var wrapper = document.getElementById('subSelectWrapper');
  if (wrapper) {
    wrapper.style.display = cb.checked ? 'block' : 'none';
  }
}

function toggleRichAcc(btn) {
  var card = btn.closest('.pdp-rich-acc-card');
  card.classList.toggle('active');
}

// Compute dynamic express delivery date (3 business days ahead)
(function() {
  function getBusinessDate(offset) {
    var d = new Date();
    var count = 0;
    while (count < offset) {
      d.setDate(d.getDate() + 1);
      var day = d.getDay();
      if (day !== 0 && day !== 6) count++;
    }
    var weekday = d.toLocaleDateString('en-US', { weekday: 'long' });
    var dateNum = d.getDate();
    var month = d.toLocaleDateString('en-US', { month: 'long' });
    return weekday + ', ' + dateNum + ' ' + month;
  }
  var dateEl = document.getElementById('pdpExpressDate');
  if (dateEl) dateEl.textContent = getBusinessDate(3);
})();

async function triggerPdpAddToCart() {
  var btn = document.getElementById('pdpAtcBtn');
  var origHtml = btn.innerHTML;
  btn.innerHTML = '<span>ADDING TO CART...</span>';
  btn.disabled = true;

  var varId = document.getElementById('pdpSelectedVariantId').value;

  try {
    var res = await fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: varId, quantity: 1 })
    });
    if (res.ok) {
      btn.innerHTML = '<span>ADDED TO CART ✓</span>';
      var cartRes = await fetch('/cart.js');
      var cartData = await cartRes.json();
      var countEl = document.getElementById('earthlyCartCount');
      if (countEl) countEl.textContent = cartData.item_count;

      setTimeout(function() {
        btn.innerHTML = origHtml;
        btn.disabled = false;
        if (typeof openEarthlyCartDrawer === 'function') {
          openEarthlyCartDrawer();
        }
      }, 600);
    } else {
      btn.innerHTML = '<span>TRY AGAIN</span>';
      setTimeout(function() { btn.innerHTML = origHtml; btn.disabled = false; }, 1200);
    }
  } catch(e) {
    btn.innerHTML = '<span>TRY AGAIN</span>';
    setTimeout(function() { btn.innerHTML = origHtml; btn.disabled = false; }, 1200);
  }
}
function playPdpVideo(container) {
  var video = container.querySelector('.s-main-product__video-file');
  var poster = container.querySelector('.s-main-product__preview-image');
  var icon = container.querySelector('.s-main-product__play-icon');
  if (video.paused) {
    video.play();
    if (poster) poster.classList.add('is-hidden');
    if (icon) icon.classList.add('is-hidden');
  } else {
    video.pause();
    if (icon) icon.classList.remove('is-hidden');
  }
}
</script>

