</style>

<script>
(function() {
  const productVariants = {{ product.variants | json }};
  const bundleOptIdx = {{ bundle_opt_idx }};
  const mainImg = document.getElementById('zvMainImg');
  const priceCurrentEl = document.getElementById('zvPriceCurrent');
  const priceCompareEl = document.getElementById('zvPriceCompare');
  const priceSaveEl = document.getElementById('zvPriceSave');
  const stickyPriceEl = document.getElementById('zvStickyPrice');
  const mediaBadge = document.getElementById('zvMediaBadge');

  let activeTier = ({{ product.handle | json }} === 'zavelyn-foldable-zippered-storage-bins') ? 6 : (({{ product.handle | json }} === 'livestock-heating-lamp' || {{ product.handle | json }} === 'zavelyn-custom-fit-home-dentures') ? 3 : 2);
  let activeQty = (bundleOptIdx > -1) ? 1 : 2;
  let activeVariantId = '{{ current_variant.id }}';

  // State of selected options
  let currentOptions = {{ current_variant.options | json }};

  // Helper to format currency
  function formatMoney(cents) {
    return (cents / 100).toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  }

  // Update bundle card prices & active variant for native bundle products
  function refreshVariantAndBundlePrices() {
    if (bundleOptIdx > -1) {
      // For each bundle tier card (1, 2, 3), find matching variant with current non-bundle options
      const offerLabels = document.querySelectorAll('#zvBundleOffers .kc-offer');
      offerLabels.forEach((label, idx) => {
        const bundleVal = label.getAttribute('data-bundle-val');
        const testOptions = [...currentOptions];
        testOptions[bundleOptIdx] = bundleVal;

        const matchedVar = productVariants.find(v => {
          return testOptions.every((opt, i) => v.options[i] === opt);
        });

        const priceStrong = label.querySelector('.zv-tier-price');
        const compareS = label.querySelector('.zv-tier-compare');

        if (matchedVar) {
          if (priceStrong) priceStrong.textContent = formatMoney(matchedVar.price);
          if (compareS) {
            if (matchedVar.compare_at_price > matchedVar.price) {
              compareS.textContent = formatMoney(matchedVar.compare_at_price);
            } else {
              compareS.textContent = '';
            }
          }

          // If this card is currently selected, set activeVariantId
          const radio = label.querySelector('input[type="radio"]');
          if (radio && radio.checked) {
            activeVariantId = matchedVar.id;
            activeQty = 1;
            if (priceCurrentEl) priceCurrentEl.textContent = formatMoney(matchedVar.price);
            if (stickyPriceEl) stickyPriceEl.textContent = formatMoney(matchedVar.price);
            if (compareS && matchedVar.compare_at_price > matchedVar.price) {
              if (priceCompareEl) priceCompareEl.textContent = formatMoney(matchedVar.compare_at_price);
              const savePct = Math.round((matchedVar.compare_at_price - matchedVar.price) * 100 / matchedVar.compare_at_price);
              if (priceSaveEl) priceSaveEl.textContent = 'SAVE ' + savePct + '%';
              if (mediaBadge) mediaBadge.textContent = 'SAVE ' + savePct + '%';
            }
            if (matchedVar.featured_image && mainImg) {
              mainImg.src = matchedVar.featured_image.src;
            }
          }
        }
      });
    } else {
      // Single-variant product: Tier 1, 2, 3
      if (activeTier === 1) activeQty = 1;
      else if (activeTier === 2) activeQty = 2;
      else if (activeTier === 3) activeQty = 3;
    }
  }

  // 1. Image Thumbnail Switching
  const thumbBtns = document.querySelectorAll('.zv-thumb-btn');
  thumbBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      thumbBtns.forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const src = this.getAttribute('data-img-src');
      if (src && mainImg) {
        mainImg.src = src;
      }
    });
  });

  // 2. Offer Tier Radio Changes
  const bundleRadios = document.querySelectorAll('input[name="zv_offer_tier"]');
  bundleRadios.forEach(radio => {
    radio.addEventListener('change', function() {
      activeTier = parseInt(this.value, 10);
      refreshVariantAndBundlePrices();
    });
  });

  // 3. Option Swatch Pills (e.g. Color, Size)
  const swatchBtns = document.querySelectorAll('.zv-option-pill');
  swatchBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const optIdx = parseInt(this.getAttribute('data-option-index'), 10);
      const optVal = this.getAttribute('data-option-value');
      
      const group = this.closest('.zv-variant-swatches');
      group.querySelectorAll('.zv-option-pill').forEach(b => b.classList.remove('active'));
      this.classList.add('active');

      const labelVal = group.querySelector('.zv-selected-val');
      if (labelVal) labelVal.textContent = optVal;

      currentOptions[optIdx] = optVal;
      refreshVariantAndBundlePrices();
    });
  });

  // Initialize prices
  refreshVariantAndBundlePrices();

  // 4. Cart Add Action
  async function addToCart(goToCheckout = false) {
    const claimBtn = document.getElementById('zvClaimOfferBtn');
    const spinner = document.getElementById('zvBtnSpinner');
    if (claimBtn) claimBtn.classList.add('loading');
    if (spinner) spinner.classList.remove('hidden');

    // On vFit, sync activeQty with vFit quantity stepper if present
    const vfitQtyDisp = document.getElementById('vfitQtyDisplay');
    if (vfitQtyDisp) {
      const q = parseInt(vfitQtyDisp.innerText, 10);
      if (!isNaN(q) && q >= 1) activeQty = q;
    }

    try {
      const res = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: activeVariantId,
          quantity: activeQty
        })
      });

      if (!res.ok) {
        throw new Error('Failed to add item to cart');
      }

      if (goToCheckout) {
        window.location.href = '/checkout';
        return;
      }

      // 1. Try Willa Cart Drawer
      if (typeof window.willaOpenCartDrawer === 'function') {
        if (typeof window.willaRefreshCart === 'function') {
          await window.willaRefreshCart();
        }
        window.willaOpenCartDrawer();
        return;
      }

      // 2. Try Zavelyn Cart Drawer Custom Element
      const zavelynDrawer = document.querySelector('zavelyn-cart-drawer');
      if (zavelynDrawer) {
        if (typeof zavelynDrawer.refresh === 'function') await zavelynDrawer.refresh();
        if (typeof zavelynDrawer.open === 'function') {
          zavelynDrawer.open();
          return;
        }
      }

      // 3. Fallback: Open willaCartDrawer DOM element directly
      const directDrawer = document.getElementById('willaCartDrawer');
      const directOverlay = document.getElementById('willaCartOverlay');
      if (directDrawer) {
        directDrawer.classList.add('active');
        if (directOverlay) directOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
        if (typeof window.willaRefreshCart === 'function') {
          await window.willaRefreshCart();
        }
        return;
      }

      // 4. Dispatch global event
      document.dispatchEvent(new CustomEvent('zavelyn:cart:open'));
    } catch(err) {
      console.error(err);
      alert('Could not add to cart. Please try again.');
    } finally {
      if (claimBtn) claimBtn.classList.remove('loading');
      if (spinner) spinner.classList.add('hidden');
    }
  }

  const claimBtn = document.getElementById('zvClaimOfferBtn');
  if (claimBtn) {
    claimBtn.addEventListener('click', () => addToCart(false));
  }

  const buyNowBtn = document.getElementById('zvBuyNowBtn');
  if (buyNowBtn) {
    buyNowBtn.addEventListener('click', () => addToCart(true));
  }

  const stickyBtn = document.getElementById('zvStickyBtn');
  if (stickyBtn) {
    stickyBtn.addEventListener('click', () => addToCart(false));
  }

  // 5. Sticky ATC Bar scroll listener
  const stickyBar = document.getElementById('zvStickyBar');
  const buyBox = document.querySelector('.zv-pdp-buybox');
  if (stickyBar && buyBox) {
    window.addEventListener('scroll', function() {
      const rect = buyBox.getBoundingClientRect();
      if (rect.bottom < 100) {
        stickyBar.classList.add('visible');
      } else {
        stickyBar.classList.remove('visible');
      }
    });
  }
})();
</script>
