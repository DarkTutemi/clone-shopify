<script>
  (function () {
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.rs__read-more');
      if (!btn) return;
      var id = btn.dataset.target;
      var action = btn.dataset.action;
      var wrap = document.querySelector('[data-block-id="' + id + '"]');
      if (!wrap) return;
      var trunc = wrap.querySelector('.rs__text-truncated');
      var full = wrap.querySelector('.rs__text-full');
      if (action === 'expand') {
        trunc.classList.add('is-hidden');
        full.classList.add('is-visible');
      } else {
        trunc.classList.remove('is-hidden');
        full.classList.remove('is-visible');
      }
    });
  })();
</script>
