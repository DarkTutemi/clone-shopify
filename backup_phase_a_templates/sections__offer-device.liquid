{%- liquid
  if request.page_type == 'product' and product != blank
    assign offer_product = product
  elsif section.settings.product != blank
    assign offer_product = section.settings.product
  else
    assign offer_product = all_products['v1-device']
  endif
  if offer_product == blank
    assign offer_product = collections.all.products.first
  endif
  assign product = offer_product
  assign current_variant = product.selected_or_first_available_variant
  assign s = section.settings
  assign brand = s.brand_name | default: 'Zavelyn'
  assign cta_label = s.cta_label | default: 'Add to cart'
  assign sec_gallery = section.blocks | where: 'type', 'sec_gallery' | first
  assign sec_hero = section.blocks | where: 'type', 'sec_hero' | first
  assign sec_heal = section.blocks | where: 'type', 'sec_heal' | first
  assign sec_features = section.blocks | where: 'type', 'sec_features' | first
  assign sec_reset = section.blocks | where: 'type', 'sec_reset' | first
  assign sec_howto = section.blocks | where: 'type', 'sec_howto' | first
  assign sec_reviews_slider = section.blocks | where: 'type', 'sec_reviews_slider' | first
  assign sec_stats = section.blocks | where: 'type', 'sec_stats' | first
  assign sec_relief = section.blocks | where: 'type', 'sec_relief' | first
  assign sec_compare = section.blocks | where: 'type', 'sec_compare' | first
  assign sec_faq = section.blocks | where: 'type', 'sec_faq' | first
  assign sec_loox = section.blocks | where: 'type', 'sec_loox' | first
  assign sec_footer = section.blocks | where: 'type', 'sec_footer' | first
  assign pack_1 = product.variants[0] | default: current_variant
  assign pack_2 = product.variants[1]
  assign pack_3 = product.variants[2]
-%}
{% render 'offer-seo', product: product, section: section %}
{{ 'zavelyn-device.css' | asset_url | stylesheet_tag }}

<div class="offer-page offer-page--device" id="OfferTop">
  <div class="offer-ticker">
    <p class="offer-ticker__line">⚡ {{ s.ticker_text | default: 'LIMITED OFFER.' }} <span>{{ s.ticker_highlight | default: 'DEVICE + 3 FREE BONUSES' }}</span></p>
  </div>
  {% render 'offer-header', brand: brand, product: product %}

  {%- comment -%} ===== 1. HERO + BUY BOX ===== {%- endcomment -%}
  <section class="offer-hero">
    <div class="offer-hero__grid">
      <div class="offer-hero__left">
        <div class="offer-media" data-offer-gallery>
          <div class="offer-media__stage">
            {%- if sec_gallery and sec_gallery.settings.image_1 != blank -%}
              {%- assign main_src = sec_gallery.settings.image_1 | image_url: width: 1200 -%}
            {%- elsif sec_gallery and sec_gallery.settings.fallback_1 != blank -%}
              {%- assign main_src = sec_gallery.settings.fallback_1 | asset_url -%}
            {%- else -%}
              {%- assign main_src = 'pen-gallery-1.jpg' | asset_url -%}
            {%- endif -%}
            <button type="button" class="offer-media__zoom" data-offer-zoom aria-label="Open gallery">
              <img data-offer-main src="{{ main_src }}" alt="{{ product.title | escape }}" width="1200" height="1200" fetchpriority="high">
            </button>
            <button type="button" class="offer-media__nav offer-media__nav--prev" data-offer-prev aria-label="Previous">❮</button>
            <button type="button" class="offer-media__nav offer-media__nav--next" data-offer-next aria-label="Next">❯</button>
          </div>
          <div class="offer-thumbs" role="list" {% if sec_gallery %}{{ sec_gallery.shopify_attributes }}{% endif %}>
            {%- if sec_gallery -%}
              {% render 'offer-group-slots', group: sec_gallery, mode: 'gallery', count: 7 %}
            {%- else -%}
              {%- assign galleries = 'pen-gallery-1.jpg,pen-gallery-2.jpg,pen-gallery-3.jpg,pen-gallery-4.jpg,pen-gallery-5.jpg,pen-gallery-6.jpg,pen-gallery-7.jpg' | split: ',' -%}
              {%- for file in galleries -%}
                {%- assign thumb_file = file | replace: '.jpg', '-thumb.jpg' -%}
                <button type="button" class="{% if forloop.first %}is-active{% endif %}" data-offer-thumb data-index="{{ forloop.index0 }}" data-src="{{ file | asset_url }}" aria-label="Image {{ forloop.index }}">
                  <img src="{{ thumb_file | asset_url }}" alt="" width="60" height="60" {% if forloop.first %}loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
                </button>
              {%- endfor -%}
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="offer-hero__right">
        <a class="offer-stars" href="#REVIEW">
          <img src="{{ 'offer-stars-47.png' | asset_url }}" alt="4.6 out of 5 stars" width="141" height="26" loading="eager">
          <span>rated <strong>4.6/5</strong> by <strong>50,000+</strong> customers</span>
        </a>
        <h1 class="offer-title">{{ product.title }}</h1>

        <div class="device-bonuses" {% if sec_hero %}{{ sec_hero.shopify_attributes }}{% endif %}>
          <p class="device-bonuses__label">{{ sec_hero.settings.bonus_label | default: 'Buy now and receive 3 bonuses:' }}</p>
          <ul class="device-bonuses__list">
            <li><span class="device-check" aria-hidden="true">✓</span><span>{{ sec_hero.settings.bonus_1 | default: 'FREE How to Use Acupuncture eBook ($10 Value)' }}</span></li>
            <li><span class="device-check" aria-hidden="true">✓</span><span>{{ sec_hero.settings.bonus_2 | default: 'FREE 3x Extra Healing Pen Cap ($15 Value)' }}</span></li>
            <li><span class="device-check" aria-hidden="true">✓</span><span>{{ sec_hero.settings.bonus_3 | default: 'FREE Healing Body Point Map ($5 Value)' }}</span></li>
          </ul>
        </div>

        <div class="device-perks-4">
          <div class="device-perk">{%- assign _oi_fallback_1_1 = sec_hero.settings.perk_1_fallback | default: 'pen-icon-natural.svg' -%}{% render 'offer-img', image: sec_hero.settings.perk_1_icon, fallback: _oi_fallback_1_1, width: 48, height: 48, alt: '' %}<span>{{ sec_hero.settings.perk_1 | default: 'Natural Pain Relief' }}</span></div>
          <div class="device-perk">{%- assign _oi_fallback_2_1 = sec_hero.settings.perk_2_fallback | default: 'pen-icon-ergo.svg' -%}{% render 'offer-img', image: sec_hero.settings.perk_2_icon, fallback: _oi_fallback_2_1, width: 48, height: 48, alt: '' %}<span>{{ sec_hero.settings.perk_2 | default: 'Ergonomic Design' }}</span></div>
          <div class="device-perk">{%- assign _oi_fallback_3_1 = sec_hero.settings.perk_3_fallback | default: 'pen-icon-easy.svg' -%}{% render 'offer-img', image: sec_hero.settings.perk_3_icon, fallback: _oi_fallback_3_1, width: 48, height: 48, alt: '' %}<span>{{ sec_hero.settings.perk_3 | default: 'Easy To Use' }}</span></div>
          <div class="device-perk">{%- assign _oi_fallback_4_1 = sec_hero.settings.perk_4_fallback | default: 'pen-icon-warranty.svg' -%}{% render 'offer-img', image: sec_hero.settings.perk_4_icon, fallback: _oi_fallback_4_1, width: 48, height: 48, alt: '' %}<span>{{ sec_hero.settings.perk_4 | default: '1-Year Warranty' }}</span></div>
        </div>

        {%- assign default_pack = pack_1 -%}
        {%- if s.packages_reversed and pack_3 != blank -%}
          {%- assign default_pack = pack_3 -%}
        {%- endif -%}

        {% form 'product', product, id: 'OfferAddForm', class: 'offer-buy-form' %}
          <input type="hidden" name="id" id="OfferVariantId" value="{{ default_pack.id }}">
          <input type="hidden" name="quantity" value="1">

          <div class="offer-bundles" data-device-packs id="OfferPackages">
            <div class="offer-bundles__head">
              <p class="offer-bundles__label">{{ s.packs_title | default: 'Choose your package' }}</p>
            </div>
            <div class="offer-bundles__list{% if s.packages_reversed %} offer-bundles__list--rev{% endif %}" role="radiogroup" aria-label="Choose package">
              <div class="offer-bundle{% unless s.packages_reversed %} is-active{% endunless %}">
                <label class="offer-bundle__pick">
                  <input
                    type="radio"
                    name="device_pack"
                    value="{{ pack_1.id }}"
                    data-pack="1"
                    data-cta-price="{{ pack_1.price | money_without_trailing_zeros }}"
                    {% unless s.packages_reversed %}checked{% endunless %}
                  >
                  <span class="offer-bundle__radio" aria-hidden="true"></span>
                  <span class="offer-bundle__body">
                    <span class="offer-bundle__content">
                      <span class="offer-bundle__title">{{ s.pack_1_title | default: 'Buy 1' }}</span>
                      <span class="offer-bundle__meta-row">
                        <span class="offer-bundle__meta">{{ s.pack_1_save | default: 'Save 46$' }}</span>
                        <span class="offer-bundle__ship">{{ s.pack_1_ship | default: '$4.95 ship' }}</span>
                      </span>
                    </span>
                    <span class="offer-bundle__price-col">
                      <span class="offer-bundle__price">{{ pack_1.price | money_without_trailing_zeros }}</span>
                      {% if pack_1.compare_at_price > pack_1.price %}
                        <span class="offer-bundle__compare">{{ pack_1.compare_at_price | money_without_trailing_zeros }}</span>
                      {% endif %}
                    </span>
                  </span>
                </label>
              </div>
              {% if pack_2 != blank %}
              <div class="offer-bundle offer-bundle--featured">
                <label class="offer-bundle__pick">
                  <input
                    type="radio"
                    name="device_pack"
                    value="{{ pack_2.id }}"
                    data-pack="2"
                    data-cta-price="{{ pack_2.price | money_without_trailing_zeros }}"
                  >
                  <span class="offer-bundle__radio" aria-hidden="true"></span>
                  <span class="offer-bundle__body">
                    <span class="offer-bundle__content">
                      <span class="offer-bundle__title">{{ s.pack_2_title | default: 'Buy 2' }}</span>
                      <span class="offer-bundle__meta-row">
                        <span class="offer-bundle__meta">{{ s.pack_2_save | default: 'Save 92$' }}</span>
                        {% if s.pack_2_ship != blank %}
                          <span class="offer-bundle__ship">{{ s.pack_2_ship }}</span>
                        {% endif %}
                      </span>
                    </span>
                    <span class="offer-bundle__price-col">
                      <span class="offer-bundle__price">{{ pack_2.price | money_without_trailing_zeros }}</span>
                      {% if pack_2.compare_at_price > pack_2.price %}
                        <span class="offer-bundle__compare">{{ pack_2.compare_at_price | money_without_trailing_zeros }}</span>
                      {% endif %}
                    </span>
                  </span>
                </label>
              </div>
              {% endif %}
              {% if pack_3 != blank %}
              <div class="offer-bundle offer-bundle--value{% if s.packages_reversed %} is-active{% endif %}">
                <label class="offer-bundle__pick">
                  <input
                    type="radio"
                    name="device_pack"
                    value="{{ pack_3.id }}"
                    data-pack="3"
                    data-cta-price="{{ pack_3.price | money_without_trailing_zeros }}"
                    {% if s.packages_reversed %}checked{% endif %}
                  >
                  <span class="offer-bundle__radio" aria-hidden="true"></span>
                  <span class="offer-bundle__body">
                    <span class="offer-bundle__content">
                      <span class="offer-bundle__title">{{ s.pack_3_title | default: 'Buy 3' }}</span>
                      <span class="offer-bundle__meta-row">
                        <span class="offer-bundle__meta">{{ s.pack_3_save | default: 'Extra 10% OFF' }}</span>
                        <span class="offer-bundle__ship offer-bundle__ship--free">{{ s.pack_3_ship | default: 'Free ship' }}</span>
                      </span>
                    </span>
                    <span class="offer-bundle__price-col">
                      <span class="offer-bundle__price">{{ pack_3.price | money_without_trailing_zeros }}</span>
                      {% if pack_3.compare_at_price > pack_3.price %}
                        <span class="offer-bundle__compare">{{ pack_3.compare_at_price | money_without_trailing_zeros }}</span>
                      {% endif %}
                    </span>
                  </span>
                </label>
              </div>
              {% endif %}
            </div>
          </div>

          <button class="offer-cta device-atc" type="submit" name="add" data-offer-checkout data-device-cta {% unless default_pack.available %}disabled{% endunless %}>
            <span class="offer-cta__label device-atc__label">{{ cta_label }}</span>
            <span class="offer-cta__sep device-atc__sep" aria-hidden="true">—</span>
            <span class="offer-cta__price device-atc__price" data-device-cta-price data-offer-cta-price>{{ default_pack.price | money_without_trailing_zeros }}</span>
          </button>
        {% endform %}

        <div class="offer-faq device-accordion" data-offer-accordion>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">Everything in your box</button>
            <div class="offer-faq__panel" hidden><div class="offer-faq__body">
              <ul class="device-accordion-list">
                <li><strong>{{ brand }} V1 Device</strong></li>
                <li><strong>Protective carrying case</strong></li>
                <li><strong>How to Use Acupuncture eBook</strong> — $10 value</li>
                <li><strong>3x Extra attachment heads</strong> — $15 value</li>
                <li><strong>Healing Body Point Map</strong> — $5 value</li>
              </ul>
              <p class="device-accordion-bonus"><strong>$30 in bonuses — FREE today</strong></p>
            </div></div>
          </div>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">How to get relief in 5 min</button>
            <div class="offer-faq__panel" hidden><div class="offer-faq__body">
              <ol class="device-accordion-steps">
                <li><strong>Turn on</strong> and set a comfortable intensity.</li>
                <li><strong>Hold the tip</strong> on the sore spot (or glide for larger areas).</li>
                <li><strong>Use 5–10 minutes</strong> — many feel a light tingle as tension eases.</li>
              </ol>
              <p><a class="device-accordion-link" href="#howto">See full step-by-step guide ↓</a></p>
            </div></div>
          </div>
          <div class="offer-faq__item">
            <button type="button" class="offer-faq__trigger" aria-expanded="false">Common questions</button>
            <div class="offer-faq__panel" hidden><div class="offer-faq__body">
              <p><strong>How soon will I feel it?</strong><br>Many notice relief within minutes on a targeted area. Results vary — consistent use helps most.</p>
              <p><strong>What if I don’t love it?</strong><br>You’re covered by our <strong>30-day money-back guarantee</strong>. Contact us within 30 days for a full refund.</p>
              <p><strong>Is it safe for daily use?</strong><br>Yes — non-invasive and adjustable. Not recommended with a pacemaker or implanted electronic devices; ask your doctor if unsure.</p>
            </div></div>
          </div>
        </div>

        {%- comment -%} Laura quote inside buy-box (Solvora placement) {%- endcomment -%}
        <div class="device-inline-quote">
          <img src="{{ 'pen-laura.jpg' | asset_url }}" alt="Laura M." width="50" height="50" loading="lazy">
          <div>
            <p class="device-inline-quote__text">“I was skeptical at first, but after a few sessions, I could feel real relief in my lower back. It’s now part of my daily self-care routine, and I love how simple it is to use.”</p>
            <p class="device-inline-quote__meta"><strong>Laura M.</strong> <span aria-hidden="true">★★★★★</span> — Verified Buyer</p>
          </div>
        </div>

        <div class="device-shipnote" data-device-shipnote>
          <div class="device-shipnote__from">
            <span class="device-flag" data-device-flag aria-hidden="true"></span>
            <span data-device-ship-label>Shipping to</span>
            <strong data-device-ship-place>{{ localization.country.name | default: 'your country' }}</strong>
          </div>
          <div class="device-shipnote__eta">Order will arrive by <strong data-device-arrive-by>…</strong></div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 2-3. Press to heal + premium checklist (2-col) ===== {%- endcomment -%}
  <section class="offer-sec device-sec-heal">
    <div class="device-heal">
      <h2 class="device-heal__title" {% if sec_heal %}{{ sec_heal.shopify_attributes }}{% endif %}>{{ sec_heal.settings.heading | default: 'Press the pen against body parts you want to heal!' }}</h2>
      <div class="device-heal__grid">
        <div class="device-heal__media">
          {%- assign _oi_fallback_5_1 = sec_heal.settings.fallback | default: 'pen-heal.webp' -%}{% render 'offer-img', image: sec_heal.settings.image, fallback: _oi_fallback_5_1, alt: 'How to use acupuncture pen', width: 500, height: 500, loading: 'lazy' %}
        </div>
        <div class="device-premium-box">
          <div class="device-premium-box__inset" aria-hidden="true"></div>
          <ul class="device-premium-box__list">
            <li>
              <span class="device-premium-box__check" aria-hidden="true">✓</span>
              <span><strong>Full-Body Pain Relief</strong> – Unlike medications, acupuncture has no side effects. It's perfect for arthritis, sciatica, sports injuries, muscle, joint, back pain, plantar fasciitis, and more.</span>
            </li>
            <li>
              <span class="device-premium-box__check" aria-hidden="true">✓</span>
              <span><strong>Boost Your Health</strong> – Acupuncture promotes healthy blood circulation and firmer skin. It also reduces stress and anxiety as your body begins to heal.</span>
            </li>
            <li>
              <span class="device-premium-box__check" aria-hidden="true">✓</span>
              <span><strong>9 Intensity Levels</strong> – Suitable for any treatment you need. You decide what level suits you best.</span>
            </li>
            <li>
              <span class="device-premium-box__check" aria-hidden="true">✓</span>
              <span><strong>Pain-Free Acupuncture</strong> – Get the same quality acupuncture treatment without the discomfort of needles.</span>
            </li>
            <li>
              <span class="device-premium-box__check" aria-hidden="true">✓</span>
              <span><strong>Easy to Use</strong> – Press the pen on the painful areas, and hold. It releases electric pulses to stimulate acupuncture points. That results in pain relief and healing.</span>
            </li>
            <li>
              <span class="device-premium-box__check" aria-hidden="true">✓</span>
              <span><strong>Package Includes</strong> – Comes with {{ brand }} V1 Device, protective carrying case and 3 extra bonuses.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 4. Icon grid / image-with-text (Solvora: dark bg + white icons) ===== {%- endcomment -%}
  <section class="offer-sec device-sec-itg">
    <div class="offer-row">
      <div class="offer-head device-itg-head"><h2>{{ brand }} V1 Device</h2></div>
      <div class="device-itg">
        <div class="device-itg__col">
          <article class="device-icon-card">
            <img src="{{ 'pen-icon-pain.webp' | asset_url }}" alt="Targeted Pain Relief" width="176" height="176" loading="lazy" decoding="async">
            <h3>Targeted Pain Relief</h3>
            <p>Precise electrical pulses focus on specific areas to help ease tension and discomfort exactly where you need it.</p>
          </article>
          <article class="device-icon-card">
            <img src="{{ 'pen-icon-circ.webp' | asset_url }}" alt="Improved Circulation" width="176" height="176" loading="lazy" decoding="async">
            <h3>Improved Circulation</h3>
            <p>Activates local blood flow to support recovery, reduce tension buildup, and enhance overall comfort.</p>
          </article>
        </div>
        <div class="device-itg__center">
          {%- assign _oi_fallback_6_1 = sec_features.settings.fallback | default: 'pen-gloves.jpg' -%}{% render 'offer-img', image: sec_features.settings.image, fallback: _oi_fallback_6_1, alt: 'V1 Device', width: 900, height: 800, loading: 'lazy' %}
        </div>
        <div class="device-itg__col">
          <article class="device-icon-card">
            <img src="{{ 'pen-icon-relax.webp' | asset_url }}" alt="Deep Muscle Relaxation" width="176" height="176" loading="lazy" decoding="async">
            <h3>Deep Muscle Relaxation</h3>
            <p>Gentle stimulation helps release tight muscles, reduce stiffness, and support a more relaxed body.</p>
          </article>
          <article class="device-icon-card">
            <img src="{{ 'pen-icon-intensity.webp' | asset_url }}" alt="Adjustable Intensity Control" width="176" height="176" loading="lazy" decoding="async">
            <h3>Adjustable Intensity Control</h3>
            <p>Customize each session with multiple intensity levels for a comfortable and personalized experience.</p>
          </article>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 5. Daily reset ===== {%- endcomment -%}
  <section class="offer-sec offer-sec--mint">
    <div class="offer-row">
      <div class="offer-head"><h2>Your Daily Reset, <span class="offer-blue">Simplified</span></h2></div>
      <div class="device-reset">
        <p>Daily tension doesn't disappear on its own, it builds up over time through movement, posture, and constant activity.</p>
        <p>The <strong>{{ brand }} V1</strong> gives you a simple way to step out of that cycle and take control. <strong>Designed for everyday use</strong>, it fits seamlessly into your routine without effort.</p>
        <p>In just a few minutes, you create a <strong>targeted moment of relief</strong> that helps your body release tension and reset. No appointments, no waiting, <strong>no complicated setup</strong>.</p>
        <p>Use it whenever you need – during a break, after a long day, or as part of your evening routine. It becomes a <strong>natural habit</strong> that supports how your body feels day after day.</p>
        <p>With consistent use, you'll notice a greater sense of <strong>ease</strong>, improved <strong>comfort</strong>, and a more balanced daily rhythm.</p>
      </div>
    </div>
  </section>

  {%- comment -%} ===== 6. How to use (2-col: master image + step cards) ===== {%- endcomment -%}
  <section class="offer-sec device-sec-howto" id="howto">
    <div class="device-howto">
      <div class="device-howto__head">
        <h2 class="device-howto__title" {% if sec_howto %}{{ sec_howto.shopify_attributes }}{% endif %}>{{ sec_howto.settings.heading | default: 'How To Use' }} {{ brand }} V1 Device</h2>
        <p class="device-howto__eyebrow">Step-by-Step Guide</p>
      </div>
      <div class="device-howto__grid">
        <div class="device-howto__media">
          {%- assign _oi_fallback_7_1 = sec_howto.settings.fallback | default: 'pen-howto.jpg' -%}{% render 'offer-img', image: sec_howto.settings.image, fallback: _oi_fallback_7_1, alt: 'How to use V1', width: 1000, height: 1000, loading: 'lazy' %}
        </div>
        <div class="device-howto__steps">
          <article class="device-step">
            <div class="device-step__thumb">
              {%- assign _oi_fallback_8_1 = sec_howto.settings.step_1_fallback | default: 'pen-step-1.jpg' -%}{%- assign _oi_alt_8_2 = sec_howto.settings.step_1_title | default: 'Choose & attach head' -%}{% render 'offer-img', image: sec_howto.settings.step_1_image, fallback: _oi_fallback_8_1, alt: _oi_alt_8_2, width: 320, height: 400, loading: 'lazy' %}
            </div>
            <div class="device-step__copy">
              <span class="device-step__num">1</span>
              <h3>{{ sec_howto.settings.step_1_title | default: 'Choose & Attach Head' }}</h3>
              <p>Select the right attachment for your needs and simply screw it on securely before use.</p>
            </div>
          </article>
          <article class="device-step">
            <div class="device-step__thumb">
              {%- assign _oi_fallback_9_1 = sec_howto.settings.step_2_fallback | default: 'pen-step-2.jpg' -%}{%- assign _oi_alt_9_2 = sec_howto.settings.step_2_title | default: 'Adjust intensity' -%}{% render 'offer-img', image: sec_howto.settings.step_2_image, fallback: _oi_fallback_9_1, alt: _oi_alt_9_2, width: 320, height: 400, loading: 'lazy' %}
            </div>
            <div class="device-step__copy">
              <span class="device-step__num">2</span>
              <h3>{{ sec_howto.settings.step_2_title | default: 'Adjust Intensity (1–9)' }}</h3>
              <p>Turn on the device and choose your preferred intensity level. Start low and adjust to what feels most comfortable.</p>
            </div>
          </article>
          <article class="device-step">
            <div class="device-step__thumb">
