<style>
  #SectionId-{{ section.id }} {
    display: block;
    width: 100%;
    background-color: #ffffff;
    color: #074174;
    font-family: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
    border-top: 1px solid #dae3ea;
    box-sizing: border-box;
    padding-top: 72px;
  }

  #SectionId-{{ section.id }} .navage-footer-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  #SectionId-{{ section.id }} .navage-footer-inner {
    padding-bottom: 50px;
  }

  #SectionId-{{ section.id }} .navage-footer-item-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr) 1.2fr;
    gap: 30px;
    align-items: start;
  }

  #SectionId-{{ section.id }} .navage-footer-item {
    display: flex;
    flex-direction: column;
    gap: 28px;
    word-break: break-word;
  }

  #SectionId-{{ section.id }} .navage-footer-menu-block {
    display: flex;
    flex-direction: column;
  }

  #SectionId-{{ section.id }} .navage-footer-menu-title {
    font-size: 20px;
    font-weight: 700;
    color: #074174;
    margin: 0 0 16px 0;
    line-height: 1.3;
    text-transform: none;
    letter-spacing: 0;
  }

  #SectionId-{{ section.id }} .navage-footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  #SectionId-{{ section.id }} .navage-footer-links li a {
    color: #074174;
    text-decoration: none;
    font-size: 15px;
    line-height: 1.4;
    opacity: 0.85;
    transition: opacity 0.2s, color 0.2s;
  }

  #SectionId-{{ section.id }} .navage-footer-links li a:hover {
    color: #074174;
    opacity: 1;
    text-decoration: underline;
  }

  #SectionId-{{ section.id }} .navage-header-numbers {
    list-style: none;
    margin: 0 0 20px 0;
    padding: 0;
    font-size: 16px;
    font-weight: 700;
    color: #074174;
  }

  #SectionId-{{ section.id }} .navage-header-numbers a {
    color: #074174;
    text-decoration: underline;
    font-weight: 700;
  }

  #SectionId-{{ section.id }} .navage-custom-after {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  #SectionId-{{ section.id }} .navage-social-media {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 20px;
    align-items: center;
  }

  #SectionId-{{ section.id }} .navage-social-item a {
    color: #074174;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  #SectionId-{{ section.id }} .navage-social-item a:hover {
    color: #00A3E0;
  }

  #SectionId-{{ section.id }} .navage-canada-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid #c4c4c4;
    border-radius: 30px;
    padding: 10px 20px;
    color: #074174;
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    max-width: fit-content;
    transition: border-color 0.2s;
  }

  #SectionId-{{ section.id }} .navage-canada-link:hover {
    border-color: #074174;
  }

  #SectionId-{{ section.id }} .navage-footer-aside {
    background: #074174;
    color: #ffffff;
    text-align: center;
    font-size: 14px;
    padding: 14px 20px;
    margin-left: -24px;
    margin-right: -24px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #SectionId-{{ section.id }} .navage-footer-aside a {
    color: #ffffff;
    font-size: 14px;
    text-decoration: underline;
  }

  #SectionId-{{ section.id }} .navage-divider {
    display: inline-block;
    margin: 0 10px;
    color: rgba(255, 255, 255, 0.6);
  }

  @media screen and (max-width: 1024px) {
    #SectionId-{{ section.id }} .navage-footer-item-list {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }
  }

  @media screen and (max-width: 640px) {
    #SectionId-{{ section.id }} {
      padding-top: 40px;
    }
    #SectionId-{{ section.id }} .navage-footer-item-list {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    #SectionId-{{ section.id }} .navage-footer-aside {
      font-size: 12px;
      line-height: 1.8;
      padding: 16px 10px;
    }
  }
</style>

