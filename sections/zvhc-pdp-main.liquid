{% comment %}
  ZAVELYN HAIR CARE — Main Product Section & Buy Box
  Supports dynamic 1/2/3 bundle cards, shade swatches for Fibers & Compact, and safe variant resolution
{% endcomment %}

{% assign has_shades = false %}
{% for option in product.options_with_values %}
  {% if option.name == 'Shade' %}
    {% assign has_shades = true %}
    {% assign shade_option = option %}
  {% endif %}
{% endfor %}

<section class="zvhc-pdp-main" id="zvhcBuyBoxSection" style="padding: 40px 0 60px; background: var(--zvhc-ivory);">
  <div class="zvhc-container">
    <div class="zvhc-pdp-grid">
      <!-- 1. Left Gallery Column -->
      <div class="zvhc-gallery">
        <div class="zvhc-main-image-wrap" style="position: relative; border-radius: 20px; overflow: hidden; background: #FFFFFF; border: 2px solid rgba(1,93,71,0.08); aspect-ratio: 1/1; box-shadow: 0 10px 30px rgba(0,0,0,0.04);">
          {% if product.featured_image %}
            <img id="zvhcMainImg" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
          {% else %}
            <img id="zvhcMainImg" src="https://cdn.shopify.com/s/files/1/0826/2483/9865/files/zvhc-3256807907799249-hero.jpg?v=1795264419" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
          {% endif %}
          <div class="zvhc-gallery-badge" style="position: absolute; top: 14px; left: 14px; background: var(--zvhc-green); color: var(--zvhc-lime); font-size: 0.75rem; font-weight: 800; padding: 5px 12px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.05em;">
            100% PURE BOTANICAL
          </div>
        </div>
        
        <!-- Thumbnails Row -->
        <div class="zvhc-thumbs-row" style="display: flex; gap: 10px; margin-top: 14px; overflow-x: auto; padding-bottom: 6px;">
          {% if product.images.size > 1 %}
            {% for img in product.images limit: 6 %}
              <div class="zvhc-thumb-item {% if forloop.first %}is-active{% endif %}" onclick="zvhcSelectThumb(this, '{{ img | image_url: width: 1000 }}')" style="width: 72px; height: 72px; flex-shrink: 0; border-radius: 12px; overflow: hidden; cursor: pointer; border: 2px solid {% if forloop.first %}var(--zvhc-orange){% else %}rgba(1,93,71,0.12){% endif %}; background: #FFF;">
                <img src="{{ img | image_url: width: 160 }}" alt="{{ product.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- 2. Right Buy Box Column -->
      <div class="zvhc-buybox" style="display: flex; flex-direction: column;">
        <!-- Review Stars -->
        <div class="zvhc-reviews-row" style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
          <div class="zvhc-stars" style="color: var(--zvhc-orange); font-size: 1.15rem; letter-spacing: 2px;">★★★★★</div>
          <span style="font-size: 0.86rem; font-weight: 700; color: var(--zvhc-forest); opacity: 0.9;">Verified Botanical Formula · US Verified</span>
        </div>

        <h1 class="zvhc-pdp-title" style="color: var(--zvhc-forest); font-family: var(--zvhc-font-heading); font-size: clamp(1.8rem, 3.2vw, 2.4rem); font-weight: 900; line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 12px;">
          {{ product.title }}
        </h1>
        
        <div class="zvhc-pdp-subtitle" style="font-size: 0.98rem; line-height: 1.5; color: #444; margin-bottom: 24px;">
          {{ product.description | strip_html | truncatewords: 35 | default: "Targeted botanical therapy formulated with high-potency active plant lipids to restore vitality, bounce, and density." }}
        </div>

        {% if has_shades %}
          <!-- Shade Selector (For Fibers and Hairline Compact) -->
          <div class="zvhc-shade-selector" style="background: #FFFFFF; border-radius: 16px; padding: 18px 20px; border: 2px solid rgba(1,93,71,0.08); margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
              <span style="font-size: 0.82rem; font-weight: 800; color: var(--zvhc-forest); text-transform: uppercase; letter-spacing: 0.06em;">CHOOSE YOUR SHADE:</span>
              <span id="zvhcSelectedShadeName" style="font-size: 0.85rem; font-weight: 700; color: var(--zvhc-orange);">Black</span>
            </div>
            <div class="zvhc-shade-options" style="display: flex; gap: 12px; flex-wrap: wrap;">
              {% for val in shade_option.values %}
                {% assign swatch_color = '#1A1A1A' %}
                {% if val contains 'Dark Brown' %}
                  {% assign swatch_color = '#382218' %}
                {% elsif val contains 'Medium Brown' %}
                  {% assign swatch_color = '#5C3826' %}
                {% endif %}
                <button type="button" class="zvhc-shade-btn {% if forloop.first %}is-active{% endif %}" data-shade="{{ val | escape }}" onclick="zvhcSelectShade('{{ val | escape }}', this)" style="display: flex; align-items: center; gap: 8px; background: #FAF8F5; border: 2px solid {% if forloop.first %}var(--zvhc-orange){% else %}rgba(0,0,0,0.1){% endif %}; padding: 8px 14px; border-radius: 999px; cursor: pointer; font-size: 0.85rem; font-weight: 700; color: var(--zvhc-forest);">
                  <span style="width: 18px; height: 18px; border-radius: 50%; background: {{ swatch_color }}; display: inline-block; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.4);"></span>
                  <span>{{ val }}</span>
                </button>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- Kaching-Style Bundle Cards (1x, 2x, 3x) -->
        <div class="zvhc-bundle-label" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <span style="font-size: 0.82rem; font-weight: 800; color: var(--zvhc-forest); text-transform: uppercase; letter-spacing: 0.06em;">SELECT QUANTITY / COURSE:</span>
          <span style="color: var(--zvhc-green); font-size: 0.78rem; font-weight: 800;">30-DAY MONEY-BACK GUARANTEE</span>
        </div>

        <div class="zvhc-bundle-cards-group" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px;">
          <!-- Tier 1: 1 Unit (Starter Supply) -->
          <div class="zvhc-bundle-card" data-tier="1" onclick="zvhcSelectTier(1)" style="position: relative; background: #FFFFFF; border-radius: 16px; padding: 18px 20px; border: 2px solid rgba(1,93,71,0.12); cursor: pointer; transition: all 0.2s ease;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <div class="zvhc-radio-circle" style="width: 20px; height: 20px; border-radius: 50%; border: 2px solid #CCC; display: flex; align-items: center; justify-content: center;">
                  <div class="zvhc-radio-dot" style="width: 10px; height: 10px; border-radius: 50%; background: var(--zvhc-green); display: none;"></div>
                </div>
                <div>
                  <div style="font-weight: 800; font-size: 1.05rem; color: var(--zvhc-forest);">Buy 1 (Starter Supply)</div>
                  <div style="font-size: 0.8rem; color: #777;">Standard single unit order</div>
                </div>
              </div>
              <div style="text-align: right;">
                <div class="zvhc-tier-price" id="zvhcPriceTier1" style="font-weight: 900; font-size: 1.25rem; color: var(--zvhc-forest);">$39.99</div>
                <div class="zvhc-tier-compare" id="zvhcCompareTier1" style="font-size: 0.85rem; text-decoration: line-through; color: #888;">$49.99</div>
              </div>
            </div>
          </div>

          <!-- Tier 2: 2 Units (Duo Care - Most Popular) -->
          <div class="zvhc-bundle-card is-selected" data-tier="2" onclick="zvhcSelectTier(2)" style="position: relative; background: #FFFFFF; border-radius: 16px; padding: 20px; border: 2.5px solid var(--zvhc-orange); cursor: pointer; box-shadow: 0 8px 24px rgba(253,85,10,0.12); transition: all 0.2s ease;">
            <div style="position: absolute; top: -12px; right: 20px; background: var(--zvhc-orange); color: #FFF; font-size: 0.72rem; font-weight: 900; padding: 3px 12px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.05em;">
              ★ MOST POPULAR · SAVE 30%
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <div class="zvhc-radio-circle" style="width: 20px; height: 20px; border-radius: 50%; border: 2px solid var(--zvhc-green); display: flex; align-items: center; justify-content: center;">
                  <div class="zvhc-radio-dot" style="width: 10px; height: 10px; border-radius: 50%; background: var(--zvhc-green); display: block;"></div>
                </div>
                <div>
                  <div style="font-weight: 800; font-size: 1.05rem; color: var(--zvhc-forest);">Buy 2 (Duo Care Course)</div>
                  <div style="font-size: 0.8rem; color: var(--zvhc-green); font-weight: 700;">Includes FREE US Shipping</div>
                </div>
              </div>
              <div style="text-align: right;">
                <div class="zvhc-tier-price" id="zvhcPriceTier2" style="font-weight: 900; font-size: 1.25rem; color: var(--zvhc-forest);">$69.99</div>
                <div class="zvhc-tier-compare" id="zvhcCompareTier2" style="font-size: 0.85rem; text-decoration: line-through; color: #888;">$99.98</div>
              </div>
            </div>
          </div>

          <!-- Tier 3: 3 Units (Trio Bundle - Best Value) -->
          <div class="zvhc-bundle-card" data-tier="3" onclick="zvhcSelectTier(3)" style="position: relative; background: #FFFFFF; border-radius: 16px; padding: 18px 20px; border: 2px solid rgba(1,93,71,0.12); cursor: pointer; transition: all 0.2s ease;">
            <div style="position: absolute; top: -11px; right: 20px; background: var(--zvhc-green); color: var(--zvhc-lime); font-size: 0.72rem; font-weight: 900; padding: 3px 12px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.05em;">
              BEST VALUE · SAVE 40%
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div style="display: flex; align-items: center; gap: 12px;">
                <div class="zvhc-radio-circle" style="width: 20px; height: 20px; border-radius: 50%; border: 2px solid #CCC; display: flex; align-items: center; justify-content: center;">
                  <div class="zvhc-radio-dot" style="width: 10px; height: 10px; border-radius: 50%; background: var(--zvhc-green); display: none;"></div>
                </div>
                <div>
                  <div style="font-weight: 800; font-size: 1.05rem; color: var(--zvhc-forest);">Buy 3 (Trio Restoration Bundle)</div>
                  <div style="font-size: 0.8rem; color: var(--zvhc-green); font-weight: 700;">Includes FREE US Shipping</div>
                </div>
              </div>
              <div style="text-align: right;">
                <div class="zvhc-tier-price" id="zvhcPriceTier3" style="font-weight: 900; font-size: 1.25rem; color: var(--zvhc-forest);">$89.99</div>
                <div class="zvhc-tier-compare" id="zvhcCompareTier3" style="font-size: 0.85rem; text-decoration: line-through; color: #888;">$149.97</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Add to Cart CTA -->
        <button type="button" id="zvhcAddToCartBtn" onclick="zvhcExecuteAddToCart()" style="width: 100%; background: var(--zvhc-forest); color: var(--zvhc-lime); font-family: var(--zvhc-font-heading); font-size: 1.15rem; font-weight: 900; letter-spacing: 0.04em; padding: 18px 24px; border-radius: 999px; border: none; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 10px 28px rgba(23,45,32,0.3); text-transform: uppercase;">
          ADD TO CART — <span id="zvhcCtaPrice">$69.99</span>
        </button>

        <!-- Trust Features Strip -->
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 24px; text-align: center; border-top: 1px solid rgba(1,93,71,0.1); padding-top: 18px;">
          <div>
            <div style="font-size: 1.2rem; margin-bottom: 4px;">🌿</div>
            <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-forest);">100% CLEAN BOTANICAL</div>
          </div>
          <div>
            <div style="font-size: 1.2rem; margin-bottom: 4px;">🇺🇸</div>
            <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-forest);">FAST US DELIVERY</div>
          </div>
          <div>
            <div style="font-size: 1.2rem; margin-bottom: 4px;">🛡️</div>
            <div style="font-size: 0.75rem; font-weight: 800; color: var(--zvhc-forest);">30-DAY GUARANTEE</div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- Sticky Mobile Add to Cart Dock -->
<div id="zvhcStickyDock" style="display: none; position: fixed; bottom: 0; left: 0; right: 0; background: #FFFFFF; border-top: 2px solid rgba(1,93,71,0.12); padding: 12px 16px; z-index: 998; box-shadow: 0 -8px 24px rgba(0,0,0,0.12);">
  <div style="display: flex; justify-content: space-between; align-items: center; max-width: 600px; margin: 0 auto; gap: 12px;">
    <div>
      <div style="font-size: 0.8rem; font-weight: 800; color: var(--zvhc-forest);" id="zvhcStickyTitle">{{ product.title | truncate: 25 }}</div>
      <div style="font-size: 1.15rem; font-weight: 900; color: var(--zvhc-orange);" id="zvhcStickyPrice">$69.99</div>
    </div>
    <button type="button" onclick="zvhcExecuteAddToCart()" style="background: var(--zvhc-forest); color: var(--zvhc-lime); font-weight: 900; font-size: 0.95rem; padding: 14px 22px; border-radius: 999px; border: none; cursor: pointer; text-transform: uppercase;">
      ADD TO CART
    </button>
  </div>
</div>

<script>
  window.ZVHC_PRODUCT_DATA = {{ product | json }};
</script>
