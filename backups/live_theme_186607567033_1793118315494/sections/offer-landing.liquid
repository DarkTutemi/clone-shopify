          {%- for block in day_blocks -%}
            <article class="offer-day offer-day--{{ block.settings.style }}" {{ block.shopify_attributes }}>
              {% render 'offer-img', image: block.settings.icon, fallback: block.settings.fallback_asset, class: 'offer-day__icon', width: 55, height: 55, loading: 'lazy', alt: '' %}
