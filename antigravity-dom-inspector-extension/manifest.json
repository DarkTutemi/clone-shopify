{
  "manifest_version": 3,
  "name": "Antigravity DOM Inspector & Agent Bridge",
  "version": "1.1.0",
  "description": "Click any element on page, inspect DOM & computed styles, and send directly to Antigravity AI Agent or copy to chat.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:9876/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Antigravity DOM Inspector"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Bật / Tắt Antigravity DOM Inspector"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end",
      "all_frames": false
    }
  ]
}
