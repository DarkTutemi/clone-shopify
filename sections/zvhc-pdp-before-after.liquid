        <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #B0476E; color: #FFFFFF; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 14px; border-radius: 9999px; white-space: nowrap;">
          ★ CRITICAL TURNING POINT
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
          <span style="font-size: 0.75rem; font-weight: 800; color: #B0476E; letter-spacing: 0.08em; text-transform: uppercase; background: #FDF2F6; padding: 4px 12px; border-radius: 6px;">{{ ba_p2_badge }}</span>
          <span style="font-size: 0.85rem; font-weight: 800; color: #2B1B24;">{{ ba_p2_time }}</span>
        </div>
        <div style="font-size: 1.25rem; font-weight: 800; color: #2B1B24; margin-bottom: 12px;">
          {{ ba_p2_title }}
        </div>
        <p style="font-size: 0.92rem; color: #5A4651; line-height: 1.6; margin-bottom: 20px; flex-grow: 1;">
          {{ ba_p2_desc }}
        </p>
        <div style="background: #FDF2F6; border-radius: 10px; padding: 14px 16px; border-left: 3px solid #B0476E;">
          <div style="font-size: 0.8rem; font-weight: 700; color: #2B1B24; margin-bottom: 2px;">Key Milestone:</div>
