n every single night before tying my edges down with a satin wrap. By week 4, the bald patch from tight cheer ponytails was 70% covered in fuzzy new growth. It takes patience but it pays off."},{"rating":4,"name":"Tierra W.","location":"New Orleans, LA","tag":"Lace Wig Wearer","date":"3 weeks ago","title":"Saved my hairline from lace glue damage","text":"Years of ghost bond adhesive completely wrecked my perimeter. This oil gave my follicles a break. My hairline stopped tingling and peeling within 48 hours. Knocked off one star because the 120ml jar goes fast if you use it on your full scalp like I do. Need a larger 250ml size!"},{"rating":4,"name":"Destiny M.","location":"Baltimore, MD","tag":"4C Coils • Wash Day","date":"4 weeks ago","title":"Great pre-poo treatment","text":"I warm about a tablespoon in a bowl of warm water and use it as a pre-shampoo hot oil mask on wash days. My detangling session went from 45 minutes of crying and snapped combs down to 15 minutes of easy slip. Lost half a star on price, but the quality speaks for itself."},{"rating":3,"name":"Jasmine D.","location":"Atlanta, GA","tag":"Protective Styles • Braids","date":"3 days ago","title":"USPS crushed the package, but customer service was 10/10","text":"Package arrived with the outer box completely crushed by the mail carrier and a little oil had seeped past the foil seal. I emailed support with photos and they sent out a replacement the very next morning without giving me the runaround. The oil itself is thick, rich, and works wonders on my braided scalp."},{"rating":3,"name":"Brittany K.","location":"Detroit, MI","tag":"4C Coils • Traction Alopecia","date":"1 week ago","title":"Delivery took 8 days to Michigan","text":"The shipping was delayed through the regional distribution center and took over a week to arrive when tracking estimated 3 days. Almost canceled my order, but once it finally got here and I used it on my thinning temples, I understood the hype. Smells authentic and herbal, not like synthetic perfume."},{"rating":3,"name":"Danielle P.","location":"Philadelphia, PA","tag":"High Porosity • Dry Scalp","date":"2 weeks ago","title":"Lid was jammed shut, had to run under hot water","text":"Whoever sealed my jar tightened it with superhero strength, I literally had to run the lid under boiling water to twist it open. Once opened, the batana paste is lovely and melts instantly into my fingers. Sinks into my scalp without staining my silk pillowcase. Just wish the lid wasn't so stiff."}];
      {% endif %}
      let currentFilter = 'all';
      let visibleCount = 8;
      const step = 8;

      const container = document.getElementById('reviews-cards-list');
      const loadMoreBtn = document.getElementById('load-more-reviews-btn');
      const countDisplay = document.getElementById('review-count-display');
      const filterBtns = document.querySelectorAll('.review-filter-btn');

      function getFilteredReviews() {
        if (currentFilter === 'all') {
          // Sort: 5-star first (most recent), then 4-star, then 3-star — so the first 8 visible are always 6×5★ + 2×4★
          const fiveStar = allReviews.filter(r => r.rating === 5);
          const fourStar = allReviews.filter(r => r.rating === 4);
          const threeStar = allReviews.filter(r => r.rating === 3);
          return [...fiveStar.slice(0, 6), ...fourStar.slice(0, 2), ...fiveStar.slice(6), ...fourStar.slice(2), ...threeStar];
        }
        const ratingNum = parseInt(currentFilter, 10);
        return allReviews.filter(r => r.rating === ratingNum);
      }

      function renderStars(rating) {
        let stars = '';
        for (let i = 1; i <= 5; i++) {
          stars += (i <= rating) ? '★' : '☆';
        }
        return stars;
      }

      function renderReviews() {
        const filtered = getFilteredReviews();
        const toShow = filtered.slice(0, visibleCount);

        container.innerHTML = toShow.map(r => {
          const starsHtml = renderStars(r.rating);
          const starColor = r.rating === 5 ? '#FFB800' : (r.rating === 4 ? '#E5A500' : '#D49200');
          
          return `
            <div class="review-card">
              <!-- Top Row: Rating & Date -->
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <div style="color: ${starColor}; font-size: 1.15rem; letter-spacing: 2px;">
                  ${starsHtml}
                </div>
                <div style="font-size: 0.78rem; color: #8A7681; font-weight: 500;">
                  ${r.date}
                </div>
              </div>

              <!-- Author Info & Badges -->
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <strong style="color: #2B1B24; font-size: 0.95rem;">${r.name}</strong>
                  <span style="font-size: 0.72rem; color: #7A6671;">(${r.location})</span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="background: #E6F4EA; color: #2E7D32; font-size: 0.7rem; font-weight: 800; padding: 3px 8px; border-radius: 9999px; letter-spacing: 0.02em;">
                    ✓ VERIFIED BUYER
                  </span>
                </div>
              </div>

              <!-- Hair Tag -->
              <div>
                <span style="background: #FAF0F4; color: #6B1D3A; font-size: 0.72rem; font-weight: 700; padding: 3px 10px; border-radius: 6px;">
                  ${r.tag}
                </span>
              </div>

              <!-- Review Headline -->
              <h4 style="font-size: 1rem; color: #2B1B24; margin: 4px 0 0; font-weight: 700; line-height: 1.35;">
                ${r.title}
              </h4>

              <!-- Review Body -->
              <p style="font-size: 0.9rem; color: #4A3A43; line-height: 1.6; margin: 0;">
                ${r.text}
              </p>
            </div>
          `;
        }).join('');

        // Update count text
        countDisplay.textContent = `Showing ${Math.min(visibleCount, filtered.length)} of 28,490 reviews`;

        // Update load more button visibility
        if (visibleCount >= filtered.length) {
          loadMoreBtn.style.display = 'none';
        } else {
          loadMoreBtn.style.display = 'inline-block';
          loadMoreBtn.textContent = 'LOAD MORE REVIEWS';
        }
      }

      // Filter click events
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          filterBtns.forEach(b => {
            b.classList.remove('active');
            b.style.background = '#FFFFFF';
            b.style.color = '#2B1B24';
            b.style.borderColor = '#EAD7DD';
          });
          this.classList.add('active');
          this.style.background = '#6B1D3A';
          this.style.color = '#FFFFFF';
          this.style.borderColor = '#6B1D3A';

          currentFilter = this.getAttribute('data-filter');
          visibleCount = 8;
          renderReviews();
        });
      });

      // Load more click
      loadMoreBtn.addEventListener('click', function() {
        visibleCount += step;
        renderReviews();
      });

      // Initial render
      renderReviews();
    })();
  </script>
</section>

{% endif %}

