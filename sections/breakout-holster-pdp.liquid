  <script>
    (function() {
      const VARIANT_ID = 68197875482809;

      const mainImg = document.getElementById('bh-main-photo');
      const thumbBtns = document.querySelectorAll('#Section-{{ section.id }} .bh-thumb-btn');
      const ctaBtn = document.getElementById('bh-main-atc-btn');
      const ctaText = document.getElementById('bh-cta-btn-text');
      const mobileBtn = document.getElementById('bh-dock-atc-btn');
      const mobilePrice = document.getElementById('bh-dock-price-val');
      const priceDisplay = document.getElementById('bh-price-val');
      const compareDisplay = document.getElementById('bh-compare-val');
      const savingsDisplay = document.getElementById('bh-savings-text');

      // Gallery Thumbnails
      thumbBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          thumbBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const src = btn.getAttribute('data-img');
          if (src && mainImg) mainImg.src = src;
        });
      });

      // Hand Orientation Buttons
      document.querySelectorAll('#Section-{{ section.id }} .bh-hand-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = btn.getAttribute('data-target');
          const val = btn.getAttribute('data-val');
          btn.parentElement.querySelectorAll('.bh-hand-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          if (target === 'gun1-hand') {
            document.getElementById('bh-gun1-hand-val').value = val;
          } else if (target === 'gun2-hand') {
            document.getElementById('bh-gun2-hand-val').value = val;
          }
        });
      });

      // Material Swatches
      document.querySelectorAll('#Section-{{ section.id }} .bh-swatch-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('#Section-{{ section.id }} .bh-swatch-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const mat = btn.getAttribute('data-mat');
          const matInp = document.getElementById('bh-material-val');
          if (matInp) matInp.value = mat;
          updatePricing();
        });
      });

      function updatePricing() {
        const activeSwatch = document.querySelector('#Section-{{ section.id }} .bh-swatch-btn.active');
        const mat = activeSwatch ? activeSwatch.getAttribute('data-mat') : 'Flat Black';

        let currentPrice = '129.99';
        let comparePrice = '260.00';
        let saveAmt = '130.01';

        if (mat === 'Carbon Fiber Upgrade') {
          currentPrice = '149.98';
          comparePrice = '300.00';
          saveAmt = '150.02';
        }

        const priceStr = '$' + currentPrice;
        const compareStr = '$' + comparePrice;

        if (priceDisplay) priceDisplay.innerText = priceStr;
        if (compareDisplay) compareDisplay.innerText = compareStr;
        if (mobilePrice) mobilePrice.innerText = priceStr;
        if (ctaText) ctaText.innerText = 'ADD TO CART – ' + priceStr;
        if (savingsDisplay) {
          savingsDisplay.innerText = '⇘ 🏷️ You save $' + saveAmt + ' on this order + FREE 2nd Holster included ⇙';
        }
      }

      // Add to Cart
      async function handleAddToCart() {
        const gun1 = document.getElementById('bh-gun-1')?.value || '';
        const gun2 = document.getElementById('bh-gun-2')?.value || '';

        if (!gun1 || gun1 === '-- Please Select --' || !gun2 || gun2 === '-- Please Select --') {
          alert('Please select your Gun Make & Model for both holsters.');
          return;
        }

        if (ctaBtn) {
          ctaBtn.disabled = true;
          ctaBtn.style.opacity = '0.7';
          ctaText.innerText = 'ADDING TO CART...';
        }
        if (mobileBtn) {
          mobileBtn.innerText = 'ADDING...';
        }

        const hand1 = document.getElementById('bh-gun1-hand-val')?.value || 'Right';
        const hand2 = document.getElementById('bh-gun2-hand-val')?.value || 'Right';
        const activeSwatch = document.querySelector('#Section-{{ section.id }} .bh-swatch-btn.active');
        const material = activeSwatch ? activeSwatch.getAttribute('data-mat') : 'Flat Black';

        const properties = {
          'Holster 1 Gun': gun1,
          'Holster 1 Hand': hand1 + ' Hand',
          'Holster 2 (FREE BOGO) Gun': gun2,
          'Holster 2 Hand': hand2 + ' Hand',
          'Material Finish': material === 'Carbon Fiber Upgrade' ? 'Carbon Fiber Upgrade (+ $19.99)' : 'Flat Black (Included)',
          'Promotion': 'BUY ONE GET ONE FREE (50% OFF)'
        };

        const items = [{
          id: VARIANT_ID,
          quantity: 1,
          properties: properties
        }];

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (res.ok) {
            window.location.href = '/checkout';
          } else {
            window.location.href = '/cart';
          }
        } catch (e) {
          console.error(e);
          window.location.href = '/cart';
        }
      }

      if (ctaBtn) ctaBtn.addEventListener('click', handleAddToCart);
      if (mobileBtn) mobileBtn.addEventListener('click', handleAddToCart);
    })();
  </script>
</div>

