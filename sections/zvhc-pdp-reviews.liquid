<section class="zvhc-reviews-section" id="reviews" style="padding: 72px 0; background: var(--zvhc-t01-bg, #E9E4E6);">
  <div class="zvhc-container">
    <div style="text-align: center; max-width: 680px; margin: 0 auto 48px;">
      <div style="font-size: 0.78rem; font-weight: 800; color: var(--zvhc-t01-accent-rose, #B0476E); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px;">VERIFIED TRANSPARENCY</div>
      <h2 class="zvhc-h2">Customer Reviews &amp; Formulation Integrity</h2>
      <p style="color: var(--zvhc-t01-text-muted, #5A4651); font-size: 0.95rem;">
        We collect authentic feedback exclusively from verified purchasers after order delivery.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 28px; max-width: 1040px; margin: 0 auto;">
      
      <!-- Left: Verified Community Results for This Specific SKU -->
      <div class="zvhc-editorial-card" style="display: flex; flex-direction: column; padding: 32px; border: 1px solid var(--zvhc-t01-border, #EAD7DD); background: #FFFFFF; border-radius: 16px;">
        <div style="font-size: 0.75rem; font-weight: 700; color: var(--zvhc-t01-accent-rose, #B0476E); text-transform: uppercase; margin-bottom: 6px;">{{ rev_eyebrow }}</div>
        <h3 class="zvhc-h3" style="font-size: 1.25rem; margin-bottom: 16px;">{{ rev_title }}</h3>

        <div style="display: flex; flex-direction: column; gap: 18px;">
          <!-- Review 1 -->
          <div style="border-bottom: 1px solid var(--zvhc-t01-border-subtle, #F0E6E9); padding-bottom: 14px;">
            <div style="display: flex; gap: 14px; align-items: flex-start;">
              {% if rev_r1_img != blank %}
                <div style="flex-shrink: 0; width: 72px; height: 72px; border-radius: 10px; overflow: hidden; border: 1px solid var(--zvhc-t01-border, #EAD7DD); box-shadow: 0 2px 8px rgba(43,27,36,0.06); background: #FAF6F8;">
                  <img src="{{ rev_r1_img }}" alt="{{ rev_r1_name | escape }}" style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" width="72" height="72">
                </div>
              {% endif %}
              <div style="flex-grow: 1; min-width: 0;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; flex-wrap: wrap; gap: 4px;">
                  <span style="font-weight: 700; font-size: 0.92rem; color: var(--zvhc-t01-text-main, #2B1B24);">{{ rev_r1_name }}</span>
                  <span style="font-size: 0.75rem; color: var(--zvhc-t01-accent-rose, #B0476E); font-weight: 700;">{{ rev_r1_badge }}</span>
                </div>
                <p style="font-size: 0.88rem; color: var(--zvhc-t01-text-muted, #5A4651); line-height: 1.55; margin: 0;">
                  "{{ rev_r1_text }}"
                </p>
              </div>
            </div>
          </div>

          <!-- Review 2 -->
          <div style="border-bottom: 1px solid var(--zvhc-t01-border-subtle, #F0E6E9); padding-bottom: 14px;">
            <div style="display: flex; gap: 14px; align-items: flex-start;">
              {% if rev_r2_img != blank %}
                <div style="flex-shrink: 0; width: 72px; height: 72px; border-radius: 10px; overflow: hidden; border: 1px solid var(--zvhc-t01-border, #EAD7DD); box-shadow: 0 2px 8px rgba(43,27,36,0.06); background: #FAF6F8;">
                  <img src="{{ rev_r2_img }}" alt="{{ rev_r2_name | escape }}" style="width: 100%; height: 100%; object-fit: cover; display: block;" loading="lazy" width="72" height="72">
                </div>
              {% endif %}
              <div style="flex-grow: 1; min-width: 0;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; flex-wrap: wrap; gap: 4px;">
                  <span style="font-weight: 700; font-size: 0.92rem; color: var(--zvhc-t01-text-main, #2B1B24);">{{ rev_r2_name }}</span>
                  <span style="font-size: 0.75rem; color: var(--zvhc-t01-accent-rose, #B0476E); font-weight: 700;">{{ rev_r2_badge }}</span>
                </div>
                <p style="font-size: 0.88rem; color: var(--zvhc-t01-text-muted, #5A4651); line-height: 1.55; margin: 0;">
                  "{{ rev_r2_text }}"
                </p>
              </div>
            </div>
          </div>

          <!-- Review 3 -->
