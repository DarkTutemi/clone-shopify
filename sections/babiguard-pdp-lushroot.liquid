      };

      // Elements
      const mainImg = document.getElementById('lrMainImage');
      const thumbBtns = document.querySelectorAll('#Section-{{ section.id }} .lr-thumb-btn');
      const bCards = document.querySelectorAll('#Section-{{ section.id }} .lr-bcard');
      const priceDisplay = document.getElementById('lrPriceDisplay');
      const compareDisplay = document.getElementById('lrCompareDisplay');
      const saveBadge = document.getElementById('lrSaveBadge');
      const bumpCheckbox = document.getElementById('lrOrderBumpCheckbox');
      const bumpLabel = document.getElementById('lrOrderBumpLabel');
      const savingsText = document.getElementById('lrSavingsText');
      const ctaBtn = document.getElementById('lrCtaBtn');
      const ctaMainText = document.getElementById('lrCtaMainText');
      const countdown = document.getElementById('lrCountdown');
      const mobileStickyPrice = document.getElementById('lrMobileStickyPrice');
      const mobileStickyBtn = document.getElementById('lrMobileStickyBtn');

      // Dropdown Elements
      const d1 = document.getElementById('lrDesignSelect_1');
      const d2_1 = document.getElementById('lrDesignSelect_2_1');
      const d2_2 = document.getElementById('lrDesignSelect_2_2');
      const d3_1 = document.getElementById('lrDesignSelect_3_1');
      const d3_2 = document.getElementById('lrDesignSelect_3_2');
      const d3_3 = document.getElementById('lrDesignSelect_3_3');

      // State (Card 3 active by default as shown in image)
      let activeTier = 3;
      let activeQty = 3;
      let activeBasePrice = 79.99;
      let activeComparePrice = 159.00;
      let activeSaveAmt = 79.01;
      let isBumpAdded = false;
      const bumpPrice = 12.99;

      // 1. Thumbnail Strip Click
      thumbBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          thumbBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const src = btn.getAttribute('data-img-src');
          if (src && mainImg) mainImg.src = src;
        });
      });

      // 2. Dropdown Change Handlers
      function updateGalleryFromDesign(designKey) {
        const v = VARIANTS[designKey];
        if (v && v.img) {
          if (mainImg) mainImg.src = v.img;
          thumbBtns.forEach(t => {
            if (t.getAttribute('data-img-src') === v.img) {
              thumbBtns.forEach(b => b.classList.remove('active'));
              t.classList.add('active');
            }
          });
        }
      }

      if (d1) d1.addEventListener('change', () => { if (activeTier === 1) updateGalleryFromDesign(d1.value); });
      if (d2_1) d2_1.addEventListener('change', () => { if (activeTier === 2) updateGalleryFromDesign(d2_1.value); });
      if (d3_1) d3_1.addEventListener('change', () => { if (activeTier === 3) updateGalleryFromDesign(d3_1.value); });

      // 3. Card Click Handler
      bCards.forEach(card => {
        card.addEventListener('click', (e) => {
          if (e.target.tagName.toLowerCase() === 'select') return;

          bCards.forEach(c => c.classList.remove('active'));
          card.classList.add('active');

          activeTier = parseInt(card.getAttribute('data-tier'), 10);
          activeQty = parseInt(card.getAttribute('data-qty'), 10);
          activeBasePrice = parseFloat(card.getAttribute('data-price'));
          activeComparePrice = parseFloat(card.getAttribute('data-compare'));
          activeSaveAmt = parseFloat(card.getAttribute('data-save'));

          if (activeTier === 1 && d1) updateGalleryFromDesign(d1.value);
          if (activeTier === 2 && d2_1) updateGalleryFromDesign(d2_1.value);
          if (activeTier === 3 && d3_1) updateGalleryFromDesign(d3_1.value);

          updatePriceUI();
        });
      });

      // 4. Order Bump Toggle
      if (bumpCheckbox && bumpLabel) {
        bumpLabel.addEventListener('click', (e) => {
          if (e.target !== bumpCheckbox) {
            bumpCheckbox.checked = !bumpCheckbox.checked;
          }
          isBumpAdded = bumpCheckbox.checked;
          if (isBumpAdded) {
            bumpLabel.classList.add('active');
          } else {
            bumpLabel.classList.remove('active');
          }
          updatePriceUI();
        });
      }

      // 5. Update Price & Savings UI
      function updatePriceUI() {
        let finalPrice = activeBasePrice;
        let finalCompare = activeComparePrice;
        let saveAmount = activeSaveAmt;

        if (isBumpAdded) {
          finalPrice += bumpPrice;
          finalCompare += 22.00;
          saveAmount += (22.00 - bumpPrice);
        }

        const priceStr = '$' + finalPrice.toFixed(2);
        const compareStr = '$' + finalCompare.toFixed(2);

        if (priceDisplay) priceDisplay.innerText = priceStr;
        if (compareDisplay) compareDisplay.innerText = compareStr;
        if (mobileStickyPrice) mobileStickyPrice.innerText = priceStr;

        let pct = Math.round(((finalCompare - finalPrice) / finalCompare) * 100);
        if (saveBadge) saveBadge.innerText = 'SAVE ' + pct + '%';

        if (savingsText) {
          if (activeTier === 1) {
            savingsText.innerText = 'You save $' + saveAmount.toFixed(2) + ' on this order';
          } else {
            savingsText.innerText = 'You save $' + saveAmount.toFixed(2) + ' on this order + FREE gift(s) included';
          }
        }

        if (ctaMainText) {
          ctaMainText.innerText = 'ADD TO CART – ' + priceStr;
        }
      }

      // 6. Add to Cart Handler
      async function handleAddToCart() {
        if (ctaBtn) {
          ctaBtn.disabled = true;
          ctaBtn.style.opacity = '0.7';
          ctaMainText.innerText = 'ADDING TO CART...';
        }
        if (mobileStickyBtn) {
          mobileStickyBtn.innerText = 'ADDING...';
        }

        let items = [];

        if (activeTier === 1) {
          const v1 = VARIANTS[d1 ? d1.value : 'Butterfly'] || VARIANTS['Butterfly'];
          items.push({ id: v1.id, quantity: 1, properties: { 'Tier': '1 BabiGuard' } });
        } else if (activeTier === 2) {
          const v1 = VARIANTS[d2_1 ? d2_1.value : 'Turtle'] || VARIANTS['Turtle'];
          const v2 = VARIANTS[d2_2 ? d2_2.value : 'Butterfly'] || VARIANTS['Butterfly'];
          if (v1.id === v2.id) {
            items.push({ id: v1.id, quantity: 2, properties: { 'Tier': '2 BabiGuards (Save 45% + Free Gift)' } });
          } else {
            items.push({ id: v1.id, quantity: 1, properties: { 'Tier': '2 BabiGuards - Item 1' } });
            items.push({ id: v2.id, quantity: 1, properties: { 'Tier': '2 BabiGuards - Item 2' } });
          }
        } else if (activeTier === 3) {
          const v1 = VARIANTS[d3_1 ? d3_1.value : 'Turtle'] || VARIANTS['Turtle'];
          const v2 = VARIANTS[d3_2 ? d3_2.value : 'Butterfly'] || VARIANTS['Butterfly'];
          const v3 = VARIANTS[d3_3 ? d3_3.value : 'Little Dragon'] || VARIANTS['Little Dragon'];
          
          const counts = {};
          [v1, v2, v3].forEach(v => {
            counts[v.id] = (counts[v.id] || 0) + 1;
          });
          Object.keys(counts).forEach(id => {
            items.push({ id: parseInt(id, 10), quantity: counts[id], properties: { 'Tier': '3 BabiGuards (Save 55% + 2 Free Gifts)' } });
          });
        }

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items })
          });

          if (res.ok) {
            window.location.href = '/checkout';
          } else {
            window.location.href = '/cart';
          }
        } catch (err) {
          console.error(err);
          window.location.href = '/cart';
        }
      }

      if (ctaBtn) ctaBtn.addEventListener('click', handleAddToCart);
      if (mobileStickyBtn) mobileStickyBtn.addEventListener('click', handleAddToCart);

      // 7. Flash Sale Timer
      if (countdown) {
        let totalSeconds = 6 * 3600 + 33 * 60;
        setInterval(() => {
          if (totalSeconds <= 0) totalSeconds = 24 * 3600;
          totalSeconds--;
          const h = String(Math.floor(totalSeconds / 3600)).padStart(2, '0');
          const m = String(Math.floor((totalSeconds % 3600) / 60)).padStart(2, '0');
          const s = String(totalSeconds % 60).padStart(2, '0');
          countdown.innerText = `${h}:${m}:${s}`;
        }, 1000);
      }

      updatePriceUI();
    })();
  </script>
</div>
