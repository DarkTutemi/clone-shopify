<div class="willa-pdp-page">
  <div class="willa-container">
    {% if section.settings.show_breadcrumbs %}
      <div class="willa-breadcrumbs">
        <a href="/">Home</a> &gt; <a href="/collections/all-products">Shop</a> &gt; <span>{{ product.title }}</span>
      </div>
    {% endif %}

    <div class="willa-pdp-layout">
      <!-- Media Gallery -->
      <div class="willa-pdp-gallery">
        {% assign custom_gal_count = 0 %}
        {% assign custom_first_img = '' %}
        {% for block in section.blocks %}
          {% if block.type == 'gallery_image' %}
            {% assign custom_gal_count = custom_gal_count | plus: 1 %}
            {% if custom_first_img == '' %}
              {% if block.settings.image != blank %}
                {% assign custom_first_img = block.settings.image | image_url: width: 1000 %}
              {% elsif block.settings.image_url != blank %}
                {% assign custom_first_img = block.settings.image_url %}
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}

        <div class="willa-pdp-main-img-wrap">
          {% if custom_gal_count > 0 and custom_first_img != '' %}
            <img id="willaPdpMainImg" src="{{ custom_first_img }}" alt="{{ product.title | escape }}">
          {% elsif product.featured_image %}
            <img id="willaPdpMainImg" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.title | escape }}">
          {% else %}
            <img id="willaPdpMainImg" src="https://cdn.shopify.com/s/files/1/0826/2483/9865/t/3/assets/zavelyn-hero-main.png?v=1792853600" alt="{{ product.title | escape }}">
          {% endif %}

          {% if product.compare_at_price > product.price %}
            <div class="willa-pdp-badge">{{ section.settings.badge_text | default: 'SPECIAL OFFER' }}</div>
          {% endif %}
        </div>

        <div class="willa-pdp-thumbs">
          {% if custom_gal_count > 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'gallery_image' %}
                {% assign thumb_src = '' %}
                {% if block.settings.image != blank %}
                  {% assign thumb_src = block.settings.image | image_url: width: 1000 %}
                {% elsif block.settings.image_url != blank %}
                  {% assign thumb_src = block.settings.image_url %}
                {% endif %}
                {% if thumb_src != '' %}
                  <img class="willa-pdp-thumb {% if forloop.first %}active{% endif %}" src="{{ thumb_src }}" alt="{{ block.settings.alt | default: product.title | escape }}" onclick="switchPdpImg(this.src)" {{ block.shopify_attributes }}>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% elsif product.images.size > 1 %}
            {% for image in product.images limit: 8 %}
              <img class="willa-pdp-thumb {% if forloop.first %}active{% endif %}" src="{{ image | image_url: width: 160 }}" alt="{{ product.title | escape }}" onclick="switchPdpImg(this.src)">
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- Purchase Box -->
      <div class="willa-pdp-details">
        <div class="willa-pdp-rating-row">
          <div class="willa-stars">{% render 'trustpilot-stars', width: 92, height: 17 %}</div>
          <span class="rating-text">{{ section.settings.rating_text | default: '4.9 / 5.0 (1,240+ Verified Reviews)' }}</span>
        </div>

        <h1 class="willa-pdp-title willa-serif">{{ product.title }}</h1>

        <div class="willa-pdp-price-row">
          <span class="willa-pdp-active-price" id="willaPdpPrice">{{ product.selected_or_first_available_variant.price | money }}</span>
          {% assign calc_compare = product.selected_or_first_available_variant.compare_at_price %}
          {% if calc_compare == blank or calc_compare <= product.selected_or_first_available_variant.price %}
            {% assign calc_compare = product.selected_or_first_available_variant.price | times: 1.8 | round %}
          {% endif %}
          <span class="willa-pdp-compare-price" id="willaPdpComparePrice">{{ calc_compare | money }}</span>
          <span class="willa-pdp-save-badge">{{ section.settings.save_badge_text | default: '50% OFF TODAY' }}</span>
        </div>

        <!-- Variants / Bundle Selector -->
        {% unless product.has_only_default_variant %}
          {% assign has_bundle_and_color = false %}
          {% assign bundle_option = nil %}
          {% assign color_option = nil %}

          {% if product.options.size > 1 %}
            {% for opt in product.options_with_values %}
              {% assign opt_name_down = opt.name | downcase %}
              {% if opt_name_down contains 'bundle' or opt_name_down contains 'quantity' or opt_name_down contains 'package' or opt_name_down contains 'tier' or opt_name_down contains 'pack' %}
                {% assign bundle_option = opt %}
              {% else %}
                {% assign color_option = opt %}
              {% endif %}
            {% endfor %}
            {% if bundle_option != nil and color_option != nil %}
              {% assign has_bundle_and_color = true %}
            {% endif %}
          {% endif %}

          {% if has_bundle_and_color %}
            <!-- Two-Tier Selector: Buy 1, Buy 2, Buy 3 Bundle Cards + Color Swatches -->
            <div class="willa-pdp-bundle-wrap">
              <label class="variant-label" style="font-weight: 700; margin-bottom: 10px; display: block;">Select Bundle & Save:</label>
              <div class="wf-bundle-selector">
                {% for b_val in bundle_option.values %}
                  {% assign rep_var = nil %}
                  {% for v in product.variants %}
                    {% if v.option1 == b_val and rep_var == nil %}
                      {% assign rep_var = v %}
                    {% endif %}
                  {% endfor %}

                  {% assign v_tag = 'Standard' %}
                  {% assign v_tag_class = 'standard' %}
                  {% assign v_desc = 'Standard Kit • Fast & Easy Setup' %}

                  {% if product.handle contains 'dough-mixer' %}
                    {% assign v_desc = '1x DoughMaster™ 7L Base + SUS 304 Bowl • Standard Kit' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Save 60% • Just $133.33 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 55% • Just $149.99 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'vfit' %}
                    {% assign v_desc = '1x vFit Device + Photonic Gel + Wipes • Standard Kit' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $199.99 each • Free Discreet US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 50% • Just $224.99 each • Free Discreet US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'bralisse' or product.handle contains 'shapewear' %}
                    {% assign v_desc = '1x SculptComfort™ Wire-Free Bra • Standard Kit' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $43.33 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 55% • Just $49.99 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'pacifier' or product.handle contains 'supertots' %}
                    {% assign v_desc = '1x Feeder Pacifier + 3 Teats (S,M,L) • Starter Kit' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $11.66 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 45% • Just $13.49 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'airclear' or product.handle contains 'clarifion' or product.handle contains 'ionizer' %}
                    {% assign v_desc = '1x AirClear™ Plug-In Ionizer • Single Room Purifier' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 6' or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 3, Get 3 FREE • Just $19.99 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 3' or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 55% • Just $26.66 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'foundation' or product.handle contains 'flawlessblend' %}
                    {% assign v_desc = '1x Foundation Stick + Built-In Brush • Standard Kit' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $26.66 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 45% • Just $29.99 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'pureflow' or product.handle contains 'fountain' %}
                    {% assign v_desc = '1x PureFlow™ Fountain + Triple Filter • Standard Kit' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $49.99 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 45% • Just $59.99 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'glider' or product.handle contains 'gravityglider' %}
                    {% assign v_desc = '1x GravityGlider™ RC Jet + Controller • Ready to Fly' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $33.33 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 45% • Just $39.99 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'megalifter' or product.handle contains 'lifter' or product.handle contains 'construction' %}
                    {% assign v_desc = '1x MegaLifter™ Heavy Alloy Vehicle • Ready to Dig' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $43.33 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 45% • Just $49.99 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'botana' or product.handle contains 'batana' %}
                    {% assign v_desc = '1x BotanaRoots™ 60ml Bottle • 30-Day Starter Supply' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $29.67 each • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 45% • Just $34.50 each • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'thermoglove' or product.handle contains 'glove' or product.handle contains 'ackerman' %}
                    {% assign v_desc = '1 Pair ThermoGlove™ Heated Gloves • USB Fast Charging' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $33.33/pair • Free Express US Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 45% • Just $39.99/pair • Free Express US Shipping' %}
                    {% endif %}
                  {% elsif product.handle contains 'cozyheat' %}
                    {% assign v_desc = '1 Cozy Wrap • Fast & Easy Setup' %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Buy 2, Get 1 FREE • Just $43.33 each • Free Express Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Save 45% • Just $45.00 each • Most Popular Choice' %}
                    {% endif %}
                  {% else %}
                    {% if forloop.index == 3 or b_val contains 'Buy 3' %}
                      {% assign v_tag = '★ BEST VALUE' %}
                      {% assign v_tag_class = 'best-value' %}
                      {% assign v_desc = 'Best Value Set • Free Express Shipping' %}
                    {% elsif forloop.index == 2 or b_val contains 'Buy 2' %}
                      {% assign v_tag = '★ MOST POPULAR' %}
                      {% assign v_tag_class = 'popular' %}
                      {% assign v_desc = 'Most Popular Choice • Extra Savings' %}
                    {% endif %}
                  {% endif %}

                  <div class="wf-bundle-card {% if forloop.first %}active{% endif %}"
                       data-bundle-val="{{ b_val | escape }}"
                       onclick="selectTierBundle('{{ b_val | escape }}', '{{ rep_var.price | money }}', '{{ rep_var.compare_at_price | money }}', this)">
                    <div class="wf-card-radio"></div>
                    <div class="wf-card-info">
                      <div class="wf-card-title-row">
                        <span class="wf-card-title">{{ b_val }}</span>
                        <span class="wf-card-tag {{ v_tag_class }}">{{ v_tag }}</span>
                      </div>
                      <div class="wf-card-desc">{{ v_desc }}</div>
                    </div>
                    <div class="wf-card-pricing">
                      <span class="wf-card-price">{{ rep_var.price | money }}</span>
                      {% if rep_var.compare_at_price > rep_var.price %}
                        <span class="wf-card-comp">{{ rep_var.compare_at_price | money }}</span>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              </div>

              <!-- Color / Edition Swatches / Picker -->
              <div class="willa-color-picker-wrap" style="margin-top: 18px; padding: 16px; background: #faf8f5; border: 1.5px solid #e7e4df; border-radius: 12px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                  <span style="font-size: 14px; font-weight: 700; color: #231f20;">Select {{ color_option.name }}: <strong id="willaSelectedColorLabel" style="color: #8a2c13;">{{ color_option.values.first }}</strong></span>
                  <span style="font-size: 12px; color: #16a34a; font-weight: 600;">✓ In Stock</span>
                </div>
                <div class="willa-color-chips" style="display: flex; gap: 8px; flex-wrap: wrap;">
                  {% for c_val in color_option.values %}
                    {% assign color_img = '' %}
                    {% for v in product.variants %}
                      {% if v.option2 == c_val and v.featured_image != blank and color_img == '' %}
                        {% assign color_img = v.featured_image | image_url: width: 1000 %}
                      {% endif %}
                    {% endfor %}

                    {% assign dot_color = '#cbd5e0' %}
                    {% assign c_down = c_val | downcase %}
                    {% if c_down contains 'brown' %}
                      {% assign dot_color = '#8c5a3c' %}
                    {% elsif c_down contains 'apricot' %}
                      {% assign dot_color = '#e8c39e' %}
                    {% elsif c_down contains 'green' %}
                      {% assign dot_color = '#556b2f' %}
                    {% elsif c_down contains 'rose' or c_down contains 'gold' %}
                      {% assign dot_color = '#b76e79' %}
                    {% elsif c_down contains 'pro' or c_down contains 'plus' %}
                      {% assign dot_color = '#a50034' %}
                    {% elsif c_down contains 'red' %}
                      {% assign dot_color = '#9b2c2c' %}
                    {% elsif c_down contains 'purple' %}
                      {% assign dot_color = '#7e57c2' %}
                    {% elsif c_down contains 'classic' or c_down contains 'pearl' or c_down contains 'white' %}
                      {% assign dot_color = '#ffffff' %}
                    {% elsif c_down contains 'black' %}
                      {% assign dot_color = '#111827' %}
                    {% endif %}

                    <button type="button" class="willa-color-swatch-btn {% if forloop.first %}active{% endif %}"
                            data-color-val="{{ c_val | escape }}"
                            data-color-img="{{ color_img }}"
                            onclick="selectTierColor('{{ c_val | escape }}', '{{ color_img }}', this)"
                            style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; border: 2px solid {% if forloop.first %}#8a2c13{% else %}#e2e8f0{% endif %}; border-radius: 8px; background: #ffffff; cursor: pointer; font-size: 13px; font-weight: 600; transition: all 0.2s;">
                      <span style="width: 14px; height: 14px; border-radius: 50%; background-color: {{ dot_color }}; border: 1px solid rgba(0,0,0,0.15); display: inline-block;"></span>
                      <span>{{ c_val }}</span>
                    </button>
                  {% endfor %}
                </div>
              </div>
            </div>

          {% else %}
            <!-- Single-Option Bundle or Standard Variant Chips -->
            {% assign is_bundle_product = false %}
            {% for opt in product.options_with_values %}
              {% assign opt_name_down = opt.name | downcase %}
              {% if opt_name_down contains 'bundle' or opt_name_down contains 'quantity' or opt_name_down contains 'package' or opt_name_down contains 'pack' or product.handle contains 'fence-post' %}
                {% assign is_bundle_product = true %}
              {% endif %}
            {% endfor %}

            {% if is_bundle_product and product.variants.size > 1 %}
              <div class="willa-pdp-bundle-wrap">
                <label class="variant-label" style="font-weight: 700; margin-bottom: 10px; display: block;">Select Bundle Option:</label>
                <div class="wf-bundle-selector">
                  {% for variant in product.variants %}
                    {% assign var_img = '' %}
                    {% if variant.featured_image != blank %}
                      {% assign var_img = variant.featured_image | image_url: width: 1000 %}
                    {% elsif product.featured_image != blank %}
                      {% assign var_img = product.featured_image | image_url: width: 1000 %}
                    {% endif %}

                    {% assign v_title = variant.title %}
                    {% assign v_tag = 'Standard' %}
                    {% assign v_tag_class = 'standard' %}
                    {% assign v_desc = 'Complete Kit + Mounting Hardware' %}
                    {% assign v_unit = '' %}

                    {% if product.handle contains 'fence-post' %}
                      {% if forloop.index == 1 or v_title contains '2' %}
                        {% assign v_tag = 'Standard' %}
                        {% assign v_tag_class = 'standard' %}
                        {% assign v_desc = '2 Heavy-Duty H-Stakes + Hardware • Complete 2-Post Repair' %}
                        {% assign unit_ea = variant.price | divided_by: 2.0 | money %}
                        {% assign v_unit = '(' | append: unit_ea | append: '/ea)' %}
                      {% elsif forloop.index == 2 or v_title contains '4' %}
                        {% assign v_tag = '★ MOST POPULAR' %}
                        {% assign v_tag_class = 'popular' %}
                        {% assign v_desc = '4 Heavy-Duty H-Stakes + Hardware • Save Extra 5%' %}
                        {% assign unit_ea = variant.price | divided_by: 4.0 | money %}
                        {% assign v_unit = '(' | append: unit_ea | append: '/ea)' %}
                      {% elsif forloop.index == 3 or v_title contains '6' %}
                        {% assign v_tag = '★ BEST VALUE' %}
                        {% assign v_tag_class = 'best-value' %}
                        {% assign v_desc = '6 Heavy-Duty H-Stakes + Hardware • Save Extra 15% • <span class="wf-freeship-text">🚚 FREE US SHIPPING INCLUDED</span>' %}
                        {% assign unit_ea = variant.price | divided_by: 6.0 | money %}
                        {% assign v_unit = '(' | append: unit_ea | append: '/ea)' %}
                      {% endif %}
                    {% else %}
                      {% if forloop.index == 2 %}
                        {% assign v_tag = '★ MOST POPULAR' %}
                        {% assign v_tag_class = 'popular' %}
                        {% assign v_desc = 'Save Extra 5% • Most Popular Choice' %}
                        {% assign unit_ea = variant.price | divided_by: 2.0 | money %}
                        {% assign v_unit = '(' | append: unit_ea | append: '/ea)' %}
                      {% elsif forloop.index == 3 %}
                        {% assign v_tag = '★ BEST VALUE' %}
                        {% assign v_tag_class = 'best-value' %}
                        {% assign v_desc = 'Save Extra 15% • Free Express Shipping' %}
                        {% assign unit_ea = variant.price | divided_by: 3.0 | money %}
                        {% assign v_unit = '(' | append: unit_ea | append: '/ea)' %}
                      {% else %}
                        {% assign v_desc = 'Standard Kit • Fast & Easy Setup' %}
                      {% endif %}
                    {% endif %}

                    <div class="wf-bundle-card {% if variant.id == product.selected_or_first_available_variant.id %}active{% endif %}"
                         onclick="selectPdpBundleCard('{{ variant.id }}', '{{ variant.price | money }}', '{{ variant.compare_at_price | money }}', '{{ var_img }}', this)">
                      <div class="wf-card-radio"></div>
                      <div class="wf-card-info">
                        <div class="wf-card-title-row">
                          <span class="wf-card-title">{{ variant.title }}</span>
                          <span class="wf-card-tag {{ v_tag_class }}">{{ v_tag }}</span>
                          {% if product.handle contains 'fence-post' and forloop.index == 3 %}
                            <span class="wf-card-tag freeship">🚚 FREE SHIPPING</span>
                          {% endif %}
                        </div>
                        <div class="wf-card-desc">{{ v_desc }}</div>
                      </div>
                      <div class="wf-card-pricing">
                        <span class="wf-card-price">{{ variant.price | money }}</span>
                        {% if variant.compare_at_price > variant.price %}
                          <span class="wf-card-comp">{{ variant.compare_at_price | money }}</span>
                        {% endif %}
                        {% if v_unit != '' %}
                          <span class="wf-unit-note">{{ v_unit }}</span>
                        {% endif %}
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            {% else %}
              <div class="willa-pdp-variants-wrap">
                <label class="variant-label">Select Option:</label>
                <div class="willa-pdp-variant-chips">
                  {% for variant in product.variants %}
                    {% assign var_img = '' %}
                    {% if variant.featured_image != blank %}
                      {% assign var_img = variant.featured_image | image_url: width: 1000 %}
                    {% elsif product.featured_image != blank %}
                      {% assign var_img = product.featured_image | image_url: width: 1000 %}
                    {% endif %}
                    <button type="button" class="willa-variant-chip {% if variant.id == product.selected_or_first_available_variant.id %}active{% endif %}" onclick="selectPdpVariant('{{ variant.id }}', '{{ variant.price | money }}', '{{ variant.compare_at_price | money }}', '{{ var_img }}', this)">
                      {{ variant.title }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endif %}
          {% endif %}
        {% endunless %}

        <!-- Quantity & ATC -->
        <div class="willa-pdp-actions">
          <div class="willa-pdp-qty-row">
            <label for="willaPdpQty">Quantity:</label>
            <div class="willa-pdp-qty-ctrl">
              <button type="button" onclick="adjustPdpQty(-1)">-</button>
              <input type="number" id="willaPdpQty" value="1" min="1" max="10" readonly>
              <button type="button" onclick="adjustPdpQty(1)">+</button>
            </div>
          </div>

          <button type="button" id="willaPdpAtcBtn" class="willa-btn-primary willa-pdp-atc" onclick="submitPdpOrder()">
            {% if product.available %}
              ADD TO CART ➔
            {% else %}
              SOLD OUT
            {% endif %}
          </button>
        </div>

        <!-- 1-Click Direct Checkout Button -->
        <button type="button" id="willaPdpShopNowBtn" class="willa-pdp-shopnow" onclick="submitPdpDirectCheckout()">
          ⚡ SHOP NOW (1-CLICK CHECKOUT) ➔
        </button>

        <!-- Guarantees Row -->
        <div class="willa-pdp-trust-box">
          <div class="pdp-trust-item">
            <span>🛡️</span> <strong>30-Day Money-Back Guarantee</strong>
          </div>
          {% unless product.handle contains 'fence-post' %}
            <div class="pdp-trust-item">
              <span>🚚</span> <strong>Free Express Delivery on Orders $49+</strong>
            </div>
          {% endunless %}
          <div class="pdp-trust-item">
            <span>🔒</span> <strong>Safe &amp; Encrypted 256-Bit Checkout</strong>
          </div>
        </div>

        <!-- Accordions: Description, Features, Shipping -->
        <div class="willa-pdp-accordions">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              <details class="willa-faq-item" {% if forloop.first or block.settings.open_default %}open{% endif %} {{ block.shopify_attributes }}>
                <summary>
                  <span>{{ block.settings.title }}</span>
                  <span class="faq-icon">+</span>
                </summary>
                <div class="faq-content">
                  {% if block.settings.use_product_description %}
                    {% if product.description != blank %}
                      {{ product.description }}
                    {% else %}
                      <p>Industrial-grade construction engineered for tough jobs and reliable long-term performance.</p>
                    {% endif %}
                  {% else %}
                    <p>{{ block.settings.content }}</p>
                  {% endif %}
                </div>
              </details>
            {% endfor %}
          {% else %}
            <details class="willa-faq-item" open>
              <summary>
                <span>Product Description</span>
                <span class="faq-icon">+</span>
              </summary>
              <div class="faq-content">
                {% if product.description != blank %}
                  {{ product.description }}
                {% else %}
                  <p>Industrial-grade construction engineered for tough jobs and reliable long-term performance.</p>
                {% endif %}
              </div>
            </details>

            <details class="willa-faq-item">
              <summary>
                <span>Shipping &amp; Delivery Information</span>
                <span class="faq-icon">+</span>
              </summary>
              <div class="faq-content">
                <p>Orders are dispatched within 24 hours from our US warehouses. Free standard shipping is automatically applied to orders over $49. Delivery takes 3–5 business days with live tracking.</p>
              </div>
            </details>

            <details class="willa-faq-item">
              <summary>
                <span>Warranty &amp; Returns</span>
                <span class="faq-icon">+</span>
              </summary>
              <div class="faq-content">
                <p>We offer an unconditional 30-Day Money-Back Guarantee. If you are not completely satisfied, email support@tryzavelyn.com for an immediate exchange or refund.</p>
              </div>
            </details>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Sticky Bottom Purchase Bar -->
  {% if section.settings.enable_sticky_atc %}
    <div class="willa-pdp-sticky-bar" id="willaStickyAtc">
      <div class="sticky-bar-left">
        <span class="sticky-title">{{ product.title | truncate: 30 }}</span>
